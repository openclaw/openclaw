+    private sealed class Transport : IGatewayAiSetupTransport
+    {
+        public GatewayAiSetupRoute Route { get; init; } = new("gateway", "agent", "authority", new string('A', 64));
+        public long Generation => 1;
+        public bool IsConnected => true;
+        public IReadOnlyCollection<string> OperatorScopes { get; set; } = ["operator.admin"];
+        public IReadOnlyCollection<string> Methods => ["openclaw.setup.detect", "openclaw.setup.verify", "openclaw.setup.activate"];
+        public List<string> MethodsCalled { get; } = [];
+        public string? Model { get; init; }
+        public Task<JsonElement> RequestAsync(string method, object parameters, int timeoutMs, CancellationToken cancellationToken)
+        {
+            Assert.Equal("openclaw.setup.detect", method);
+            MethodsCalled.Add(method);
+            return Task.FromResult(JsonSerializer.SerializeToElement(new
+            {
+                candidates = Model is null ? Array.Empty<object>() :
+                    [new { kind = "existing-model", label = "Current model", detail = "Configured", modelRef = Model, recommended = false },
+                        new { kind = "provider-auto:ollama", label = "Ollama", detail = "Discovered", modelRef = Model, recommended = false }],
+                manualProviders = Array.Empty<object>(), workspace = "/synthetic", configuredModel = Model, setupComplete = Model is not null
+            }));
+        }
+    }
