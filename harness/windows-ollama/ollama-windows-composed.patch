 using System.Diagnostics;
+using System.IO.Pipes;
+using System.Text.Json;
 
 namespace OpenClaw.SetupEngine.Tests;
 
@@ -45,6 +47,69 @@ public class CommandRunnerTests
         }
     }
 
+    [Fact]
+    public async Task AdmittedInstaller_CancellationDrainsRootWithoutKillingExternalApp()
+    {
+        var name = "openclaw-installer-" + Guid.NewGuid().ToString("N");
+        using var parentPipe = new NamedPipeServerStream(name, PipeDirection.InOut, 1,
+            PipeTransmissionMode.Byte, PipeOptions.Asynchronous | PipeOptions.CurrentUserOnly);
+        using var appPipe = new NamedPipeServerStream(name + "-app", PipeDirection.InOut, 1,
+            PipeTransmissionMode.Byte, PipeOptions.Asynchronous | PipeOptions.CurrentUserOnly);
+        using var deadline = new CancellationTokenSource(TimeSpan.FromSeconds(20));
+        using var cancellation = new CancellationTokenSource();
+        var run = CreateRunner().RunAdmittedInstallerAsync(FindTestHost(),
+            ["--process-fixture", "admitted-installer", name], cancellation.Token);
+        Process? child = null;
+        StreamWriter? parentWriter = null;
+        StreamWriter? appWriter = null;
+        try
+        {
+            await parentPipe.WaitForConnectionAsync(deadline.Token);
+            using var reader = new StreamReader(parentPipe, leaveOpen: true);
+            using var identity = JsonDocument.Parse((await reader.ReadLineAsync(deadline.Token))!);
+            child = Process.GetProcessById(identity.RootElement.GetProperty("Child").GetInt32());
+            await appPipe.WaitForConnectionAsync(deadline.Token);
+            parentWriter = new StreamWriter(parentPipe, leaveOpen: true) { AutoFlush = true };
+            appWriter = new StreamWriter(appPipe, leaveOpen: true) { AutoFlush = true };
+            cancellation.Cancel();
+            Assert.False(run.IsCompleted);
+            Assert.False(child.HasExited);
+            await parentWriter.WriteLineAsync("release");
+            var result = await run.WaitAsync(deadline.Token);
+            Assert.Equal(0, result.ExitCode);
+            Assert.False(result.TimedOut);
+            Assert.Contains("installer-finished", result.Stdout);
+            // The direct installer exited and its output drain ended while this app still owns the pipes.
+            Assert.False(child.HasExited);
+        }
+        finally
+        {
+            if (parentWriter is not null && !run.IsCompleted)
+            {
+                try { await parentWriter.WriteLineAsync("release"); }
+                catch (IOException) { /* The fixture parent may already have exited. */ }
+            }
+            if (appWriter is not null) await appWriter.WriteLineAsync("release");
+            if (child is not null)
+            {
+                await child.WaitForExitAsync(deadline.Token);
+                child.Dispose();
+            }
+            await run.WaitAsync(deadline.Token);
+            parentWriter?.Dispose();
+            appWriter?.Dispose();
+        }
+    }
+
+    [Fact]
+    public async Task AdmittedInstaller_CancelledAdmissionNeverCreatesProcess()
+    {
+        using var cancellation = new CancellationTokenSource();
+        cancellation.Cancel();
+        await Assert.ThrowsAnyAsync<OperationCanceledException>(() => CreateRunner().RunAdmittedInstallerAsync(
+            "an-executable-that-must-not-be-started", [], cancellation.Token));
+    }
+
