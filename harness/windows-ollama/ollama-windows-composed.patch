+using System.Text.Json;
+using OpenClaw.TestSupport;
+
+namespace OpenClaw.SetupEngine.Tests;
+
+public sealed class OllamaWindowsSetupTests
+{
+    private static OllamaWindowsObservation Missing => new(
+        OllamaWindowsInstallationState.NoSupportedRegistration, OllamaWindowsActivity.NotActive,
+        null, OllamaWindowsApiState.NotListening, 0);
+    private static OllamaWindowsObservation Stopped => new(
+        OllamaWindowsInstallationState.Verified, OllamaWindowsActivity.NotActive,
+        new(Path.Combine(Path.GetTempPath(), "existing-ollama"), "existing-version"),
+        OllamaWindowsApiState.NotListening, 0);
+
+    [Fact]
+    public async Task ExistingGatewayModelAvoidsWindowsInventoryAndAllAppMutations()
+    {
+        var transport = new Transport { Model = "ollama/existing:tag" };
+        using var host = new Host();
+        var setup = Create(host, transport);
+        var snapshot = await setup.InspectAsync(CancellationToken.None);
+        Assert.Equal("ollama/existing:tag", snapshot.ExistingGatewayCandidate?.ModelRef);
+        Assert.Equal("existing-model", snapshot.ExistingGatewayCandidate?.Kind);
+        Assert.Equal(0, host.Observations);
+        Assert.Throws<InvalidOperationException>(() => setup.Review(snapshot, OllamaWindowsAction.Install));
+        Assert.Equal((0, 0, 0), (host.Acquisitions, host.Installations, host.Opens));
+        Assert.All(transport.MethodsCalled, method => Assert.Equal("openclaw.setup.detect", method));
+    }
+
+    [Theory]
+    [InlineData((int)OllamaWindowsInstallationState.Unknown, (int)OllamaWindowsActivity.NotActive, (int)OllamaWindowsApiState.NotListening)]
+    [InlineData((int)OllamaWindowsInstallationState.NoSupportedRegistration, (int)OllamaWindowsActivity.Unknown, (int)OllamaWindowsApiState.NotListening)]
+    [InlineData((int)OllamaWindowsInstallationState.NoSupportedRegistration, (int)OllamaWindowsActivity.NotActive, (int)OllamaWindowsApiState.Unknown)]
+    [InlineData((int)OllamaWindowsInstallationState.NoSupportedRegistration, (int)OllamaWindowsActivity.Active, (int)OllamaWindowsApiState.NotListening)]
+    public async Task UnknownOrActiveEvidenceCannotBecomeInstallConsent(
+        int installation, int activity, int api)
+    {
+        using var host = new Host { Current = new((OllamaWindowsInstallationState)installation,
+            (OllamaWindowsActivity)activity, null, (OllamaWindowsApiState)api, 0) };
+        var setup = Create(host, new Transport());
+        var snapshot = await setup.InspectAsync(CancellationToken.None);
+        Assert.Throws<InvalidOperationException>(() => setup.Review(snapshot, OllamaWindowsAction.Install));
+        Assert.Equal(0, host.Acquisitions);
+    }
+
+    [Fact]
+    public async Task UnboundGatewayMayBeInspectedButCannotAuthorizeAppInstallation()
+    {
+        using var host = new Host();
+        var transport = new Transport { Route = new("gateway", "agent", "authority") };
+        var setup = Create(host, transport);
+        var snapshot = await setup.InspectAsync(CancellationToken.None);
+        Assert.Throws<InvalidOperationException>(() => setup.Review(snapshot, OllamaWindowsAction.Install));
+        Assert.Equal(0, host.Acquisitions);
+    }
+
+    [Fact]
+    public async Task RegisteredStoppedApplicationIsOpenedWithoutReinstalling()
+    {
+        using var host = new Host { Current = Stopped, AfterOpen = Stopped with
+            { ApiState = OllamaWindowsApiState.Reachable, LocalChatModelCount = 0 } };
+        var transport = new Transport();
+        var setup = Create(host, transport);
+        var intent = setup.Review(await setup.InspectAsync(CancellationToken.None), OllamaWindowsAction.Open);
+        var result = await setup.RunAsync(intent, CancellationToken.None);
+        Assert.Equal(OllamaWindowsSetupOutcome.AppReadyNeedsModel, result.Outcome);
+        Assert.Equal((0, 0, 1), (host.Acquisitions, host.Installations, host.Opens));
+        Assert.All(transport.MethodsCalled, method => Assert.Equal("openclaw.setup.detect", method));
+    }
+
+    [Fact]
+    public async Task ServiceAppearingDuringDownloadIsReusedWithoutInstallationOrLaunch()
+    {
+        using var host = new Host();
+        host.DuringAcquire = () => host.Current = Missing with
+            { Activity = OllamaWindowsActivity.Active, ApiState = OllamaWindowsApiState.Reachable, LocalChatModelCount = 1 };
+        var transport = new Transport();
+        var setup = Create(host, transport);
+        var intent = setup.Review(await setup.InspectAsync(CancellationToken.None), OllamaWindowsAction.Install);
+        var result = await setup.RunAsync(intent, CancellationToken.None);
+        Assert.Equal(OllamaWindowsSetupOutcome.GatewayReadinessUnknown, result.Outcome);
+        Assert.Equal((1, 0, 0), (host.Acquisitions, host.Installations, host.Opens));
+        Assert.All(transport.MethodsCalled, method => Assert.Equal("openclaw.setup.detect", method));
+    }
+
+    [Fact]
+    public async Task RevokedGatewayAuthorityAfterDownloadCannotAdmitInstallation()
+    {
+        using var host = new Host();
+        var transport = new Transport();
+        host.DuringAcquire = () => transport.OperatorScopes = [];
+        var setup = Create(host, transport);
+        var intent = setup.Review(await setup.InspectAsync(CancellationToken.None), OllamaWindowsAction.Install);
+        var result = await setup.RunAsync(intent, CancellationToken.None);
+        Assert.Equal(OllamaWindowsSetupOutcome.Failed, result.Outcome);
+        Assert.Equal(0, host.Installations);
+    }
+
+    [Fact]
+    public async Task CancellationAfterAdmissionKeepsOperationOwnedUntilInstallationSettles()
+    {
+        using var host = new Host();
+        var installed = new TaskCompletionSource<CommandResult>(TaskCreationOptions.RunContinuationsAsynchronously);
+        host.PendingInstall = installed.Task;
+        var setup = Create(host, new Transport());
+        var intent = setup.Review(await setup.InspectAsync(CancellationToken.None), OllamaWindowsAction.Install);
+        using var cancellation = new CancellationTokenSource();
+        var run = setup.RunAsync(intent, cancellation.Token);
+        Task? drain = null;
+        try
+        {
+            await host.InstallStarted.Task.WaitAsync(TimeSpan.FromSeconds(10));
+            Assert.Equal(1, host.Installations);
+            cancellation.Cancel();
+            drain = setup.DrainAsync();
