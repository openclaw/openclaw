diff --git a/src/OpenClaw.SetupEngine.UI/Controls/OllamaWindowsSetupDialog.cs b/src/OpenClaw.SetupEngine.UI/Controls/OllamaWindowsSetupDialog.cs
new file mode 100644
index 00000000..8e98d3d0
--- /dev/null
+++ b/src/OpenClaw.SetupEngine.UI/Controls/OllamaWindowsSetupDialog.cs
@@ -0,0 +1,296 @@
+using System.Diagnostics;
+using OpenClaw.Shared;
+using Microsoft.UI.Xaml;
+using Microsoft.UI.Xaml.Automation;
+using Microsoft.UI.Xaml.Controls;
+
+namespace OpenClaw.SetupEngine.UI.Controls;
+
+internal sealed record OllamaWindowsDialogResult(OllamaWindowsSetupResult? Result,
+    bool ContinueConnection = false, bool UseDetectedModel = false);
+
+/// <summary>Native review and progress only. The setup owner admits every app action.</summary>
+internal sealed class OllamaWindowsSetupDialog : ContentDialog
+{
+    private enum PrimaryAction { Check, Run, UseDetected }
+    private readonly TextBlock _message = new() { Name = "OllamaAppMessage", TextWrapping = TextWrapping.Wrap };
+    private readonly TextBlock _status = new() { Name = "OllamaAppStatus", TextWrapping = TextWrapping.Wrap };
+    private readonly ProgressBar _progress = new() { IsIndeterminate = true, Visibility = Visibility.Collapsed };
+    private readonly CheckBox _consent = new() { Name = "OllamaAppInstallConsent" };
+    private readonly TextBlock _details = new() { TextWrapping = TextWrapping.Wrap };
+    private readonly TextBlock _diagnostics = new() { Name = "OllamaAppDiagnostics", TextWrapping = TextWrapping.Wrap, IsTextSelectionEnabled = true };
+    private readonly Expander _diagnosticDetails = new() { Visibility = Visibility.Collapsed };
+    private OllamaWindowsSetup? _setup;
+    private OllamaWindowsReviewedIntent? _intent;
+    private OllamaWindowsDialogResult _result = new(null);
+    private PrimaryAction _primary;
+    private CancellationToken _pageCancellation;
+    private CancellationTokenSource? _request;
+    private CancellationTokenRegistration _pageRegistration;
+    private Task _work = Task.CompletedTask;
+    private Task _show = Task.CompletedTask;
+    private bool _working;
+    private bool _closing;
+    private bool _cancelRequested;
+    private int _version;
+    private int _workVersion;
+
+    public OllamaWindowsSetupDialog()
+    {
+        Title = S("Title");
+        AutomationProperties.SetAutomationId(this, "OllamaWindowsSetupDialog");
+        AutomationProperties.SetAutomationId(_consent, _consent.Name);
+        AutomationProperties.SetName(_consent, S("Consent"));
+        AutomationProperties.SetAutomationId(_status, _status.Name);
+        AutomationProperties.SetLiveSetting(_status, AutomationLiveSetting.Polite);
+        AutomationProperties.SetAutomationId(_diagnostics, _diagnostics.Name);
+        _diagnosticDetails.Header = S("CheckDetails");
+        _diagnosticDetails.Content = _diagnostics;
+        _consent.Content = new TextBlock { Text = S("Consent"), TextWrapping = TextWrapping.Wrap };
+        _consent.Checked += (_, _) => UpdateButtons();
+        _consent.Unchecked += (_, _) => UpdateButtons();
+        var links = new StackPanel { Spacing = 4 };
+        links.Children.Add(new HyperlinkButton
+        {
+            Content = S("License"),
+            NavigateUri = new Uri("https://github.com/ollama/ollama/blob/v0.40.13/LICENSE")
+        });
+        links.Children.Add(new HyperlinkButton
+        {
+            Content = S("SourceInfo"),
+            NavigateUri = new Uri("https://learn.microsoft.com/windows/package-manager/winget/")
+        });
+        var downloadDetails = new StackPanel { Spacing = 8 };
+        downloadDetails.Children.Add(_details);
+        downloadDetails.Children.Add(links);
+        var content = new StackPanel { Spacing = 16, MaxWidth = 520 };
+        content.Children.Add(_message);
+        content.Children.Add(_status);
+        content.Children.Add(_diagnosticDetails);
+        content.Children.Add(_progress);
+        content.Children.Add(_consent);
+        content.Children.Add(new Expander { Header = S("DownloadDetails"), Content = downloadDetails });
+        Content = new ScrollViewer { Content = content, VerticalScrollBarVisibility = ScrollBarVisibility.Auto,
+            HorizontalScrollBarVisibility = ScrollBarVisibility.Disabled, MaxHeight = 460 };
+        PrimaryButtonClick += (_, args) =>
+        {
+            args.Cancel = _primary != PrimaryAction.UseDetected;
+            if (_working || _closing) { args.Cancel = true; return; }
+            if (_primary == PrimaryAction.UseDetected)
+                _result = _result with { ContinueConnection = true, UseDetectedModel = true };
+            else
+                AsyncEventHandlerGuard.Run(() => StartWorkAsync(_primary == PrimaryAction.Run ? RunReviewedAsync : CheckAsync),
+                    onError: ReportFailure);
+        };
+        SecondaryButtonClick += (_, args) =>
+        {
+            if (_working || _closing) { args.Cancel = true; return; }
+            _result = _result with { ContinueConnection = true, UseDetectedModel = false };
+        };
+        Closing += (_, args) =>
+        {
+            if (_working && !_closing)
+            {
+                args.Cancel = true;
+                CancelContinuation();
+            }
+        };
+    }
+
+    public async Task<OllamaWindowsDialogResult> ShowOwnedAsync(XamlRoot root, ElementTheme theme,
+        OllamaWindowsSetup setup, CancellationToken ct)
+    {
+        ct.ThrowIfCancellationRequested();
+        var version = ++_version;
+        _setup = setup;
+        _pageCancellation = ct;
+        _closing = false;
+        _result = new(null);
+        XamlRoot = root;
+        RequestedTheme = theme;
+        _details.Text = SetupLocalization.Format("Onboarding_OllamaApp_DownloadIdentity",
+            OllamaWindowsPackage.Version, OllamaWindowsPackage.Id);
+        _pageRegistration = ct.Register(() => DispatcherQueue.TryEnqueue(() =>
+        {
+            if (version != _version) return;
+            CancelContinuation();
+            if (ct.IsCancellationRequested) Hide();
+        }));
+        _show = ShowNativeAsync();
+        try
+        {
+            await StartWorkAsync(CheckAsync);
+            await _show;
+            await _work;
+            return _result;
+        }
+        finally
+        {
+            _closing = true;
+            if (!_show.IsCompletedSuccessfully) CancelContinuation();
+            try { await _work; }
+            finally
+            {
+                _pageRegistration.Dispose();
+                _request?.Dispose();
+                _request = null;
+            }
+        }
+    }
+
+    private async Task ShowNativeAsync() { await ShowAsync(); }
+
+    private Task StartWorkAsync(Func<CancellationToken, Task> action)
+    {
+        if (_working || _closing) return Task.CompletedTask;
+        _working = true;
+        ++_workVersion;
+        _cancelRequested = false;
+        _request?.Dispose();
+        _request = CancellationTokenSource.CreateLinkedTokenSource(_pageCancellation);
+        _progress.Visibility = Visibility.Visible;
+        UpdateButtons();
+        return _work = WorkCoreAsync(action, _request.Token);
+    }
+
+    private async Task WorkCoreAsync(Func<CancellationToken, Task> action, CancellationToken ct)
+    {
+        try { await action(ct); }
+        catch (OperationCanceledException) when (ct.IsCancellationRequested)
+        {
+            _result = new(new(OllamaWindowsSetupOutcome.CancelledBeforeMutation));
+            ShowResult();
+        }
+        catch (Exception error) { ReportFailure(error); }
+        finally
+        {
+            _working = false;
+            _progress.Visibility = Visibility.Collapsed;
+            UpdateButtons();
+        }
+    }
+
+    private async Task CheckAsync(CancellationToken ct)
+    {
+        _intent = null;
+        _consent.IsChecked = false;
+        _status.Text = S("Checking");
+        _diagnostics.Text = "";
+        _diagnosticDetails.Visibility = Visibility.Collapsed;
+        var snapshot = await _setup!.InspectAsync(ct);
+        ct.ThrowIfCancellationRequested();
+        if (_closing) return;
+        if (snapshot.ExistingGatewayCandidate is { } candidate)
+            _result = new(new(OllamaWindowsSetupOutcome.ReusedExistingService, snapshot.Windows, candidate));
+        else if (snapshot.Windows.ApiReachable)
+            _result = new(new(snapshot.Windows.LocalChatModelCount == 0
+                ? OllamaWindowsSetupOutcome.AppReadyNeedsModel : OllamaWindowsSetupOutcome.GatewayReadinessUnknown,
+                snapshot.Windows));
+        else if (snapshot.Windows.Activity == OllamaWindowsActivity.NotActive &&
+            snapshot.Windows.ApiState == OllamaWindowsApiState.NotListening &&
+            (snapshot.Windows.InstallationState == OllamaWindowsInstallationState.Verified ||
+                snapshot.Windows.InstallationState == OllamaWindowsInstallationState.NoSupportedRegistration &&
+                !snapshot.Windows.HasInstallationConflict))
+        {
+            var action = snapshot.Windows.InstallationState == OllamaWindowsInstallationState.Verified
+                ? OllamaWindowsAction.Open : OllamaWindowsAction.Install;
+            _intent = _setup.Review(snapshot, action);
+            _result = new(null);
+            _primary = PrimaryAction.Run;
+            _message.Text = action == OllamaWindowsAction.Install
+                ? SetupLocalization.Format("Onboarding_OllamaApp_ReviewInstall", OllamaWindowsPackage.Version)
+                : S("ReviewOpen");
+            _status.Text = S("ReviewBeforeAction");
+            return;
+        }
+        else
+            _result = new(new(snapshot.Windows.Activity == OllamaWindowsActivity.Active
+                ? OllamaWindowsSetupOutcome.WaitingForApp : OllamaWindowsSetupOutcome.InspectionRequired,
+                snapshot.Windows));
+        ShowResult();
+    }
+
+    private async Task RunReviewedAsync(CancellationToken ct)
+    {
+        if (_intent is null || _intent.Action == OllamaWindowsAction.Install && _consent.IsChecked != true)
+            throw new InvalidOperationException("Review and confirm the Ollama app download first.");
+        var version = _workVersion;
+        var progress = new Progress<OllamaWindowsSetupStage>(stage =>
+        {
+            if (!_closing && _working && version == _workVersion)
+            {
+                _status.Text = S(_cancelRequested ? "CancelPending" : stage.ToString());
+                UpdateButtons();
+            }
+        });
+        var result = await _setup!.RunAsync(_intent, ct, progress);
+        _intent = null;
+        _result = new(result);
+        if (!_closing) ShowResult();
+    }
+
+    private void ShowResult()
+    {
+        var outcome = _result.Result?.Outcome ?? OllamaWindowsSetupOutcome.InspectionRequired;
+        _primary = outcome == OllamaWindowsSetupOutcome.ReusedExistingService ? PrimaryAction.UseDetected : PrimaryAction.Check;
+        _message.Text = S(outcome == OllamaWindowsSetupOutcome.InspectionRequired &&
+            _result.Result?.Windows?.HasInstallationConflict == true ? "InstallerConflict" : "Outcome_" + outcome);
+        if (_result.Result?.ExistingGatewayCandidate is { } candidate)
+            _message.Text += Environment.NewLine + SetupLocalization.Format("Onboarding_OllamaApp_DetectedModel", candidate.ModelRef);
+        _status.Text = "";
+        _diagnostics.Text = _result.Result?.Diagnostic ?? "";
+        _diagnosticDetails.Visibility = string.IsNullOrWhiteSpace(_diagnostics.Text) ? Visibility.Collapsed : Visibility.Visible;
+        _diagnosticDetails.IsExpanded = _diagnosticDetails.Visibility == Visibility.Visible;
+        _consent.Visibility = Visibility.Collapsed;
+    }
+
+    private void UpdateButtons()
+    {
+        var install = _primary == PrimaryAction.Run && _intent?.Action == OllamaWindowsAction.Install;
+        _consent.Visibility = install ? Visibility.Visible : Visibility.Collapsed;
+        _consent.IsEnabled = !_working;
+        PrimaryButtonText = S(_primary switch
+        {
+            PrimaryAction.UseDetected => "UseDetected",
+            PrimaryAction.Run => install ? "Install" : "Open",
+            _ => "CheckAgain"
+        });
+        IsPrimaryButtonEnabled = !_working && !_closing && (!install || _consent.IsChecked == true);
+        SecondaryButtonText = S("ConnectionSetup");
+        IsSecondaryButtonEnabled = !_working && !_closing;
+        CloseButtonText = S(_working
+            ? _cancelRequested ? "CancelPendingButton" : _setup?.MutationInFlight == true ? "CancelFurther" : "Cancel"
+            : "Close");
+    }
+
+    private void CancelContinuation()
+    {
+        _cancelRequested = true;
+        try { _request?.Cancel(); }
+        catch (AggregateException error) { Trace.TraceWarning("Ollama cancellation callback failed ({0}).", error.GetType().Name); }
+        _status.Text = S("CancelPending");
+        UpdateButtons();
+    }
+
+    private void ReportFailure(Exception error)
+    {
+        Trace.TraceWarning("Ollama setup dialog failed ({0}).", error.GetType().Name);
+        _intent = null;
+        _result = new(new(OllamaWindowsSetupOutcome.Failed, Failure: SetupLogger.Sanitize(error.Message)));
+        if (!_closing) ShowResult();
+    }
+
+    public async Task CloseOwnedAsync()
+    {
+        _closing = true;
+        CancelContinuation();
+        try { Hide(); }
+        finally
+        {
+            try { await _work; }
+            finally { await _show; }
+        }
+    }
+
+    private static string S(string key) => SetupLocalization.GetString("Onboarding_OllamaApp_" + key);
+}
