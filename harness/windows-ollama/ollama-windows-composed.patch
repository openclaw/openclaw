+using System.ComponentModel;
+using System.Diagnostics;
+using System.Net.Sockets;
+using System.Runtime.InteropServices;
+using System.Runtime.Versioning;
+using System.Security.Cryptography;
+using System.Text.Json;
+using Microsoft.Win32;
+using OpenClaw.Connection;
+using OpenClaw.Shared.Inference;
+
+namespace OpenClaw.SetupEngine;
+
+/// <summary>Reviewed catalog bytes, not a mutable URL or executable supplied by a provider response.</summary>
+internal static class OllamaWindowsPackage
+{
+    public const string Id = "Ollama.Ollama";
+    public const string Version = "0.40.13";
+    public const string ProductCode = "{44E83376-CE68-45EB-8FC1-393500EB558C}_is1";
+    // microsoft/winget-pkgs fcb37e5558b7629d808ecc6210488848328afcb3,
+    // manifests/o/Ollama/Ollama/0.40.13/Ollama.Ollama.installer.yaml (x64 and ARM64).
+    public const string Sha256 = "9e3c76e54e7184c68e88a2378b909bf59bbe454f83c076cb4f4a717e946ae719";
+    public const string SourceArgument = "https://cdn.winget.microsoft.com/cache";
+    public const string SourceIdentifier = "Microsoft.Winget.Source_8wekyb3d8bbwe";
+    public static readonly TimeSpan AcquisitionTimeout = TimeSpan.FromMinutes(30);
+}
+
+internal sealed class OllamaWindowsInstaller(string directory, FileStream file) : IAsyncDisposable
+{
+    public string Directory { get; } = directory;
+    public FileStream File { get; } = file;
+
+    public async ValueTask DisposeAsync()
+    {
+        await File.DisposeAsync();
+        DeleteScratch(Directory);
+    }
+
+    internal static void DeleteScratch(string directory)
+    {
+        try
+        {
+            OllamaWindowsAppHost.RejectReparseAncestors(directory);
+            foreach (var entry in System.IO.Directory.EnumerateFileSystemEntries(directory))
+                if ((System.IO.File.GetAttributes(entry) & (FileAttributes.Directory | FileAttributes.ReparsePoint)) != 0)
+                    throw new IOException("Installer scratch contains an unexpected entry; it was preserved.");
+            System.IO.Directory.Delete(directory, recursive: true);
+        }
+        catch (Exception error)
+        {
+            Trace.TraceWarning("Ollama installer scratch was preserved ({0}).", error.GetType().Name);
+        }
+    }
+}
+
+/// <summary>Current-user Windows registration and app acquisition; never owns the external app's lifetime.</summary>
+internal sealed class OllamaWindowsAppHost(ICommandRunner commands, string localDataDirectory) : IOllamaWindowsAppHost
+{
+    private const string UninstallRoot = @"Software\Microsoft\Windows\CurrentVersion\Uninstall\";
+    private string WinGetPath => Path.Combine(
+        Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),
+        "Microsoft", "WindowsApps", "winget.exe");
+
+    public async Task<OllamaWindowsObservation> ObserveAsync(CancellationToken ct)
+    {
+        if (!OperatingSystem.IsWindows())
+            throw new PlatformNotSupportedException("Ollama desktop installation requires Windows.");
+        var windows = await Task.Run(InspectWindows, ct);
+        ct.ThrowIfCancellationRequested();
+        using var backend = new OllamaInferenceBackend();
+        try
+        {
+            var models = await backend.ListModelsAsync(ct);
+            return windows with { ApiState = OllamaWindowsApiState.Reachable, LocalChatModelCount = models.Count };
+        }
+        catch (OllamaInferenceException error)
+        {
+            // Only the typed socket refusal establishes no listener at this probe.
+            // Authentication, invalid responses and timeouts must not become absence.
+            return windows with
+            {
+                ApiState = IsConnectionRefused(error) ? OllamaWindowsApiState.NotListening : OllamaWindowsApiState.Unknown,
+                Failure = windows.Failure ?? SetupLogger.Sanitize(error.Message)
+            };
+        }
+    }
+
+    [SupportedOSPlatform("windows")]
+    private static OllamaWindowsObservation InspectWindows()
+    {
+        try
+        {
+            var activity = InspectActivity();
+            var installationConflict = InspectInstallationConflict();
+            var registrations = new List<OllamaWindowsInstallation>();
+            foreach (var hive in new[] { RegistryHive.CurrentUser, RegistryHive.LocalMachine })
+            foreach (var view in new[] { RegistryView.Registry64, RegistryView.Registry32 })
+            {
+                using var root = RegistryKey.OpenBaseKey(hive, view);
+                using var key = root.OpenSubKey(UninstallRoot + OllamaWindowsPackage.ProductCode);
+                if (key is null) continue;
+                if (key.GetValue("InstallLocation") is not string location || string.IsNullOrWhiteSpace(location))
+                    throw new InvalidDataException("Ollama registration has no installation location.");
+                var directory = Path.TrimEndingDirectorySeparator(Path.GetFullPath(location));
+                var installed = new OllamaWindowsInstallation(directory, key.GetValue("DisplayVersion") as string ?? "");
+                using var app = OpenTrustedOllamaFile(installed.AppPath);
+                using var cli = OpenTrustedOllamaFile(installed.CliPath);
+                registrations.Add(installed);
+            }
+            var matches = registrations.DistinctBy(value => value.Directory, StringComparer.OrdinalIgnoreCase).ToArray();
+            if (matches.Length > 1)
+                throw new InvalidDataException("Multiple Ollama installation locations need review.");
+            if (matches.Length == 1)
+                return new(OllamaWindowsInstallationState.Verified, activity, matches[0],
+                    OllamaWindowsApiState.Unknown, 0, HasInstallationConflict: installationConflict);
+
+            var defaultApp = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),
+                "Programs", "Ollama", "ollama app.exe");
+            if (!DefinitelyAbsent(defaultApp))
+                throw new InvalidDataException("An unregistered Ollama app needs inspection before installation.");
+            foreach (var directory in (Environment.GetEnvironmentVariable("PATH") ?? "").Split(Path.PathSeparator))
+            {
+                if (!string.IsNullOrWhiteSpace(directory) && !DefinitelyAbsent(Path.Combine(directory.Trim('"'), "ollama.exe")))
+                    throw new InvalidDataException("An existing Ollama CLI needs inspection before desktop installation.");
+            }
+            return new(OllamaWindowsInstallationState.NoSupportedRegistration, activity, null,
+                OllamaWindowsApiState.Unknown, 0, HasInstallationConflict: installationConflict);
+        }
+        catch (Exception error)
+        {
+            return new(OllamaWindowsInstallationState.Unknown, OllamaWindowsActivity.Unknown, null,
+                OllamaWindowsApiState.Unknown, 0, SetupLogger.Sanitize(error.Message));
+        }
+    }
+
+    private static OllamaWindowsActivity InspectActivity()
+    {
+        var unknown = false;
+        var active = false;
+        foreach (var name in new[] { "ollama", "ollama app", "OllamaSetup" })
+        foreach (var process in Process.GetProcessesByName(name))
+        using (process)
+        {
+            try
+            {
+                var image = process.MainModule?.FileName;
+                if (image is null) { unknown = true; continue; }
+                using var file = OpenTrustedOllamaFile(image);
+                active = true;
+            }
+            catch (InvalidOperationException) { /* A process that exited during enumeration is not active. */ }
+            catch (ArgumentException) { }
+            catch (Win32Exception) { unknown = true; }
+            catch (IOException) { unknown = true; }
+            catch (UnauthorizedAccessException) { unknown = true; }
+        }
+        return active ? OllamaWindowsActivity.Active : unknown ? OllamaWindowsActivity.Unknown : OllamaWindowsActivity.NotActive;
+    }
+
+    private static bool InspectInstallationConflict()
+    {
+        // The qualified Inno installer unconditionally taskkills llama-server.exe,
+        // including unrelated runtimes. Presence alone blocks installation: never
+        // require a foreign process to carry the Ollama signer or expose its path.
+        var processes = Process.GetProcessesByName("llama-server");
+        try { return processes.Length != 0; }
+        finally { foreach (var process in processes) process.Dispose(); }
+    }
+
+    public async Task<OllamaWindowsInstaller> AcquireAsync(CancellationToken ct, Action beforeDownload)
+    {
+        if (!OperatingSystem.IsWindows()) throw new PlatformNotSupportedException();
+        var architecture = RuntimeInformation.OSArchitecture switch
+        {
+            Architecture.X64 => "x64",
+            Architecture.Arm64 => "arm64",
+            _ => throw new PlatformNotSupportedException("The reviewed Ollama installer supports x64 and ARM64 Windows.")
+        };
+        ct.ThrowIfCancellationRequested();
+        var source = await commands.RunAsync(WinGetPath, ["source", "export", "winget"],
+            TimeSpan.FromSeconds(30), ct: ct);
+        if (source.TimedOut || source.ExitCode != 0)
+            throw new IOException("WinGet could not read its source. Update App Installer, then recheck Ollama setup.");
+        using (var json = JsonDocument.Parse(source.Stdout))
+        {
+            var value = json.RootElement;
+            if (value.GetProperty("Name").GetString() != "winget" ||
+                value.GetProperty("Arg").GetString() != OllamaWindowsPackage.SourceArgument ||
+                value.GetProperty("Type").GetString() != "Microsoft.PreIndexed.Package" ||
+                value.GetProperty("Identifier").GetString() != OllamaWindowsPackage.SourceIdentifier)
+                throw new InvalidDataException("The configured WinGet source is not the reviewed Microsoft catalog. No source settings were changed.");
+        }
+        ct.ThrowIfCancellationRequested();
+        beforeDownload();
+        var directory = Path.Combine(Path.GetFullPath(localDataDirectory), "OllamaSetup", Guid.NewGuid().ToString("N"));
+        RejectReparseAncestors(directory);
+        Directory.CreateDirectory(directory);
+        try
+        {
+            var result = await commands.RunAsync(WinGetPath,
+                ["download", "--id", OllamaWindowsPackage.Id, "--exact", "--source", "winget",
+                    "--version", OllamaWindowsPackage.Version, "--architecture", architecture,
+                    "--installer-type", "inno", "--download-directory", directory, "--skip-dependencies",
+                    "--accept-package-agreements", "--accept-source-agreements", "--disable-interactivity"],
+                OllamaWindowsPackage.AcquisitionTimeout, ct: ct);
+            ct.ThrowIfCancellationRequested();
+            if (result.TimedOut || result.ExitCode != 0)
+                throw new IOException("WinGet could not download the reviewed Ollama installer. Recheck App Installer and catalog access before retrying.");
+            RejectReparseAncestors(directory);
+            var files = Directory.GetFiles(directory, "*.exe", SearchOption.TopDirectoryOnly);
+            if (files.Length != 1)
+                throw new InvalidDataException("WinGet returned an unexpected installer set.");
+            var file = new FileStream(files[0], FileMode.Open, FileAccess.Read, FileShare.Read);
+            try
+            {
+                await VerifyInstallerAsync(file, ct);
+                return new(directory, file);
+            }
+            catch { await file.DisposeAsync(); throw; }
+        }
+        catch
+        {
+            // Failed acquisition is not installation. Preserve unexpected/reparse scratch rather than following it.
+            OllamaWindowsInstaller.DeleteScratch(directory);
+            throw;
+        }
+    }
+
+    public async Task<CommandResult> InstallAsync(OllamaWindowsInstaller installer, CancellationToken admissionCancellation, Action beforeAdmission)
+    {
+        await VerifyInstallerAsync(installer.File, admissionCancellation);
+        var current = await ObserveAsync(admissionCancellation);
+        if (current.ApiState != OllamaWindowsApiState.NotListening ||
+            current.Activity != OllamaWindowsActivity.NotActive ||
+            current.InstallationState != OllamaWindowsInstallationState.NoSupportedRegistration ||
+            current.HasInstallationConflict)
+            throw new InvalidOperationException("Ollama appeared or its inspection changed before installation. Recheck the existing service.");
+        // Recheck the destructive upstream installer conflict at the last practical
+        // admission boundary, independently of any Ollama registration or signer.
+        if (await Task.Run(InspectInstallationConflict, admissionCancellation))
+            throw new InvalidOperationException("An existing llama-server.exe process must be stopped by its owner before Ollama installation.");
+        beforeAdmission();
+        admissionCancellation.ThrowIfCancellationRequested();
+        return await commands.RunAdmittedInstallerAsync(installer.File.Name,
+            ["/VERYSILENT", "/NORESTART", "/SUPPRESSMSGBOXES"], admissionCancellation);
+    }
+
+    public async Task OpenAsync(OllamaWindowsInstallation installation, CancellationToken ct, Action beforeOpen)
+    {
+        if (!OperatingSystem.IsWindows()) throw new PlatformNotSupportedException();
+        using var app = await Task.Run(() => OpenTrustedOllamaFile(installation.AppPath), ct);
+        if (await Task.Run(InspectActivity, ct) != OllamaWindowsActivity.NotActive)
+            throw new InvalidOperationException("An Ollama process is already present. Recheck it before opening the app.");
+        beforeOpen();
+        ct.ThrowIfCancellationRequested();
+        using var process = Process.Start(new ProcessStartInfo(installation.AppPath)
+        {
+            UseShellExecute = true,
+            WorkingDirectory = installation.Directory
+        }) ?? throw new IOException("Windows could not open the verified Ollama application.");
+        // Dispose only our handle. The external app is not a child-process lease or a rollback target.
+    }
+
+    private static async Task VerifyInstallerAsync(FileStream file, CancellationToken ct)
+    {
+        RejectReparseAncestors(file.Name);
+        file.Position = 0;
+        var hash = await SHA256.HashDataAsync(file, ct).ConfigureAwait(false);
+        if (!CryptographicOperations.FixedTimeEquals(hash, Convert.FromHexString(OllamaWindowsPackage.Sha256)))
+            throw new InvalidDataException("The Ollama installer does not match the reviewed catalog hash.");
+        file.Position = 0;
+        var signature = await Task.Run(() => WindowsAuthenticodeVerifier.VerifyOllamaSignedFile(file), ct).ConfigureAwait(false);
+        if (!signature.IsTrusted) throw new InvalidDataException(signature.Detail);
+    }
+
+    private static FileStream OpenTrustedOllamaFile(string path)
+    {
+        RejectReparseAncestors(path);
+        var file = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.Read);
+        try
+        {
+            var signature = WindowsAuthenticodeVerifier.VerifyOllamaSignedFile(file);
+            if (!signature.IsTrusted) throw new InvalidDataException(signature.Detail);
+            return file;
+        }
+        catch { file.Dispose(); throw; }
+    }
+
+    internal static void RejectReparseAncestors(string path)
+    {
+        for (string? current = Path.GetFullPath(path); current is not null; current = Path.GetDirectoryName(current))
+        {
+            try
+            {
+                if ((File.GetAttributes(current) & FileAttributes.ReparsePoint) != 0)
+                    throw new IOException("An Ollama installation or acquisition path contains a reparse point.");
+            }
+            catch (FileNotFoundException) { }
+            catch (DirectoryNotFoundException) { }
+        }
+    }
+
+    private static bool DefinitelyAbsent(string path)
+    {
+        try { _ = File.GetAttributes(path); return false; }
+        catch (FileNotFoundException) { return true; }
+        catch (DirectoryNotFoundException) { return true; }
+    }
+
+    private static bool IsConnectionRefused(Exception error)
+    {
+        for (Exception? current = error; current is not null; current = current.InnerException)
+            if (current is SocketException { SocketErrorCode: SocketError.ConnectionRefused }) return true;
+        return false;
+    }
+}
diff --git a/src/OpenClaw.SetupEngine/OllamaWindowsSetup.cs b/src/OpenClaw.SetupEngine/OllamaWindowsSetup.cs
new file mode 100644
index 00000000..e6db7baa
--- /dev/null
+++ b/src/OpenClaw.SetupEngine/OllamaWindowsSetup.cs
@@ -0,0 +1,264 @@
+namespace OpenClaw.SetupEngine;
+
+internal enum OllamaWindowsInstallationState { Unknown, NoSupportedRegistration, Verified }
+internal enum OllamaWindowsActivity { Unknown, Active, NotActive }
+internal enum OllamaWindowsApiState { Unknown, NotListening, Reachable }
+internal enum OllamaWindowsAction { Install, Open }
+internal enum OllamaWindowsSetupStage { Checking, Downloading, Installing, Opening, RecheckingGateway }
+internal enum OllamaWindowsSetupOutcome
+{
+    ReusedExistingService, AppReadyNeedsModel, GatewayReadinessUnknown,
+    WaitingForApp, InspectionRequired, CancelledBeforeMutation, CancelledInstallationPresent,
+    InstallationOutcomeUnknown, Failed
+}
+
+internal sealed record OllamaWindowsInstallation(string Directory, string Version)
+{
+    public string AppPath => Path.Combine(Directory, "ollama app.exe");
+    public string CliPath => Path.Combine(Directory, "ollama.exe");
+}
+
+internal sealed record OllamaWindowsObservation(
+    OllamaWindowsInstallationState InstallationState, OllamaWindowsActivity Activity,
+    OllamaWindowsInstallation? Installation, OllamaWindowsApiState ApiState, int LocalChatModelCount,
+    string? Failure = null, bool HasInstallationConflict = false)
+{
+    public bool ApiReachable => ApiState == OllamaWindowsApiState.Reachable;
+}
+
+internal sealed record OllamaWindowsSetupSnapshot(
+    GatewayAiSetupRoute Route, long ConnectionGeneration, OllamaWindowsObservation Windows,
+    GatewayAiSetupCandidate? ExistingGatewayCandidate);
+
+internal sealed record OllamaWindowsSetupResult(
+    OllamaWindowsSetupOutcome Outcome, OllamaWindowsObservation? Windows = null,
+    GatewayAiSetupCandidate? ExistingGatewayCandidate = null, int? InstallerExitCode = null, string? Failure = null)
+{
+    public string? Diagnostic
+    {
+        get
+        {
+            var detail = string.IsNullOrWhiteSpace(Failure) ? Windows?.Failure : Failure;
+            if (string.IsNullOrWhiteSpace(detail) && Outcome == OllamaWindowsSetupOutcome.InspectionRequired &&
+                Windows?.HasInstallationConflict == true)
+                detail = "The Ollama installer may terminate an existing llama-server.exe process. Stop that runtime through its current owner before installing Ollama.";
+            if (string.IsNullOrWhiteSpace(detail)) return null;
+            var sanitized = SetupLogger.Sanitize(detail);
+            return sanitized[..Math.Min(sanitized.Length, 2048)];
+        }
+    }
+}
+
+/// <summary>Single-use app consent; model downloads and provider configuration are excluded.</summary>
+internal sealed class OllamaWindowsReviewedIntent(
+    OllamaWindowsSetupSnapshot reviewed, OllamaWindowsAction action)
+{
+    private int _consumed;
+    public OllamaWindowsSetupSnapshot Reviewed { get; } = reviewed;
+    public OllamaWindowsAction Action { get; } = action;
+    public bool IsConsumed => Volatile.Read(ref _consumed) != 0;
+    public void Consume()
+    {
+        if (Interlocked.Exchange(ref _consumed, 1) != 0)
+            throw new InvalidOperationException("Review Ollama again before repeating this action.");
+    }
+}
+
+/// <summary>Windows facts and side effects only. Gateway discovery stays with GatewayAiSetupClient.</summary>
+internal interface IOllamaWindowsAppHost
+{
+    Task<OllamaWindowsObservation> ObserveAsync(CancellationToken ct);
+    Task<OllamaWindowsInstaller> AcquireAsync(CancellationToken ct, Action beforeDownload);
+    Task<CommandResult> InstallAsync(OllamaWindowsInstaller installer, CancellationToken admissionCancellation, Action beforeAdmission);
+    Task OpenAsync(OllamaWindowsInstallation installation, CancellationToken ct, Action beforeOpen);
+}
+
+/// <summary>
+/// One setup-window operation. Its task is the existing page drain's mutation lease;
+/// cancellation withdraws continuation, never ownership of an admitted installer.
+/// </summary>
+internal sealed class OllamaWindowsSetup(
+    IOllamaWindowsAppHost host, GatewayAiSetupClient gateway, SetupAccessDraft draft)
+{
+    private Task<OllamaWindowsSetupResult>? _operation;
+    public bool MutationInFlight { get; private set; }
+
+    public async Task<OllamaWindowsSetupSnapshot> InspectAsync(CancellationToken ct)
+    {
+        RequireCurrentRoute();
+        var detection = await gateway.DetectAsync(ct);
+        var existing = detection?.Candidates.FirstOrDefault(candidate => candidate.ModelTarget is null &&
+            candidate.ModelRef.StartsWith("ollama/", StringComparison.Ordinal));
+        var windows = existing is not null
+            ? new OllamaWindowsObservation(OllamaWindowsInstallationState.Unknown, OllamaWindowsActivity.Unknown,
+                null, OllamaWindowsApiState.Unknown, 0)
+            : await host.ObserveAsync(ct);
+        RequireCurrentRoute();
+        if (!gateway.HasCurrentDiscovery)
+            throw new InvalidOperationException("Refresh the selected Gateway before setting up Ollama.");
+        return new(gateway.Route, gateway.ConnectionGeneration, windows, existing);
+    }
+
+    public OllamaWindowsReviewedIntent Review(OllamaWindowsSetupSnapshot snapshot, OllamaWindowsAction action)
+    {
+        RequireSnapshot(snapshot);
+        if (string.IsNullOrWhiteSpace(snapshot.Route.EndpointBinding))
+            throw new InvalidOperationException("Verify the selected Gateway endpoint before reviewing an Ollama app action.");
+        if (snapshot.ExistingGatewayCandidate is not null || snapshot.Windows.ApiReachable ||
+            snapshot.Windows.Activity != OllamaWindowsActivity.NotActive ||
+            snapshot.Windows.ApiState == OllamaWindowsApiState.Unknown ||
+            (action == OllamaWindowsAction.Install
+                ? snapshot.Windows.InstallationState != OllamaWindowsInstallationState.NoSupportedRegistration ||
+                    snapshot.Windows.HasInstallationConflict
+                : snapshot.Windows.InstallationState != OllamaWindowsInstallationState.Verified ||
+                    snapshot.Windows.Installation is null))
+            throw new InvalidOperationException("Recheck the existing Ollama service before choosing an installation action.");
+        return draft.ReviewOllama(snapshot, action);
+    }
+
+    public Task<OllamaWindowsSetupResult> RunAsync(OllamaWindowsReviewedIntent intent,
+        CancellationToken ct, IProgress<OllamaWindowsSetupStage>? progress = null)
+    {
+        if (_operation is { IsCompleted: false })
+            throw new InvalidOperationException("The previous Ollama action is still settling.");
+        if (!ReferenceEquals(draft.OllamaIntent, intent))
+            throw new InvalidOperationException("The reviewed Ollama action changed.");
+        ct.ThrowIfCancellationRequested();
+        RequireIntent(intent);
+        intent.Consume();
+        return _operation = RunCoreAsync(intent, ct, progress);
+    }
+
+    private async Task<OllamaWindowsSetupResult> RunCoreAsync(OllamaWindowsReviewedIntent intent,
+        CancellationToken ct, IProgress<OllamaWindowsSetupStage>? progress)
+    {
+        var admitted = false;
+        int? installerExit = null;
+        try
+        {
+            progress?.Report(OllamaWindowsSetupStage.Checking);
+            var current = await InspectAsync(ct);
+            RequireIntent(intent);
+            if (Reuse(current) is { } reuse)
+                return reuse;
+            if (current.Windows.Activity != OllamaWindowsActivity.NotActive ||
+                current.Windows.ApiState == OllamaWindowsApiState.Unknown)
+                return new(OllamaWindowsSetupOutcome.InspectionRequired, current.Windows);
+            if (intent.Action == OllamaWindowsAction.Install)
+            {
+                if (current.Windows.InstallationState != OllamaWindowsInstallationState.NoSupportedRegistration ||
+                    current.Windows.HasInstallationConflict)
+                    return new(OllamaWindowsSetupOutcome.InspectionRequired, current.Windows);
+                progress?.Report(OllamaWindowsSetupStage.Downloading);
+                await using var installer = await host.AcquireAsync(ct, () => RequireIntent(intent));
+                // Downloading can take minutes. Never install over an app/service that appeared meanwhile.
+                current = await InspectAsync(ct);
+                RequireIntent(intent);
+                if (Reuse(current) is { } lateReuse)
+                    return lateReuse;
+                if (current.Windows.Activity != OllamaWindowsActivity.NotActive ||
+                    current.Windows.ApiState == OllamaWindowsApiState.Unknown ||
+                    current.Windows.HasInstallationConflict ||
+                    current.Windows.InstallationState != OllamaWindowsInstallationState.NoSupportedRegistration)
+                    return new(OllamaWindowsSetupOutcome.InspectionRequired, current.Windows);
+                ct.ThrowIfCancellationRequested();
+                progress?.Report(OllamaWindowsSetupStage.Installing);
+                MutationInFlight = true;
+                var installed = await host.InstallAsync(installer, ct, () =>
+                {
+                    RequireIntent(intent);
+                    ct.ThrowIfCancellationRequested();
+                    admitted = true;
+                });
+                installerExit = installed.ExitCode;
+                // Cancellation after admission is not proof that Windows stopped deployment.
+                var observed = await host.ObserveAsync(CancellationToken.None);
+                if (ct.IsCancellationRequested)
+                    return Cancelled(observed, installerExit);
+                if (installed.TimedOut || installed.ExitCode != 0 ||
+                    observed.InstallationState != OllamaWindowsInstallationState.Verified)
+                    return new(OllamaWindowsSetupOutcome.InstallationOutcomeUnknown, observed,
+                        InstallerExitCode: installerExit);
+                // The installer starts its desktop app. Do not launch a second instance here.
+                current = current with { Windows = observed };
+            }
+            else
+            {
+                if (current.Windows.InstallationState != OllamaWindowsInstallationState.Verified ||
+                    current.Windows.Installation is not { } installation ||
+                    installation != intent.Reviewed.Windows.Installation)
+                    return new(OllamaWindowsSetupOutcome.InspectionRequired, current.Windows);
+                RequireIntent(intent);
+                ct.ThrowIfCancellationRequested();
+                progress?.Report(OllamaWindowsSetupStage.Opening);
+                MutationInFlight = true;
+                await host.OpenAsync(installation, ct, () =>
+                {
+                    RequireIntent(intent);
+                    ct.ThrowIfCancellationRequested();
+                    admitted = true;
+                });
+            }
+            if (ct.IsCancellationRequested)
+                return Cancelled(await host.ObserveAsync(CancellationToken.None), installerExit);
+            progress?.Report(OllamaWindowsSetupStage.RecheckingGateway);
+            var rechecked = await InspectAsync(ct);
+            return Reuse(rechecked) ?? new(OllamaWindowsSetupOutcome.WaitingForApp, rechecked.Windows,
+                InstallerExitCode: installerExit);
+        }
+        catch (OperationCanceledException) when (ct.IsCancellationRequested)
+        {
+            if (!admitted)
+                return new(OllamaWindowsSetupOutcome.CancelledBeforeMutation);
+            try { return Cancelled(await host.ObserveAsync(CancellationToken.None), installerExit); }
+            catch { return new(OllamaWindowsSetupOutcome.InstallationOutcomeUnknown, InstallerExitCode: installerExit); }
+        }
+        catch (Exception error)
+        {
+            return new(admitted ? OllamaWindowsSetupOutcome.InstallationOutcomeUnknown : OllamaWindowsSetupOutcome.Failed,
+                InstallerExitCode: installerExit, Failure: SetupLogger.Sanitize(error.Message));
+        }
+        finally { MutationInFlight = false; }
+    }
+
+    private static OllamaWindowsSetupResult Cancelled(OllamaWindowsObservation observed, int? exitCode) =>
+        new(observed.InstallationState == OllamaWindowsInstallationState.Verified
+                ? OllamaWindowsSetupOutcome.CancelledInstallationPresent
+                : OllamaWindowsSetupOutcome.InstallationOutcomeUnknown,
+            observed, InstallerExitCode: exitCode);
+
+    private static OllamaWindowsSetupResult? Reuse(OllamaWindowsSetupSnapshot snapshot)
+    {
+        if (snapshot.ExistingGatewayCandidate is { } candidate)
+            return new(OllamaWindowsSetupOutcome.ReusedExistingService, snapshot.Windows, candidate);
+        if (snapshot.Windows.ApiReachable)
+            return new(snapshot.Windows.LocalChatModelCount == 0
+                    ? OllamaWindowsSetupOutcome.AppReadyNeedsModel
+                    : OllamaWindowsSetupOutcome.GatewayReadinessUnknown,
+                snapshot.Windows);
+        return null;
+    }
+
+    private void RequireIntent(OllamaWindowsReviewedIntent intent)
+    {
+        if (!ReferenceEquals(draft.OllamaIntent, intent))
+            throw new InvalidOperationException("The reviewed Ollama action changed.");
+        RequireSnapshot(intent.Reviewed);
+    }
+
+    private void RequireCurrentRoute() => gateway.EnsureLocalAiCanStart(gateway.Route.GatewayId);
+
+    private void RequireSnapshot(OllamaWindowsSetupSnapshot snapshot)
+    {
+        RequireCurrentRoute();
+        if (gateway.Route != snapshot.Route || gateway.ConnectionGeneration != snapshot.ConnectionGeneration ||
+            !gateway.HasCurrentDiscovery)
+            throw new InvalidOperationException("The reviewed Gateway connection changed. Recheck Ollama first.");
+    }
+
+    public async Task DrainAsync()
+    {
+        if (_operation is { } operation)
+            await operation;
+    }
+}
