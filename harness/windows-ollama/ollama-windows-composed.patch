+    private sealed class Host : IOllamaWindowsAppHost, IDisposable
+    {
+        private readonly TempDirectory _temp = new();
+        public OllamaWindowsObservation Current { get; set; } = Missing;
+        public OllamaWindowsObservation? AfterInstall { get; init; }
+        public OllamaWindowsObservation? AfterOpen { get; init; }
+        public Action? DuringAcquire { get; set; }
+        public Task<CommandResult>? PendingInstall { get; set; }
+        public TaskCompletionSource InstallStarted { get; } = new(TaskCreationOptions.RunContinuationsAsynchronously);
+        public int InstallExitCode { get; init; }
+        public Exception? InstallAdmissionFailure { get; init; }
+        public int Observations { get; private set; }
+        public int Acquisitions { get; private set; }
+        public int Installations { get; private set; }
+        public int Opens { get; private set; }
+        public Task<OllamaWindowsObservation> ObserveAsync(CancellationToken ct)
+        {
+            ct.ThrowIfCancellationRequested();
+            Observations++;
+            return Task.FromResult(Current);
+        }
+        public Task<OllamaWindowsInstaller> AcquireAsync(CancellationToken ct, Action beforeDownload)
+        {
+            ct.ThrowIfCancellationRequested();
+            beforeDownload();
+            Acquisitions++;
+            var directory = _temp.Combine(Guid.NewGuid().ToString("N"));
+            Directory.CreateDirectory(directory);
+            var path = Path.Combine(directory, "synthetic-installer.bin");
+            File.WriteAllText(path, "Synthetic bytes. Never executed.");
+            DuringAcquire?.Invoke();
+            return Task.FromResult(new OllamaWindowsInstaller(directory,
+                new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.Read)));
+        }
+        public Task<CommandResult> InstallAsync(OllamaWindowsInstaller installer,
+            CancellationToken admissionCancellation, Action beforeAdmission)
+        {
+            admissionCancellation.ThrowIfCancellationRequested();
+            if (InstallAdmissionFailure is { } failure) throw failure;
+            beforeAdmission();
+            Installations++;
+            InstallStarted.TrySetResult();
+            if (AfterInstall is { } after) Current = after;
+            return PendingInstall ?? Task.FromResult(new CommandResult(InstallExitCode, "", "", TimeSpan.Zero, false));
+        }
+        public Task OpenAsync(OllamaWindowsInstallation installation, CancellationToken ct, Action beforeOpen)
+        {
+            ct.ThrowIfCancellationRequested();
+            beforeOpen();
+            Opens++;
+            if (AfterOpen is { } after) Current = after;
+            return Task.CompletedTask;
+        }
+        public void Dispose() => _temp.Dispose();
+    }
