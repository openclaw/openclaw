+internal static class ProviderArtworkPrivatePresentation
+{
+    internal const string JobVariable = "OPENCLAW_PROVIDER_ARTWORK_PRIVATE_CAPTURE_JOB";
+    internal const string JobValue = "private-mounted-v1";
