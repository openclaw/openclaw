diff --git a/lib/cleanup.js b/lib/cleanup.js
new file mode 100644
index 0000000000000000000000000000000000000000..192fcb5192a269839d4ce7bebec97660066cd274
--- /dev/null
+++ b/lib/cleanup.js
@@ -0,0 +1,125 @@
+'use strict';
+
+const handlerMarker = Symbol.for('proper-lockfile.exit-handler');
+const signalExitEmitter = Symbol.for('signal-exit emitter');
+const signals = ['SIGABRT', 'SIGALRM', 'SIGHUP', 'SIGINT', 'SIGTERM'];
+
+// Match signal-exit's supported fatal signals without loading its process wrappers.
+if (process.platform !== 'win32') {
+    signals.push('SIGVTALRM', 'SIGXCPU', 'SIGXFSZ', 'SIGUSR2', 'SIGTRAP', 'SIGSYS', 'SIGQUIT', 'SIGIOT');
+}
+if (process.platform === 'linux') {
+    signals.push('SIGIO', 'SIGPOLL', 'SIGPWR', 'SIGSTKFLT', 'SIGUNUSED');
+}
+
+module.exports = function createCleanup(locks) {
+    let installed = false;
+    const handlers = new Map();
+    const deferredSignals = new Set();
+
+    function releaseLocks() {
+        for (const file in locks) {
+            const lock = locks[file];
+
+            try { lock.options.fs.rmdirSync(lock.lockfilePath); } catch (e) { /* Best effort during exit. */ }
+        }
+    }
+
+    function removeListeners() {
+        if (!installed) {
+            return;
+        }
+
+        installed = false;
+        deferredSignals.clear();
+        process.removeListener('removeListener', restoreSignal);
+        process.removeListener('exit', onExit);
+        for (const [signal, handler] of handlers) {
+            process.removeListener(signal, handler);
+        }
+        handlers.clear();
+    }
+
+    function onExit() {
+        releaseLocks();
+        removeListeners();
+    }
+
+    function restoreSignal(signal) {
+        if (!deferredSignals.has(signal) ||
+            process.listeners(signal).some((listener) => !listener[handlerMarker])) {
+            return;
+        }
+
+        deferredSignals.delete(signal);
+        process.prependListener(signal, handlers.get(signal));
+        if (deferredSignals.size === 0) {
+            process.removeListener('removeListener', restoreSignal);
+        }
+    }
+
+    function install() {
+        if (installed) {
+            return;
+        }
+
+        installed = true;
+        process.once('exit', onExit);
+
+        for (const signal of signals) {
+            const handler = () => {
+                const listeners = process.listeners(signal);
+                const lockHandlers = listeners.filter((listener) => listener[handlerMarker]).length;
+                // signal-exit v4 uses these same counts to coexist with v3.
+                // They describe passive observers, not application signal handlers.
+                const passiveHandlers = lockHandlers +
+                    (process.__signal_exit_emitter__?.count || 0) +
+                    (globalThis[signalExitEmitter]?.count || 0);
+
+                if (listeners.length !== passiveHandlers) {
+                    return;
+                }
+
+                if (passiveHandlers > lockHandlers) {
+                    // Let signal-exit decide whether to terminate: v4 may veto exit.
+                    // Its unload removes the signal listener before invoking callbacks.
+                    // Reattach after that removal, so only a re-raised signal releases locks.
+                    if (deferredSignals.size === 0) {
+                        process.on('removeListener', restoreSignal);
+                    }
+                    deferredSignals.add(signal);
+                    process.removeListener(signal, handler);
+
+                    return;
+                }
+
+                releaseLocks();
+                removeListeners();
+
+                // Another lockfile copy or signal-exit observer owns the remaining dispatch.
+                if (process.listenerCount(signal) === 0) {
+                    process.kill(process.pid, process.platform === 'win32' && signal === 'SIGHUP' ? 'SIGINT' : signal);
+                }
+            };
+
+            handler[handlerMarker] = true;
+            handlers.set(signal, handler);
+            try {
+                // Inspect application once-handlers before EventEmitter removes them.
+                process.prependListener(signal, handler);
+            } catch (e) {
+                // Some signals are unavailable on this platform.
+                handlers.delete(signal);
+            }
+        }
+    }
+
+    return {
+        install,
+        removeIfEmpty() {
+            if (Object.keys(locks).length === 0) {
+                removeListeners();
+            }
+        },
+    };
+};
