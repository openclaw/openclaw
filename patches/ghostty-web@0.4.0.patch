++                // Keep palette mutation and reset semantics with Ghostty's owner.
++                var handler = @import("../stream_readonly.zig").Handler.init(self.terminal);
++                defer handler.deinit();
++                try handler.vt(.color_operation, value);
++            },
+@@ -278,7 +282,0 @@
+-    fn colorOperation(self: *ResponseHandler, op: anytype, requests: anytype) !void {
+-        _ = self;
+-        _ = op;
+-        _ = requests;
+-        // Color operations are not supported in WASM context
+-    }
+-
+@@ -423 +421 @@
+-    wrapper.stream = ResponseStream.init(wrapper.handler);
++    wrapper.stream = ResponseStream.initAlloc(alloc, wrapper.handler);
+@@ -458,0 +457,25 @@
++}
++
++fn themeRGB(value: u32) color.RGB {
++    return .{ .r = @truncate(value >> 16), .g = @truncate(value >> 8), .b = @truncate(value) };
++}
++
++/// Host theme updates must not enter the stateful PTY output stream.
++pub fn setThemeColors(
++    ptr: ?*anyopaque,
++    foreground: u32,
++    background: u32,
++    cursor: u32,
++    palette: *const [16]u32,
++) callconv(.c) void {
++    const wrapper: *TerminalWrapper = @ptrCast(@alignCast(ptr orelse return));
++    var defaults = wrapper.terminal.colors.palette.original;
++    for (palette.*, 0..) |value, index| defaults[index] = themeRGB(value);
++    wrapper.terminal.colors.palette.changeDefault(defaults);
++    // The UI owns the first 16 defaults. Keep application changes to the
++    // extended palette, but make OSC 104 restore the newly selected UI palette.
++    for (0..16) |index| wrapper.terminal.colors.palette.reset(@intCast(index));
++    wrapper.terminal.colors.foreground = color.DynamicRGB.init(themeRGB(foreground));
++    wrapper.terminal.colors.background = color.DynamicRGB.init(themeRGB(background));
++    wrapper.terminal.colors.cursor = color.DynamicRGB.init(themeRGB(cursor));
++    wrapper.terminal.flags.dirty.palette = true;
+--- a/src/terminal/c/main.zig
++++ b/src/terminal/c/main.zig
