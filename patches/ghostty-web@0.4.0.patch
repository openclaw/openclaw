+ */
+export interface ITerminalForUrlProvider {
+    buffer: {
+        active: {
+            getLine(y: number): IBufferLineForUrlProvider | undefined;
+        };
+    };
+}
+/**
+ * Minimal buffer line interface for URL detection
+ */
