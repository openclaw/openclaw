{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Lifecycle hooks and compatibility shims must stay executable by plain Node.
    "allowJs": true,
    // Benchmarks exercise the real Control UI owners and their Solid dependencies.
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "tsBuildInfoFile": ".artifacts/tsgo-cache/scripts.tsbuildinfo"
  },
  "include": [
    "scripts/**/*",
    "src/**/*.d.ts",
    "packages/**/*.d.ts",
    "ui/src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/dist/**",
    // E2E clients import built dist artifacts and are validated by Docker runs,
    // so they cannot join this source-only program.
    "scripts/e2e/**"
  ]
}
