# Job fragment for the parent's dedicated manual-only temporary proof workflow.
# Copy the sealed small payload to .github/native-llama/mac/ in that branch.
# Parent owns on: workflow_dispatch, branch publication, dispatch, review and inspection.
mac-native-llama:
  permissions:
    contents: read
  runs-on: macos-26
  timeout-minutes: 150
  env:
    DEVELOPER_DIR: /Applications/Xcode_26.4.1.app/Contents/Developer
    LLAMA_GITHUB_HOSTED_ACK: task-owned-secretless-github-hosted
  steps:
    - name: Checkout manual proof payload
      uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      with:
        persist-credentials: false
        sparse-checkout: .github/native-llama/mac
    - name: Checkout historical native Before
      uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      with:
        repository: openclaw/openclaw
        ref: 0b584645a34242f72b0566f8cf3acebd9ac63a73
        path: .source-before
        persist-credentials: false
        fetch-depth: 1
    - name: Checkout reviewed native After
      uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      with:
        repository: openclaw/openclaw
        ref: adcfa7ca4a204860ff67b5e1db4f45bd7d5c8a17
        path: .source-after
        persist-credentials: false
        fetch-depth: 1
    - name: Checkout Gateway fixture producer
      uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      with:
        repository: openclaw/openclaw
        ref: 7830780292c95ac7f2e96ecee19cdfb1639393bb
        path: .source-core
        persist-credentials: false
        fetch-depth: 1
    - name: Install source CI pinned Node
      uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
      with:
        node-version: 24.22.1
    - name: Install source packageManager pinned pnpm
      uses: ./.source-before/.github/actions/setup-pnpm-store-cache
      with:
        node-version: 24.22.1
        package-manager-file: .source-before/package.json
        lockfile-path: .source-before/pnpm-lock.yaml
        cache-mode: off
    - name: Capture real native onboarding and prepare sheets
      shell: /bin/bash --noprofile --norc -e -o pipefail {0}
      run: |
        /bin/bash .github/native-llama/mac/run-mac-ci.sh \
          "$GITHUB_WORKSPACE/.source-before" \
          "$GITHUB_WORKSPACE/.source-after" \
          "$GITHUB_WORKSPACE/.source-core" \
          "$GITHUB_WORKSPACE/.artifacts/native-llama/mac"
    - name: Preserve Mac native proof and failure evidence
      if: always()
      uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
      with:
        name: native-llama-mac-exact-identity
        path: .artifacts/native-llama/mac/
        if-no-files-found: error
        retention-days: 7
