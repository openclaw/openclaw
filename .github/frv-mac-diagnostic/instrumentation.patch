+// LOCAL DIAGNOSTIC OVERLAY ONLY. Not a production fix or performance measurement.
+enum MacDiagnosticTrace {
+    static func emit(_ stage: String, fd: Int32 = -1, detail: String = "") {
+        let savedErrno = errno
+        defer { errno = savedErrno }
+        let line = "MAC_DIAG t=\(DispatchTime.now().uptimeNanoseconds) stage=\(stage) fd=\(fd) main=\(Thread.isMainThread) errno=\(savedErrno) \(detail)\n"
+        line.withCString { _ = Darwin.write(STDERR_FILENO, $0, strlen($0)) }
+    }
+}
