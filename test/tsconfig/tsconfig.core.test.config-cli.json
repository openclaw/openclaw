{
  "extends": "./tsconfig.core.test.shard.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../.artifacts/tsgo-cache/core-test-config-cli.tsbuildinfo"
  },
  "include": [
    "../../src/config/**/*.test.ts",
    "../../src/config/**/*.test.tsx",
    "../../src/cli/**/*.test.ts",
    "../../src/cli/**/*.test.tsx",
    "../../src/hooks/**/*.test.ts",
    "../../src/hooks/**/*.test.tsx"
  ],
  "exclude": [
    "../../node_modules",
    "../../dist",
    "../../**/dist/**",
    "../../src/cli/cron-cli/**",
    "../../src/cli/cron*.test.ts",
    "../../src/cli/cron*.test.tsx",
    "../../src/cli/daemon-cli/**",
    "../../src/cli/program/**",
    "../../src/config/sessions/**",
    "../../src/cli/update-cli/**/*.test.ts",
    "../../src/cli/update-cli/**/*.test.tsx",
    "../../src/cli/update*.test.ts",
    "../../src/cli/update*.test.tsx"
  ]
}
