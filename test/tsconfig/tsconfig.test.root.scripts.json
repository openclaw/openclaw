    "../../test/scripts/check-*.ts",
    "../../test/scripts/check-*.tsx",
    "../../test/scripts/pr-*.ts",
    "../../test/scripts/pr-*.tsx",
    "../../test/scripts/release-*.ts",
    "../../test/scripts/release-*.tsx",
    "../../test/scripts/vitest-*.ts",
    "../../test/scripts/vitest-*.tsx"
  ]
