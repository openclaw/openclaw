    "../../dist",
    "../../**/dist/**",
    "../../src/cli/cron-cli/**",
    "../../src/cli/cron*.test.ts",
    "../../src/cli/cron*.test.tsx",
    "../../src/cli/daemon-cli/**"
  ]
}
