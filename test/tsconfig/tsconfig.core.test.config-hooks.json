{
  "extends": "./tsconfig.core.test.shard.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../.artifacts/tsgo-cache/core-test-config-hooks.tsbuildinfo"
  },
  "include": [
    "../../src/config/**/*.test.ts",
    "../../src/config/**/*.test.tsx",
    "../../src/hooks/**/*.test.ts",
    "../../src/hooks/**/*.test.tsx"
  ],
  "exclude": [
    "../../node_modules",
    "../../dist",
    "../../**/dist/**",
    "../../src/config/sessions/**"
  ]
}
