{
  "extends": "./tsconfig.core.test.shard.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../.artifacts/tsgo-cache/core-test-infra.tsbuildinfo"
  },
  "include": [
    "../../src/infra/**/*.test.ts",
    "../../src/infra/**/*.test.tsx",
    "../../src/media/**/*.test.ts",
    "../../src/media/**/*.test.tsx"
  ],
  "exclude": [
    "../../node_modules",
    "../../dist",
    "../../**/dist/**",
    "../../src/infra/outbound/**",
    "../../src/infra/sqlite-*.test.ts",
    "../../src/infra/update-*.test.ts",
    "../../src/infra/update-*.test.tsx",
    "../../src/infra/package-update-*.test.ts",
    "../../src/infra/package-update-*.test.tsx"
  ]
}
