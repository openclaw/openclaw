    "../../src/agents/runtime-plan/**/*.test.ts",
    "../../src/agents/runtime-plan/**/*.test.tsx",
    "../../src/agents/sandbox/**/*.test.ts",
    "../../src/agents/sandbox/**/*.test.tsx",
    "../../src/agents/tools/**/*.test.ts",
    "../../src/agents/tools/**/*.test.tsx",
    "../../src/agents/worktrees/**/*.test.ts",
    "../../src/agents/worktrees/**/*.test.tsx"
  ]
}
