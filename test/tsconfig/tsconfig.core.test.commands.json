{
  "extends": "./tsconfig.core.test.shard.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../.artifacts/tsgo-cache/core-test-commands.tsbuildinfo"
  },
  "include": [
    "../../src/agents/command/**/*.test.ts",
    "../../src/agents/command/**/*.test.tsx",
    "../../src/commands/**/*.test.ts",
    "../../src/commands/**/*.test.tsx",
    "../../src/tui/**/*.test.ts",
    "../../src/tui/**/*.test.tsx",
    "../../src/wizard/**/*.test.ts",
    "../../src/wizard/**/*.test.tsx"
  ],
  "exclude": [
    "../../node_modules",
    "../../dist",
    "../../**/dist/**",
    "../../src/commands/doctor*.test.ts",
    "../../src/commands/doctor*.test.tsx",
    "../../src/commands/doctor/**/*.test.ts",
    "../../src/commands/doctor/**/*.test.tsx",
    "../../src/commands/oauth-tls-preflight.doctor*.test.ts",
    "../../src/commands/oauth-tls-preflight.doctor*.test.tsx"
  ]
}
