fail() {
	printf 'openclaw-release-deploy: %s\n' "$*" >&2
	return 1
}

proof() {
	"$node_bin" --no-warnings "$release_lib" "$@"
}

proof_json() {
	local command="$1" payload="$2"
	shift 2
	# Suspension task diagnostics are private payloads, not process-list arguments.
	printf '%s' "$payload" | proof "$command" @stdin "$@"
}

profile_command() {
	local operation="$1" payload="$2" command_exit output mutating=0
	((profile_owner_unsafe == 0)) || return "$profile_owner_unsafe"
	# A pipe-backed command substitution can wait on an escaped writer after timeout dies.
	output="$(mktemp "${TMPDIR:-/tmp}/openclaw-profile-output.XXXXXXXX" 8>&- 9>&-)" || return 1
	case "$operation" in
	prepare | admit | disarm | cleanup | retire | collect | close-arm | strict-observation | terminalize-arm) mutating=1 ;;
	esac
	if printf '%s' "$payload" | {
		if ((mutating)); then
			# This trusted Node keeps the flock and marks it close-on-exec before child commands.
			env -u NODE_OPTIONS "$timeout_bin" --signal=TERM --kill-after=10s 45s \
				"$node_bin" --no-warnings "$release_lib" startup-profile "$operation" 8>&-
		else
			bounded 45 "$node_bin" --no-warnings "$release_lib" startup-profile "$operation"
		fi
	} >"$output"; then
		if ! profile_result="$(<"$output")"; then
			rm -- "$output" 8>&- 9>&- || :
			return 1
		fi
		rm -- "$output" 8>&- 9>&- || return 1
		printf '%s\n' "$profile_result"
		return $?
	else
		command_exit=$?
	fi
	case "$command_exit" in
	1 | 2 | 124)
		rm -- "$output" 8>&- 9>&- || return 1
		return "$command_exit"
		;;
	*)
		if ((mutating == 0)); then
			printf 'PROFILE_READ_INCOMPLETE phase=%s exit=%s stdout=%s\n' "$operation" "$command_exit" "$output" >&2
			return "$command_exit"
		fi
		profile_owner_unsafe=76
		printf 'PROFILE_OWNER_UNJOINED phase=%s supervisor_exit=%s further-mutation=refused stdout=%s\n' \
			"$operation" "$command_exit" "$output" >&2
		return 76
		;;
	esac
}

profile_warning() {
	((profile_owner_unsafe == 0)) || return "$profile_owner_unsafe"
	local label=STARTUP_PROFILE_INCOMPLETE
	((arm_steady_profile == 0)) || label=STEADY_PROFILE_ARM_INCOMPLETE
	printf '%s phase=%s deployment-outcome=separate\n' "$label" "$1" >&2
}

profile_maintenance() {
	[[ -d /var/lib/openclaw-team-diagnostics ]] || return 0
	local receipt payload='{}'
	if [[ -n "${1:-}" ]]; then printf -v payload '{"retainArm":"%s"}' "$1"; fi
	profile_command cleanup "$payload" >/dev/null || { local code=$?; profile_warning cleanup; return "$code"; }
	receipt="$profile_result"
	if [[ "$receipt" == *'"reload":true'* ]]; then
		system_systemctl daemon-reload || { profile_warning reload; return 1; }
	fi
	profile_command retire '{}' >/dev/null || { local code=$?; profile_warning retirement; return "$code"; }
}

profile_inspect() {
	local payload
	profile_operation="$("$node_bin" -p 'require("node:crypto").randomUUID()')" || return 1
	payload="$("$node_bin" -e '
const [operation,release,identity,journal,activation,pid,start,ownerPid,ownerStart,uid,gid,steady]=process.argv.slice(1);
process.stdout.write(JSON.stringify({operation,release,releaseIdentity:JSON.parse(identity),journal,activation,predecessor:{pid:Number(pid),start},owner:{pid:Number(ownerPid),start:ownerStart},uid:Number(uid),gid:Number(gid),...(steady==="1"?{mode:"steady"}:{})}));
' "$profile_operation" "$candidate_release" "$candidate_info" "${journal_file%/*}" "$journal_file" \
		"$suspension_pid" "$suspension_generation" "$$" "$(process_generation "$$")" "$runtime_uid" "$(id -g openclaw)" "$arm_steady_profile")" || return 1
	profile_command inspect "$payload" >/dev/null || return $?
	profile_inspection="$profile_result"
}

profile_skip_no_effect() {
	profile_command no-effects "{\"operation\":\"$profile_operation\"}" >/dev/null || return $?
	# Inspection is read-only and may refuse before returning a cleanup baseline.
	[[ "$(proof journal-field "$journal_file" phase)" == B_PREVIOUS_PUBLISHED &&
		"$(read_pointer "$current_link")" == "$previous_release" &&
		"$(read_pointer "$previous_link")" == "$previous_release" ]] || return 1
	assert_exclusive_owner system && assert_protected_identity && assert_policy && check_suspension || return 1
	migration_check_existing_guard || return 1
	profile_closed=1
	profile_finished=1
	printf 'STEADY_PROFILE_SKIPPED operation=%s outcome=skipped-no-effect phase=inspection\n' "$profile_operation"
}

profile_close() {
	((profile_owner_unsafe == 0)) || return "$profile_owner_unsafe"
	((arm_steady_profile && !profile_closed)) && [[ -n "$profile_operation" ]] || return 0
	local request receipt verification
	request="$profile_inspection"
	[[ -n "$request" ]] || printf -v request '{"operation":"%s"}' "$profile_operation"
	if profile_command close-arm "$request" >/dev/null &&
		receipt="$profile_result" &&
		printf -v verification '{"request":%s,"receipt":%s}' "$request" "$receipt" &&
		profile_command verify-closed "$verification" >/dev/null; then
		profile_closed=1
		profile_finished=1
		profile_keep_arm=0
		printf 'STEADY_PROFILE_SKIPPED operation=%s outcome=closed phase=%s\n' "$profile_operation" "$1"
	else
		((profile_owner_unsafe != 0)) || profile_owner_unsafe=1
		fail 'optional profile closure is unverified; journal and owner evidence retained'
		return "$profile_owner_unsafe"
	fi
}

profile_prepare() {
	if profile_command prepare "$profile_inspection" >/dev/null &&
		system_systemctl daemon-reload &&
		profile_command verify-environment "{\"operation\":\"$profile_operation\",\"armed\":true}" >/dev/null; then
		return 0
	fi
	((profile_owner_unsafe == 0)) || return "$profile_owner_unsafe"
	((arm_steady_profile)) || return 1
	profile_close preparation
}

profile_admit() {
	[[ -n "$profile_operation" ]] && ((profile_finished == 0)) || return 0
	if ((arm_steady_profile)); then
		if profile_command admit "{\"operation\":\"$profile_operation\",\"pid\":$service_pid,\"start\":\"$service_generation\"}" &&
			profile_command disarm "{\"operation\":\"$profile_operation\"}" >/dev/null &&
			system_systemctl daemon-reload &&
			profile_command verify-environment "{\"operation\":\"$profile_operation\",\"armed\":false}" >/dev/null; then
			return 0
		fi
		profile_close admission
		return $?
	fi
	profile_command admit "{\"operation\":\"$profile_operation\",\"pid\":$service_pid,\"start\":\"$service_generation\"}" || { profile_warning admission || return $?; }
	profile_command disarm "{\"operation\":\"$profile_operation\"}" >/dev/null || { profile_warning disarm || return $?; }
	system_systemctl daemon-reload || profile_warning reload
}

profile_finish() {
	[[ -n "$profile_operation" ]] && ((profile_finished == 0)) || return 0
	if ((arm_steady_profile)); then
		[[ "$1" == true && -n "$profile_convergence" ]] || { profile_close deployment-exit; return $?; }
		local observation
		if profile_command strict-observation "$profile_convergence" >/dev/null &&
			observation="$profile_result" &&
			printf '%s' "$observation" | "$node_bin" -e '
const operation=process.argv[1];let input="";
process.stdin.on("data",chunk=>input+=chunk).on("end",()=>{
const receipt=JSON.parse(input);if(receipt.operation!==operation||receipt.outcome!=="strict-observed")process.exit(1);
});' "$profile_operation"; then
			profile_finished=1
			profile_keep_arm=1
			return 0
		fi
		profile_close ineligible-or-unregistered
		return $?
	fi
	profile_finished=1
	profile_command disarm "{\"operation\":\"$profile_operation\"}" >/dev/null || { profile_warning disarm || return $?; }
	system_systemctl daemon-reload || profile_warning reload
	profile_command verify-environment "{\"operation\":\"$profile_operation\",\"armed\":false}" >/dev/null || { profile_warning environment || return $?; }
	profile_command collect "{\"operation\":\"$profile_operation\",\"wait\":$1}" || { profile_warning collection || return $?; }
}

bounded() {
	local seconds="$1"
	shift
	# Close owner capabilities on exec, not on function calls that can leave restoration aliases.
	"$timeout_bin" --signal=TERM --kill-after=10s "${seconds}s" "$@" 8>&- 9>&-
}

