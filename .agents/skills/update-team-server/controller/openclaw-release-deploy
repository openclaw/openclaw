migration_prepare_live() {
	local process_json instance
	# Audit sealed trees before starting the short native lease. The library binds
	# these facts to this controller and lock, then rereads mutable inputs at use.
	migration_release_proof="$(proof migration-live-preflight "$journal_file" "$serving_root" "$migration_evidence" "$$")" || return 1
	# Rehearsal carries no mutation authority: take a fresh native lease and OS generation now.
	capture_generation system || return 1
	suspension_scope=system; suspension_release="$previous_release"
	suspension_pid="$service_pid"; suspension_generation="$service_generation"
	process_json="$(run_gateway "$previous_release" gateway call system.info --params '{}' --json --timeout 30000)" || return 1
	instance="$(PROCESS_JSON="$process_json" EXPECTED_PID="$service_pid" "$node_bin" -e '
const p=JSON.parse(process.env.PROCESS_JSON); if(p.pid!==Number(process.env.EXPECTED_PID)||typeof p.processInstanceId!=="string"||!p.processInstanceId)process.exit(2); process.stdout.write(p.processInstanceId);
')" || return 1
	assert_frozen_predecessor "$instance" || return 1
	suspension_instance="$instance"
	prepare_suspension "$previous_release" || return 1
	check_suspension || return 1
	migration_check_guard || return 1
	migration_record_suspension
}

migration_record_suspension() {
	local transition
	((suspension_cleanup_only == 0)) || { fail 'cannot journal a cleanup-only suspension as migration authority'; return 1; }
	transition="$(PID="$suspension_pid" GENERATION="$suspension_generation" INSTANCE="$suspension_instance" \
		LEASE="$held_suspension" EXPIRY="$suspension_expiry" LEASE_STATE="$suspension_state" RELEASE_PROOF="$migration_release_proof" "$node_bin" -e '
const e=process.env; process.stdout.write(JSON.stringify({phase:"prepared",process:{pid:Number(e.PID),generation:e.GENERATION,instance:e.INSTANCE},suspension:{id:e.LEASE,expiresAtMs:Number(e.EXPIRY),status:e.LEASE_STATE.toLowerCase(),terminalPolicy:"preserve"},releaseProof:JSON.parse(e.RELEASE_PROOF)}));
')" || return 1
	migration_evidence="$(printf '%s' "$transition" | proof migration-transition "$journal_file" "$serving_root" "$migration_evidence" @stdin "$$")" || return 1
}

migration_select_candidate() {
	local phase current previous original_previous
	phase="$(proof journal-field "$journal_file" phase)" || return 1
	current="$(read_pointer "$current_link")" || return 1
	previous=absent
	if [[ -L "$previous_link" ]]; then previous="$(read_pointer "$previous_link")" || return 1; fi
	if [[ "$(proof migration-status "$journal_file" "$serving_root")" != prepared ]]; then
		[[ "$current" == "$candidate_release" && "$previous" == "$previous_release" ]] || return 1
		return 0
	fi
	original_previous="$(proof journal-field "$journal_file" pointerTopology.previous.sha)" || return 1
	[[ "$current" == "$previous_release" || "$current" == "$candidate_release" ]] || return 1
	[[ "$previous" == "$previous_release" || "$previous" == "$releases_root/$original_previous" ||
		("$original_previous" == null && "$previous" == absent) ]] || return 1
	if [[ "$phase" == A_PREPARED || "$phase" == B_PREVIOUS_PUBLISHED ]]; then
		if [[ "$previous" != "$previous_release" ]]; then
			migration_check_guard || return 1
			atomic_pointer "$previous_release" "$previous_link" || return 1
		fi
		if [[ "$current" == "$previous_release" ]]; then
			migration_evidence="$(proof migration-advance-activation "$journal_file" "$serving_root" "$migration_evidence" B_PREVIOUS_PUBLISHED)" || return 1
			migration_check_guard || return 1
			atomic_pointer "$candidate_release" "$current_link" || return 1
		fi
	fi
	migration_evidence="$(proof migration-advance-activation "$journal_file" "$serving_root" "$migration_evidence" C_CURRENT_SELECTED)" || return 1
}

recover_live_migration_candidate() {
	local request snapshot receipt instance live_pid live_generation live_instance migration_kind migration_label migration_nocow
	local migration_session_proof nocow_summary
	[[ "$mode" == recover && "$reconcile_stopped" == 0 ]] || { fail 'live candidate reconciliation requires explicit live recovery'; return 1; }
	operator_check_lock held || return 1
	migration_evidence="$(proof migration-load "$journal_file" "$serving_root")" || return 1
	previous_release="$releases_root/$(proof journal-field "$journal_file" predecessor.sha)" || return 1
	candidate_release="$releases_root/$(proof journal-field "$journal_file" candidate.sha)" || return 1
	candidate_info="$(proof validate-release "$candidate_release" "$(basename "$candidate_release")" "$root_uid" sealed)" || return 1
	migration_guard="$(proof migration-guard-descriptor "$serving_root")" || return 1
	migration_check_guard || return 1
	if [[ -n "$reconcile_config_hash" ]]; then
		[[ "$operator_expected_sha" == "$(basename "$candidate_release")" ]] || { fail 'config reconciliation requires the exact selected candidate'; return 1; }
		recheck_generation system "$operator_expected_pid" "$operator_expected_generation" || return 1
		instance="$(read_process_instance "$candidate_release" "$operator_expected_pid")" || return 1
		request="$("$node_bin" -e 'const [candidate,pid,generation,instance,configSha256,journalSha256,runtimeUid]=process.argv.slice(1);process.stdout.write(JSON.stringify({candidate,process:{pid:Number(pid),generation,instance},configSha256,journalSha256,runtimeUid:Number(runtimeUid)}))' \
			"$operator_expected_sha" "$operator_expected_pid" "$operator_expected_generation" "$instance" "$reconcile_config_hash" "$reconcile_journal_hash" "$runtime_uid")" || return 1
		snapshot="$(proof migration-reconcile-snapshot "$journal_file" "$serving_root" "$migration_evidence" "$request")" || return 1
		recheck_generation system "$operator_expected_pid" "$operator_expected_generation" || return 1
		[[ "$(read_process_instance "$candidate_release" "$operator_expected_pid")" == "$instance" ]] || return 1
		migration_check_guard || return 1
		migration_evidence="$(proof migration-reconcile-commit "$journal_file" "$serving_root" "$migration_evidence" "$snapshot")" || return 1
		printf 'RECOVERY_CONFIG_RECONCILED config_sha256=%s journal_sha256=%s original-journal=retained-in-reconciliation restart=0\n' "$reconcile_config_hash" "$reconcile_journal_hash"
	fi
	receipt="$(proof migration-reconcile-check "$journal_file" "$serving_root" "$migration_evidence")" || return 1
	read -r live_pid live_generation live_instance < <(printf '%s' "$receipt" | "$node_bin" -e 'const r=JSON.parse(require("node:fs").readFileSync(0,"utf8"));console.log(r.process.pid,r.process.generation,r.process.instance)')
	recheck_generation system "$live_pid" "$live_generation" || return 1
	[[ "$(read_process_instance "$candidate_release" "$live_pid")" == "$live_instance" ]] || return 1
	protected_identity="$(proof journal-field "$journal_file" protectedPaths)" || return 1
	policy_identity="$(proof policy "$config_file")" || return 1
	session_witness="$(proof migration-original-witness "$journal_file" "$serving_root" "$migration_evidence")" || return 1
	migration_session_proof="$(proof migration-session-proof "$journal_file" "$serving_root" "$migration_evidence")" || return 1
	if ! wait_for_live "$candidate_release" "$candidate_info" system "$live_pid" "$live_generation"; then
		fail 'live selected candidate verification failed; journal and evidence retained, no service action performed'
		return 1
	fi
	proof migration-reconcile-check "$journal_file" "$serving_root" "$migration_evidence" >/dev/null || return 1
	migration_check_guard || return 1
	recheck_generation system "$live_pid" "$live_generation" || return 1
	[[ "$(read_process_instance "$candidate_release" "$live_pid")" == "$live_instance" ]] || return 1
	assert_protected_identity || return 1
	assert_policy || return 1
	verified_markers record "$(basename "$candidate_release")" || return 1
	migration_kind="$(proof migration-record-kind "$journal_file" "$serving_root")" || return 1
	migration_nocow="$(proof migration-record-nocow "$journal_file" "$serving_root")" || return 1
	migration_label="${migration_kind%-*}-to-${migration_kind##*-}"
	if [[ "$migration_nocow" == 1 ]]; then migration_label="${migration_kind}+nocow"; fi
	nocow_summary="$(proof migration-nocow-summary "$journal_file" "$serving_root" "$migration_evidence")" || return 1
	proof migration-finish "$journal_file" "$serving_root" "$migration_evidence" >/dev/null || return 1
	migration_evidence=""
	printf 'SUCCESS sha=%s action=deploy migration=%s previous=%s session-proof=%s%s APPROVAL_DELTA=0\n' \
		"$(basename "$candidate_release")" "$migration_label" "$(basename "$previous_release")" "$migration_session_proof" "$nocow_summary"
}

recover_agent_schema_migration() {
	local migration_phase old_pid old_generation runtime_gid doctor_stage doctor_log migration_kind migration_label migration_session_proof migration_nocow
	local warm_preflight rehearsal_inputs rehearsal_status verified_evidence doctor_exit=0
	local nocow_summary=""
	migration_evidence="$(proof migration-load "$journal_file" "$serving_root")" || return 1
	previous_release="$releases_root/$(proof journal-field "$journal_file" predecessor.sha)" || return 1
	candidate_release="$releases_root/$(proof journal-field "$journal_file" candidate.sha)" || return 1
	previous_info="$(proof validate-release "$previous_release" "$(basename "$previous_release")" "$root_uid" sealed)" || return 1
	candidate_info="$(proof validate-release "$candidate_release" "$(basename "$candidate_release")" "$root_uid" sealed)" || return 1
	migration_kind="$(proof migration-record-kind "$journal_file" "$serving_root")" || return 1
	migration_nocow="$(proof migration-record-nocow "$journal_file" "$serving_root")" || return 1
	migration_label="${migration_kind%-*}-to-${migration_kind##*-}"
	[[ "$migration_kind" != config-codex-turn-idle ]] || migration_label="$migration_kind"
	if [[ "$migration_nocow" == 1 && "$migration_kind" != offline-doctor ]]; then migration_label="${migration_kind}+nocow"; fi
