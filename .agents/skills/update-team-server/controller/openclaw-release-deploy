	if ((${accept_partial_nocow:-0})); then
		[[ "$mode" == recover && "$migration_nocow" == 1 && "$migration_phase" == doctor-started ]] || {
			fail '--accept-partial-nocow is not applicable: requires a doctor-started NOCOW recovery'; return 1;
		}
	fi
	# A new copied proof may bind authored config only while the original process
	# still serves, before cold work. The library publishes under this owner's lock.
	if [[ "$migration_kind" != offline-doctor && ("$migration_phase" == rehearsal || "$migration_phase" == prepared) && "$(system_state)" == active ]]; then
		warm_preflight="$(MIGRATION_EVIDENCE="$migration_evidence" "$node_bin" -e '
const r=JSON.parse(process.env.MIGRATION_EVIDENCE).record;
process.stdout.write(r && ["AGENT_REHEARSAL","A_PREPARED"].includes(r.phase) && r.agentMigration.artifacts.preflight ? "yes" : "no");
')" || return 1
		if [[ "$warm_preflight" == yes ]]; then
			old_pid="$(proof journal-field "$journal_file" process.pid)" || return 1
			old_generation="$(proof journal-field "$journal_file" process.generation)" || return 1
			recheck_generation system "$old_pid" "$old_generation" || return 1
			rehearsal_inputs="$(proof migration-rehearsal-inputs "$journal_file" "$serving_root" "$migration_evidence" "$runtime_uid")" || return 1
			rehearsal_status="$(REHEARSAL_INPUTS="$rehearsal_inputs" "$node_bin" -e 'process.stdout.write(JSON.parse(process.env.REHEARSAL_INPUTS).status)')" || return 1
			[[ "$rehearsal_status" == current || "$rehearsal_status" == warm-config-refresh-required ]] || {
				fail 'migration rehearsal inspector returned an unknown state'; return 1;
			}
			if [[ "$rehearsal_status" == warm-config-refresh-required ]]; then
				runtime_gid="$(id -g openclaw)" || return 1
				migration_evidence="$(proof migration-rehearse "$journal_file" "$serving_root" "$migration_evidence" \
					"$config_file" "$state_database" "$runtime_home" "$runtime_uid" "$runtime_gid" "$build_budget")" || return 1
				recheck_generation system "$old_pid" "$old_generation" || return 1
				proof migration-preflight-check "$journal_file" "$serving_root" "$migration_evidence" >/dev/null || return 1
				policy_identity="$(proof policy "$config_file")" || return 1
				printf 'REHEARSAL_REFRESHED candidate=%s prior-evidence=retained\n' "$(basename "$candidate_release")"
			fi
		fi
	fi
	protected_identity="$(proof journal-field "$journal_file" protectedPaths)" || return 1
	if [[ "$migration_nocow" == 1 && "$migration_phase" == doctor-started ]]; then
		proof offline-doctor-inputs "$journal_file" "$serving_root" "$migration_evidence" >/dev/null || return 1
	elif [[ "$migration_kind" == config-codex-turn-idle ]]; then
		proof migration-config-recovery-check "$journal_file" "$serving_root" "$migration_evidence" >/dev/null || return 1
	else
		assert_protected_identity || return 1
	fi
	if [[ "$migration_kind" == config-codex-turn-idle &&
		"$(proof migration-status "$journal_file" "$serving_root")" == stores-verified ]]; then
		migration_rebind_config_guards || return 1
	else
		migration_assert_inputs || return 1
	fi
	# Recovery never installs or recreates the permanent condition or a lost permit.
	migration_guard="$(proof migration-guard-descriptor "$serving_root")" || return 1
	migration_check_guard || return 1
	migration_phase="$(proof migration-status "$journal_file" "$serving_root")" || return 1
	nocow_summary="$(proof migration-nocow-summary "$journal_file" "$serving_root" "$migration_evidence")" || return 1
	if [[ "$migration_kind" == offline-doctor && -z "$nocow_summary" && "${accept_partial_nocow:-0}" == 0 && ("$migration_phase" == recovering-predecessor || ("$mode" == recover && ("$migration_phase" == doctor-started || "$migration_phase" == prepared))) ]]; then
		recover_offline_doctor_predecessor
		return $?
	fi
	if [[ "$migration_kind" == offline-doctor && "$migration_phase" == doctor-started && -z "$nocow_summary" && "${accept_partial_nocow:-0}" == 0 ]]; then
		fail 'offline Doctor already attempted; use explicit --recover, never repeat Doctor'
		return 1
	fi
	if [[ "$migration_nocow" == 1 && "$migration_phase" == doctor-started && "$mode" != recover ]]; then
		fail 'migration NOCOW Doctor requires explicit --recover; recovery is forward-only'
		return 1
	fi
	if [[ "$migration_phase" == rehearsal ]]; then
		proof migration-permit-present "$serving_root" >/dev/null || return 1
		proof release-capacity activate "$candidate_release" "$mirror" "$build_home" "$serving_root" "$runtime_home" >&2 || return 1
		if [[ "$migration_nocow" == 1 ]]; then
			migration_evidence="$(proof offline-doctor-preflight "$journal_file" "$serving_root" "$migration_evidence" "$config_file" "$state_database")" || return 1
		fi
		if [[ "$migration_kind" == offline-doctor ]]; then
			: # Its explicit cold-only preflight is already bound above.
		elif ((skip_migration_rehearsal)); then
			migration_evidence="$(proof migration-waive-rehearsal "$journal_file" "$serving_root" "$migration_evidence" \
				"$config_file" "$state_database")" || return 1
			printf 'REHEARSAL_WAIVED candidate=%s scope=warm-copy-only authority=explicit-operator\n' "$(basename "$candidate_release")"
		else
			runtime_gid="$(id -g openclaw)" || return 1
			migration_evidence="$(proof migration-rehearse "$journal_file" "$serving_root" "$migration_evidence" \
				"$config_file" "$state_database" "$runtime_home" "$runtime_uid" "$runtime_gid" "$build_budget")" || return 1
		fi
		migration_prepare_live || return 1
		migration_phase=prepared
	fi
	if [[ "$migration_phase" != stores-verified ]]; then
		old_pid="$(proof journal-field "$journal_file" process.pid)" || return 1
		old_generation="$(proof journal-field "$journal_file" process.generation)" || return 1
		if [[ "$(system_state)" == active ]]; then
			[[ "$migration_phase" == prepared ]] || { fail 'unexpected writer during one-way agent migration'; return 1; }
			recheck_generation system "$old_pid" "$old_generation" || return 1
			if [[ -z "$held_suspension" ]]; then migration_prepare_live || return 1; fi
			migration_stop_contract || return 1
			proof migration-live-check "$journal_file" "$serving_root" "$migration_evidence" "$migration_release_proof" "$$" >/dev/null || return 1
			# Once stopped or Doctor-started, recovery must finish forward using original evidence.
			proof release-capacity activate "$candidate_release" "$mirror" "$build_home" "$serving_root" "$runtime_home" >&2 || return 1
			renew_suspension_before_handoff || return 1
			migration_record_suspension || return 1
			check_suspension || return 1
			arm_suspension_handoff || return 1
			migration_check_guard || return 1
			proof migration-permit-revoke "$journal_file" "$serving_root" "$migration_evidence" >/dev/null || return 1
			check_suspension || return 1
			# Revoke, then settle every admitted start job while current still selects the predecessor.
			bounded 180 "$systemctl_bin" stop openclaw-gateway.service || return 1
			held_suspension=""; predecessor_stopped=1
		fi
		if [[ "$migration_phase" == prepared ]]; then
			proof migration-permit-revoke "$journal_file" "$serving_root" "$migration_evidence" >/dev/null || return 1
		fi
		proof migration-permit-absent "$serving_root" >/dev/null || return 1
		migration_assert_stopped || return 1
		[[ ! -e "$proc_root/$old_pid" || "$(process_generation "$old_pid")" != "$old_generation" ]] || return 1
		migration_select_candidate || return 1
		if [[ "$migration_phase" == prepared ]]; then
			migration_evidence="$(proof migration-cold-backup "$journal_file" "$serving_root" "$migration_evidence" "$config_file" "$state_database" "$proc_root")" || return 1
			migration_assert_stopped || return 1
			migration_evidence="$(printf '%s' '{"phase":"doctor-started"}' | proof migration-transition "$journal_file" "$serving_root" "$migration_evidence" @stdin)" || return 1
		fi
		nocow_summary="$(proof migration-nocow-summary "$journal_file" "$serving_root" "$migration_evidence")" || return 1
		if ((${accept_partial_nocow:-0})) || [[ -n "$nocow_summary" ]]; then
			migration_evidence="$(proof offline-doctor-accept-partial "$journal_file" "$serving_root" "$migration_evidence" "$proc_root")" || return 1
			nocow_summary="$(proof migration-nocow-summary "$journal_file" "$serving_root" "$migration_evidence")" || return 1
			printf 'NOCOW_PARTIAL_ACCEPTED%s\n' "$nocow_summary"
		else
		if [[ "$migration_nocow" == 1 ]]; then
			# Reuse the original capture on forward recovery; never recapture migrated data.
			migration_evidence="$(proof offline-doctor-capture "$journal_file" "$serving_root" "$migration_evidence" "$proc_root")" || return 1
		fi
		migration_assert_stopped || return 1
		proof migration-writers-stopped "$journal_file" "$serving_root" "$migration_evidence" "$proc_root" >/dev/null || return 1
		printf 'MIGRATING migration=%s candidate=%s recovery=forward-only\n' "$migration_label" "$(basename "$candidate_release")"
		doctor_stage="$(proof journal-field "$journal_file" agentMigration.stage)" || return 1
		doctor_log="$serving_root/journal/$doctor_stage/doctor-$(date -u +%Y%m%dT%H%M%SZ)-$$" || return 1
		if [[ "$migration_kind" == config-codex-turn-idle ]]; then
			migration_evidence="$(proof migration-config-apply "$journal_file" "$serving_root" "$migration_evidence" "$proc_root")" || return 1
		else
		if [[ "$migration_nocow" == 1 ]]; then
			migration_evidence="$(proof offline-doctor-intent "$journal_file" "$serving_root" "$migration_evidence" "$doctor_log" "$proc_root")" || return 1
			doctor_log="$(proof offline-doctor-log "$journal_file" "$serving_root" "$migration_evidence" "$proc_root")" || return 1
		fi
		# The candidate's Doctor defers the btrfs NOCOW store rewrite during managed updates
		# unless the updater requests it; only the explicit +nocow transaction asks for it.
		local doctor_nocow_env=()
		if [[ "$migration_nocow" == 1 ]]; then doctor_nocow_env=(OPENCLAW_DOCTOR_SQLITE_NOCOW_REPAIR=1); fi
		(umask 077; set -o noclobber
			if [[ "$migration_nocow" == 1 ]]; then
				exec >>"$doctor_log.stdout" 2>>"$doctor_log.stderr" || exit 1
			else
				exec >"$doctor_log.stdout" 2>"$doctor_log.stderr" || exit 1
			fi
			bounded "$build_budget" "$runuser_bin" -u openclaw -- env -i \
				HOME="$runtime_home" OPENCLAW_HOME="$runtime_home" OPENCLAW_STATE_DIR="$(dirname "$config_file")" \
				OPENCLAW_CONFIG_PATH="$config_file" OPENCLAW_SUPERVISOR_MODE=external OPENCLAW_SERVICE_REPAIR_POLICY=external \
				OPENCLAW_UPDATE_IN_PROGRESS=1 "${doctor_nocow_env[@]}" \
				OPENCLAW_SYSTEMD_UNIT=openclaw-gateway.service PATH=/usr/bin:/bin TMPDIR=/tmp \
				XDG_CONFIG_HOME="$runtime_home/.config" XDG_CACHE_HOME="$runtime_home/.cache" NODE_DISABLE_COMPILE_CACHE=1 \
				"$node_bin" --no-warnings "$candidate_release/dist/index.js" doctor --repair --non-interactive --no-workspace-suggestions) || doctor_exit=$?
		if [[ "$migration_nocow" == 1 ]]; then
			stopped_system_owners || return 1
			migration_native_guard || return 1
			if verified_evidence="$(proof offline-doctor-verify "$journal_file" "$serving_root" "$migration_evidence" "$doctor_exit" "$proc_root")"; then
				migration_evidence="$verified_evidence"
			else
				migration_evidence="$(proof migration-load "$journal_file" "$serving_root")" || return 1
				return 1
			fi
		elif ((doctor_exit != 0)); then return 1; fi
		fi
		fi
		migration_assert_stopped || return 1
		proof migration-writers-stopped "$journal_file" "$serving_root" "$migration_evidence" "$proc_root" >/dev/null || return 1
		if verified_evidence="$(proof migration-verify-stores "$journal_file" "$serving_root" "$migration_evidence" "$config_file" "$state_database")"; then
			migration_evidence="$verified_evidence"
		else
			migration_evidence="$(proof migration-load "$journal_file" "$serving_root")" || return 1
			return 1
		fi
		protected_identity="$(proof journal-field "$journal_file" protectedPaths)" || return 1
		if [[ "$migration_kind" == config-codex-turn-idle ]]; then migration_rebind_config_guards || return 1; fi
	fi
	# Reuse the bound pre-Doctor witness and report whether native code had already
	# advanced the schema before this owner's cold capture.
	session_witness="$(proof migration-original-witness "$journal_file" "$serving_root" "$migration_evidence")" || return 1
	[[ -n "$session_witness" ]] || return 1
	migration_session_proof="$(proof migration-session-proof "$journal_file" "$serving_root" "$migration_evidence")" || return 1
	migration_check_guard || return 1
	if [[ "$(system_state)" != active ]]; then
		migration_assert_stopped || return 1
		proof migration-permit-publish "$journal_file" "$serving_root" "$migration_evidence" "$proc_root" >/dev/null || return 1
		migration_check_guard || return 1
		system_systemctl start openclaw-gateway.service || return 1
	else
		proof migration-permit-present "$serving_root" >/dev/null || return 1
	fi
	# A native condition skip exits0; Type=simple also does not prove exec/listener readiness.
	capture_service_generation system || return 1
	old_pid="$service_pid"; old_generation="$service_generation"
	wait_for_live "$candidate_release" "$candidate_info" system || return 1
	proof migration-check "$journal_file" "$serving_root" "$migration_evidence" >/dev/null || return 1
	recheck_generation system "$old_pid" "$old_generation" || return 1
	assert_protected_identity || return 1
	assert_policy || return 1
	verified_markers record "$(basename "$candidate_release")" || return 1
	nocow_summary="$(proof migration-nocow-summary "$journal_file" "$serving_root" "$migration_evidence")" || return 1
	proof migration-finish "$journal_file" "$serving_root" "$migration_evidence" >/dev/null || return 1
	migration_evidence=""
	cleanup_releases || return 1
	printf 'SUCCESS sha=%s action=deploy migration=%s previous=%s session-proof=%s%s APPROVAL_DELTA=0\n' \
	  "$(basename "$candidate_release")" "$migration_label" "$(basename "$previous_release")" "$migration_session_proof" "$nocow_summary"
}

recover_offline_doctor_predecessor() {
	local phase recovered_pid recovered_generation
	[[ "$mode" == recover ]] || { fail 'offline Doctor rollback requires explicit --recover'; return 1; }
	phase="$(proof migration-status "$journal_file" "$serving_root")" || return 1
	if [[ "$phase" == prepared ]]; then
		migration_assert_stopped || return 1
		migration_evidence="$(printf '%s' '{"phase":"doctor-started"}' | proof migration-transition "$journal_file" "$serving_root" "$migration_evidence" @stdin)" || return 1
		phase=doctor-started
	fi
	if [[ "$phase" == doctor-started ]]; then
		migration_assert_stopped || return 1
		migration_evidence="$(proof offline-doctor-recover "$journal_file" "$serving_root" "$migration_evidence" "$proc_root")" || return 1
	fi
	proof offline-recovery-position "$journal_file" "$serving_root" "$migration_evidence" >/dev/null || return 1
	protected_identity="$(proof journal-field "$journal_file" protectedPaths)" || return 1
	session_witness="$(proof migration-original-witness "$journal_file" "$serving_root" "$migration_evidence")" || return 1
	if [[ "$(system_state)" != active ]]; then
		migration_assert_stopped || return 1
		proof compatibility "$candidate_release" "$previous_release" "$state_database" >/dev/null || return 1
		restore_pointer_topology || return 1
		migration_assert_stopped || return 1
		proof offline-recovery-permit "$journal_file" "$serving_root" "$migration_evidence" "$proc_root" >/dev/null || return 1
		system_systemctl start openclaw-gateway.service || return 1
	fi
	capture_service_generation system || return 1
	recovered_pid="$service_pid"; recovered_generation="$service_generation"
	[[ "$(read_pointer "$current_link")" == "$previous_release" && "$(realpath "$proc_root/$recovered_pid/cwd")" == "$previous_release" ]] || return 1
	proof migration-permit-present "$serving_root" >/dev/null || return 1
	wait_for_live "$previous_release" "$previous_info" system "$recovered_pid" "$recovered_generation" || return 1
	assert_protected_identity && assert_policy || return 1
	recheck_generation system "$recovered_pid" "$recovered_generation" || return 1
	proof offline-recovery-finish "$journal_file" "$serving_root" "$migration_evidence" "$proc_root" >/dev/null || return 1
	migration_evidence=""
	printf 'RECOVERED action=restored-offline-doctor-predecessor sha=%s backups=retained APPROVAL_DELTA=0\n' "$(basename "$previous_release")"
}

install_migration_guard_current() {
	[[ ! -e "$journal_file" && ! -L "$journal_file" ]] || { fail 'native guard bootstrap refuses a pending journal'; return 1; }
	local release
	release="$(read_pointer "$current_link")" || return 1
	[[ "$(basename "$release")" == "$operator_expected_sha" ]] || return 1
	recheck_generation system "$operator_expected_pid" "$operator_expected_generation" || return 1
	[[ "$(realpath "$proc_root/$service_pid/cwd")" == "$release" ]] || return 1
	assert_protected_identity || return 1
	assert_policy || return 1
	proof compatibility "$release" "$release" "$state_database" >/dev/null || return 1
	assert_frozen_predecessor || return 1
	migration_install_guard || return 1
	recheck_generation system "$operator_expected_pid" "$operator_expected_generation" || return 1
	[[ "$(read_pointer "$current_link")" == "$release" ]] || return 1
	assert_protected_identity || return 1
	assert_policy || return 1
	proof migration-permit-present "$serving_root" >/dev/null || return 1
	printf 'MIGRATION_GUARD_INSTALLED sha=%s restart=0 native-condition=positive-path-exists\n' "$operator_expected_sha"
}

activate_agent_schema_migration() {
	local record
	assert_protected_identity || return 1
	assert_policy || return 1
	capture_generation system || return 1
	operator_expected_sha="$(basename "$previous_release")"
	operator_expected_pid="$service_pid"; operator_expected_generation="$service_generation"
	if ((offline_doctor_repair)); then
		migration_guard="$(proof migration-guard-descriptor "$serving_root")" || return 1
		migration_check_guard || return 1
		proof migration-permit-present "$serving_root" >/dev/null || return 1
	else
		install_migration_guard_current || return 1
	fi
	record="$(migration_capture_record)" || return 1
	migration_evidence="$(printf '%s' "$record" | proof migration-create "$serving_root" @stdin)" || return 1
	recover_agent_schema_migration
}

bind_successor_generation() {
	# Type=simple acknowledges fork, not exec or listener readiness.
	# Bind the OS generation now; wait_for_live owns listener/RPC convergence.
	capture_service_generation system || return 1
	suspension_scope=system
	suspension_release="$candidate_release"
	suspension_pid="$service_pid"
	suspension_generation="$service_generation"
	suspension_instance=""
}

prepare_rollback_suspension() {
	# Bind at successful start or explicit recovery, not after failed verification:
	# a replacement must never gain rollback authority by answering a fresh lease RPC.
	[[ "$suspension_scope" == system && "$suspension_release" == "$candidate_release" ]] || return 1
	recheck_generation system "$suspension_pid" "$suspension_generation" || return 1
	if ((interrupt_after_drain)); then
		# system.info is fenced after preparation; bind the already-owned successor before its lease.
		suspension_instance="$(read_process_instance "$candidate_release" "$suspension_pid")" || return 1
		recheck_generation system "$suspension_pid" "$suspension_generation" || return 1
	fi
	if prepare_suspension "$candidate_release" && check_suspension; then
		return 0
	fi
	# A running but unfenceable successor stays in place, even when verification is unhealthy.
	fail 'rollback successor could not be safely fenced; refusing restart and retaining evidence'
}

rollback_activation() {
	local exit_code="$1" predecessor_sha candidate_sha topology expected_pid expected_generation rollback_owner
	local failure_code="$1" rollback_pid="" rollback_generation=""
	((failure_code != 0)) || failure_code=1
	((rollback_armed)) || return "$exit_code"
	local migration_phase
	migration_phase="$(proof migration-status "$journal_file" "$serving_root")" || { rollback_armed=0; return "$failure_code"; }
	if [[ "$migration_phase" != none ]]; then
		rollback_armed=0
		fail 'agent schema migration is forward-only; journal, backups, and boot fence retained'
		return "$failure_code"
	fi
	rollback_armed=0
	load_journal_witness || return "$failure_code"
	verification_deadline=0
	predecessor_sha="$(proof journal-field "$journal_file" predecessor.sha)" || return "$failure_code"
	candidate_sha="$(proof journal-field "$journal_file" candidate.sha)" || return "$failure_code"
	topology="$(proof journal-field "$journal_file" topology)" || return "$failure_code"
	if [[ "$candidate_sha" != "$predecessor_sha" ]]; then
		record_failed "$candidate_sha" || return "$failure_code"
	fi
	if ! proof compatibility "$candidate_release" "$previous_release" "$state_database" >/dev/null; then
		proof journal-phase "$journal_file" ROLLBACK_FAILED "$session_witness_record" >/dev/null || true
		fail 'rollback compatibility cannot be proved; candidate remains selected and evidence is retained'
		return "$failure_code"
	fi
	# Changed system-deployment policy cannot converge by polling the previous runtime.
	if ! assert_protected_identity || { [[ "$topology" == system ]] && ! assert_policy; }; then
		proof journal-phase "$journal_file" ROLLBACK_FAILED "$session_witness_record" >/dev/null || true
		return "$failure_code"
	fi
	if [[ "$topology" == migration-user ]]; then
		if ! restore_migration_topology; then
			proof journal-phase "$journal_file" ROLLBACK_FAILED "$session_witness_record" >/dev/null || true
			fail 'migration rollback failed; automation stopped and evidence retained'
			return "$failure_code"
		fi
		if ! wait_for_live "$previous_release" "$previous_info" migration-user; then
			proof journal-phase "$journal_file" ROLLBACK_FAILED "$session_witness_record" >/dev/null || true
			fail 'migration rollback failed; automation stopped and evidence retained'
			return "$failure_code"
		fi
	else
		expected_pid="$(proof journal-field "$journal_file" process.pid)" || return "$failure_code"
		expected_generation="$(proof journal-field "$journal_file" process.generation)" || return "$failure_code"
		if ((predecessor_stopped == 0)); then
			rollback_owner=untouched
			recheck_generation system "$expected_pid" "$expected_generation" || {
				proof journal-phase "$journal_file" ROLLBACK_FAILED "$session_witness_record" >/dev/null || true
				fail 'predecessor changed before observed shutdown; refusing rollback restart'
				return 1
			}
		elif predecessor_is_stopped "$expected_pid"; then
			rollback_owner=stopped
		elif ((restart_failed)); then
			proof journal-phase "$journal_file" ROLLBACK_FAILED "$session_witness_record" >/dev/null || true
			fail 'failed-start ownership changed during rollback proof; refusing restart'
			return 1
		else
			rollback_owner=running
			if ! prepare_rollback_suspension; then
				proof journal-phase "$journal_file" ROLLBACK_FAILED "$session_witness_record" >/dev/null || true
				return 1
			fi
		fi
		restore_pointer_topology || return "$failure_code"
		if [[ "$rollback_owner" == untouched ]]; then
			resume_suspension || return 1
			if [[ "$mode" != runtime ]]; then
				rollback_pid="$expected_pid"; rollback_generation="$expected_generation"
			fi
		else
			if [[ "$rollback_owner" == stopped ]]; then
				predecessor_is_stopped "$expected_pid" || {
					proof journal-phase "$journal_file" ROLLBACK_FAILED "$session_witness_record" >/dev/null || true
					fail 'failed-start ownership changed before rollback restart'
					return 1
				}
			elif ! assert_protected_identity || ! assert_policy || ! check_suspension || ! arm_suspension_handoff; then
				proof journal-phase "$journal_file" ROLLBACK_FAILED "$session_witness_record" >/dev/null || true
				fail 'successor suspension or generation changed before rollback restart'
				return 1
			fi
			system_systemctl restart openclaw-gateway.service || {
				proof journal-phase "$journal_file" ROLLBACK_FAILED "$session_witness_record" >/dev/null || true
				return "$failure_code"
			}
			held_suspension=""
			if [[ "$mode" != runtime ]]; then
				capture_service_generation system || return "$failure_code"
				rollback_pid="$service_pid"; rollback_generation="$service_generation"
				[[ "$(realpath "$proc_root/$rollback_pid/cwd")" == "$previous_release" ]] || return "$failure_code"
			fi
		fi
		if ! wait_for_live "$previous_release" "$previous_info" system "$rollback_pid" "$rollback_generation"; then
			proof journal-phase "$journal_file" ROLLBACK_FAILED "$session_witness_record" >/dev/null || true
			fail 'activation rollback failed; automation stopped and evidence retained'
			return "$failure_code"
		fi
	fi
	# on_exit calls rollback in an OR-list, so retirement cannot rely on errexit.
	proof unlink-exact "$journal_file" "$root_uid" "$session_witness_record" || return 1
	printf 'ROLLED_BACK sha=%s\n' "$predecessor_sha" >&2
	return "$exit_code"
}

restore_migration_enablement() {
	local expected_system_enabled="$1" expected_user_enabled="$2"
	if [[ "$(system_unit_state)" != "$expected_system_enabled" ]]; then
		system_systemctl disable openclaw-gateway.service || return 1
	fi
	if [[ "$(user_unit_state)" != "$expected_user_enabled" ]]; then
		if [[ "$expected_user_enabled" == enabled ]]; then
			user_unit_file enable || return 1
		else
			user_unit_file disable || return 1
		fi
	fi
}

restore_migration_topology() {
	local expected_system_enabled expected_user_enabled expected_system_active expected_user_active
	local observed_system observed_user
	expected_system_enabled="$(proof journal-field "$journal_file" services.system.unitFileState)" || return 1
	expected_user_enabled="$(proof journal-field "$journal_file" services.user.unitFileState)" || return 1
	expected_system_active="$(proof journal-field "$journal_file" services.system.activeState)" || return 1
	expected_user_active="$(proof journal-field "$journal_file" services.user.activeState)" || return 1
	[[ "$expected_system_enabled" == disabled &&
		("$expected_user_enabled" == enabled || "$expected_user_enabled" == disabled) &&
		"$expected_system_active" == inactive && "$expected_user_active" == active ]] ||
		fail 'migration journal cannot restore an unsupported predecessor topology'
	observed_system="$(system_state)"
	observed_user="$(user_state)"
	[[ ! ("$observed_system" == active && "$observed_user" == active) ]] ||
		fail 'migration rollback found simultaneous Gateway owners'
	if [[ "$observed_system" == active ]]; then
		[[ "$observed_user" != active ]] || return 1
		prepare_rollback_suspension || return 1
		assert_protected_identity || return 1
		assert_policy || return 1
		check_suspension || return 1
		arm_suspension_handoff || return 1
		system_systemctl stop openclaw-gateway.service || return 1
		predecessor_stopped=1
		held_suspension=""
	fi
	restore_pointer_topology || return 1
	restore_migration_enablement "$expected_system_enabled" "$expected_user_enabled" || return 1
	if [[ "$(user_state)" != active ]]; then
		assert_exclusive_owner quiescent || return 1
		predecessor_stopped=1
		held_suspension=""
		user_systemctl start openclaw-gateway.service || return 1
	else
		resume_suspension || return 1
	fi
	assert_exclusive_owner migration-user
}

restore_pointer_topology() {
	local current_present previous_present previous_sha
	current_present="$(proof journal-field "$journal_file" pointerTopology.current.present)" || return 1
	previous_present="$(proof journal-field "$journal_file" pointerTopology.previous.present)" || return 1
	if [[ "$current_present" == true ]]; then
		if [[ "$(read_pointer "$current_link")" != "$previous_release" ]]; then
			atomic_pointer "$previous_release" "$current_link" || return 1
		fi
	elif [[ -L "$current_link" ]]; then
		proof unlink-pointer "$current_link" "$serving_root" "$root_uid" || return 1
	fi
	if [[ "$previous_present" == true ]]; then
		previous_sha="$(proof journal-field "$journal_file" pointerTopology.previous.sha)" || return 1
		if [[ ! -L "$previous_link" || "$(read_pointer "$previous_link")" != "$releases_root/$previous_sha" ]]; then
			atomic_pointer "$releases_root/$previous_sha" "$previous_link" || return 1
		fi
	elif [[ -L "$previous_link" ]]; then
		proof unlink-pointer "$previous_link" "$serving_root" "$root_uid" || return 1
	fi
	if [[ "$(proof gateway-runtime changing "$serving_root")" == yes ]]; then
		proof gateway-runtime restore "$serving_root" >/dev/null || return 1
		system_systemctl daemon-reload || return 1
		load_gateway_runtime || return 1
	fi
}

on_exit() {
	local exit_code=$? cleanup_exit
	if [[ -n "$abandon_rehearsal_sha" || "$mode" == prepare-release || "$mode" == snapshot-rehearsal || "$mode" == continue-frozen ]]; then exit "$exit_code"; fi
	# Admission failure or a lost journal receipt carries no profile cleanup authority.
	if [[ -n "$frozen_target_sha" && -z "$migration_evidence" && -z "$held_suspension" ]] && ((rollback_armed == 0)); then exit "$exit_code"; fi
	if [[ "$mode" == handoff-source ]]; then
		trap - EXIT
		if [[ -n "$held_suspension" ]]; then resume_suspension || exit_code=1; fi
		exit "$exit_code"
	fi
	if [[ "$mode" == handoff-* ]]; then
		trap - EXIT
		if ((exit_code != 0)); then printf 'HANDOFF_TARGET_RETAINED forward-recovery=required journal-and-source-evidence=retained\n' >&2; fi
		exit "$exit_code"
	fi
	if ((start_stopped_current)); then
		trap - EXIT
		stopped_current_finish "$exit_code"
		exit $?
	fi
	trap - EXIT ERR
	# The exec-based capture mode owns its own permit and has no deployment cleanup authority.
	[[ "$mode" != steady-profile ]] || exit "$exit_code"
	profile_finish false || { cleanup_exit=$?; ((exit_code != 0)) || exit_code="$cleanup_exit"; }
	if ((exit_code != 0)); then
		profile_close deployment-exit || { cleanup_exit=$?; ((exit_code != 0)) || exit_code="$cleanup_exit"; }
	fi
	if ((profile_owner_unsafe)); then
		((exit_code != 0)) || exit_code="$profile_owner_unsafe"
		exit "$exit_code"
	fi
	if [[ "$mode" == operator-restart ]] && ((operator_receipt_open && !operator_restart_verified)); then
		((exit_code != 0)) || exit_code=1
		operator_receipt failed "$exit_code" || true
	fi
	if ((exit_code != 0)) && [[ -n "$migration_evidence" && -e "$journal_file" ]]; then
		local migration_phase
		migration_phase="$(proof migration-status "$journal_file" "$serving_root")" || migration_phase=unknown
		if [[ "$migration_phase" == doctor-started || "$migration_phase" == stores-verified ]]; then
			record_failed "$(basename "$candidate_release")" || exit_code=1
			if [[ "$(proof migration-record-kind "$journal_file" "$serving_root")" == offline-doctor ]]; then
				printf 'OFFLINE_DOCTOR_RETAINED recovery=explicit-verified-owner phase=%s\n' "$migration_phase" >&2
			else
				printf 'MIGRATION_RETAINED recovery=forward-only phase=%s\n' "$migration_phase" >&2
			fi
		fi
	fi
	if ((rollback_armed)); then
		rollback_activation "$exit_code" || exit_code=$?
	fi
	# A rollback lease can belong to the successor even though the original predecessor stopped.
	if [[ -n "$held_suspension" ]]; then
		resume_suspension || exit_code=1
	fi
	if ((exit_code == 0 && profile_keep_arm)); then
		profile_maintenance "$profile_operation" || { cleanup_exit=$?; ((exit_code != 0)) || exit_code="$cleanup_exit"; }
	else
		profile_maintenance || { cleanup_exit=$?; ((exit_code != 0)) || exit_code="$cleanup_exit"; }
	fi
	if ((exit_code == 0 && profile_keep_arm)); then
		# This is the final closeout action. Earlier journal retirement is not capture eligibility.
		profile_command terminalize-arm "{\"operation\":\"$profile_operation\"}" ||
			{ profile_close terminalization || exit_code=$?; }
	elif ((arm_steady_profile)); then
		profile_close exit-maintenance || { cleanup_exit=$?; ((exit_code != 0)) || exit_code="$cleanup_exit"; }
	fi
	exit "$exit_code"
}

recheck_recovery_generation() {
	if [[ "$phase" != MIGRATION_SWITCHING ]]; then
		recheck_generation "$suspension_scope" "$suspension_pid" "$suspension_generation"
		return $?
	fi
	# Before stop, migration may have changed enablement, but never active ownership.
	local observed_system_enabled observed_user_enabled
	[[ "$(system_state)" == inactive && "$(user_state)" == active ]] || return 1
	observed_system_enabled="$(system_unit_state)"
	observed_user_enabled="$(user_unit_state)"
	[[ ("$observed_system_enabled" == enabled || "$observed_system_enabled" == disabled) &&
		("$observed_user_enabled" == disabled || "$observed_user_enabled" == "$expected_user_enabled") ]] || return 1
	read_service user || return 1
	[[ "$service_pid" == "$suspension_pid" &&
		"$(process_generation "$service_pid")" == "$suspension_generation" ]] || {
		fail 'migration predecessor generation changed during recovery'
		return 1
	}
	assert_single_listener "$service_pid"
}

check_recovery_predecessor() {
	proof recovery-check "$journal_file" "$1" "$serving_root" "$2" >/dev/null || return 1
	if [[ -n "${recovery_pid:-}" ]]; then
		[[ ! -e "$proc_root/$suspension_pid" && ! -L "$proc_root/$suspension_pid" ]] || return 1
		recovery_jobs_settled || return 1
		recheck_generation system "$recovery_pid" "$recovery_generation" || return 1
		[[ "$(realpath "$proc_root/$recovery_pid/cwd")" == "$previous_release" ]] || return 1
		proof gateway-runtime process "$serving_root" "$gateway_runtime_snapshot" "$proc_root" "$recovery_pid" >/dev/null || return 1
		[[ "$(read_process_instance "$previous_release" "$recovery_pid")" == "$recovery_instance" ]] || return 1
		recheck_generation system "$recovery_pid" "$recovery_generation"
		return $?
	fi
	recheck_recovery_generation
}

observe_recovery_suspension() {
	local evidence="$1" params="$2" response
	if [[ -n "${recovery_pid:-}" ]]; then
		check_recovery_predecessor "$evidence" "$recovery_pointer_view" || return 1
		# The historical ID satisfies the status contract; only RUNNING is accepted for this replacement.
		response="$(run_gateway "$previous_release" gateway call gateway.suspend.status --params "$params" --json --timeout 30000)" || return 1
		check_recovery_predecessor "$evidence" "$recovery_pointer_view" || return 1
		proof_json suspension-running "$response" >/dev/null || return 1
		printf 'RESTARTED\n'
		return 0
	fi
	recheck_recovery_generation || return 1
	response="$(run_gateway "$previous_release" gateway call gateway.suspend.status \
		--params "$params" --json --timeout 30000)" || return 1
	recheck_recovery_generation || return 1
	proof_json suspension-recovery-status "$response" "$evidence"
}

recover_predecessor() {
	local evidence lease params outcome response expected_system_enabled expected_user_enabled witness_receipt=""
	local recovery_pid="${2:-}" recovery_generation="${3:-}" recovery_instance="" recovery_pointer_view=observed
	if [[ -n "$reconcile_request" ]]; then
		recovery_pointer_view=restored
		evidence="$(proof recovery-snapshot "$journal_file" "$serving_root" "$1" restored "$reconcile_request")" || return 1
		reconcile_evidence="$evidence"
		protected_identity="$(proof fingerprint "$config_file" "$state_database")" || return 1
		assert_protected_identity || return 1
	else
		evidence="$(proof recovery-snapshot "$journal_file" "$serving_root" "$1")" || return 1
	fi
	if [[ -n "$recovery_pid" ]]; then
		[[ "$mode" == recover && "$topology" == system && "$session_proof" == original-pre-cutover &&
			"$(proof gateway-runtime changing "$serving_root")" == no &&
			! -e "$proc_root/$suspension_pid" && ! -L "$proc_root/$suspension_pid" ]] || return 1
		recheck_generation system "$recovery_pid" "$recovery_generation" || return 1
		[[ "$(realpath "$proc_root/$recovery_pid/cwd")" == "$previous_release" ]] || return 1
		recovery_instance="$(read_process_instance "$previous_release" "$recovery_pid")" || return 1
	fi
	if [[ "$phase" == MIGRATION_SWITCHING ]]; then
		expected_system_enabled="$(proof journal-field "$journal_file" services.system.unitFileState)" || return 1
		expected_user_enabled="$(proof journal-field "$journal_file" services.user.unitFileState)" || return 1
	fi
	lease="$(proof journal-field "$journal_file" suspension.id)" || return 1
	params="$(proof suspension-lease-params "$lease")" || return 1
	check_recovery_predecessor "$evidence" "$recovery_pointer_view" || return 1
	outcome="$(observe_recovery_suspension "$evidence" "$params")" || return 1
	# The running release is still the predecessor; no candidate migration is admitted here.
	proof compatibility "$previous_release" "$candidate_release" "$state_database" >/dev/null || return 1
	assert_policy || return 1
	check_recovery_predecessor "$evidence" "$recovery_pointer_view" || return 1
	outcome="$(observe_recovery_suspension "$evidence" "$params")" || return 1
	check_recovery_predecessor "$evidence" "$recovery_pointer_view" || return 1
	if [[ -z "$reconcile_request" ]]; then restore_pointer_topology || return 1; fi
	recovery_pointer_view=restored
	check_recovery_predecessor "$evidence" restored || return 1
	outcome="$(observe_recovery_suspension "$evidence" "$params")" || return 1
	check_recovery_predecessor "$evidence" restored || return 1
	if [[ "$phase" == MIGRATION_SWITCHING ]]; then
		restore_migration_enablement "$expected_system_enabled" "$expected_user_enabled" || return 1
		check_recovery_predecessor "$evidence" restored || return 1
		outcome="$(observe_recovery_suspension "$evidence" "$params")" || return 1
		check_recovery_predecessor "$evidence" restored || return 1
	fi
	if [[ "$outcome" == ACTIVE ]]; then
		held_suspension="$lease"
		resume_suspension || return 1
		outcome=resumed
	elif [[ "$outcome" != RESTARTED ]]; then
		# Expiry already reopened admission. This is observation, not a resume.
		outcome=already-resumed
	fi
	if [[ -n "$recovery_pid" ]]; then
		wait_for_live "$previous_release" "$previous_info" system "$recovery_pid" "$recovery_generation" || return 1
	else
		response="$(run_gateway "$previous_release" gateway call system.info --params '{}' --json --timeout 30000)" || return 1
		proof recovery-process "$response" "$evidence" >/dev/null || return 1
	fi
	assert_protected_identity || return 1
	assert_policy || return 1
	if [[ "$session_proof" == original-pre-cutover ]]; then
		printf '%s' "$session_witness" | proof session-preservation-verify \
			"$previous_release" "$candidate_release" "$state_database" >/dev/null || return 1
		witness_receipt=' session-proof=original-pre-cutover'
	else
		proof compatibility "$previous_release" "$candidate_release" "$state_database" >/dev/null || return 1
	fi
	check_recovery_predecessor "$evidence" restored || return 1
	if [[ -n "$recovery_pid" ]]; then
		observe_recovery_suspension "$evidence" "$params" >/dev/null || return 1
		check_recovery_predecessor "$evidence" restored || return 1
	else
		response="$(run_gateway "$previous_release" gateway call gateway.suspend.status \
			--params "$params" --json --timeout 30000)" || return 1
		proof_json suspension-running "$response" >/dev/null || return 1
		recheck_generation "$suspension_scope" "$suspension_pid" "$suspension_generation" || return 1
	fi
	if [[ "$phase" == MIGRATION_SWITCHING ]]; then
		[[ "$(system_unit_state)" == "$expected_system_enabled" &&
		"$(user_unit_state)" == "$expected_user_enabled" ]] || return 1
	fi
	proof recovery-finish "$journal_file" "$evidence" "$serving_root" restored >/dev/null || return 1
	if [[ -n "$reconcile_evidence" ]]; then
		printf 'RECOVERY_CONFIG_RECONCILED config_sha256=%s journal_sha256=%s original-journal=retired-without-rewrite\n' "$reconcile_config_hash" "$reconcile_journal_hash"
	fi
	printf 'RECOVERED phase=%s action=restore-pointer-no-restart suspension=%s%s\n' "$phase" "$outcome" "$witness_receipt"
}

worker_config_stopped() {
	migration_native_guard || return 1
	if [[ "${1:-}" != accepted ]]; then
		proof migration-permit-absent "$serving_root" >/dev/null || return 1
	fi
	stopped_system_owners || return 1
	[[ ! -e "$proc_root/$operator_expected_pid" || "$(process_generation "$operator_expected_pid")" != "$operator_expected_generation" ]] || return 1
	proof worker-config check "$serving_root" >/dev/null
}

finish_worker_config() {
	local recovery="$1" outcome old_pid old_generation
	protected_identity="$(proof journal-field "$journal_file" protectedPaths)" || return 1
	assert_protected_identity || return 1
	assert_policy || return 1
	proof worker-config check "$serving_root" >/dev/null || return 1
	proof compatibility "$previous_release" "$previous_release" "$state_database" >/dev/null || return 1
	if [[ "$(system_state)" != active ]]; then
		# Recovery may observe a published permit before start was requested or completed.
		worker_config_stopped accepted || return 1
		proof worker-config permit "$serving_root" >/dev/null || return 1
		migration_native_guard || return 1
		proof worker-config check "$serving_root" >/dev/null || return 1
		system_systemctl start openclaw-gateway.service || return 1
	else
		proof migration-permit-present "$serving_root" >/dev/null || return 1
	fi
	capture_service_generation system || return 1
	old_pid="$service_pid"; old_generation="$service_generation"
	wait_for_live "$previous_release" "$previous_info" system || return 1
	recheck_generation system "$old_pid" "$old_generation" || return 1
	proof worker-config check "$serving_root" >/dev/null || return 1
	outcome="$(proof worker-config finish "$serving_root")" || return 1
	printf '%s sha=%s action=repair-worker-bootstrap result=%s session-proof=original-pre-maintenance APPROVAL_DELTA=0\n' \
		"$recovery" "$(basename "$previous_release")" "$outcome"
}

recover_worker_config() {
	local phase job token restore_phase restore_value expected_value phase_log live_cancellation cancel_live=0
	local cancellation_params cancellation_response cancellation_result
	phase="$(proof worker-config pending "$serving_root")" || return 1
	[[ "$phase" != none ]] || return 0
	previous_release="$(read_pointer "$current_link")" || return 1
	[[ "$(basename "$previous_release")" == "$(proof journal-field "$journal_file" predecessor.sha)" ]] || return 1
	previous_info="$(proof validate-release "$previous_release" "$(basename "$previous_release")" "$root_uid" sealed)" || return 1
	operator_expected_pid="$(proof journal-field "$journal_file" process.pid)" || return 1
	operator_expected_generation="$(proof journal-field "$journal_file" process.generation)" || return 1
	session_witness="$(proof worker-config witness "$serving_root")" || return 1
	[[ -n "$session_witness" ]] || return 1
	migration_guard="$(proof migration-guard-descriptor "$serving_root")" || return 1
	migration_native_guard || return 1
	assert_policy || return 1
	proof compatibility "$previous_release" "$previous_release" "$state_database" >/dev/null || return 1
	live_cancellation="$(proof worker-config live-cancellation "$serving_root")" || return 1
	if [[ ("$phase" == CONFIG_PREPARED || "$live_cancellation" == yes) && "$(system_state)" == active ]]; then
		capture_generation system || return 1
		if [[ "$service_pid" == "$operator_expected_pid" && "$service_generation" == "$operator_expected_generation" ]]; then
			cancel_live=1
		elif [[ "$phase" == CONFIG_PREPARED ]]; then
			fail 'worker config predecessor changed before cancellation'
			return 1
		fi
	fi
	if ((cancel_live)); then
		# Cancellation intent survives permit/resume crash windows without lending the old lease to a new process.
		recheck_generation system "$operator_expected_pid" "$operator_expected_generation" || return 1
		[[ "$(system_systemctl show openclaw-gateway.service --property=ControlPID --value)" == 0 ]] || return 1
		job="$(system_systemctl show openclaw-gateway.service --property=Job --value)" || return 1
		[[ -z "$job" || "$job" == 0 ]] || return 1
		proof worker-config cancel "$serving_root" >/dev/null || return 1
		proof worker-config permit "$serving_root" >/dev/null || return 1
		suspension_scope=system; suspension_release="$previous_release"
		suspension_pid="$operator_expected_pid"; suspension_generation="$operator_expected_generation"
		cancellation_params="$(proof suspension-lease-params "$(proof journal-field "$journal_file" suspension.id)")" || return 1
		# This journal, not the generic exit trap, owns an interrupted cancellation.
		held_suspension=""
		recheck_generation system "$operator_expected_pid" "$operator_expected_generation" || return 1
		cancellation_response="$(run_gateway "$previous_release" gateway call gateway.suspend.resume --params "$cancellation_params" --json --timeout 30000)" || return 1
		recheck_generation system "$operator_expected_pid" "$operator_expected_generation" || return 1
		cancellation_result="$(printf '%s' "$cancellation_response" | proof worker-config cancellation-result "$serving_root")" || return 1
		printf 'WORKER_CONFIG_CANCELLATION suspension=%s\n' "$cancellation_result" || return 1
	elif [[ "$phase" != CONFIG_VERIFIED && "$phase" != CONFIG_RESTORED ]]; then
		worker_config_stopped || return 1
		# Unknown config drift refuses this operation; native .bak files and SQLite are never restored.
		restore_phase="$(proof worker-config restore "$serving_root")" || return 1
		if [[ "$restore_phase" == CONFIG_RESTORING ]]; then
			token="$(proof journal-field "$journal_file" request)" || return 1
			restore_value="$(proof worker-config expected-value "$serving_root" "$token")" || return 1
			expected_value="$(proof worker-config replacement-value "$serving_root" "$token")" || return 1
			phase_log="$(proof worker-config log-path "$serving_root" "$token")" || return 1
			worker_config_stopped || return 1
			(umask 077; set -o noclobber; run_gateway "$previous_release" config set cloudWorkers.profiles.aws.settings.setup "$restore_value" --strict-json --expect-current-json "$expected_value" \
				>"$phase_log.restore.$$.stdout" 2>"$phase_log.restore.$$.stderr") || { fail 'worker config inverse write failed; native evidence and start fence retained'; return 1; }
			worker_config_stopped || return 1
			[[ "$(proof worker-config restore "$serving_root")" == CONFIG_RESTORED ]] || return 1
		fi
	fi
	finish_worker_config RECOVERED
}

repair_worker_bootstrap() {
	local value_json expected_value payload runtime_gid phase_log
	[[ ! -e "$journal_file" && ! -L "$journal_file" ]] || { fail 'worker config repair refuses an existing activation journal'; return 1; }
	previous_release="$(read_pointer "$current_link")" || return 1
	[[ "$previous_release" == "$releases_root/$operator_expected_sha" ]] || { fail 'worker config expected serving SHA changed'; return 1; }
	previous_info="$(proof validate-release "$previous_release" "$operator_expected_sha" "$root_uid" sealed)" || return 1
	recheck_generation system "$operator_expected_pid" "$operator_expected_generation" || return 1
	assert_protected_identity || return 1
	assert_policy || return 1
	assert_scheduler_owner "$previous_release" || return 1
	proof compatibility "$previous_release" "$previous_release" "$state_database" >/dev/null || return 1
	migration_guard="$(proof migration-guard-descriptor "$serving_root")" || return 1
	migration_native_guard || return 1
	proof migration-permit-present "$serving_root" >/dev/null || return 1
	runtime_gid="$(id -g openclaw)" || return 1
	worker_config_token="$(proof worker-config prepare "$serving_root" "$config_file" "$state_database" \
		"$operator_expected_sha" "$worker_expected_config_hash" "$worker_expected_setup_hash" "$runtime_uid" "$runtime_gid")" || return 1
	value_json="$(proof worker-config replacement-value "$serving_root" "$worker_config_token")" || return 1
	expected_value="$(proof worker-config expected-value "$serving_root" "$worker_config_token")" || return 1
	phase_log="$(proof worker-config log-path "$serving_root" "$worker_config_token")" || return 1
	printf 'WORKER_CONFIG_EVIDENCE=%s\n' "${phase_log%/native-config}" || return 1
	# Only the reviewed credential-free setup leaf enters argv; whole config stays private.
	# The public CLI forbids expectations during dry-run and in batch mode.
	(umask 077; set -o noclobber; run_gateway "$previous_release" config set cloudWorkers.profiles.aws.settings.setup "$value_json" --strict-json --dry-run \
		>"$phase_log.preflight.stdout" 2>"$phase_log.preflight.stderr") || { fail 'worker config dry-run failed; inspect private native-config preflight logs'; return 1; }
	proof worker-config check-prepared "$serving_root" "$worker_config_token" >/dev/null || return 1
	recheck_generation system "$operator_expected_pid" "$operator_expected_generation" || return 1
	suspension_scope=system; suspension_pid="$operator_expected_pid"; suspension_generation="$operator_expected_generation"
	suspension_instance="$(read_process_instance "$previous_release" "$operator_expected_pid")" || return 1
	session_witness="$(proof session-preservation-witness "$previous_release" "$previous_release" "$state_database")" || return 1
	prepare_suspension "$previous_release" || return $?
	check_suspension || return 1
	payload="$(printf '%s' "$session_witness" | "$node_bin" -e '
const fs=require("node:fs"),[pid,generation,instance,id,expiry,state]=process.argv.slice(1);
process.stdout.write(JSON.stringify({process:{pid:Number(pid),generation,instance},suspension:{id,expiresAtMs:Number(expiry),status:state.toLowerCase(),terminalPolicy:"preserve"},witness:JSON.parse(fs.readFileSync(0,"utf8"))}));
' "$operator_expected_pid" "$operator_expected_generation" "$suspension_instance" "$held_suspension" "$suspension_expiry" "$suspension_state")" || return 1
	printf '%s' "$payload" | proof worker-config begin "$serving_root" "$worker_config_token" >/dev/null || return 1
	migration_stop_contract || return 1
	assert_protected_identity || return 1
	assert_policy || return 1
	check_suspension || return 1
	proof worker-config revoke "$serving_root" >/dev/null || return 1
	check_suspension || return 1
	arm_suspension_handoff || return 1
	bounded 180 "$systemctl_bin" stop openclaw-gateway.service || return 1
	held_suspension=""; predecessor_stopped=1
	worker_config_stopped || return 1
	proof worker-config writing "$serving_root" >/dev/null || return 1
	# Full-raw hash binds owner admission, not an external CLI CAS. The CLI owns its snapshot CAS.
	# Its leaf expectation prevents stale-target overwrite; post-write proof refuses unrelated drift.
	proof worker-config check-prepared "$serving_root" "$worker_config_token" >/dev/null || return 1
	(umask 077; set -o noclobber; run_gateway "$previous_release" config set cloudWorkers.profiles.aws.settings.setup "$value_json" --strict-json --expect-current-json "$expected_value" \
		>"$phase_log.write.stdout" 2>"$phase_log.write.stderr") || { fail 'worker config native write failed; private logs and original backup retained'; return 1; }
	worker_config_stopped || return 1
	proof worker-config accept "$serving_root" >/dev/null || return 1
	finish_worker_config SUCCESS
}

check_stopped_recovery() {
	stopped_system_owners || return 1
	migration_guard="$(proof migration-guard-descriptor "$serving_root")" || return 1
	migration_native_guard || return 1
	proof migration-permit-present "$serving_root" >/dev/null || return 1
	assert_protected_identity && assert_policy || return 1
	printf '%s' "$session_witness" | proof session-preservation-verify "$previous_release" "$previous_release" "$state_database" >/dev/null || return 1
	proof recovery-start-writers "$journal_file" "$reconcile_evidence" "$serving_root" "$proc_root" >/dev/null || return 1
	stopped_system_owners
}

recovery_jobs_settled() {
	local controller job
	for controller in system_systemctl user_systemctl; do
		[[ "$("$controller" show openclaw-gateway.service --property=ControlPID --value)" == 0 ]] || return 1
		job="$("$controller" show openclaw-gateway.service --property=Job --value)" || return 1
		[[ -z "$job" || "$job" == 0 ]] || { fail 'recovery Gateway control jobs have not settled'; return 1; }
	done
}

abandon_rehearsal() {
	local evidence snapshot instance admitted_instance retired
	operator_check_lock held
	evidence="$(proof migration-abandon-evidence "$journal_file" "$serving_root" "$abandon_rehearsal_sha")"
	previous_release="$releases_root/$(printf '%s' "$evidence" | "$node_bin" -e 'process.stdout.write(JSON.parse(require("node:fs").readFileSync(0,"utf8")).record.predecessor.sha)')"
	load_gateway_runtime
	capture_generation system
	migration_guard="$(proof migration-guard-descriptor "$serving_root")"
	migration_native_guard
	instance="$(read_process_instance "$previous_release" "$service_pid")"
	snapshot="$(proof migration-abandon-snapshot "$journal_file" "$serving_root" "$abandon_rehearsal_sha" "$$" "$instance" "$evidence")"
	capture_generation system
	migration_native_guard
	admitted_instance="$(read_process_instance "$previous_release" "$service_pid")"
	[[ "$instance" == "$admitted_instance" ]] || fail 'rehearsal abandonment Gateway process instance changed'
	operator_check_lock held
	retired="$(proof migration-abandon "$journal_file" "$serving_root" "$abandon_rehearsal_sha" "$$" "$admitted_instance" "$snapshot")"
	printf 'ABANDONED sha=%s action=abandon-rehearsal restart=0 retained=%s\n' "$abandon_rehearsal_sha" "$retired"
}

recover_journal() {
	local phase predecessor_sha candidate_sha current_sha topology expected_pid expected_generation
	local observed_system observed_user recovery_record evidence recovery_position recovery_release recovery_info recovery_label
	local migration_phase worker_phase missing stopped_snapshot started_restored=0 need_start=0
	local recovery_owned_pid="" recovery_owned_generation=""
	local start_state start_result=0 runtime_reload
	if [[ -n "$reconcile_config_hash" ]]; then
		[[ -e "$journal_file" ]] || return 1
		phase="$(proof journal-field "$journal_file" phase)" || return 1
		[[ "$phase" == ROLLBACK_FAILED || (("$phase" == C_CURRENT_SELECTED || "$phase" == D_VERIFYING) && "$reconcile_stopped" == 0) ]] || {
			fail 'config reconciliation requires a retained failed rollback journal or live prepared C journal'; return 1;
		}
		[[ "$phase" != C_CURRENT_SELECTED || "$(proof gateway-runtime changing "$serving_root")" == no ]] || return 1
	fi
	worker_phase="$(proof worker-config pending "$serving_root")" || return 1
	if ((${accept_partial_nocow:-0})); then
		[[ "$worker_phase" == none && "$(proof migration-status "$journal_file" "$serving_root")" == doctor-started ]] || {
			fail '--accept-partial-nocow is not applicable to this recovery'; return 1;
		}
	fi
	if [[ "$worker_phase" != none ]]; then
		[[ -z "$reconcile_config_hash" ]] || { fail 'config reconciliation refuses a worker config journal'; return 1; }
		recover_worker_config || return $?
		worker_config_recovered=1
		return 0
	fi
	migration_phase="$(proof migration-status "$journal_file" "$serving_root")" || return 1
	if [[ "$migration_phase" != none ]]; then
		if [[ -n "$reconcile_config_hash" ]] || proof journal-field "$journal_file" agentMigration.artifacts.reconciliation >/dev/null 2>&1; then
			recover_live_migration_candidate || return $?
		else
			recover_agent_schema_migration || return $?
		fi
		migration_recovered=1
		return 0
	fi
	migration_check_existing_guard || return 1
	[[ -e "$journal_file" ]] || return 0
	recovery_record="$(proof journal-read "$journal_file")" || {
		fail 'activation journal is ambiguous; pointer and service state were not changed'
		return 1
	}
	session_witness_record="$recovery_record"
	load_journal_witness || return 1
	phase="$(proof journal-field "$journal_file" phase)"
	predecessor_sha="$(proof journal-field "$journal_file" predecessor.sha)"
	candidate_sha="$(proof journal-field "$journal_file" candidate.sha)"
	topology="$(proof journal-field "$journal_file" topology)"
	expected_pid="$(proof journal-field "$journal_file" process.pid)"
	expected_generation="$(proof journal-field "$journal_file" process.generation)"
	suspension_scope="$topology"
	suspension_pid="$expected_pid"
	suspension_generation="$expected_generation"
	previous_release="$releases_root/$predecessor_sha"
	suspension_release="$previous_release"
	candidate_release="$releases_root/$candidate_sha"
	previous_info="$(proof validate-release "$previous_release" "$predecessor_sha" "$root_uid" sealed)"
	candidate_info="$(proof validate-release "$candidate_release" "$candidate_sha" "$root_uid" sealed)"
	protected_identity="$(proof journal-field "$journal_file" protectedPaths)"
	if [[ -z "$reconcile_config_hash" ]]; then assert_protected_identity; fi
	policy_identity="$(proof policy "$config_file")"
	current_sha=absent
	if [[ -L "$current_link" ]]; then
		current_sha="$(basename "$(read_pointer "$current_link")")"
	fi
	if [[ "$(proof gateway-runtime changing "$serving_root")" == yes ]]; then
		# File publication and daemon-reload are separate commits. Reconcile only
		# a journal-authorized command after all earlier manager jobs have settled.
		recovery_jobs_settled || return 1
		runtime_reload="$(system_systemctl show openclaw-gateway.service --property=ExecStart --value | proof gateway-runtime reload-check "$serving_root")" || return 1
		case "$runtime_reload" in
		CACHED) ;;
		RELOAD)
			system_systemctl daemon-reload || return 1
			load_gateway_runtime || return 1
			;;
		*) fail 'runtime recovery returned an unknown manager state'; return 1 ;;
		esac
	fi
	if [[ -n "$reconcile_config_hash" ]]; then
		[[ "$topology" == system && "$candidate_sha" != "$predecessor_sha" && "$current_sha" == "$operator_expected_sha" &&
			(( ("$phase" == ROLLBACK_FAILED || "$phase" == C_CURRENT_SELECTED) && "$current_sha" == "$predecessor_sha") ||
			 ("$phase" == ROLLBACK_FAILED && "$current_sha" == "$candidate_sha" && "$reconcile_stopped" == 0 &&
			  "$(proof gateway-runtime changing "$serving_root")" == no)) ]] || {
			fail 'config reconciliation requires the expected restored predecessor or live selected failed candidate'; return 1;
		}
		if ((reconcile_stopped == 0)); then recheck_generation system "$operator_expected_pid" "$operator_expected_generation" || return 1; fi
		reconcile_request="$("$node_bin" -e 'process.stdout.write(JSON.stringify({config:{path:process.argv[1],sha256:process.argv[2]},journalSha256:process.argv[3],databasePath:process.argv[4],runtimeUid:Number(process.argv[5]),...(process.argv[6]==="1"?{startStopped:true}:{}),...(process.argv[7]==="selected"?{process:{pid:Number(process.argv[8]),generation:process.argv[9]}}:{})}))' \
			"$config_file" "$reconcile_config_hash" "$reconcile_journal_hash" "$state_database" "$runtime_uid" "$reconcile_stopped" \
			"$([[ "$current_sha" == "$candidate_sha" ]] && echo selected || echo restored)" "$operator_expected_pid" "$operator_expected_generation")" || return 1
	fi
	case "$phase" in
	A_PREPARED | B_PREVIOUS_PUBLISHED | C_CURRENT_SELECTED)
		if [[ -n "$reconcile_request" ]]; then
			[[ "$phase" == C_CURRENT_SELECTED && "$session_proof" == original-pre-cutover &&
				! -e "$proc_root/$expected_pid" && ! -L "$proc_root/$expected_pid" ]] || {
				fail 'prepared config reconciliation requires an independently bound replacement predecessor'; return 1;
			}
			recheck_generation system "$operator_expected_pid" "$operator_expected_generation" || return 1
			[[ "$(realpath "$proc_root/$operator_expected_pid/cwd")" == "$previous_release" ]] || return 1
			recover_predecessor "$recovery_record" "$operator_expected_pid" "$operator_expected_generation"
		elif recheck_generation "$topology" "$expected_pid" "$expected_generation"; then
			recover_predecessor "$recovery_record"
		elif [[ "$topology" == system && ("$mode" == recover || "$phase" == C_CURRENT_SELECTED) ]] && predecessor_is_stopped "$expected_pid"; then
			proof recovery-snapshot "$journal_file" "$serving_root" "$recovery_record" >/dev/null || return 1
			# A crash after stop has no successor lease. The exit owner retains
			# the original witness and performs the existing compatibility-checked rollback.
			rollback_armed=1
			predecessor_stopped=1
			if [[ "$mode" == recover ]]; then
				rollback_activation 0 || return $?
				printf 'RECOVERED phase=%s action=restored-stopped-predecessor session-proof=%s\n' "$phase" "$session_proof"
			else
				fail 'prepared activation recovery requires one compatibility-checked stopped rollback'
			fi
		elif [[ "$mode" == recover && "$topology" == system &&
			"$(proof gateway-runtime changing "$serving_root")" == no ]] && capture_generation system &&
			[[ "$(realpath "$proc_root/$service_pid/cwd")" == "$previous_release" ]]; then
			recover_predecessor "$recovery_record" "$service_pid" "$service_generation"
		elif [[ "$phase" == C_CURRENT_SELECTED && "$current_sha" == "$candidate_sha" ]] &&
			assert_exclusive_owner system && wait_for_live "$candidate_release" "$candidate_info" system; then
			verified_markers record "$candidate_sha" || return 1
			proof unlink-exact "$journal_file" "$root_uid" "$session_witness_record"
			printf 'RECOVERED phase=%s action=verified-successor-no-restart session-proof=%s\n' "$phase" "$session_proof"
		else
			fail 'selected-pointer recovery cannot prove either the predecessor or verified successor'
		fi
		;;
	MIGRATION_SWITCHING)
		[[ "$topology" == migration-user ]] || fail 'migration switching topology is invalid'
		observed_system="$(system_state)"
		observed_user="$(user_state)"
		[[ ! ("$observed_system" == active && "$observed_user" == active) ]] ||
			fail 'migration switching recovery found simultaneous Gateway owners'
		if [[ "$observed_system" == active && "$observed_user" != active ]]; then
			[[ "$current_sha" == "$candidate_sha" ]] || fail 'migration successor pointer changed'
			bind_successor_generation || fail 'migration successor durable ownership is ambiguous'
			if wait_for_live "$candidate_release" "$candidate_info" system; then
				proof unlink-exact "$journal_file" "$root_uid" "$session_witness_record"
				printf 'RECOVERED phase=%s action=verified-system-no-restart\n' "$phase"
			else
				rollback_armed=1
				predecessor_stopped=1
				fail 'migration successor verification failed and requires compatibility-checked rollback'
			fi
		elif [[ "$observed_system" == inactive && "$observed_user" == active ]]; then
			recover_predecessor "$recovery_record"
		elif [[ "$observed_system" != active && "$observed_user" != active ]]; then
			[[ "$current_sha" == "$candidate_sha" ]] || fail 'stopped migration pointer changed'
			predecessor_stopped=1
			proof compatibility "$candidate_release" "$previous_release" "$state_database" >/dev/null ||
				fail 'migration predecessor compatibility cannot be proved during switching recovery'
			restore_migration_topology || { fail 'migration switching recovery cannot restore exact predecessor ownership'; return 1; }
			wait_for_live "$previous_release" "$previous_info" migration-user || return 1
			proof unlink-exact "$journal_file" "$root_uid" "$session_witness_record"
			printf 'RECOVERED phase=%s action=restored-user-topology\n' "$phase"
		else
			fail 'migration switching service topology is ambiguous'
		fi
		;;
	D_VERIFYING)
		[[ "$current_sha" == "$candidate_sha" ]] || fail 'verification journal points at an unexpected release'
		# A stopped successor needs absence proof, not a mandatory live lease or RPC.
		if ! predecessor_is_stopped "$expected_pid"; then
			bind_successor_generation || return 1
			if wait_for_live "$candidate_release" "$candidate_info" system; then
				verified_markers record "$candidate_sha" || return 1
				proof unlink-exact "$journal_file" "$root_uid" "$session_witness_record"
				printf 'RECOVERED phase=%s action=verified-no-restart session-proof=%s\n' "$phase" "$session_proof"
				return 0
			fi
		fi
		rollback_armed=1
		predecessor_stopped=1
		fail 'verification recovery failed and requires one compatibility-checked rollback'
		;;
	ROLLBACK_FAILED)
		if [[ "$(proof gateway-runtime changing "$serving_root")" == yes ]]; then
			[[ "$mode" == recover ]] || { fail 'runtime rollback requires --recover'; return 1; }
			if recheck_generation system "$expected_pid" "$expected_generation"; then
				recover_predecessor "$recovery_record"
				return $?
			fi
			if ! predecessor_is_stopped "$expected_pid"; then
				bind_successor_generation || return 1
				if wait_for_live "$candidate_release" "$candidate_info" system; then
					proof unlink-exact "$journal_file" "$root_uid" "$session_witness_record" || return 1
					printf 'RECOVERED phase=ROLLBACK_FAILED action=verified-runtime-no-restart\n'
					return 0
				fi
			fi
			rollback_armed=1; predecessor_stopped=1
			fail 'runtime recovery requires the existing compatibility-checked rollback'
			return 1
		fi
		if [[ "$mode" != recover || "$topology" != system || "$candidate_sha" == "$predecessor_sha" ]]; then
			if [[ "$mode" != recover ]]; then missing='--recover is required';
			elif [[ "$topology" != system ]]; then missing='journal topology must be system';
			else missing='journal candidate and predecessor SHAs must be distinct'; fi
			fail "failed rollback requires explicit recovery of a distinct system release; evidence retained; missing precondition: $missing"
			return 1
		fi
		if [[ "$current_sha" == "$candidate_sha" ]]; then
			recovery_position=selected
			recovery_release="$candidate_release"
			recovery_info="$candidate_info"
			recovery_label="current-candidate"
		elif [[ "$current_sha" == "$predecessor_sha" ]]; then
			recovery_position=restored
			recovery_release="$previous_release"
			recovery_info="$previous_info"
			recovery_label=restored-predecessor
		else
			fail 'failed rollback current pointer matches neither journal release; evidence retained'
			return 1
		fi
		# A bound original is mandatory; only descriptor-less legacy journals use fresh-current proof.
		evidence="$(proof recovery-snapshot "$journal_file" "$serving_root" "$recovery_record" "$recovery_position" "$reconcile_request")" || return 1
		if [[ -n "$reconcile_request" ]]; then
			reconcile_evidence="$evidence"
			reconcile_position="$recovery_position"
			protected_identity="$(proof fingerprint "$config_file" "$state_database")" || return 1
			assert_protected_identity || return 1
		fi
		proof compatibility "$candidate_release" "$recovery_release" "$state_database" >/dev/null || return 1
		proof recovery-check "$journal_file" "$evidence" "$serving_root" "$recovery_position" >/dev/null || return 1
		if ((reconcile_stopped)); then
			start_state="$(proof recovery-start-status "$journal_file" "$evidence" "$serving_root")" || return 1
			if [[ "$start_state" == UNUSED ]]; then
				need_start=1
			else
				recovery_jobs_settled && capture_service_generation system || { fail 'stopped predecessor start is unverified; intent and journal retained; repeat start refused'; return 1; }
			fi
		elif [[ -n "$reconcile_evidence" ]]; then
			capture_generation system || return 1
		elif ! capture_generation system; then
			need_start=1
		fi
		if ((need_start)); then
			if [[ "$recovery_position" != restored || -n "$requested_sha" && "$requested_sha" != "$predecessor_sha" ]]; then
				refuse_verified_recovery "$candidate_sha"
				return 1
			fi
			stopped_snapshot="$(stopped_restored_snapshot "$expected_pid")" || return 1
			migration_guard="$(proof migration-guard-descriptor "$serving_root")" || return 1
			migration_native_guard || return 1
			proof migration-permit-present "$serving_root" >/dev/null || return 1
			proof compatibility "$candidate_release" "$recovery_release" "$state_database" >/dev/null || return 1
			assert_protected_identity || return 1
			assert_policy || return 1
			proof recovery-check "$journal_file" "$evidence" "$serving_root" restored >/dev/null || return 1
			if ((reconcile_stopped)); then
				check_stopped_recovery || return 1
				proof recovery-start-intent "$journal_file" "$evidence" "$serving_root" >/dev/null || return 1
				check_stopped_recovery || return 1
			fi
			migration_native_guard || return 1
			proof migration-permit-present "$serving_root" >/dev/null || return 1
			[[ "$(read_pointer "$current_link")" == "$recovery_release" &&
				"$(stopped_restored_snapshot "$expected_pid")" == "$stopped_snapshot" ]] || {
				fail 'stopped restored Gateway ownership changed before start; journal retained'
				return 1
			}
			rollback_armed=0
			held_suspension=""
			bounded 180 "$systemctl_bin" start openclaw-gateway.service || { start_result=$?; ((reconcile_stopped)) || return "$start_result"; }
			if ((reconcile_stopped)); then
				printf 'RECOVERY_START_REQUEST result=%s repeat-start=refused\n' "$start_result"
				recovery_jobs_settled || return 1
			fi
			started_restored=1
			capture_service_generation system || {
				if ((reconcile_stopped)); then fail 'stopped predecessor start is unverified; intent and journal retained; repeat start refused'; return 1; fi
				fail 'restored predecessor start occurred but generation binding failed; journal retained; no additional start attempted'
				return 1
			}
			[[ "$(realpath "$proc_root/$service_pid/cwd")" == "$recovery_release" ]] || {
				fail 'restored predecessor start occurred but the working release is unexpected; journal retained; no additional start attempted'
				return 1
			}
			recovery_owned_pid="$service_pid"
			recovery_owned_generation="$service_generation"
			suspension_release="$recovery_release"
			suspension_pid="$service_pid"
			suspension_generation="$service_generation"
		fi
		if ((reconcile_stopped)); then operator_expected_pid="$service_pid"; operator_expected_generation="$service_generation"; fi
		if [[ -n "$reconcile_evidence" ]]; then
			[[ "$service_pid" == "$operator_expected_pid" && "$service_generation" == "$operator_expected_generation" ]] || {
				fail 'reviewed reconciliation process generation changed'; return 1;
			}
			recovery_owned_pid="$service_pid"; recovery_owned_generation="$service_generation"
		fi
		expected_pid="$service_pid"
		expected_generation="$service_generation"
		wait_for_live "$recovery_release" "$recovery_info" system "$recovery_owned_pid" "$recovery_owned_generation" || {
			if ((started_restored)); then
				fail 'restored predecessor start occurred but verification failed; journal retained; no additional start attempted'
			else
				fail 'current release verification failed; rollback evidence retained without restart'
			fi
			return 1
		}
		if ((reconcile_stopped)); then recovery_jobs_settled || return 1; fi
		if ! { proof compatibility "$candidate_release" "$recovery_release" "$state_database" >/dev/null &&
			assert_protected_identity && assert_policy &&
			proof recovery-check "$journal_file" "$evidence" "$serving_root" "$recovery_position" >/dev/null &&
			recheck_generation system "$expected_pid" "$expected_generation"; }; then
			if ((started_restored)); then
				fail 'restored predecessor start occurred but final verification failed; journal retained; no additional start attempted'
			fi
			return 1
		fi
		proof recovery-finish "$journal_file" "$evidence" "$serving_root" "$recovery_position" >/dev/null || return 1
		if [[ -n "$reconcile_evidence" ]]; then
			printf 'RECOVERY_CONFIG_RECONCILED config_sha256=%s journal_sha256=%s original-journal=retired-without-rewrite\n' "$reconcile_config_hash" "$reconcile_journal_hash"
		fi
		if ((started_restored)); then
			printf 'RECOVERED phase=ROLLBACK_FAILED action=started-restored-predecessor session-proof=%s\n' "$session_proof"
		elif [[ -n "$reconcile_evidence" && "$recovery_position" == selected ]]; then
			printf 'RECOVERED phase=ROLLBACK_FAILED action=verified-selected-candidate-reconciled-config session-proof=%s\n' "$session_proof"
		else
			printf 'RECOVERED phase=ROLLBACK_FAILED action=verified-%s-no-restart session-proof=%s\n' "$recovery_label" "$session_proof"
		fi
		;;
	*) fail 'activation journal has an unknown durable phase' ;;
	esac
}

freeze_origin_main() {
	local remote_url
	[[ -d "$mirror" && ! -L "$mirror" ]] || fail 'isolated deploy-account mirror has not been installed'
	remote_url="$(bounded_build "$fetch_budget" git -C "$mirror" remote get-url origin)" || return 1
	[[ "$remote_url" == "$official_origin" ]] || fail 'deploy-account mirror origin is not official'
	proof release-capacity fetch "$mirror" "$mirror" "$build_home" "$serving_root" "$runtime_home" >&2 || return 1
	bounded_build "$fetch_budget" git "${mirror_git_config[@]}" -C "$mirror" fetch --prune origin \
		+refs/heads/main:refs/remotes/origin/main +refs/heads/main:refs/heads/main
	frozen_main="$(run_build git -C "$mirror" rev-parse refs/remotes/origin/main)"
	[[ "$frozen_main" =~ ^[a-f0-9]{40}$ ]] || fail 'frozen official origin/main is not an exact SHA'
}

prepare_release() {
	local timer enabled active prepared_info
	[[ ! -e "$journal_file" && ! -L "$journal_file" ]] || fail 'release preparation refuses a pending activation journal'
	for timer in openclaw-hourly-update.timer openclaw-nightly-update.timer; do
		enabled="$(system_systemctl is-enabled "$timer" 2>/dev/null || true)"
		active="$(system_systemctl is-active "$timer" 2>/dev/null || true)"
		[[ ("$enabled" == disabled || "$enabled" == not-found) && "$active" == inactive ]] ||
			fail 'release preparation requires disabled inactive deployment timers'
	done
	# Both existing owners require ordinary errexit context, never an OR-list caller.
	freeze_origin_main
	bounded_build "$fetch_budget" git -C "$mirror" merge-base --is-ancestor "$requested_sha" "$frozen_main" ||
		fail 'prepared SHA is not in the verified official main history'
	if [[ -e "$releases_root/$requested_sha" ]]; then
		# An already sealed release needs validation, never resealing or activation.
		prepared_info="$(proof validate-release "$releases_root/$requested_sha" "$requested_sha" "$root_uid" sealed)" || return 1
	else
		prepared_info="$(publish_release "$requested_sha" "$mirror")"
	fi
	[[ ! -e "$journal_file" && ! -L "$journal_file" ]] || fail 'activation journal appeared during release preparation'
	printf 'PREPARED sha=%s action=prepare-release restart=0 activation=0\n' "$requested_sha"
	printf '%s\n' "$prepared_info"
}

assert_frozen_predecessor() {
	[[ -n "$frozen_target_sha" ]] || return 0
	local instance="${1:-}" observed timer enabled active
	operator_check_lock held || return 1
	proof maintenance-idle "$ancestor_boundary" >/dev/null || return 1
	for timer in openclaw-hourly-update.timer openclaw-nightly-update.timer; do
		enabled="$(system_systemctl is-enabled "$timer" 2>/dev/null || true)"
		active="$(system_systemctl is-active "$timer" 2>/dev/null || true)"
		[[ ("$enabled" == disabled || "$enabled" == not-found) && "$active" == inactive ]] || {
			fail 'frozen continuation requires disabled inactive deployment timers'; return 1;
		}
	done
	observed="$(proof validate-frozen-release "$candidate_release" "$frozen_target_sha" "$frozen_manifest_sha" "$root_uid")" || return 1
	[[ "$observed" == "$frozen_release_binding" ]] || { fail 'frozen release identity changed after admission'; return 1; }
	[[ "$(read_pointer "$current_link")" == "$releases_root/$frozen_predecessor_sha" ]] || {
		fail 'frozen continuation predecessor changed'; return 1;
	}
	recheck_generation system "$frozen_predecessor_pid" "$frozen_predecessor_start" || return 1
	if [[ -z "$instance" ]]; then
		instance="$(read_process_instance "$previous_release" "$frozen_predecessor_pid")" || return 1
	fi
	[[ "$instance" == "$frozen_process_instance" ]] || { fail 'frozen continuation process instance changed'; return 1; }
	recheck_generation system "$frozen_predecessor_pid" "$frozen_predecessor_start" || return 1
	proof gateway-runtime process "$serving_root" "$gateway_runtime_snapshot" "$proc_root" "$frozen_predecessor_pid" >/dev/null || return 1
	observed="$(proof validate-frozen-release "$candidate_release" "$frozen_target_sha" "$frozen_manifest_sha" "$root_uid")" || return 1
	[[ "$observed" == "$frozen_release_binding" ]] || { fail 'frozen release identity changed after admission'; return 1; }
	[[ "$(read_pointer "$current_link")" == "$previous_release" ]] || return 1
	assert_protected_identity || return 1
	assert_policy
}

continue_frozen_release() {
	operator_check_lock held
	[[ ! -e "$journal_file" && ! -L "$journal_file" ]] || fail 'frozen continuation refuses a pending journal; use its existing recovery owner'
	assert_protected_identity
	assert_policy
	previous_release="$(read_pointer "$current_link")"
	[[ "$previous_release" == "$releases_root/$frozen_predecessor_sha" ]] || fail 'frozen continuation predecessor changed'
	previous_info="$(proof validate-release "$previous_release" "$frozen_predecessor_sha" "$root_uid" sealed)"
	candidate_release="$releases_root/$frozen_target_sha"
	frozen_release_binding="$(proof validate-frozen-release "$candidate_release" "$frozen_target_sha" "$frozen_manifest_sha" "$root_uid")"
	candidate_info="$(printf '%s' "$frozen_release_binding" | "$node_bin" -e 'let s="";process.stdin.on("data",x=>s+=x);process.stdin.on("end",()=>process.stdout.write(JSON.stringify(JSON.parse(s).release)));')"
	recheck_generation system "$frozen_predecessor_pid" "$frozen_predecessor_start"
	frozen_process_instance="$(read_process_instance "$previous_release" "$frozen_predecessor_pid")"
	assert_frozen_predecessor "$frozen_process_instance"
	assert_scheduler_owner "$previous_release"
	freeze_origin_main
	bounded_build "$fetch_budget" git -C "$mirror" merge-base --is-ancestor "$frozen_target_sha" "$frozen_main" ||
		fail 'frozen candidate is not in current official main history'
	bounded_build "$fetch_budget" git -C "$mirror" merge-base --is-ancestor "$frozen_predecessor_sha" "$frozen_target_sha" ||
		fail 'frozen candidate is not a successor of the expected predecessor'
	assert_frozen_predecessor
	[[ ! -e "$journal_file" && ! -L "$journal_file" ]] || fail 'activation journal appeared during frozen admission'
	activate_prepared_release
}

activate_prepared_release() {
	migration_kind="$(proof migration-kind "$previous_info" "$candidate_info" "$config_file")"
	if ((offline_doctor_repair)); then
		if [[ "$migration_kind" == none ]]; then migration_kind=offline-doctor; fi
	fi
	if [[ -n "$frozen_target_sha" && "$migration_kind" != none && "$migration_kind" != state-17-18 && "$migration_kind" != state-18-19 && "$migration_kind" != state-19-20 && "$migration_kind" != agent-23-24 && "$migration_kind" != agent-24-25 && "$migration_kind" != offline-doctor ]]; then
		fail 'frozen continuation requires unchanged schemas or a qualified state17/agent23 to18/23, state18/agent23 to19/23, state19/agent23 to19/24, state19/agent24 to20/24, or state20/agent24 to20/25 edge'
	fi
	# The selector supplies facts. The existing deployment owner creates the journal
	# and retains its normal suspension, Doctor and forward-recovery responsibilities.
	if [[ "$mode" == continue-frozen ]]; then mode=deploy; fi
	if [[ "$migration_kind" != none ]]; then
		((capture_startup_profile + arm_steady_profile == 0)) || fail 'startup profiling cannot accompany a storage or configuration migration'
		activate_agent_schema_migration
	else
		activate_release system
	fi
}

snapshot_for_rehearsal() {
	local release
	[[ ! -e "$journal_file" && ! -L "$journal_file" ]] || fail 'rehearsal snapshot refuses a pending activation journal'
	release="$(read_pointer "$current_link")" || return 1
	bounded "${OPENCLAW_TEAM_SNAPSHOT_BUDGET:-7200}" "$node_bin" --no-warnings "$release_lib" snapshot-for-rehearsal \
		"$serving_root" "$release" "$config_file" "$state_database" "$rehearsal_snapshot_label"
	[[ ! -e "$journal_file" && ! -L "$journal_file" && "$(read_pointer "$current_link")" == "$release" ]] ||
		fail 'serving release or activation state changed during rehearsal snapshot'
}

handoff_source() {
	local phase admission running_containers schedule_snapshot timer maintenance_state
	phase="$(proof host-handoff status "$serving_root")"
	previous_release="$(read_pointer "$current_link")"
	[[ "$previous_release" == "$releases_root/$operator_expected_sha" ]] || fail 'handoff source SHA changed'
	previous_info="$(proof validate-release "$previous_release" "$operator_expected_sha" "$root_uid" sealed)"
	if [[ "$phase" != none ]]; then
		phase="$(proof host-handoff source-check "$serving_root" "$operator_expected_sha" "$operator_expected_pid" \
			"$operator_expected_generation" "$handoff_peer" "$handoff_target_sha")"
	fi
	assert_protected_identity
	assert_policy
	migration_guard="$(proof migration-guard-descriptor "$serving_root")"
	migration_native_guard
	if [[ "$phase" == none || "$phase" == SOURCE_PREPARED ]]; then
		if [[ "$phase" == SOURCE_PREPARED ]] && predecessor_is_stopped "$operator_expected_pid" &&
			proof migration-permit-absent "$serving_root" >/dev/null; then
			proof host-handoff source-stopped "$serving_root" >/dev/null
		else
			recheck_generation system "$operator_expected_pid" "$operator_expected_generation"
			[[ "$(realpath "$proc_root/$operator_expected_pid/cwd")" == "$previous_release" ]] || fail 'handoff source process is not the selected release'
			assert_scheduler_owner "$previous_release"
			suspension_scope=system; suspension_release="$previous_release"
			suspension_pid="$operator_expected_pid"; suspension_generation="$operator_expected_generation"
			suspension_instance="$(read_process_instance "$previous_release" "$operator_expected_pid")"
			prepare_suspension "$previous_release"
			check_suspension
			schedule_snapshot="$(for timer in openclaw-hourly-health-check.timer openclaw-disk-maintenance.timer; do
				printf '%s\n' "$timer"
				system_systemctl show "$timer" --property=UnitFileState --property=ActiveState --property=SubState --property=LastTriggerUSec --property=NextElapseUSecRealtime || exit 1
			done)"
			admission="$(SOURCE="$previous_info" PID="$suspension_pid" GENERATION="$suspension_generation" INSTANCE="$suspension_instance" \
				LEASE="$held_suspension" EXPIRY="$suspension_expiry" LEASE_STATE="$suspension_state" SCHEDULES="$schedule_snapshot" "$node_bin" -e '
const e=process.env,schedules={};let name;for(const line of e.SCHEDULES.split("\n")){const i=line.indexOf("=");if(i<0){name=line;schedules[name]={};}else schedules[name][line.slice(0,i)]=line.slice(i+1);}
process.stdout.write(JSON.stringify({source:JSON.parse(e.SOURCE),process:{pid:Number(e.PID),generation:e.GENERATION,instance:e.INSTANCE},suspension:{id:e.LEASE,expiresAtMs:Number(e.EXPIRY),status:e.LEASE_STATE.toLowerCase(),terminalPolicy:"preserve"},schedules}));')"
			if [[ "$phase" == none ]]; then
				printf '%s' "$admission" | proof host-handoff source-begin "$serving_root" "$handoff_peer" "$handoff_target_sha" "$config_file" "$state_database" @stdin >/dev/null
			else
				printf '%s' "$admission" | proof host-handoff source-suspension "$serving_root" @stdin >/dev/null
			fi
			migration_stop_contract
			assert_protected_identity
			assert_policy
			check_suspension
			arm_suspension_handoff
			proof host-handoff source-revoke "$serving_root" >/dev/null
			check_suspension
			[[ "$(realpath "$proc_root/$operator_expected_pid/cwd")" == "$previous_release" ]] || fail 'handoff source cwd changed before stop'
			bounded 180 "$systemctl_bin" stop openclaw-gateway.service
			held_suspension=""; predecessor_stopped=1
			predecessor_is_stopped "$operator_expected_pid"
			proof host-handoff source-stopped "$serving_root" >/dev/null
		fi
	fi
	predecessor_is_stopped "$operator_expected_pid"
	if ((handoff_stop_only)); then
		printf 'HANDOFF_STOPPED sha=%s source-start-permit=absent external-writers=must-settle-before-export\n' "$operator_expected_sha"
		return 0
	fi
	for timer in openclaw-hourly-health-check.timer openclaw-disk-maintenance.timer; do
		[[ "$(system_systemctl is-enabled "$timer" 2>/dev/null || true)" == disabled &&
			"$(system_systemctl is-active "$timer" 2>/dev/null || true)" == inactive ]] ||
			fail 'source health and disk-maintenance timers must be retired before final export'
		maintenance_state="$(system_systemctl show "${timer%.timer}.service" --property=ActiveState --property=MainPID --property=ControlPID --property=Job)"
		MAINTENANCE_STATE="$maintenance_state" "$node_bin" -e '
const s=Object.fromEntries(process.env.MAINTENANCE_STATE.trim().split("\n").map(line=>{const i=line.indexOf("=");return[line.slice(0,i),line.slice(i+1)]}));
if(!["inactive","failed"].includes(s.ActiveState)||s.MainPID!=="0"||s.ControlPID!=="0"||!["","0"].includes(s.Job))process.exit(1);
' || fail 'source maintenance service has not settled before final export'
	done
	if [[ -x /usr/bin/podman ]]; then
		running_containers="$(cd "$runtime_home" && run_runtime /usr/bin/podman --remote=false ps --format '{{.ID}}')"
		[[ -z "$running_containers" ]] || fail 'running rootless Podman containers must settle through their owner before handoff export'
	fi
	proof host-handoff source-export "$serving_root"
	if [[ -x /usr/bin/podman ]]; then
		running_containers="$(cd "$runtime_home" && run_runtime /usr/bin/podman --remote=false ps --format '{{.ID}}')"
		[[ -z "$running_containers" ]] || fail 'a rootless Podman writer appeared during export; settle it before final filesystem transfer'
	fi
	printf 'HANDOFF_EXPORTED sha=%s target=%s source-start-permit=absent source-journal=retained\n' "$operator_expected_sha" "$handoff_target_sha"
}

handoff_target_stopped() {
	local system_json manager_json user_json
	system_json="$(system_systemctl show openclaw-gateway.service --property=ActiveState --property=SubState --property=MainPID --property=ControlPID --property=Job --property=UnitFileState)"
	manager_json="$(system_systemctl show "user@$runtime_uid.service" --property=ActiveState --property=MainPID --property=ControlPID --property=Job)"
	user_json=""
	if [[ "$manager_json" == *'ActiveState=active'* ]]; then
		user_json="$(user_systemctl show openclaw-gateway.service --property=ActiveState --property=MainPID --property=ControlPID --property=Job --property=UnitFileState)"
	fi
	SYSTEM_SNAPSHOT="$system_json" MANAGER_SNAPSHOT="$manager_json" USER_SNAPSHOT="$user_json" "$node_bin" -e '
const parse=text=>Object.fromEntries(text.trim().split("\n").map(line=>{const i=line.indexOf("=");return[line.slice(0,i),line.slice(i+1)]}));
const stopped=x=>["inactive","failed"].includes(x.ActiveState)&&x.MainPID==="0"&&x.ControlPID==="0"&&["","0"].includes(x.Job);
const s=parse(process.env.SYSTEM_SNAPSHOT),m=parse(process.env.MANAGER_SNAPSHOT),u=parse(process.env.USER_SNAPSHOT);
if(!stopped(s)||!["disabled","enabled"].includes(s.UnitFileState))process.exit(1);
if(m.ActiveState==="active"){if(!stopped(u)||!["disabled","not-found"].includes(u.UnitFileState))process.exit(1);}else if(!stopped(m))process.exit(1);
'
	[[ -z "$("$ss_bin" -H -ltnp "sport = :$gateway_port")" ]] || fail 'target Gateway listener is already owned'
	migration_guard="$(proof migration-guard-descriptor "$serving_root")"
	migration_native_guard
}

handoff_select_target() {
	local pointer
	previous_release="$releases_root/$(proof journal-field "$journal_file" predecessor.sha)"
	candidate_release="$releases_root/$(proof journal-field "$journal_file" candidate.sha)"
	# The imported journal precedes both names; previous is always published first.
	for pointer in "$previous_link" "$current_link"; do
		proof host-handoff target-selection "$serving_root" prefix >/dev/null
		if [[ ! -e "$pointer" && ! -L "$pointer" ]]; then
			if [[ "$pointer" == "$previous_link" ]]; then atomic_pointer "$previous_release" "$pointer"
			else atomic_pointer "$candidate_release" "$pointer"; fi
		fi
	done
	# A retry can observe a rename that completed before its original directory fsync.
	proof sync-directory "$serving_root" >/dev/null
	proof host-handoff target-selection "$serving_root" complete >/dev/null
}

handoff_target() {
	local phase
	phase="$(proof host-handoff status "$serving_root")"
	if [[ "$mode" == handoff-import ]]; then
		handoff_target_stopped
		proof migration-permit-absent "$serving_root" >/dev/null
		proof host-handoff target-import "$serving_root" "$handoff_manifest" "$handoff_manifest_hash"
		handoff_select_target
		printf 'HANDOFF_IMPORTED next=native-doctor candidate-selected=true start-permit=absent\n'
		return 0
	fi
	[[ "$phase" == TARGET_* ]] || fail 'target handoff has no imported source journal'
	previous_release="$releases_root/$(proof journal-field "$journal_file" predecessor.sha)"
	candidate_release="$releases_root/$(proof journal-field "$journal_file" candidate.sha)"
	candidate_info="$(proof validate-release "$candidate_release" "$(basename "$candidate_release")" "$root_uid" sealed)"
	if [[ "$mode" == handoff-doctor ]]; then
		handoff_target_stopped
		proof migration-permit-absent "$serving_root" >/dev/null
		proof host-handoff target-doctor "$serving_root"
		printf 'HANDOFF_DOCTOR_VERIFIED next=native-worktree-relocation-and-approved-config\n'
		return 0
	fi
	if [[ "$phase" != TARGET_VERIFYING ]]; then
		handoff_target_stopped
		proof host-handoff target-selection "$serving_root" complete >/dev/null
		proof host-handoff target-ready "$serving_root" "$handoff_config_hash" >/dev/null
	fi
	if [[ "$(system_state)" != active ]]; then
		handoff_target_stopped
		proof host-handoff target-permit "$serving_root" >/dev/null
		system_systemctl enable openclaw-gateway.service
		bounded 180 "$systemctl_bin" start openclaw-gateway.service
	fi
	[[ "$(read_pointer "$current_link")" == "$candidate_release" ]] || fail 'target serving pointer changed'
	protected_identity="$(proof fingerprint "$config_file" "$state_database")"
	policy_identity="$(proof policy "$config_file")"
	session_witness="$(proof host-handoff target-witness "$serving_root")"
	wait_for_live "$candidate_release" "$candidate_info" system
	verified_markers record "$(basename "$candidate_release")"
	proof host-handoff target-finish "$serving_root" >/dev/null
	printf 'SUCCESS sha=%s action=host-handoff previous=%s source-writer=fenced APPROVAL_DELTA=0\n' "$(basename "$candidate_release")" "$(basename "$previous_release")"
}

clean_candidate() {
	local pathname="$1" parent="$2" owner="$3" group="$4" binding="$5" device inode
	read -r device inode <<<"$binding"
	bounded 120 "$node_bin" --no-warnings "$release_lib" clean-candidate \
		"$pathname" "$parent" "$owner" "$group" "$device" "$inode" >/dev/null
}

cleanup_candidate_failure() {
	local exit_code="$1"
	trap - EXIT
	if [[ -n "${candidate_staging_identity:-}" && -e "$candidate_staging_path" ]]; then
		clean_candidate "$candidate_staging_path" "$serving_root/staging" "$root_uid" "$root_gid" "$candidate_staging_identity" || exit_code=1
	fi
	if [[ -n "${candidate_build_identity:-}" && -e "$candidate_build_path" ]]; then
		clean_candidate "$candidate_build_path" "$work_root" "$deploy_file_uid" "$deploy_gid" "$candidate_build_identity" || exit_code=1
	fi
	if [[ -n "${candidate_cache_identity:-}" && -e "$candidate_cache_path" ]]; then
		clean_candidate "$candidate_cache_path" "$build_home/cache" "$deploy_file_uid" "$deploy_gid" "$candidate_cache_identity" || exit_code=1
	fi
	exit "$exit_code"
}

publish_release() (
	set -Eeuo pipefail
	local target_sha="$1" reference_release="$2"
	local build_directory="$work_root/$target_sha.$$" staging="$serving_root/staging/$target_sha.$$"
	local published="$releases_root/$target_sha" origin_after published_info
	candidate_build_path="$build_directory"
	candidate_staging_path="$staging"
	candidate_cache_path="$build_home/cache/$target_sha.$$"
	candidate_build_identity=""
	candidate_staging_identity=""
	candidate_cache_identity=""
	if [[ -e "$published" ]]; then
		published_info="$(proof validate-release "$published" "$target_sha" "$root_uid" sealed)"
		proof release-capacity activate "$published" "$mirror" "$build_home" "$serving_root" "$runtime_home" >&2
		bounded 120 "$node_bin" --no-warnings "$release_lib" seal-tree "$published"
		printf '%s\n' "$published_info"
		return 0
	fi
	[[ ! -e "$build_directory" && ! -e "$staging" && ! -e "$candidate_cache_path" && ! -L "$candidate_cache_path" ]] || fail 'candidate path already exists'
	proof release-capacity build "$reference_release" "$mirror" "$build_home" "$serving_root" "$runtime_home" >&2
	trap 'cleanup_candidate_failure "$?"' EXIT
	run_build mkdir -m 0700 -- "$build_directory"
	candidate_build_identity="$(proof stat-identity "$build_directory")"
	run_build mkdir -m 0700 -- "$candidate_cache_path"
	candidate_cache_identity="$(proof stat-identity "$candidate_cache_path")"
	local cache_environment=(env "PNPM_CONFIG_STORE_DIR=$candidate_cache_path/store" "PNPM_HOME=$candidate_cache_path/pnpm" "XDG_CACHE_HOME=$candidate_cache_path/metadata")
	bounded_build "$clone_budget" git "${mirror_git_config[@]}" clone --no-local --no-hardlinks --no-checkout \
		"file://$mirror" "$build_directory" >&2
	bounded_build "$clone_budget" git "${mirror_git_config[@]}" -C "$build_directory" checkout --detach "$target_sha" >&2
	run_build git -C "$build_directory" remote set-url origin "$official_origin" >&2
	origin_after="$(run_build git -C "$build_directory" remote get-url origin)"
	[[ "$origin_after" == "$official_origin" &&
		"$(run_build git -C "$build_directory" rev-parse HEAD)" == "$target_sha" &&
		-d "$build_directory/.git" && ! -L "$build_directory/.git" &&
		! -e "$build_directory/.git/objects/info/alternates" ]] ||
		fail 'candidate is not a standalone clone of the frozen official SHA'
	bounded_build "$build_budget" "${cache_environment[@]}" pnpm -C "$build_directory" install --frozen-lockfile >&2
	bounded_build "$build_budget" "${cache_environment[@]}" env NODE_OPTIONS=--max-old-space-size=24576 \
		pnpm -C "$build_directory" build >&2
	proof validate-release "$build_directory" "$target_sha" "$root_uid" candidate >/dev/null
	# Every runtime symlink is release-local; installed hardlinks/reflinks survive cache unlink.
	clean_candidate "$candidate_cache_path" "$build_home/cache" "$deploy_file_uid" "$deploy_gid" "$candidate_cache_identity"
	candidate_cache_identity=""
	proof release-capacity stage "$build_directory" "$mirror" "$build_home" "$serving_root" "$runtime_home" >&2
	install -d -m 0700 "$staging"
	candidate_staging_identity="$(proof stat-identity "$staging")"
	cp -a "$build_directory/." "$staging"
	chown -hR "$root_uid:$root_uid" "$staging"
	proof manifest "$staging" "$target_sha" "$root_uid" "$frozen_main" >/dev/null
	bounded 120 "$node_bin" --no-warnings "$release_lib" seal-tree "$staging"
	proof validate-release "$staging" "$target_sha" "$root_uid" sealed >/dev/null
	[[ "$(proof stat-identity "$staging" | cut -d' ' -f1)" == "$(proof stat-identity "$releases_root" | cut -d' ' -f1)" ]] ||
		fail 'candidate publication crosses filesystem devices'
	mv -T "$staging" "$published"
	candidate_staging_identity=""
	proof sync-directory "$releases_root"
	published_info="$(proof validate-release "$published" "$target_sha" "$root_uid" sealed)"
	clean_candidate "$candidate_build_path" "$work_root" "$deploy_file_uid" "$deploy_gid" "$candidate_build_identity"
	candidate_build_identity=""
	trap - EXIT
	proof release-capacity activate "$published" "$mirror" "$build_home" "$serving_root" "$runtime_home" >&2
	printf '%s\n' "$published_info"
)

cleanup_releases() {
	local current_sha previous_sha protected_sha field directory sha identity device inode quarantine quarantine_name extra
	local verified_shas verified_count=0 release_device
	local selected_sha="${1:-}"
	local -a directories protected
	current_sha="$(read_pointer "$current_link")" || return 1
	current_sha="$(basename "$current_sha")"
	previous_sha=""
	if [[ -L "$previous_link" ]]; then
		previous_sha="$(read_pointer "$previous_link")" || return 1
		previous_sha="$(basename "$previous_sha")"
	fi
	protected=("$current_sha" "$previous_sha" "$selected_sha")
	verified_shas="$(verified_markers list)" || return 1
	while IFS= read -r protected_sha; do
		[[ -n "$protected_sha" ]] || continue
		protected+=("$protected_sha")
		verified_count=$((verified_count + 1))
		((verified_count < 3)) || break
	done <<<"$verified_shas"
	if [[ -e "$journal_file" ]]; then
		# Original pointer targets are needed to restore topology after an interrupted cutover.
		for field in predecessor.sha candidate.sha pointerTopology.current.sha pointerTopology.previous.sha; do
			protected_sha="$(proof journal-field "$journal_file" "$field")" || return 1
			[[ "$protected_sha" == null ]] || protected+=("$protected_sha")
		done
	fi
	for quarantine in "$serving_root/quarantine"/*; do
		[[ -e "$quarantine" ]] || continue
		quarantine_name="$(basename "$quarantine")"
		IFS=. read -r sha device inode extra <<<"$quarantine_name"
		[[ "$sha" =~ ^[a-f0-9]{40}$ && "$device" =~ ^[0-9]+$ &&
			"$inode" =~ ^[0-9]+$ && -z "$extra" ]] || continue
		[[ " ${protected[*]} " != *" $sha "* &&
			! -e "$serving_root/pins/$sha" ]] || continue
		if [[ "$(proof prune-quarantine "$quarantine" "$serving_root" "$root_uid" "$device" "$inode")" == PRUNED ]]; then
			printf 'PRUNED_RELEASE=%s\n' "$sha"
		fi
	done
	directories=()
	while IFS= read -r directory; do
		[[ -n "$directory" ]] && directories+=("$directory")
	done < <(proof list-releases "$releases_root")
	identity="$(proof stat-identity "$releases_root")" || return 1
	read -r release_device inode <<<"$identity"
	for directory in "${directories[@]}"; do
		sha="$(basename "$directory")"
		[[ "$sha" =~ ^[a-f0-9]{40}$ ]] || continue
		[[ " ${protected[*]} " != *" $sha "* &&
			! -e "$serving_root/pins/$sha" ]] || continue
		# Failure markers do not pin trees; retain mounted diagnostics before scanning.
		identity="$(proof stat-identity "$directory")" || continue
		read -r device inode <<<"$identity"
		if [[ "$device" != "$release_device" ]]; then
			printf 'RETAIN different-filesystem release=%s\n' "$sha" >&2
			continue
		fi
		if ! proof validate-release "$directory" "$sha" "$root_uid" sealed >/dev/null 2>&1; then
			printf 'RETAIN uncertain release=%s\n' "$sha" >&2
			continue
		fi
		quarantine="$serving_root/quarantine/$sha.$device.$inode"
		if proof quarantine "$directory" "$quarantine" "$root_uid" "$device" "$inode" >/dev/null; then
			if [[ "$(proof prune-quarantine "$quarantine" "$serving_root" "$root_uid" "$device" "$inode")" == PRUNED ]]; then
				printf 'PRUNED_RELEASE=%s\n' "$sha"
			else
				printf 'QUARANTINED_RELEASE=%s\n' "$sha"
			fi
		else
			printf 'RETAIN replacement-safe quarantine refused release=%s\n' "$sha" >&2
		fi
	done
	# A release removed in this pass must not leave a stale verification claim.
	verified_markers list >/dev/null
}

activate_release() {
	local topology="$1" old_pid old_generation old_instance suspension_result predecessor_sha candidate_sha
	local prepare_profile=0
	local prior_current_sha=absent prior_previous_sha=absent
	local prior_system_enabled prior_system_active prior_user_enabled prior_user_active
	predecessor_sha="$(basename "$previous_release")"
	candidate_sha="$(basename "$candidate_release")"
	capture_generation "$topology"
	old_pid="$service_pid"
	old_generation="$service_generation"
	suspension_scope="$topology"
	suspension_pid="$old_pid"
	suspension_generation="$old_generation"
	prior_system_enabled="$(system_unit_state)"
	prior_system_active="$(system_state)"
	prior_user_enabled="$(user_unit_state)"
	prior_user_active="$(user_state)"
	assert_protected_identity
	assert_policy
	assert_scheduler_owner "$previous_release"
	run_gateway "$candidate_release" config validate >/dev/null
	session_witness="$(proof session-preservation-witness "$previous_release" "$candidate_release" "$state_database")"
	# Bind before suspension fences ordinary RPCs; frozen continuation must keep
	# its admitted predecessor through the ordinary activation owner.
	old_instance="$(read_process_instance "$previous_release" "$old_pid")"
	assert_frozen_predecessor "$old_instance"
	suspension_instance="$old_instance"
	if prepare_suspension "$previous_release"; then
		:
	else
		suspension_result=$?
		return "$suspension_result"
	fi
	if ! check_suspension; then
		printf 'DEFERRED preserved Gateway suspension changed before activation\n'
		return 75
	fi
	assert_protected_identity
	assert_policy
	proof compatibility "$previous_release" "$candidate_release" "$state_database" >/dev/null
	assert_frozen_predecessor "$old_instance"
	if ! check_suspension; then
		printf 'DEFERRED preserved Gateway suspension expired during compatibility proof\n'
		return 75
	fi
	if [[ -L "$current_link" ]]; then
		prior_current_sha="$(basename "$(read_pointer "$current_link")")"
		[[ "$prior_current_sha" == "$predecessor_sha" ]] ||
			fail 'current release changed before journal publication'
	fi
	if [[ -L "$previous_link" ]]; then
		prior_previous_sha="$(basename "$(read_pointer "$previous_link")")"
	fi
	set -- "$journal_file" "$previous_info" "$candidate_info" "$topology" \
		"$old_pid" "$old_generation" "$old_instance" "$protected_identity" \
		"$prior_current_sha" "$prior_previous_sha" \
		"$prior_system_enabled" "$prior_system_active" "$prior_user_enabled" "$prior_user_active" \
		"$held_suspension" "$suspension_expiry" "$suspension_state"
	if [[ "$topology" == system ]]; then
		printf '%s' "$session_witness" | proof journal-create "$@" @stdin "$runtime_target" >/dev/null
	else
		proof journal-create "$@" >/dev/null
	fi
	session_witness_record="$(proof journal-read "$journal_file")"
	load_journal_witness
	if [[ "$mode" != runtime ]]; then atomic_pointer "$previous_release" "$previous_link"; fi
	proof journal-phase "$journal_file" B_PREVIOUS_PUBLISHED "$session_witness_record" >/dev/null
	if ((capture_startup_profile || arm_steady_profile)); then
		[[ "$topology" == system ]] || fail 'startup profiling requires an ordinary system deployment'
		migration_check_existing_guard
		if profile_inspect; then
			prepare_profile=1
		elif ((arm_steady_profile)); then
			profile_skip_no_effect || return $?
		else
			return 1
		fi
	fi
	if [[ "$topology" == system && "$mode" != runtime ]]; then
		assert_stop_start_contract || return 1
		if ! assert_frozen_predecessor "$old_instance" || ! assert_protected_identity || ! assert_policy || ! check_suspension || ! arm_suspension_handoff; then
			printf 'DEFERRED owned suspension or predecessor changed before system stop\n'
			return 75
		fi
		# Publishing current while this process lives can trigger its installation-replacement restart.
		rollback_armed=1
		if ! system_systemctl stop openclaw-gateway.service; then
			restart_failed=1
			if predecessor_is_stopped "$old_pid"; then
				predecessor_stopped=1
				held_suspension=""
			fi
			fail 'system stop failed; retaining exact predecessor ownership for rollback'
			return 1
		fi
		predecessor_stopped=1
		held_suspension=""
		predecessor_is_stopped "$old_pid" || return 1
		assert_protected_identity
		assert_policy
	fi
	if [[ "$mode" == runtime ]]; then
		rollback_armed=1
		proof gateway-runtime apply "$serving_root" >/dev/null
		system_systemctl daemon-reload
		load_gateway_runtime
	else
		atomic_pointer "$candidate_release" "$current_link"
	fi
	proof journal-phase "$journal_file" C_CURRENT_SELECTED "$session_witness_record" >/dev/null
	rollback_armed=1
	if [[ "$topology" == migration-user ]]; then
		proof journal-phase "$journal_file" MIGRATION_SWITCHING "$session_witness_record" >/dev/null
		user_unit_file disable
		system_systemctl enable openclaw-gateway.service
		# Enablement has moved, but this lease still belongs to the exact live user process.
		if ! check_suspension migration-switching; then
			printf 'DEFERRED preserved Gateway suspension expired during migration switching\n'
			return 75
		fi
		user_systemctl stop openclaw-gateway.service
		predecessor_stopped=1
		held_suspension=""
		assert_exclusive_owner quiescent
		assert_protected_identity
		system_systemctl start openclaw-gateway.service
	elif [[ "$mode" == runtime ]]; then
		if ! assert_protected_identity || ! assert_policy || ! check_suspension || ! arm_suspension_handoff; then
			printf 'DEFERRED owned suspension or predecessor changed before runtime restart\n'
			return 75
		fi
		if ! system_systemctl restart openclaw-gateway.service; then
