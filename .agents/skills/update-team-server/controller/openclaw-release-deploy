	PREVIOUS_INFO="$previous_info" CANDIDATE_INFO="$candidate_info" PROTECTED_PATHS="$protected_identity" CONFIG_MIGRATION_KIND="${migration_kind:-none}" OFFLINE_DOCTOR="$offline_doctor_repair" GATEWAY_RUNTIME="$gateway_runtime_snapshot" \
