run_gateway_node() {
	local rpc_budget="${OPENCLAW_TEAM_RPC_BUDGET:-45}" remaining
	if ((verification_deadline > 0)); then
		rpc_budget=$((verification_deadline - SECONDS))
		((rpc_budget > 0)) || return 1
	fi
	if ((drain_deadline > 0)); then
		remaining=$((drain_deadline - SECONDS))
		((remaining > 0)) || return 1
		if ((remaining < rpc_budget)); then
			rpc_budget="$remaining"
		fi
	fi
	bounded "$rpc_budget" "$runuser_bin" -u openclaw -- env \
		HOME="$runtime_home" OPENCLAW_HOME="$runtime_home" \
		OPENCLAW_CONFIG_PATH="$config_file" OPENCLAW_STATE_DIR="$(dirname "$(dirname "$state_database")")" \
		XDG_RUNTIME_DIR="$runtime_dir" \
		DBUS_SESSION_BUS_ADDRESS="$bus_address" \
		OPENCLAW_SUPERVISOR_MODE=external \
		OPENCLAW_SYSTEMD_UNIT=openclaw-gateway.service \
		"$node_bin" "$@"
}

run_gateway() {
	local release="$1"
	shift
	run_gateway_node "$release/dist/index.js" "$@"
}

run_marker_rpc() {
	run_gateway_node --input-type=module -e '
import { pathToFileURL } from "node:url";
const [release, method, payload, timeout] = process.argv.slice(1);
const { callGatewayFromCli, isGatewayTransportError } = await import(pathToFileURL(`${release}/dist/plugin-sdk/gateway-runtime.js`).href);
try {
  const result = await callGatewayFromCli(method, { json: true, timeout }, JSON.parse(payload), {
    clientName: "cli", mode: "cli", scopes: ["operator.admin"], expectFinal: false, progress: false, sharedStateMode: "read-only",
  });
  process.stdout.write(JSON.stringify(result));
} catch (error) {
  // A startup admission refusal is pre-dispatch: nothing ran, so the caller may re-send the same payload.
  if (method === "agent" && !isGatewayTransportError(error) && error?.code === "UNAVAILABLE" &&
    error?.details?.code === "agent-database-inspection-pending") {
    process.stderr.write(`MARKER_ADMISSION_PENDING agent=${String(error.details.agentId)}\n`);
    process.stdout.write("RETRYABLE_ADMISSION_PENDING");
    process.exitCode = 76;
  } else {
    // Only a read of an acknowledged run may recover transport uncertainty.
    if (method !== "agent.wait" || !isGatewayTransportError(error) ||
      !(error.kind === "timeout" || [undefined, 1006, 1012].includes(error.code))) throw error;
    process.stderr.write(`MARKER_OBSERVATION_TRANSPORT_UNAVAILABLE kind=${error.kind}\n`);
    process.stdout.write("RETRYABLE_OBSERVATION_TRANSPORT");
    process.exitCode = 75;
  }
}
' "$@"
}

read_process_instance() {
	local response
	# JSON CLI failures live on stdout; report the exit without exposing the private response.
	response="$(run_gateway "$1" gateway call system.info --params '{}' --json --timeout 30000)" || {
		printf 'GATEWAY_RPC_FAILED method=system.info exit=%s\n' "$?" >&2
		return 1
	}
	proof_json suspension-process-instance "$response" "$2"
}

system_state() {
	system_systemctl is-active openclaw-gateway.service 2>/dev/null || true
}

user_manager_stopped() {
	local manager manager_after
	local -a properties=(--property=LoadState --property=ActiveState --property=SubState
		--property=MainPID --property=ControlPID --property=Job --property=ControlGroup)
	# A retired user manager has no bus. Prove its native process/job/cgroup state;
	# a transport error alone never means that the legacy Gateway is inactive.
	manager="$(system_systemctl show "user@$runtime_uid.service" "${properties[@]}")" || return 1
	printf '%s' "$manager" | proof user-manager-stopped "$ancestor_boundary" "$runtime_uid" >/dev/null || return 1
	manager_after="$(system_systemctl show "user@$runtime_uid.service" "${properties[@]}")" || return 1
	[[ "$manager_after" == "$manager" ]] || return 1
}

user_state() {
	local observed exit_code=0
	observed="$(user_systemctl is-active openclaw-gateway.service 2>/dev/null)" || exit_code=$?
	case "$exit_code:$observed" in
	0:active | 3:inactive | 3:failed) printf '%s\n' "$observed"; return 0 ;;
	esac
	[[ -z "$observed" && "$exit_code" != 0 ]] || return 1
	user_manager_stopped || return 1
	printf 'inactive\n'
}

system_unit_state() {
	system_systemctl is-enabled openclaw-gateway.service 2>/dev/null || true
}

user_unit_state() {
	user_file_systemctl is-enabled 2>/dev/null || true
}

assert_exclusive_owner() {
	local expected="$1" observed_system observed_user observed_user_enabled
	observed_system="$(system_state)"
	observed_user="$(user_state)" || return 1
	if [[ "$observed_system" == active && "$observed_user" == active ]]; then
		fail 'user and system Gateway units are simultaneously active'
		return 1
	fi
	# Conditional callers disable errexit; one predicate must return every ownership failure.
	case "$expected" in
	system)
		[[ "$observed_system" == active && "$observed_user" == inactive &&
			"$(system_unit_state)" == enabled && "$(user_unit_state)" == disabled ]] ||
			fail 'system Gateway active ownership or durable enablement is not exclusive'
		;;
	migration-user)
		observed_user_enabled="$(user_unit_state)"
		[[ "$observed_user" == active && "$observed_system" == inactive &&
			"$(system_unit_state)" == disabled &&
			("$observed_user_enabled" == enabled || "$observed_user_enabled" == disabled) ]] ||
			fail 'legacy user/system Gateway active ownership or durable enablement is unsafe'
		;;
	migration-switching)
		[[ "$observed_user" == active && "$observed_system" == inactive &&
			"$(system_unit_state)" == enabled && "$(user_unit_state)" == disabled ]] ||
			fail 'migration handoff lost its active user owner or exact durable enablement'
		;;
	quiescent)
		[[ "$observed_user" == inactive && "$observed_system" == inactive ]] ||
			fail 'Gateway ownership is not quiescent during migration'
		;;
	*) fail 'unknown Gateway ownership topology' ;;
	esac
}

load_gateway_runtime() {
	local operation=current
	if [[ "$mode" == runtime ]]; then operation=capture; fi
	gateway_runtime_snapshot="$(proof gateway-runtime "$operation" "$serving_root")" || return 1
	gateway_runtime_bin="$(printf '%s' "$gateway_runtime_snapshot" | "$node_bin" -e 'let s="";process.stdin.on("data",x=>s+=x);process.stdin.on("end",()=>process.stdout.write(JSON.parse(s).executable));')" || return 1
}

read_service() {
	local scope="$1" output key value active_state="" sub_state="" exec_start="" user="" group="" environment=""
	if [[ "$scope" == system ]]; then
		proof gateway-runtime check "$serving_root" "$gateway_runtime_snapshot" >/dev/null || return 1
		output="$(system_systemctl show openclaw-gateway.service \
			--property=ActiveState --property=SubState --property=MainPID \
			--property=ExecStart --property=User --property=Group --property=Environment)" || return 1
	else
		output="$(user_systemctl show openclaw-gateway.service \
			--property=ActiveState --property=SubState --property=MainPID \
			--property=ExecStart)" || return 1
	fi
	service_pid=""
	while IFS='=' read -r key value; do
		case "$key" in
		ActiveState) active_state="$value" ;;
		SubState) sub_state="$value" ;;
		MainPID) service_pid="$value" ;;
		ExecStart) exec_start="$value" ;;
		User) user="$value" ;;
		Group) group="$value" ;;
		Environment) environment="$value" ;;
		esac
	done <<<"$output"
	[[ "$active_state" == active && "$sub_state" == running && "$service_pid" =~ ^[1-9][0-9]*$ ]] ||
		return 1
	if [[ "$scope" == system ]]; then
		[[ "$user" == openclaw && "$group" == openclaw &&
			" $environment " == *" HOME=$runtime_home "* &&
			" $environment " == *' OPENCLAW_SUPERVISOR_MODE=external '* &&
			"$exec_start" == *"argv[]=$gateway_runtime_bin $serving_root/current/dist/index.js gateway --port $gateway_port ;"* ]] ||
			return 1
	else
		[[ "$exec_start" == *"argv[]=/usr/bin/node $legacy_current/dist/index.js gateway --port $gateway_port ;"* ]] ||
			return 1
	fi
}

process_generation() {
	local process_stat remainder
	local -a fields
	IFS= read -r process_stat <"$proc_root/$1/stat" || return 1
	[[ "$process_stat" == *') '* ]] || return 1
	remainder="${process_stat##*) }"
	read -r -a fields <<<"$remainder"
	[[ "${fields[19]:-}" =~ ^[1-9][0-9]*$ ]] || return 1
	printf '%s' "${fields[19]}"
}

assert_single_listener() {
	local expected_pid="$1" listing
	listing="$("$ss_bin" -H -ltnp "sport = :$gateway_port")" || return 1
	LISTENER_SNAPSHOT="$listing" EXPECTED_PID="$expected_pid" EXPECTED_PORT="$gateway_port" \
		"$node_bin" -e '
const lines = (process.env.LISTENER_SNAPSHOT ?? "").split("\n").filter(Boolean);
if (lines.length < 1 || lines.length > 2) process.exit(2);
const families = new Set();
for (const line of lines) {
  const address = line.match(new RegExp("(?:^|\\s)(127\\.0\\.0\\.1|\\[::1\\]):" + process.env.EXPECTED_PORT + "(?:\\s|$)"))?.[1];
  if (!address || families.has(address)) process.exit(2);
  families.add(address);
  const matches = [...line.matchAll(/pid=(\d+)/g)].map((match) => match[1]);
  if (matches.length !== 1 || matches[0] !== process.env.EXPECTED_PID) process.exit(2);
}
'
}

capture_service_generation() {
	local scope="$1"
	assert_exclusive_owner "$scope" || return 1
	if [[ "$scope" == migration-user || "$scope" == migration-switching ]]; then
		read_service user || {
			fail 'legacy user Gateway ownership or entrypoint drifted'
			return 1
		}
	else
		read_service system || {
			fail 'root-owned system Gateway ownership or entrypoint drifted'
			return 1
		}
	fi
	service_generation="$(process_generation "$service_pid")" || {
		fail 'Gateway process generation is unavailable'
		return 1
	}
}

capture_generation() {
	capture_service_generation "$1" || return 1
	assert_single_listener "$service_pid" || {
		fail 'Gateway does not own one exact loopback listener'
		return 1
	}
}

recheck_generation() {
	local scope="$1" expected_pid="$2" expected_generation="$3"
	capture_generation "$scope" || return 1
	[[ "$service_pid" == "$expected_pid" && "$service_generation" == "$expected_generation" ]] ||
		fail 'Gateway process generation changed during deployment'
}

predecessor_is_stopped() {
	local old_pid="$1"
	# Reused or reappearing old PID paths remain ambiguous, even with stopped units.
	[[ -d "$proc_root" && ! -e "$proc_root/$old_pid" && ! -L "$proc_root/$old_pid" ]] || return 1
	stopped_system_owners || return 1
	[[ ! -e "$proc_root/$old_pid" && ! -L "$proc_root/$old_pid" ]]
}

assert_stop_start_contract() {
	local properties
	properties="$(system_systemctl show openclaw-gateway.service --all \
		--property=KillSignal --property=RestartKillSignal --property=FileDescriptorStoreMax \
		--property=NFileDescriptorStore --property=RuntimeDirectory \
		--property=RequiredBy --property=RequisiteOf --property=PartOf --property=ConsistsOf \
		--property=BindsTo --property=BoundBy --property=PropagatesStopTo --property=StopPropagatedFrom \
		--property=Upholds --property=UpheldBy)" || return 1
	printf '%s' "$properties" | proof gateway-stop-start-contract >/dev/null
}

audit_root() {
	proof audit-root "$serving_root" "$root_uid" "$runtime_uid" "$deploy_uid" "$ancestor_boundary" >/dev/null
	proof audit-build "$build_home" "$root_uid" "$deploy_uid" "$deploy_gid" \
		"$runtime_home" "$deploy_file_uid" >/dev/null
}

read_pointer() {
	local pointer="$1" target sha
	[[ -L "$pointer" ]] || return 1
	target="$(realpath "$pointer")" || return 1
	[[ "$(dirname "$target")" == "$releases_root" ]] || return 1
	sha="$(basename "$target")"
	[[ "$sha" =~ ^[a-f0-9]{40}$ ]] || return 1
	proof validate-release "$target" "$sha" "$root_uid" sealed >/dev/null || return 1
	printf '%s\n' "$target"
}

atomic_pointer() {
	local target="$1" pointer="$2" temporary="${2}.next.$$"
	[[ "$(dirname "$target")" == "$releases_root" && "$(dirname "$pointer")" == "$serving_root" ]] ||
		{ fail 'pointer target is outside the sealed serving namespace'; return 1; }
	ln -s "$target" "$temporary" || return 1
	mv -Tf "$temporary" "$pointer" || return 1
	proof sync-directory "$serving_root"
}

assert_protected_identity() {
	local current_identity
	if [[ -n "$reconcile_evidence" ]]; then
		proof recovery-check "$journal_file" "$reconcile_evidence" "$serving_root" "${reconcile_position:-restored}" >/dev/null || return 1
	fi
	current_identity="$(proof fingerprint "$config_file" "$state_database")" || return 1
	if [[ -n "$protected_identity" && "$protected_identity" != "$current_identity" ]]; then
		if [[ "${candidate_config_verification:-0}" == 1 && -z "$reconcile_evidence" ]]; then
			[[ "$verified_pid" == "$candidate_config_pid" && "$verified_generation" == "$candidate_config_generation" ]] || return 1
			recheck_generation system "$verified_pid" "$verified_generation" || return 1
			proof candidate-config-accept "$journal_file" "$serving_root" "$protected_identity" \
				"$verified_pid" "$verified_generation" "$runtime_uid" "$policy_identity" || return 1
			protected_identity="$(proof journal-field "$journal_file" protectedPaths)" || return 1
			current_identity="$(proof fingerprint "$config_file" "$state_database")" || return 1
		fi
	fi
	if [[ -n "$protected_identity" && "$protected_identity" != "$current_identity" ]]; then
		fail 'protected configuration or SQLite device/inode identity changed'
		return 1
	fi
	protected_identity="$current_identity"
}

assert_policy() {
	local observed
	observed="$(proof policy "$config_file")" || return 1
	if [[ -n "$policy_identity" && "$observed" != "$policy_identity" ]]; then
		fail 'configured deployment policy or model drifted'
		return 1
	fi
	policy_identity="$observed"
}

assert_scheduler_owner() {
	local release="$1" scheduler_status
	scheduler_status="$(run_gateway "$release" gateway call update.status --params '{}' --json --timeout 30000)" || {
		printf 'GATEWAY_RPC_FAILED method=update.status exit=%s\n' "$?" >&2
		return 1
	}
	printf '%s' "$scheduler_status" | proof scheduler @stdin >/dev/null
}

retain_suspension_cleanup_offer() {
	local offered offered_lease offered_expiry
	if offered="$(proof_json suspension-offer "$1" 2>/dev/null)"; then
		read -r offered_lease offered_expiry <<<"$offered"
		if [[ -n "$held_suspension" && "$offered_lease" != "$held_suspension" ]]; then
			printf 'SUSPENSION_REPLACEMENT_OFFER expected=%s offered=%s cleanup=offered-only\n' "$held_suspension" "$offered_lease" >&2
		fi
		held_suspension="$offered_lease"; suspension_expiry="$offered_expiry"
		suspension_cleanup_only=1
	fi
}

request_suspension() {
	local release="$1" request="$2" response parsed offered_lease offered_expiry _terminal_blocked
	local failure_code failure_category failure_stage=initial
	local expected_id="${held_suspension:-}" prior_expiry="${suspension_expiry:-}"
	((suspension_cleanup_only == 0)) || { fail 'suspension offer is cleanup-only, not continued authority'; return 1; }
	((suspension_handoff_started == 0)) || { fail 'cannot renew an attempted suspension handoff'; return 1; }
	if response="$(run_gateway "$release" gateway call gateway.suspend.prepare \
		--params "$request" --json --timeout 30000)"; then
		:
	else
		failure_code=$?
		[[ -z "$expected_id" ]] || failure_stage=renewal
		if [[ -n "$expected_id" ]]; then
			suspension_cleanup_only=1
			retain_suspension_cleanup_offer "$response"
			printf 'SUSPENSION_RENEWAL_UNCERTAIN expected=%s cleanup=exact-observed-only\n' "$expected_id" >&2
		fi
		failure_category="$(proof_json suspension-prepare-failure "$response" "$failure_code" 2>/dev/null)" || failure_category=unclassified
		printf 'SUSPENSION_PREPARE_FAILED stage=%s exit=%s category=%s\n' \
			"$failure_stage" "$failure_code" "$failure_category" >&2
		printf 'DEFERRED renewable preserve-only drain preparation unavailable or conflicting\n'
		return 75
	fi
	last_suspension_prepare="$SECONDS"
	[[ -z "$expected_id" ]] || suspension_cleanup_only=1
	# An offered lease remains cleanup-only until the complete response and any
	# renewal identity/expiry binding pass. A raced replacement never grants stop.
	retain_suspension_cleanup_offer "$response"
	if [[ -n "$expected_id" ]]; then
		if ! parsed="$(proof_json suspension-prepare "$response" "$expected_id" "$prior_expiry")"; then
			printf 'SUSPENSION_RENEWAL_UNCERTAIN expected=%s cleanup=exact-observed-only\n' "$expected_id" >&2
			printf 'DEFERRED renewable preserve-only drain lease changed, regressed, or expired blockers=%s\n' \
				"$suspension_blockers"
			return 75
		fi
	elif ! parsed="$(proof_json suspension-prepare "$response")"; then
		printf 'DEFERRED renewable preserve-only drain lease malformed or expired\n'
		return 75
	fi
	read -r suspension_state offered_lease offered_expiry suspension_active_count suspension_retry_after_ms _terminal_blocked suspension_blockers suspension_write_custody <<<"$parsed"
	if [[ "$suspension_state" == BUSY ]]; then
		printf 'DEFERRED Gateway restart drain or another suspension blocks preservation blockers=%s\n' \
			"$suspension_blockers"
		return 75
	fi
	held_suspension="$offered_lease"
	suspension_expiry="$offered_expiry"
	suspension_cleanup_only=0
}

poll_suspension() {
	local release="$1" response params parsed observed_expiry _terminal_blocked rpc_exit
	params="$(proof suspension-lease-params "$held_suspension")" || {
		printf 'SUSPENSION_POLL_FAILED stage=params method=gateway.suspend.status exit=%s\n' "$?" >&2
		return 1
	}
	response="$(run_gateway "$release" gateway call gateway.suspend.status \
		--params "$params" --json --timeout 30000)" || {
		rpc_exit=$?
		printf 'SUSPENSION_POLL_FAILED stage=rpc method=gateway.suspend.status exit=%s\n' "$rpc_exit" >&2
		return "$rpc_exit"
	}
	parsed="$(proof_json suspension-status "$response" "$held_suspension" "$suspension_expiry")" || {
		printf 'SUSPENSION_POLL_FAILED stage=proof method=gateway.suspend.status exit=%s\n' "$?" >&2
		return 1
	}
	read -r suspension_state observed_expiry suspension_active_count suspension_retry_after_ms _terminal_blocked suspension_blockers suspension_write_custody <<<"$parsed"
	[[ "$observed_expiry" == "$suspension_expiry" ]] || {
		printf 'SUSPENSION_POLL_FAILED stage=expiry method=gateway.suspend.status exit=1\n' >&2
		return 1
	}
}

prepare_suspension() {
	local release="$1" request request_id now_ms remaining_ms
	local remaining_budget sleep_seconds renewal_wait retry_seconds poll_exit
	if [[ ! "$drain_budget" =~ ^[1-9][0-9]*$ ]] || ((drain_budget > 3600)); then
		fail 'preserve-only drain budget must be between 1 and 3600 seconds'
		return 1
	fi
	if [[ ! "$drain_poll_interval" =~ ^[1-9][0-9]*$ ]] || ((drain_poll_interval > 300)); then
		fail 'preserve-only drain status poll interval must be between 1 and 300 seconds'
		return 1
	fi
	suspension_release="$release"
	((suspension_handoff_started == 0)) || [[ -z "$held_suspension" ]] || {
		fail 'cannot prepare or renew an attempted suspension handoff'; return 1;
	}
	if [[ -z "$held_suspension" ]]; then
		suspension_handoff_started=0; suspension_prearm_renewal_attempted=0; suspension_cleanup_only=0
	fi
	drain_budget_elapsed=0
	request_id="team-release-$$-$(date -u +%Y%m%dT%H%M%SZ)"
	request="$(proof suspension-prepare-params "$request_id")" || return 1
	suspension_request="$request"
	drain_deadline=$((SECONDS + drain_budget))
	if ! request_suspension "$release" "$request"; then
		return 75
	fi
	while [[ "$suspension_state" == DRAINING ]]; do
		remaining_budget=$((drain_deadline - SECONDS))
		if ((remaining_budget <= 0)); then
			if ((interrupt_after_drain)); then
				drain_budget_elapsed=1
				break
			fi
			printf 'DEFERRED preserve-only Gateway drain exceeded its %s-second budget blockers=%s\n' \
				"$drain_budget" "$suspension_blockers"
			return 75
		fi
		printf 'DRAINING activeCount=%s lease=%s expiresAtMs=%s blockers=%s custody=%s\n' \
			"$suspension_active_count" "$held_suspension" "$suspension_expiry" "$suspension_blockers" "$suspension_write_custody"
		now_ms="$(proof suspension-now)" || return 1
		remaining_ms=$((suspension_expiry - now_ms))
		if ((remaining_ms <= 5000)); then
			printf 'DEFERRED preserve-only Gateway drain lease expired before renewal blockers=%s\n' \
				"$suspension_blockers"
			return 75
		fi
		if ((remaining_ms <= 30000)); then
			renewal_wait=$((3 - (SECONDS - last_suspension_prepare)))
			if ((renewal_wait > 0)); then
				if ((renewal_wait >= remaining_budget || remaining_ms <= (renewal_wait + 5) * 1000)); then
					printf 'DEFERRED preserve-only Gateway drain cannot safely renew before its deadline blockers=%s\n' \
						"$suspension_blockers"
					return 75
				fi
				sleep "$renewal_wait"
				continue
			fi
			if ! request_suspension "$release" "$request"; then
				return 75
			fi
			continue
		fi
		retry_seconds=$(((suspension_retry_after_ms + 999) / 1000))
		sleep_seconds="$drain_poll_interval"
		if ((retry_seconds > sleep_seconds)); then
			sleep_seconds="$retry_seconds"
		fi
		renewal_wait=$(((remaining_ms - 30000 + 999) / 1000))
		if ((renewal_wait < sleep_seconds)); then
			sleep_seconds="$renewal_wait"
		fi
		if ((sleep_seconds > remaining_budget)); then
			sleep_seconds="$remaining_budget"
		fi
		if ((sleep_seconds > 0)); then
			sleep "$sleep_seconds"
		fi
		if ((SECONDS >= drain_deadline)); then
			continue
		fi
		if poll_suspension "$release"; then
			:
		else
			poll_exit=$?
			# A deadline-owned timeout enters the same fresh lease/generation check as
			# expiry between polls. Other failed observations never authorize interruption.
			if ((poll_exit == 124 && SECONDS >= drain_deadline)); then continue; fi
			if ((SECONDS >= drain_deadline)); then
				printf 'DEFERRED preserve-only Gateway drain exceeded its %s-second budget blockers=%s\n' \
					"$drain_budget" "$suspension_blockers"
			else
				printf 'DEFERRED preserve-only Gateway drain status changed, expired, or became unavailable blockers=%s\n' \
					"$suspension_blockers"
			fi
			return 75
		fi
	done
	drain_deadline=0
	if [[ "$suspension_state" != READY ]]; then
		# Write custody is transient (a protected final chat write in flight), so a single
		# refusal on custody alone wastes the whole prepared release. Re-poll for a bounded
		# window while the only refusal is held custody; every other refusal stays final.
		custody_wait_deadline=$((SECONDS + custody_wait_budget))
		until check_suspension; do
			if [[ "$suspension_state" == DRAINING && "$suspension_write_custody" == held ]] &&
				{ [[ ",$suspension_blockers," != *,terminal-persistence:* ]] || ((${waive_terminal_persistence:-0})); } &&
				((interrupt_after_drain && drain_budget_elapsed && SECONDS < custody_wait_deadline)); then
				now_ms="$(proof suspension-now)" || return 1
				if ((suspension_expiry - now_ms <= 5000)); then
					printf 'DEFERRED bounded interruption lease expired while write custody was held blockers=%s\n' \
						"$suspension_blockers"
					return 75
				fi
				printf 'WAITING transient write custody activeCount=%s blockers=%s\n' \
					"$suspension_active_count" "$suspension_blockers"
				sleep "$custody_wait_interval"
				continue
			fi
			if ((${waive_terminal_persistence:-0} && !${terminal_persistence_waiver_armed:-0})) &&
				[[ "$suspension_state" == DRAINING ]] && ((interrupt_after_drain && drain_budget_elapsed)); then
				# Operator-explicit: final writes that did not settle within the custody budget are abandoned.
				terminal_persistence_waiver_armed=1
				printf 'TERMINAL_PERSISTENCE_WAIVED activeCount=%s blockers=%s custody=%s\n' \
					"$suspension_active_count" "$suspension_blockers" "$suspension_write_custody"
				continue
			fi
			printf 'DEFERRED bounded interruption lacks a valid owned lease or has pending terminal persistence\n'
			return 75
		done
	fi
	if [[ "$suspension_state" == DRAINING ]]; then
		printf 'INTERRUPTING authorized after %s-second graceful drain activeCount=%s blockers=%s custody=%s\n' \
			"$drain_budget" "$suspension_active_count" "$suspension_blockers" "$suspension_write_custody"
	fi
}

check_suspension() {
	((suspension_cleanup_only == 0)) || { fail 'suspension offer is cleanup-only, not continued authority'; return 1; }
	poll_suspension "$suspension_release" || {
		printf 'SUSPENSION_CHECK_FAILED stage=status exit=%s\n' "$?" >&2
		return 1
	}
	recheck_generation "${1:-$suspension_scope}" "$suspension_pid" "$suspension_generation" || {
		printf 'SUSPENSION_CHECK_FAILED stage=generation exit=%s\n' "$?" >&2
		return 1
	}
	# Reported writes fence interruption; absent legacy custody is unknown, not clear.
	# Keep the independent terminal-persistence fence for older residents as well.
	{ [[ "$suspension_state" == READY ]] ||
		{ ((interrupt_after_drain && drain_budget_elapsed)) &&
			[[ "$suspension_state" == DRAINING ]] &&
			{ [[ ",$suspension_blockers," != *,terminal-persistence:* ]] || ((${waive_terminal_persistence:-0})); }; }; } &&
		{ [[ "$suspension_write_custody" == clear || "$suspension_write_custody" == unknown ]] ||
			((${waive_terminal_persistence:-0} && ${terminal_persistence_waiver_armed:-0})); } || {
		# Only the native status proof's fixed state and blocker enums/counts reach this receipt.
		printf 'SUSPENSION_CHECK_FAILED stage=policy exit=1 state=%s activeCount=%s blockers=%s custody=%s interruptAfterDrain=%s drainBudgetElapsed=%s\n' \
			"$suspension_state" "$suspension_active_count" "$suspension_blockers" "$suspension_write_custody" "$interrupt_after_drain" "$drain_budget_elapsed" >&2
		return 1
	}
}

arm_suspension_handoff() {
	local params response
	((suspension_cleanup_only == 0)) || { fail 'suspension offer is cleanup-only, not continued authority'; return 1; }
	((interrupt_after_drain && drain_budget_elapsed)) && [[ "$suspension_state" == DRAINING ]] || return 0
	params="$(proof suspension-handoff-params "$held_suspension" "$suspension_pid" "$suspension_instance")" || return 1
	# An uncertain RPC may already have armed natively; never renew after sending it.
	suspension_handoff_started=1
	response="$(run_gateway "$suspension_release" gateway call gateway.suspend.handoff \
		--params "$params" --json --timeout 30000)" || return 1
	proof_json suspension-handoff "$response" "$held_suspension" "$suspension_expiry" >/dev/null || return 1
	# Arming does not renew the lease. A refused or uncertain arm is resumed by the existing exit owner.
	assert_protected_identity && assert_policy && check_suspension || return 1
	printf 'HANDOFF_ARMED lease=%s expiresAtMs=%s pid=%s\n' "$held_suspension" "$suspension_expiry" "$suspension_pid"
}

renew_suspension_before_handoff() {
	local now_ms
	[[ -n "$held_suspension" && -n "$suspension_request" ]] &&
		((suspension_handoff_started == 0 && suspension_prearm_renewal_attempted == 0)) || {
		fail 'pre-arm renewal requires the original unarmed suspension request'; return 1;
	}
	recheck_generation "$suspension_scope" "$suspension_pid" "$suspension_generation" || return 1
	now_ms="$(proof suspension-now)" || return 1
	((suspension_expiry > now_ms)) || { fail 'pre-arm renewal refuses an expired original suspension'; return 1; }
	suspension_prearm_renewal_attempted=1
	request_suspension "$suspension_release" "$suspension_request" || return 1
	if ! recheck_generation "$suspension_scope" "$suspension_pid" "$suspension_generation"; then
		suspension_cleanup_only=1
		printf 'SUSPENSION_RENEWAL_UNCERTAIN stage=generation lease=%s expiresAtMs=%s cleanup=exact-observed-only\n' "$held_suspension" "$suspension_expiry" >&2
		return 1
	fi
}

resume_suspension() {
	local params response saved_deadline saved_drain_deadline lease
	[[ -n "$held_suspension" ]] || return 0
	lease="$held_suspension"
	held_suspension=""
	recheck_generation "$suspension_scope" "$suspension_pid" "$suspension_generation" || {
		fail 'cannot resume suspension on a changed or unavailable lease owner'
		return 1
	}
	saved_deadline="$verification_deadline"
	saved_drain_deadline="$drain_deadline"
	verification_deadline=0
	drain_deadline=0
	params="$(proof suspension-lease-params "$lease")" || return 1
	if ! response="$(run_gateway "$suspension_release" gateway call gateway.suspend.resume \
		--params "$params" --json --timeout 30000)" ||
		! proof_json suspension-resume "$response" >/dev/null; then
		fail 'exact owned suspension resume was not acknowledged; automation stopped'
		return 1
	fi
	verification_deadline="$saved_deadline"
	drain_deadline="$saved_drain_deadline"
	suspension_cleanup_only=0
}

record_failed() {
	local sha="$1"
	[[ "$sha" =~ ^[a-f0-9]{40}$ ]] || return 1
	printf '%s\n' "$sha" >"$serving_root/failed/$sha"
	chmod 0600 "$serving_root/failed/$sha"
	proof sync-directory "$serving_root/failed"
}

verified_markers() {
	# Keep filesystem ownership checks and durable marker I/O in the existing Node runtime.
	"$node_bin" -e '
const fs = require("node:fs"), path = require("node:path");
const [root, rawUid, rawGid, operation, sha] = process.argv.slice(1);
const uid = Number(rawUid), gid = Number(rawGid), directory = path.join(root, "verified");
const validSha = value => /^[a-f0-9]{40}$/.test(value);
const check = (entry, mode, isDirectory) => {
  if (!entry || entry.uid !== uid || entry.gid !== gid || (entry.mode & 0o7777) !== mode ||
      (isDirectory ? !entry.isDirectory() : !entry.isFile() || entry.nlink !== 1))
    throw new Error("verified marker ownership, type, or permissions are unsafe");
};
const sync = pathname => { const fd = fs.openSync(pathname, "r"); try { fs.fsyncSync(fd); } finally { fs.closeSync(fd); } };
if (!["record", "list", "check"].includes(operation) || (operation !== "list" && !validSha(sha)))
  throw new Error("invalid verified marker operation or SHA");
let entry = fs.lstatSync(directory, { throwIfNoEntry: false });
if (!entry && operation === "record") {
  fs.mkdirSync(directory, { mode: 0o700 });
  fs.chownSync(directory, uid, gid);
  sync(root);
  entry = fs.lstatSync(directory);
}
if (!entry) { if (operation === "check") process.exit(1); process.exit(0); }
check(entry, 0o700, true);
const marker = name => {
  const pathname = path.join(directory, name), stat = fs.lstatSync(pathname, { throwIfNoEntry: false });
  if (stat) {
    check(stat, 0o600, false);
    if (fs.readFileSync(pathname, "utf8") !== name + "\n") throw new Error("verified marker content is invalid");
  }
  return stat;
};
if (operation === "record") {
  marker(sha);
  const temporary = path.join(directory, "." + sha + "." + process.pid);
  const fd = fs.openSync(temporary, "wx", 0o600);
  try { fs.fchownSync(fd, uid, gid); fs.writeFileSync(fd, sha + "\n"); fs.fsyncSync(fd); }
  finally { fs.closeSync(fd); }
  fs.renameSync(temporary, path.join(directory, sha));
  sync(directory);
} else if (operation === "check") {
  if (!marker(sha)) process.exit(1);
} else {
  const retained = [];
  for (const name of fs.readdirSync(directory).filter(validSha)) {
    const stat = marker(name), release = path.join(root, "releases", name);
    if (!fs.lstatSync(release, { throwIfNoEntry: false })) {
      fs.unlinkSync(path.join(directory, name));
      sync(directory);
    } else retained.push({ name, modified: stat.mtimeMs });
  }
  retained.sort((a, b) => b.modified - a.modified || a.name.localeCompare(b.name));
  for (const item of retained) process.stdout.write(item.name + "\n");
}
' "$serving_root" "$root_uid" "$root_gid" "$@"
}

refuse_verified_recovery() {
	local candidate_sha="$1" missing
	if [[ -z "$requested_sha" || ! "$requested_sha" =~ ^[a-f0-9]{40}$ ]]; then
		missing='--sha must name one exact verified release SHA'
	elif [[ "$requested_sha" == "$candidate_sha" ]]; then
		missing='requested SHA must be distinct from the journal candidate'
	elif [[ ! -d "$releases_root/$requested_sha" || -L "$releases_root/$requested_sha" ]]; then
		missing='requested release must exist on disk in the sealed serving namespace'
	elif ! verified_markers check "$requested_sha"; then
		missing='requested release must carry a valid root-owned verified/ marker'
	elif ! proof validate-release "$releases_root/$requested_sha" "$requested_sha" "$root_uid" sealed >/dev/null; then
		missing='requested release must be sealed-valid'
	else
		missing='owned restart requires a live generation-bound suspension or proven stopped owners; third-release recovery requires a durable journal transition supported by the admission library'
	fi
	fail "failed rollback requires explicit recovery of a distinct system release; evidence retained; missing precondition: $missing"
}

read_probe() {
	local endpoint="$1" remaining response
	remaining=$((verification_deadline - SECONDS))
	((remaining > 0)) || return 1
	response="$(bounded "$remaining" "$curl_bin" --silent --show-error \
		--connect-timeout "$remaining" --max-time "$remaining" --write-out $'\n%{http_code}' \
		"http://127.0.0.1:$gateway_port/$endpoint")" || return 1
	[[ "$response" == *$'\n'* ]] || return 1
	probe_body="${response%$'\n'*}"
	probe_status="${response##*$'\n'}"
	[[ "$probe_status" =~ ^[0-9]{3}$ && -n "$probe_body" ]]
}

verification_failure() {
	# Only call-site labels and numeric return/timing facts enter these diagnostics.
	printf 'VERIFICATION_FAILED stage=%s exit=%s elapsed_seconds=%s outcome=%s\n' \
		"$1" "$2" "$((SECONDS - $3))" "$4" >&2 || :
}

verification_step() {
	local verification_label="$1" verification_started="$SECONDS" verification_exit
	shift
	if [[ -n "$verification_owned_pid" ]]; then
		if ! capture_service_generation "$verification_owned_scope" ||
			[[ "$service_pid" != "$verification_owned_pid" || "$service_generation" != "$verification_owned_generation" ]]; then
			verification_failure "$verification_label" 1 "$verification_started" generation-changed
			return 1
		fi
	fi
	# Keep function mutations in this shell; callers retain their existing OR-list policy.
	if "$@"; then return 0; else verification_exit=$?; fi
	verification_failure "$verification_label" "$verification_exit" "$verification_started" nonzero-exit
	return "$verification_exit"
}

verify_convergence() {
	local release="$1" expected_info="$2" scope="${3:-system}" expected_build channels gateway_json
	local observed_process health_json health_status startup_json startup_status ready_json ready_status
	local convergence_state channel_state timeout_ms verification_result_started
	local -a probe_args channel_args
	cpu_degraded_waived=0
	profile_convergence=""
	expected_build="$(INFO_JSON="$expected_info" verification_step convergence.expected-build "$node_bin" -e 'process.stdout.write(JSON.parse(process.env.INFO_JSON).buildId)')" || return 1
	verification_step convergence.release proof validate-release "$release" "$(basename "$release")" "$root_uid" sealed >/dev/null || return 1
	verification_step convergence.generation capture_generation "$scope" || return 1
	verified_pid="$service_pid"
	verified_generation="$service_generation"
	if [[ "$scope" == system ]]; then
		verification_step convergence.runtime proof gateway-runtime process "$serving_root" "$gateway_runtime_snapshot" "$proc_root" "$verified_pid" >/dev/null || return 1
	fi
	timeout_ms=$(((verification_deadline - SECONDS) * 1000))
	verification_step convergence.process-budget test "$timeout_ms" -gt 0 || return 1
	observed_process="$(verification_step convergence.process-rpc run_gateway "$release" gateway call system.info --params '{}' --json --timeout "$timeout_ms")" || return 1
	verified_instance="$(PROCESS_JSON="$observed_process" EXPECTED_PID="$verified_pid" verification_step convergence.process-identity "$node_bin" -e '
const processInfo=JSON.parse(process.env.PROCESS_JSON);
if(processInfo.pid!==Number(process.env.EXPECTED_PID)||typeof processInfo.processInstanceId!=="string"||!processInfo.processInstanceId)process.exit(2);
process.stdout.write(processInfo.processInstanceId);
')" || return 1
	verification_step convergence.healthz read_probe healthz || return 1
	health_json="$probe_body"
	health_status="$probe_status"
	verification_step convergence.startupz read_probe startupz || return 1
	startup_json="$probe_body"
	startup_status="$probe_status"
	timeout_ms=$(((verification_deadline - SECONDS) * 1000))
	verification_step convergence.status-budget test "$timeout_ms" -gt 0 || return 1
	gateway_json="$(verification_step convergence.gateway-status run_gateway "$release" gateway status --json --timeout "$timeout_ms")" || return 1
	verification_step convergence.gateway-status-check proof_json gateway-status "$gateway_json" "$expected_build" >/dev/null || return 1
	verification_step convergence.readyz read_probe readyz || return 1
	ready_json="$probe_body"
	ready_status="$probe_status"
	timeout_ms=$(((verification_deadline - SECONDS) * 1000))
	verification_step convergence.channels-budget test "$timeout_ms" -gt 0 || return 1
	channels="$(verification_step convergence.channels run_gateway "$release" gateway call channels.status \
		--params "{\"probe\":true,\"timeoutMs\":$timeout_ms}" --json --timeout "$timeout_ms")" || return 1
	# Full argv keeps the strict path safe under nounset without an empty optional array.
	probe_args=(probes "$health_json" "$health_status" "$startup_json" "$startup_status" "$ready_json" "$ready_status" @stdin)
	channel_args=(channels @stdin)
	if ((allow_cpu_degraded == 1)); then
		probe_args+=(--allow-cpu-degraded)
		channel_args+=(--allow-cpu-degraded)
	fi
	verification_result_started="$SECONDS"
	convergence_state="$(printf '%s' "$channels" | verification_step convergence.probes proof "${probe_args[@]}")" || return 1
	case "$convergence_state" in
	READY) ;;
	READY_CPU_DEGRADED_OPERATOR_WAIVED)
		((allow_cpu_degraded == 1)) || { verification_failure convergence.probe-result 0 "$verification_result_started" waiver-not-authorized; return 1; }
		;;
	RECOVERING) verification_failure convergence.probe-result 0 "$verification_result_started" recovering; return 1 ;;
	*) verification_failure convergence.probe-result 0 "$verification_result_started" unexpected-result; return 1 ;;
	esac
	verification_result_started="$SECONDS"
	channel_state="$(printf '%s' "$channels" | verification_step convergence.channel-check proof "${channel_args[@]}")" || return 1
	case "$channel_state" in
	CHANNELS_OK) ;;
	CHANNELS_CPU_DEGRADED_OPERATOR_WAIVED)
		((allow_cpu_degraded == 1)) || { verification_failure convergence.channel-result 0 "$verification_result_started" waiver-not-authorized; return 1; }
		;;
	*) verification_failure convergence.channel-result 0 "$verification_result_started" unexpected-result; return 1 ;;
	esac
	verification_step convergence.protected-state assert_protected_identity || return 1
	verification_step convergence.policy assert_policy || return 1
	verification_step convergence.scheduler assert_scheduler_owner "$release" || return 1
	if [[ "$convergence_state" == READY_CPU_DEGRADED_OPERATOR_WAIVED ||
		"$channel_state" == CHANNELS_CPU_DEGRADED_OPERATOR_WAIVED ]]; then cpu_degraded_waived=1; fi
	if ((arm_steady_profile && !profile_finished)) && [[ -n "$profile_operation" ]]; then
		printf -v profile_convergence '{"operation":"%s","readiness":%s,"channels":%s,"convergenceState":"%s","channelState":"%s"}' \
			"$profile_operation" "$ready_json" "$channels" "$convergence_state" "$channel_state"
	fi
	return 0
}

verify_marker() {
	local release="$1" scope="${2:-system}"
	local marker session approvals_before approvals_after reply expected_model payload run_id terminal_state
	local observed_process timeout_ms remaining observation_pause observation_pause_ms observation_exit
	# Logical entries may retire while their exact transcript generation stays preserved.
	printf '%s' "$session_witness" | verification_step marker.session-preservation proof session-preservation-verify "$release" "$release" "$state_database" >/dev/null || return 1
	marker="TEAM_RELEASE_$(date -u +%Y%m%dT%H%M%SZ)_$$"
	session="team-release-$marker"
	approvals_before="$(verification_step marker.approvals-before proof approvals "$state_database" "$session")" || return 1
	verification_step marker.approvals-empty test "$approvals_before" = 0 || {
		fail 'verification session already has approval history'
		return 1
	}
	remaining=$((verification_deadline - SECONDS))
	verification_step marker.run-budget test "$remaining" -gt 0 || return 1
	# Native ACK plus same-run observations keep proof independent of one long-lived
	# response socket. Never redispatch a run when acknowledgment or observation fails.
	payload="$(MARKER="$marker" SESSION="$session" REMAINING="$remaining" "$node_bin" -e '
const session=process.env.SESSION,agentId=JSON.parse(process.env.OPENCLAW_TEAM_OPERATOR_PROFILE).modelAgent;
process.stdout.write(JSON.stringify({agentId,sessionId:session,
  sessionKey:`agent:${agentId}:explicit:${session.toLowerCase()}`,deliver:false,
  message:`Output only this exact string, byte-for-byte, with no prefix or suffix: ${process.env.MARKER}`,
  timeout:Number(process.env.REMAINING),idempotencyKey:require("node:crypto").randomUUID()}));
')" || return 1
	# Readiness probes can pass while startup still inspects an agent store (the listener
	# serves before store validation). That refusal is pre-dispatch, so the identical
	# payload is re-sent until the agent admits it or the verification budget ends.
	while :; do
		timeout_ms=$((remaining * 1000)); ((timeout_ms <= 60000)) || timeout_ms=60000
		observation_exit=0
		reply="$(verification_step marker.run run_marker_rpc "$release" agent "$payload" "$timeout_ms")" || observation_exit=$?
		((observation_exit == 0)) && break
		[[ "$observation_exit" == 76 && "$reply" == RETRYABLE_ADMISSION_PENDING ]] || return "$observation_exit"
		verification_step marker.admission-generation recheck_generation "$scope" "$verified_pid" "$verified_generation" || return 1
		printf 'MARKER_ADMISSION_RETRY same-payload=required same-generation=required\n' >&2
		remaining=$((verification_deadline - SECONDS))
		verification_step marker.admission-budget test "$remaining" -gt 3 || return 1
		verification_step marker.admission-pause bounded "$remaining" sleep 3 || return 1
		remaining=$((verification_deadline - SECONDS))
	done
	run_id="$(REPLY_JSON="$reply" SESSION="$session" verification_step marker.accepted "$node_bin" -e '
const reply=JSON.parse(process.env.REPLY_JSON),agentId=JSON.parse(process.env.OPENCLAW_TEAM_OPERATOR_PROFILE).modelAgent;
if(reply.status!=="accepted"||typeof reply.runId!=="string"||!reply.runId.trim()||reply.agentId!==agentId||
  reply.sessionKey!==`agent:${agentId}:explicit:${process.env.SESSION.toLowerCase()}`)process.exit(2);
process.stdout.write(reply.runId);
')" || return 1
	expected_model="$(POLICY_JSON="$policy_identity" verification_step marker.expected-model "$node_bin" -e 'process.stdout.write(JSON.parse(process.env.POLICY_JSON).model)')" || return 1
	while :; do
		verification_step marker.wait-generation recheck_generation "$scope" "$verified_pid" "$verified_generation" || return 1
		remaining=$((verification_deadline - SECONDS))
		verification_step marker.wait-budget test "$remaining" -gt 0 || return 1
		timeout_ms=$((remaining * 1000)); ((timeout_ms <= 60000)) || timeout_ms=60000
		# Keep the RPC budget available for connection and response handling. Pace
		# pending snapshots here instead of spending that budget in a server wait.
		payload="$(RUN_ID="$run_id" "$node_bin" -e 'process.stdout.write(JSON.stringify({runId:process.env.RUN_ID,timeoutMs:0}))')" || return 1
		observation_exit=0
		reply="$(verification_step marker.wait run_marker_rpc "$release" agent.wait "$payload" "$timeout_ms")" || observation_exit=$?
		verification_step marker.wait-generation-after recheck_generation "$scope" "$verified_pid" "$verified_generation" || return 1
		if ((observation_exit != 0)); then
			# The runner emits this pair only for a typed transient read failure.
			[[ "$observation_exit" == 75 && "$reply" == RETRYABLE_OBSERVATION_TRANSPORT ]] || return "$observation_exit"
			printf 'MARKER_OBSERVATION_RETRY same-run=required same-generation=required\n' >&2
		else
			terminal_state="$(REPLY_JSON="$reply" RUN_ID="$run_id" SESSION="$session" EXPECTED_REPLY="$marker" EXPECTED_MODEL="$expected_model" verification_step marker.reply-check "$node_bin" -e '
const r=JSON.parse(process.env.REPLY_JSON), receipt=r.terminalReceipt;
// A length stop can omit the visible truncation notice from terminalReply.
if(r.runId!==process.env.RUN_ID||r.error||r.pendingError===true||
  (r.stopReason!==undefined&&r.stopReason!=="stop"))process.exit(2);
if((r.status==="pending"||r.status==="timeout")&&!r.endedAt&&!receipt&&!r.terminalReply&&!r.stopReason) {
  process.stdout.write("PENDING");
} else {
  if(r.status!=="ok"||r.pendingError===true||r.terminalReply?.disposition!=="visible"||
    r.terminalReply.text!==process.env.EXPECTED_REPLY||receipt?.runId!==process.env.RUN_ID||
    receipt.sessionId!==process.env.SESSION||typeof receipt.turnId!=="string"||!receipt.turnId.trim()||
    receipt.terminalDisposition!=="visible"||receipt.effective?.provider+"/"+receipt.effective?.model!==process.env.EXPECTED_MODEL)process.exit(2);
  process.stdout.write("VERIFIED");
}
')" || return 1
			[[ "$terminal_state" == VERIFIED ]] && break
		fi
		remaining=$((verification_deadline - SECONDS))
		verification_step marker.pending-budget test "$remaining" -gt 0 || return 1
		# Keep half the remaining budget for another snapshot near the deadline.
		observation_pause_ms=$((remaining * 500))
		((observation_pause_ms <= 10000)) || observation_pause_ms=10000
		printf -v observation_pause '%d.%03d' "$((observation_pause_ms / 1000))" "$((observation_pause_ms % 1000))"
		verification_step marker.pending-pause bounded "$remaining" sleep "$observation_pause" || return 1
	done
	printf 'MARKER_VERIFIED run=%s observation=agent.wait same-generation=required\n' "$run_id"
	approvals_after="$(verification_step marker.approvals-after proof approvals "$state_database" "$session")" || return 1
	verification_step marker.approvals-unchanged test "$approvals_before" = "$approvals_after" || {
		fail 'verification session created an approval'
		return 1
	}
	verification_step marker.owner assert_exclusive_owner "$scope" || return 1
	verification_step marker.generation recheck_generation "$scope" "$verified_pid" "$verified_generation" || return 1
	timeout_ms=$(((verification_deadline - SECONDS) * 1000))
	verification_step marker.process-budget test "$timeout_ms" -gt 0 || return 1
	observed_process="$(verification_step marker.process-rpc run_gateway "$release" gateway call system.info --params '{}' --json --timeout "$timeout_ms")" || return 1
	PROCESS_JSON="$observed_process" EXPECTED_PID="$verified_pid" EXPECTED_INSTANCE="$verified_instance" verification_step marker.process-identity "$node_bin" -e '
const processInfo=JSON.parse(process.env.PROCESS_JSON);
if(processInfo.pid!==Number(process.env.EXPECTED_PID)||processInfo.processInstanceId!==process.env.EXPECTED_INSTANCE)process.exit(2);
' || return 1
	verification_step marker.protected-state assert_protected_identity || return 1
	verification_step marker.policy assert_policy || return 1
}

load_journal_witness() {
	local original
	[[ -n "$session_witness_record" ]] || session_witness_record="$(proof journal-read "$journal_file")" || return 1
	original="$(proof journal-original-witness "$journal_file" "$session_witness_record")" || return 1
	if [[ -n "$original" ]]; then
		session_witness="$original"
		session_proof="original-pre-cutover"
	fi
}

wait_for_live() {
	local release="$1" expected_info="$2" scope="${3:-system}" sleep_seconds verification_deadline
	local verification_owned_pid="${4:-}" verification_owned_generation="${5:-}" verification_owned_scope="$scope"
	local +x cpu_degraded_waived=0
	# Descriptor-less legacy recovery and no-journal checks can prove only fresh current state.
	[[ -n "$session_witness" ]] || session_witness="$(verification_step wait-for-live.session-witness proof session-preservation-witness "$release" "$release" "$state_database")" || return 1
	verification_deadline=$((SECONDS + verification_budget))
	while ((SECONDS < verification_deadline)); do
		if [[ -n "$verification_owned_pid" ]]; then
			capture_service_generation "$scope" || return 1
			[[ "$service_pid" == "$verification_owned_pid" && "$service_generation" == "$verification_owned_generation" ]] || {
				fail 'started recovery Gateway generation changed; journal retained'
				return 1
			}
		fi
		if verify_convergence "$release" "$expected_info" "$scope"; then
			verify_marker "$release" "$scope" || return $?
			if ((cpu_degraded_waived == 1)); then
				printf 'CPU_DEGRADED_OPERATOR_WAIVED scope=wait_for_live exception=performance-only sha=%s pid=%s generation=%s owner=%s final-deployment-acceptance=not-asserted\n' \
					"$(basename "$release")" "$verified_pid" "$verified_generation" "$scope"
				printf 'WARNING performance-only CPU/operator waiver used for sha=%s pid=%s generation=%s owner=%s; native degradation unchanged; wait_for_live checks passed, final deployment acceptance remains with caller\n' \
					"$(basename "$release")" "$verified_pid" "$verified_generation" "$scope" >&2
			fi
			return 0
		fi
		sleep_seconds="${OPENCLAW_TEAM_RETRY_SECONDS:-2}"
		((SECONDS < verification_deadline)) || break
		if ((SECONDS + sleep_seconds > verification_deadline)); then
			sleep_seconds=$((verification_deadline - SECONDS))
		fi
		sleep "$sleep_seconds"
	done
	verification_failure wait-for-live.budget 1 "$((verification_deadline - verification_budget))" retry-budget-ended
	return 1
}

migration_native_guard() {
	local unit_path response conditions executable
	response="$(bounded 15 "$busctl_bin" --system --json=short call org.freedesktop.systemd1 \
		/org/freedesktop/systemd1 org.freedesktop.systemd1.Manager GetUnit s openclaw-gateway.service)" || return 1
	unit_path="$(proof migration-unit-path "$response")" || return 1
	conditions="$(bounded 15 "$busctl_bin" --system --json=short get-property org.freedesktop.systemd1 \
		"$unit_path" org.freedesktop.systemd1.Unit Conditions)" || return 1
	executable="$(bounded 15 "$busctl_bin" --system --json=short get-property org.freedesktop.systemd1 \
		"$unit_path" org.freedesktop.systemd1.Service ExecConditionEx)" || return 1
	proof migration-guard-verify "$migration_guard" "$conditions" "$executable" "$serving_root" >/dev/null
}

migration_install_guard() {
	local fragment
	fragment="$(system_systemctl show openclaw-gateway.service --property=FragmentPath --value)" || return 1
	migration_guard="$(proof migration-guard-install "$fragment" "$serving_root" "$root_uid" "$ancestor_boundary")" || return 1
	system_systemctl daemon-reload || return 1
	migration_native_guard
}

migration_check_guard() {
	migration_native_guard || return 1
	[[ -z "$migration_evidence" ]] || proof migration-check "$journal_file" "$serving_root" "$migration_evidence" >/dev/null
}

migration_check_existing_guard() {
	local asset="$ancestor_boundary/etc/systemd/system/openclaw-gateway.service.d/zz-openclaw-agent-schema-migration.conf"
	if [[ -e "$asset" || -L "$asset" ]]; then
		migration_guard="$(proof migration-guard-descriptor "$serving_root")" || return 1
		migration_native_guard || return 1
		proof migration-permit-present "$serving_root" >/dev/null || return 1
	fi
}

migration_stop_contract() {
	local stop_budget
	stop_budget="$(system_systemctl show openclaw-gateway.service --property=TimeoutStopUSec --value)" || return 1
	[[ "$(system_systemctl show openclaw-gateway.service --property=KillMode --value)" == control-group &&
		"$(system_systemctl show openclaw-gateway.service --property=SendSIGKILL --value)" == yes &&
		"$stop_budget" =~ ^[1-9][0-9]*(us|ms|s|min)([[:space:]].*)?$ ]] || {
		fail 'agent migration requires bounded exact control-group shutdown'
		return 1
	}
}

migration_assert_inputs() {
	local phase
	if [[ "${migration_kind:-}" == config-codex-turn-idle || "${migration_nocow:-0}" == 1 ]]; then
		phase="$(proof migration-status "$journal_file" "$serving_root")" || return 1
	fi
	if [[ "${phase:-}" == doctor-started && "${migration_nocow:-0}" == 1 ]]; then
		proof offline-doctor-inputs "$journal_file" "$serving_root" "$migration_evidence" >/dev/null || return 1
		assert_policy
		return
	fi
	if [[ "${phase:-}" == doctor-started ]]; then
		# Atomic replacement is still fenced. Original evidence guards policy and bytes;
		# neither ordinary identity nor policy is rebound until stores verify.
		proof migration-config-recovery-check "$journal_file" "$serving_root" "$migration_evidence" >/dev/null
		return
	fi
	assert_protected_identity || return 1
	assert_policy
}

migration_rebind_config_guards() {
	local verified_policy
	verified_policy="$(proof migration-config-policy "$journal_file" "$serving_root" "$migration_evidence")" || return 1
	protected_identity="$(proof journal-field "$journal_file" protectedPaths)" || return 1
	policy_identity="$verified_policy"
	assert_protected_identity || return 1
	assert_policy
}

stopped_system_owners() {
	local snapshot key value active="" sub="" main="" control="" job="unknown" listeners
	snapshot="$(system_systemctl show openclaw-gateway.service --property=ActiveState --property=SubState \
		--property=MainPID --property=ControlPID --property=Job)" || return 1
	while IFS='=' read -r key value; do
		case "$key" in
		ActiveState) active="$value" ;;
		SubState) sub="$value" ;;
		MainPID) main="$value" ;;
		ControlPID) control="$value" ;;
		Job) job="$value" ;;
		esac
	done <<<"$snapshot"
	[[ ("$active" == inactive && "$sub" == dead || "$active" == failed && "$sub" == failed) && "$main" == 0 && "$control" == 0 &&
		("$job" == "" || "$job" == 0) && "$(user_state)" == inactive &&
		"$(user_unit_state)" == disabled && "$(system_unit_state)" == enabled ]] || {
		fail 'stopped Gateway proof requires system/user owners without queued start/control jobs'
		return 1
	}
	if ! snapshot="$(user_systemctl show openclaw-gateway.service --property=MainPID --property=ControlPID --property=Job)"; then
		user_manager_stopped || return 1
	else
		main=unknown; control=unknown; job=unknown
		while IFS='=' read -r key value; do
			case "$key" in MainPID) main="$value" ;; ControlPID) control="$value" ;; Job) job="$value" ;; esac
		done <<<"$snapshot"
		[[ "$main" == 0 && "$control" == 0 && ("$job" == "" || "$job" == 0) ]] || {
			fail 'stopped Gateway proof refuses a legacy user start job or control process'
			return 1
		}
	fi
	listeners="$("$ss_bin" -H -ltnp "sport = :$gateway_port")" || return 1
	[[ -z "$listeners" ]] || { fail 'stopped Gateway proof still has a Gateway listener'; return 1; }
}

stopped_restored_snapshot() {
	local original_pid="$1" system_snapshot user_snapshot listeners
	local -a properties=(ActiveState SubState MainPID ControlPID Job UnitFileState ExecMainPID InvocationID ExecMainStartTimestampMonotonic ControlGroup)
	local -a arguments=()
	local property
	stopped_system_owners || return 1
	for property in "${properties[@]}"; do arguments+=("--property=$property"); done
	system_snapshot="$(system_systemctl show openclaw-gateway.service "${arguments[@]}" \
		--property=ExecStart --property=User --property=Group --property=Environment --property=Slice)" || return 1
	user_snapshot="$(user_systemctl show openclaw-gateway.service "${arguments[@]}")" || return 1
	listeners="$("$ss_bin" -H -ltnp "sport = :$gateway_port")" || return 1
	[[ -z "$listeners" ]] || return 1
	SYSTEM_SNAPSHOT="$system_snapshot" USER_SNAPSHOT="$user_snapshot" GATEWAY_RUNTIME_BIN="$gateway_runtime_bin" "$node_bin" -e '
const fs = require("node:fs"), path = require("node:path"), crypto = require("node:crypto");
