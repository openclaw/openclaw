operator_pointer_snapshot() {
	local name pointer target pointer_identity
	for name in current previous; do
		pointer="$serving_root/$name"
		if [[ -L "$pointer" ]]; then
			target="$(readlink "$pointer")" || return 1
			pointer_identity="$(proof stat-identity "$pointer")" || return 1
			printf '%s %s %s\n' "$name" "$target" "$pointer_identity"
