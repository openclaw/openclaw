	state="$(printf '%s' "$snapshot" | "$node_bin" -e 'process.stdout.write(JSON.parse(require("node:fs").readFileSync(0,"utf8")).timer.state)')" || return 1
	stopped_timer_binding="$(printf '%s' "$snapshot" | "$node_bin" -e '
const fs=require("node:fs"),assert=require("node:assert/strict"),timer=JSON.parse(fs.readFileSync(0,"utf8")).timer;
assert.deepEqual(timer,JSON.parse(process.argv[1]).timer,"timer activity changed outside the admitted recovery");
process.stdout.write(JSON.stringify(timer));
' "$stopped_inputs")" || return 1
	if [[ "$state" == inactive ]]; then
		((stopped_timer_attempted == 0)) || return 1
		stopped_timer_attempted=1
		stopped_current_receipt timer-intent 0 || return 1
		# The same enabled timer is the only scheduler. No reload, enable, or timestamp rewrite.
		bounded 30 "$systemctl_bin" start openclaw-hourly-update.timer --job-mode=fail || timer_code=$?
		stopped_current_receipt timer-command "$timer_code" || return 1
		((timer_code == 0)) || return 1
		# Persistent timers can immediately launch one catch-up invocation.
		stopped_current_wait_updater || return 1
		stopped_timer_binding=""
	fi
	stopped_timer_binding="$(stopped_current_observe_timer)"
}

stopped_current_observe_timer() {
	local snapshot
	snapshot="$(stopped_current_snapshot finish)" || return 1
	printf '%s' "$snapshot" | "$node_bin" -e '
const fs=require("node:fs"),assert=require("node:assert/strict"),value=JSON.parse(fs.readFileSync(0,"utf8"));
assert.deepEqual(value.protected,JSON.parse(process.argv[1]).protected);assert.equal(value.timer.state,"active");
assert(/^[a-f0-9]{32}$/.test(value.timer.invocation));assert(Date.parse(value.timer.next)>Date.now(),"timer has no future deadline");
if(process.argv[2])assert.deepEqual(value.timer,JSON.parse(process.argv[2]),"timer schedule changed during recovery");
fs.writeSync(8,JSON.stringify({timer:value.timer})+"\n");fs.fsyncSync(8);process.stdout.write(JSON.stringify(value.timer));
' "$stopped_inputs" "${stopped_timer_binding:-}"
}

stopped_current_finish() {
	local code="$1"
	if ((stopped_admitted && stopped_start_attempted)); then
		if ! recovery_jobs_settled; then
			stopped_current_receipt unknown-native-job 1 || :
			return 1
		fi
		stopped_current_timer || { stopped_current_receipt timer-partial 1 || :; return 1; }
	fi
	if ((stopped_receipt_open)); then
		if ((code == 0 && stopped_verified)); then
			stopped_current_final || { stopped_current_receipt verification-partial 1 || :; return 1; }
			stopped_current_receipt recovered 0 || return 1
			printf 'RECOVERED sha=%s action=verified-current-after-start-request native-start-attribution=unproven APPROVAL_DELTA=0 session-proof=original-stopped-state\n' "$operator_expected_sha"
		else
			stopped_current_receipt unaccepted "$code" || :
			return 1
		fi
	fi
	return "$code"
}

stopped_current_final() {
	local stores
	stopped_current_common finish || return 1
	stores="$(proof stopped-current-state "$operator_release" "$config_file" "$state_database" "$proc_root" live "$runtime_uid")" || return 1
	printf '%s' "$stores" | "$node_bin" -e '
const fs=require("node:fs"),assert=require("node:assert/strict"),current=JSON.parse(fs.readFileSync(0,"utf8"));
for(const original of JSON.parse(process.argv[1]))assert.deepEqual(current.find(entry=>entry.path===original.path),original);
' "$stopped_stores" || return 1
	recheck_generation system "$stopped_successor_pid" "$stopped_successor_generation" || return 1
	[[ "$(system_systemctl show openclaw-gateway.service --property=InvocationID --value)" == "$stopped_successor_invocation" &&
		"$(realpath "$proc_root/$stopped_successor_pid/cwd")" == "$operator_release" ]] || return 1
	recovery_jobs_settled || return 1
	stopped_current_observe_timer >/dev/null || return 1
	recheck_generation system "$stopped_successor_pid" "$stopped_successor_generation"
}

recover_stopped_current() {
	local info receipt_file start_code=0 invocation started_pid started_generation native_outcome
	operator_check_lock held || return 1
	[[ ! -e "$journal_file" && ! -L "$journal_file" ]] || { fail 'stopped current recovery refuses any activation journal'; return 1; }
	operator_release="$(read_pointer "$current_link")" || return 1
	[[ "$operator_release" == "$releases_root/$operator_expected_sha" ]] || return 1
	operator_pointers="$(operator_pointer_snapshot)" || return 1
	assert_protected_identity && assert_policy || return 1
	verified_markers check "$operator_expected_sha" || return 1
	info="$(proof validate-release "$operator_release" "$operator_expected_sha" "$root_uid" sealed)" || return 1
	stopped_history="$(stopped_restored_snapshot "$operator_expected_pid")" || return 1
	printf '%s' "$stopped_history" | "$node_bin" -e '
const fs=require("node:fs"),assert=require("node:assert/strict"),s=JSON.parse(fs.readFileSync(0,"utf8")).system;
assert.equal(s.ExecMainPID,process.argv[1]);assert.equal(s.ExecMainStartTimestampMonotonic,process.argv[2]);assert.equal(s.InvocationID,process.argv[3]);
' "$operator_expected_pid" "$operator_expected_generation" "$stopped_expected_invocation" || return 1
	stopped_inputs="$(stopped_current_snapshot admit)" || return 1
	stopped_stores="$(proof stopped-current-state "$operator_release" "$config_file" "$state_database" "$proc_root" stopped "$runtime_uid")" || return 1
	session_witness="$(proof session-preservation-witness "$operator_release" "$operator_release" "$state_database")" || return 1
	run_gateway "$operator_release" config validate --json >/dev/null || { fail 'stopped current configuration validation failed; no start requested'; return 1; }
	stopped_current_admission || return 1
	receipt_file="$serving_root/journal/operator-start-current-$stopped_expected_boot-$stopped_expected_invocation.log"
	stopped_receipt_file="$receipt_file"
	umask 077
	set -o noclobber
	exec 8>"$receipt_file" || { fail 'stopped current incident receipt is already spent'; return 1; }
	stopped_receipt_open=1
	printf '%s\n%s\n%s\n%s\n%s\n' "$stopped_inputs" "$stopped_history" "$session_witness" "$stopped_stores" "$info" | "$node_bin" -e '
const fs=require("node:fs"),crypto=require("node:crypto"),bytes=fs.readFileSync(0);
fs.writeSync(8,JSON.stringify({admissionSha256:crypto.createHash("sha256").update(bytes).digest("hex"),
  inputs:bytes.toString().trimEnd().split("\n").map(line=>JSON.parse(line)),pointers:process.argv[1]})+"\n");fs.fsyncSync(8);
' "$operator_pointers" || return 1
	stopped_current_admission || return 1
	stopped_current_receipt start-intent 0 || return 1
	proof sync-directory "$serving_root/journal" || return 1
	stopped_current_admission || return 1
	stopped_admitted=1
	stopped_start_attempted=1
	bounded 180 "$systemctl_bin" start openclaw-gateway.service --job-mode=fail || start_code=$?
	stopped_current_receipt start-command "$start_code" || return 1
	native_outcome="$(bounded 15 "$systemctl_bin" show openclaw-gateway.service --property=ActiveState --property=SubState \
		--property=MainPID --property=ControlPID --property=Job --property=ExecMainPID \
		--property=ExecMainStartTimestampMonotonic --property=InvocationID)" || return 1
	printf '%s\n' "$native_outcome" >&8 || return 1
	stopped_current_receipt native-outcome 0 || return 1
	recovery_jobs_settled || return 1
	((start_code == 0)) || return 1
	capture_service_generation system || return 1
	started_pid="$service_pid"; started_generation="$service_generation"
	invocation="$(system_systemctl show openclaw-gateway.service --property=InvocationID --value)" || return 1
	[[ "$invocation" =~ ^[a-f0-9]{32}$ && "$invocation" != "$stopped_expected_invocation" && "$started_pid" != "$operator_expected_pid" ]] || return 1
	stopped_successor_pid="$started_pid"; stopped_successor_generation="$started_generation"; stopped_successor_invocation="$invocation"
	printf 'successor pid=%s start=%s invocation=%s\n' "$started_pid" "$started_generation" "$invocation" >&8 || return 1
	stopped_current_receipt successor-bound 0 || return 1
	[[ "$(realpath "$proc_root/$started_pid/cwd")" == "$operator_release" ]] || return 1
	wait_for_live "$operator_release" "$info" system "$started_pid" "$started_generation" || return 1
	stopped_current_common finish || return 1
	recheck_generation system "$started_pid" "$started_generation" || return 1
	[[ "$(system_systemctl show openclaw-gateway.service --property=InvocationID --value)" == "$invocation" ]] || return 1
	stopped_current_receipt gateway-verified 0 || return 1
	stopped_verified=1
}

while (($#)); do
	case "$1" in
	--continue-frozen-release)
		[[ "$mode" == deploy && $# -ge 6 && -z "$requested_sha" && -z "$frozen_target_sha" ]] || fail 'frozen continuation requires TARGET_SHA MANIFEST_SHA256 CURRENT_SHA PID START'
		mode=continue-frozen; frozen_target_sha="$2"; frozen_manifest_sha="$3"
		frozen_predecessor_sha="$4"; frozen_predecessor_pid="$5"; frozen_predecessor_start="$6"
		shift 5
		;;
	--switch-runtime)
		[[ "$mode" == deploy && $# -ge 4 ]] || fail '--switch-runtime requires node|bun, absolute binary, and SHA-256'
		mode=runtime; runtime_kind="$2"; runtime_path="$3"; runtime_hash="$4"
		shift 3
		;;
	--handoff-import)
		[[ "$mode" == deploy && $# -ge 3 && "$3" =~ ^[a-f0-9]{64}$ ]] || fail 'handoff import requires MANIFEST SHA256'
		mode=handoff-import; handoff_manifest="$2"; handoff_manifest_hash="$3"; shift 2
		;;
	--handoff-verify-doctor)
		[[ "$mode" == deploy ]] || fail 'handoff Doctor verification cannot be combined with another action'
		mode=handoff-doctor
		;;
	--handoff-activate)
		[[ "$mode" == deploy && $# -ge 2 && "$2" =~ ^[a-f0-9]{64}$ ]] || fail 'handoff activation requires approved CONFIG_SHA256'
		mode=handoff-activate; handoff_config_hash="$2"; shift
		;;
	--handoff-export | --handoff-stop)
		[[ "$mode" == deploy && $# -ge 6 ]] || fail 'handoff export requires SOURCE_SHA PID START TARGET_MACHINE_ID TARGET_SHA'
		[[ "$1" != --handoff-stop ]] || handoff_stop_only=1
		mode=handoff-source; operator_expected_sha="$2"; operator_expected_pid="$3"; operator_expected_generation="$4"
		handoff_peer="$5"; handoff_target_sha="$6"; shift 5
		;;
	--snapshot-for-rehearsal)
		[[ "$mode" == deploy && $# -ge 2 && -z "$requested_sha" && "$2" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$ ]] || fail 'rehearsal snapshot requires one fresh label'
		mode=snapshot-rehearsal; rehearsal_snapshot_label="$2"
		shift
		;;
	--prepare-release)
		[[ "$mode" == deploy && $# -ge 2 && -z "$requested_sha" && "$2" =~ ^[a-f0-9]{40}$ ]] || fail 'release preparation requires one exact official SHA'
		mode=prepare-release; requested_sha="$2"
		shift
		;;
	--repair-worker-bootstrap)
		[[ "$mode" == deploy && $# -ge 6 ]] || fail 'worker config repair requires current SHA, PID, start, config hash, and old setup hash'
		mode=worker-config
		operator_expected_sha="$2"; operator_expected_pid="$3"; operator_expected_generation="$4"
		worker_expected_config_hash="$5"; worker_expected_setup_hash="$6"
		shift 5
		;;
	--capture-steady-profile)
		[[ "$mode" == deploy && $# -ge 5 ]] || fail 'steady capture requires operation, current SHA, PID and process generation'
		mode=steady-profile
		profile_operation="$2"
		operator_expected_sha="$3"
		operator_expected_pid="$4"
		operator_expected_generation="$5"
		shift 4
		;;
	--operator-restart-current | --install-migration-guard)
		[[ "$mode" == deploy && $# -ge 4 ]] || fail 'bound action requires expected current SHA, PID, and process generation'
		if [[ "$1" == --operator-restart-current ]]; then mode=operator-restart; else mode=guard-install; fi
		operator_expected_sha="$2"
		operator_expected_pid="$3"
		operator_expected_generation="$4"
		shift 3
		;;
	--migrate)
		[[ "$mode" == deploy ]] || fail 'migration mode may be selected only once'
		mode=migrate
		;;
	--recover)
		[[ "$mode" == deploy ]] || fail 'recovery mode cannot be combined with another action'
		mode=recover
		;;
	--abandon-rehearsal)
		[[ -z "$abandon_rehearsal_sha" && $# -ge 2 && "$2" =~ ^[a-f0-9]{40}$ ]] || fail '--abandon-rehearsal requires one candidate SHA'
		abandon_rehearsal_sha="$2"
		shift
		;;
	--start-stopped-current)
		((start_stopped_current == 0)) && [[ $# -ge 6 ]] || fail 'stopped current recovery requires SHA BOOT_ID LAST_EXEC_PID LAST_EXEC_START_US LAST_INVOCATION'
		start_stopped_current=1
		operator_expected_sha="$2"; stopped_expected_boot="$3"; operator_expected_pid="$4"
		operator_expected_generation="$5"; stopped_expected_invocation="$6"
		shift 5
		;;
	--reconcile-config)
		[[ $# -ge 6 && -z "$reconcile_config_hash" && -n "$5" && -n "$6" ]] || fail '--reconcile-config requires SHA PID START CONFIG_SHA256 JOURNAL_SHA256 once'
		operator_expected_sha="$2"; operator_expected_pid="$3"; operator_expected_generation="$4"
		reconcile_config_hash="$5"; reconcile_journal_hash="$6"
		shift 5
		;;
	--reconcile-stopped-predecessor)
		[[ $# -ge 4 && -z "$reconcile_config_hash" && -n "$3" && -n "$4" ]] || fail '--reconcile-stopped-predecessor requires SHA CONFIG_SHA256 JOURNAL_SHA256 once'
		operator_expected_sha="$2"; reconcile_config_hash="$3"; reconcile_journal_hash="$4"
		reconcile_stopped=1
		shift 3
		;;
	--cleanup)
		[[ "$mode" == deploy ]] || fail 'cleanup mode cannot be combined with another action'
		mode=cleanup
		;;
	--sha)
		shift
		[[ $# -gt 0 && -z "$requested_sha" ]] || fail '--sha requires one exact value'
		requested_sha="$1"
		;;
	--offline-doctor-repair)
		((offline_doctor_repair == 0)) || fail 'offline Doctor may be selected only once'
		offline_doctor_repair=1
		;;
	--accept-partial-nocow)
		((accept_partial_nocow == 0)) || fail 'partial NOCOW acceptance may be selected only once'
		accept_partial_nocow=1
		;;
	--skip-migration-rehearsal)
		((skip_migration_rehearsal == 0)) || fail 'rehearsal waiver may be selected only once'
		skip_migration_rehearsal=1
		;;
	--arm-steady-profile)
		((arm_steady_profile == 0)) || fail 'steady profiling may be armed only once'
		arm_steady_profile=1
		;;
	--capture-startup-profile)
		((capture_startup_profile == 0)) || fail 'startup profiling may be selected only once'
		capture_startup_profile=1
		;;
	--allow-cpu-degraded)
		((allow_cpu_degraded == 0)) || fail 'CPU waiver may be selected only once'
		allow_cpu_degraded=1
		;;
	--interrupt-after-drain)
		((interrupt_after_drain == 0)) || fail 'interruption intent may be selected only once'
		interrupt_after_drain=1
		;;
	--waive-stale-terminal-persistence)
		# only meaningful with --interrupt-after-drain; receipted as TERMINAL_PERSISTENCE_WAIVED.
		waive_terminal_persistence=1
		;;
	*) fail 'usage: openclaw-release-deploy [--continue-frozen-release TARGET_SHA MANIFEST_SHA256 CURRENT_SHA PID START|--prepare-release OFFICIAL_SHA|--switch-runtime node|bun BINARY SHA256|--migrate|--recover [--abandon-rehearsal CANDIDATE_SHA|--accept-partial-nocow]|--cleanup] [--reconcile-config SHA PID START CONFIG_SHA256 JOURNAL_SHA256|--reconcile-stopped-predecessor SHA CONFIG_SHA256 JOURNAL_SHA256] [--repair-worker-bootstrap SHA PID START CONFIG_SHA256 OLD_SETUP_SHA256] [--sha OFFICIAL_MAIN_SHA] [--interrupt-after-drain] [--skip-migration-rehearsal] [--offline-doctor-repair] [--allow-cpu-degraded] [--capture-startup-profile|--arm-steady-profile] [--capture-steady-profile OPERATION SHA PID START]' ;;
	esac
	shift
done

if ((accept_partial_nocow)); then
	[[ "$mode" == recover && -z "$requested_sha" && -z "$reconcile_config_hash" && -z "$abandon_rehearsal_sha" &&
		"$start_stopped_current" == 0 && "$offline_doctor_repair" == 0 && "$skip_migration_rehearsal" == 0 &&
		"$interrupt_after_drain" == 0 && "$capture_startup_profile" == 0 && "$arm_steady_profile" == 0 ]] ||
		fail '--accept-partial-nocow requires --recover and allows only --allow-cpu-degraded'
fi

if [[ -n "$abandon_rehearsal_sha" ]]; then
	[[ "$mode" == recover && "$abandon_rehearsal_sha" =~ ^[a-f0-9]{40}$ &&
		-z "$requested_sha" && -z "$reconcile_config_hash" && "$start_stopped_current" == 0 &&
		"$offline_doctor_repair" == 0 && "$skip_migration_rehearsal" == 0 && "$interrupt_after_drain" == 0 &&
		"$allow_cpu_degraded" == 0 && "$capture_startup_profile" == 0 && "$arm_steady_profile" == 0 ]] ||
		fail '--abandon-rehearsal requires --recover and an exact candidate SHA without another action'
	operator_check_lock before
fi

if [[ "$mode" == continue-frozen ]]; then
	[[ -z "$requested_sha" && -z "$reconcile_config_hash" && "$start_stopped_current" == 0 &&
		"$frozen_target_sha" =~ ^[a-f0-9]{40}$ && "$frozen_manifest_sha" =~ ^[a-f0-9]{64}$ &&
		"$frozen_predecessor_sha" =~ ^[a-f0-9]{40}$ && "$frozen_target_sha" != "$frozen_predecessor_sha" &&
		"$frozen_predecessor_pid" =~ ^[1-9][0-9]*$ && "$frozen_predecessor_start" =~ ^[1-9][0-9]*$ ]] ||
		fail 'frozen continuation requires exact candidate, manifest and predecessor bindings without another action'
	operator_check_lock before
fi

[[ "$mode" != snapshot-rehearsal || -z "$requested_sha" ]] || fail 'rehearsal snapshot cannot be combined with --sha'

if ((start_stopped_current)); then
	[[ "$mode" == recover && -z "$requested_sha" && -z "$reconcile_config_hash" &&
		"$operator_expected_sha" =~ ^[a-f0-9]{40}$ && "$stopped_expected_boot" =~ ^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$ &&
		"$operator_expected_pid" =~ ^[1-9][0-9]*$ && "$operator_expected_generation" =~ ^[1-9][0-9]*$ &&
		"$stopped_expected_invocation" =~ ^[a-f0-9]{32}$ ]] || fail 'stopped current recovery requires --recover and exact incident bindings without another action'
	operator_check_lock before
fi

if [[ -n "$reconcile_config_hash" ]]; then
	[[ "$mode" == recover && -z "$requested_sha" && "$operator_expected_sha" =~ ^[a-f0-9]{40}$ &&
		("$reconcile_stopped" == 1 || ("$operator_expected_pid" =~ ^[1-9][0-9]*$ && "$operator_expected_generation" =~ ^[1-9][0-9]*$)) &&
		"$reconcile_config_hash" =~ ^[a-f0-9]{64}$ && "$reconcile_journal_hash" =~ ^[a-f0-9]{64}$ ]] ||
		fail 'config reconciliation requires --recover and exact SHA/PID/generation/config/journal bindings, without --sha'
	operator_check_lock before
fi

((offline_doctor_repair == 0)) || [[ ("$mode" == deploy || "$mode" == continue-frozen) && "$interrupt_after_drain" == 1 &&
  "$capture_startup_profile" == 0 && "$arm_steady_profile" == 0 && "$skip_migration_rehearsal" == 0 ]] ||
  fail '--offline-doctor-repair requires a fenced system deployment with --interrupt-after-drain, without profiling or rehearsal waiver'

((capture_startup_profile + arm_steady_profile <= 1)) || fail 'select only one profiling mode'
((capture_startup_profile + arm_steady_profile == 0)) || [[ "$mode" == deploy && "$skip_migration_rehearsal" == 0 ]] ||
	fail 'startup profiling is only valid for an ordinary deployment without migration'

((allow_cpu_degraded == 0)) || [[ "$mode" == deploy || "$mode" == continue-frozen || "$mode" == recover || "$mode" == runtime || "$mode" == handoff-source || "$mode" == handoff-activate ]] ||
	fail '--allow-cpu-degraded is only valid for deployment, runtime switching, recovery, or handoff'
((interrupt_after_drain == 0)) || [[ "$mode" == deploy || "$mode" == continue-frozen || "$mode" == worker-config || "$mode" == runtime || "$mode" == handoff-source ]] ||
	fail '--interrupt-after-drain is only valid for deployment, runtime switching, worker config repair, or source handoff'
((skip_migration_rehearsal == 0)) || [[ "$mode" == deploy ]] ||
	fail '--skip-migration-rehearsal is only valid for the canonical system deployment'

if [[ "$mode" == operator-restart || "$mode" == guard-install || "$mode" == steady-profile || "$mode" == worker-config || "$mode" == handoff-source ]]; then
	[[ -z "$requested_sha" && "$operator_expected_sha" =~ ^[a-f0-9]{40}$ &&
		"$operator_expected_pid" =~ ^[1-9][0-9]*$ && "$operator_expected_generation" =~ ^[1-9][0-9]*$ ]] ||
		fail 'operator restart requires exact current SHA/PID/generation and cannot combine with --sha'
	operator_check_lock before
fi

if [[ "$mode" == handoff-source ]]; then
	[[ "$handoff_peer" =~ ^[a-f0-9]{32}$ && "$handoff_target_sha" =~ ^[a-f0-9]{40}$ ]] || fail 'handoff target identity is invalid'
fi

[[ "$mode" != handoff-* || -z "$requested_sha" ]] || fail 'handoff modes cannot be combined with --sha'

if [[ "$mode" == worker-config ]]; then
	[[ "$worker_expected_config_hash" =~ ^[a-f0-9]{64}$ && "$worker_expected_setup_hash" =~ ^[a-f0-9]{64}$ ]] ||
		fail 'worker config repair requires exact config and old setup SHA-256 bindings'
fi
if [[ "$mode" == runtime ]]; then
	[[ -z "$requested_sha" && ("$runtime_kind" == node || "$runtime_kind" == bun) && "$runtime_hash" =~ ^[a-f0-9]{64}$ ]] || fail 'runtime switch requires a pinned binary and cannot select a release'
	operator_check_lock before
fi

exec 9>"$lock_file"
flock -n 9 || {
		if [[ -n "$abandon_rehearsal_sha" || "$mode" == operator-restart || "$mode" == guard-install || "$mode" == steady-profile || "$mode" == worker-config || "$mode" == runtime || "$mode" == prepare-release || "$mode" == continue-frozen || "$mode" == snapshot-rehearsal || "$mode" == handoff-* || -n "$reconcile_config_hash" || "$start_stopped_current" == 1 ]]; then
		fail 'bound maintenance action refused: canonical deployment lock is busy'
		exit 1
	fi
	printf 'SKIP another release deployment is running\n'
	exit 0
}
proof maintenance-idle "$ancestor_boundary" >/dev/null ||
	fail 'scheduled maintenance has not settled; deployment admission refused'
if [[ -n "$reconcile_config_hash" ]]; then operator_check_lock held; fi
if [[ -z "$abandon_rehearsal_sha" && "$mode" != handoff-* && ( -e "$journal_file" || -L "$journal_file" ) ]]; then
	handoff_pending="$(proof host-handoff status "$serving_root")"
	[[ "$handoff_pending" != SOURCE_* && "$handoff_pending" != TARGET_* ]] ||
		fail 'cross-host handoff is retained; resume its matching --handoff action, never ordinary deployment or rollback'
fi
trap on_exit EXIT

if [[ -n "$abandon_rehearsal_sha" ]]; then
	abandon_rehearsal
	exit 0
fi

if [[ "$mode" == steady-profile ]]; then
	operator_check_lock held
	[[ -z "${NODE_OPTIONS:-}" ]] || fail 'steady capture owner refuses inherited Node options'
	# Exec retains one PID/start/FD9 owner until the library revokes its permit and closes the lock.
	exec "$node_bin" --no-warnings "$release_lib" steady-profile "$profile_operation" "$serving_root" \
		"$operator_expected_sha" "$operator_expected_pid" "$operator_expected_generation"
fi

audit_root
load_gateway_runtime
if ((capture_startup_profile || arm_steady_profile)); then proof gateway-runtime profile "$serving_root" >/dev/null; fi
if [[ "$mode" == handoff-* ]]; then
	for timer in openclaw-hourly-update.timer openclaw-nightly-update.timer; do
		enabled="$(system_systemctl is-enabled "$timer" 2>/dev/null || true)"
		active="$(system_systemctl is-active "$timer" 2>/dev/null || true)"
		[[ ("$enabled" == disabled || "$enabled" == not-found) && "$active" == inactive ]] ||
			fail 'host handoff requires disabled inactive deployment timers'
	done
fi
if [[ "$mode" == handoff-source ]]; then
	operator_check_lock held
	proof migration-publication-recover "$serving_root" >/dev/null
	handoff_source
	exit 0
fi
if [[ "$mode" == handoff-* ]]; then
	proof migration-publication-recover "$serving_root" >/dev/null
	handoff_target
	exit 0
fi
if [[ "$mode" == prepare-release ]]; then
	prepare_release
	exit 0
fi
if [[ "$mode" == snapshot-rehearsal ]]; then
	snapshot_for_rehearsal
	exit 0
fi
if [[ "$mode" == continue-frozen ]]; then
	continue_frozen_release
	exit 0
fi
if ((start_stopped_current)); then
	recover_stopped_current
	exit 0
fi
profile_maintenance
if ((capture_startup_profile || arm_steady_profile)) && [[ -e "$journal_file" || -L "$journal_file" ]]; then
	fail 'startup profiling refuses an existing deployment journal; settle recovery first'
fi
proof migration-publication-recover "$serving_root" >/dev/null
if [[ "$mode" == worker-config ]]; then
	operator_check_lock held
	if repair_worker_bootstrap; then
		exit 0
	else
		worker_config_exit=$?
		if [[ -n "$worker_config_token" && "$(proof journal-field "$journal_file" request 2>/dev/null)" == "$worker_config_token" ]]; then
			recover_worker_config || printf 'WORKER_CONFIG_RETAINED recovery=explicit-owner journal-and-backup-retained\n' >&2
		fi
		exit "$worker_config_exit"
	fi
fi
if [[ "$mode" == guard-install ]]; then
	operator_check_lock held
	install_migration_guard_current
	exit 0
fi
if [[ "$mode" == operator-restart ]]; then
	migration_check_existing_guard
	operator_restart_current
	exit 0
fi
if [[ "$mode" == runtime ]]; then
	operator_check_lock held
	[[ ! -e "$journal_file" && ! -L "$journal_file" ]] || fail 'runtime switch refuses a pending activation; use --recover first'
	assert_exclusive_owner system
	previous_release="$(read_pointer "$current_link")"
	previous_info="$(proof validate-release "$previous_release" "$(basename "$previous_release")" "$root_uid" sealed)"
	candidate_release="$previous_release"; candidate_info="$previous_info"
	runtime_target="$(proof gateway-runtime target "$serving_root" "$runtime_kind" "$runtime_path" "$runtime_hash")"
	runtime_path="$(printf '%s' "$runtime_target" | "$node_bin" -e 'let s="";process.stdin.on("data",x=>s+=x);process.stdin.on("end",()=>process.stdout.write(JSON.parse(s).executable));')"
	(cd /; run_runtime env -i HOME="$runtime_home" PATH=/usr/bin:/bin "$runtime_path" -e 'const{DatabaseSync}=require("node:sqlite");const db=new DatabaseSync(":memory:");console.log(JSON.stringify({node:process.versions.node,bun:process.versions.bun,sqlite:db.prepare("select sqlite_version() as version").get().version}));db.close();') | proof gateway-runtime probe "$serving_root" "$runtime_target" >/dev/null
	capture_generation system
	proof gateway-runtime process "$serving_root" "$gateway_runtime_snapshot" "$proc_root" "$service_pid" >/dev/null
	if [[ "$(proof gateway-runtime same "$serving_root" "$runtime_target")" == SAME ]]; then
		wait_for_live "$previous_release" "$previous_info" system
		printf 'SUCCESS sha=%s action=runtime runtime=%s restart=0\n' "$(basename "$previous_release")" "$runtime_kind"
		exit 0
	fi
	activate_release system
	exit 0
fi
if [[ "$mode" == recover ]]; then
	recover_journal
	exit 0
fi
if [[ "$mode" == cleanup ]]; then
	if [[ -e "$journal_file" ]]; then
		proof journal-read "$journal_file" >/dev/null ||
			fail 'cleanup cannot inspect an ambiguous in-flight deployment journal'
	fi
	cleanup_releases
	exit 0
fi
recover_journal
((migration_recovered == 0 && worker_config_recovered == 0)) || exit 0

assert_protected_identity
assert_policy

if [[ "$mode" == migrate ]]; then
	[[ -z "$requested_sha" ]] || fail 'migration always freezes the exact serving baseline SHA'
	assert_exclusive_owner migration-user
	[[ -L "$legacy_current" ]] || fail 'legacy user Gateway pointer is missing'
	legacy_release="$(realpath "$legacy_current")"
	legacy_sha="$("$node_bin" -e 'process.stdout.write(JSON.parse(require("node:fs").readFileSync(process.argv[1],"utf8")).commit)' \
		"$legacy_release/dist/build-info.json")"
	[[ "$legacy_sha" =~ ^[a-f0-9]{40}$ ]] || fail 'legacy serving SHA is not exact'
	assert_scheduler_owner "$legacy_release"
	freeze_origin_main
	bounded_build "$fetch_budget" git -C "$mirror" merge-base --is-ancestor "$legacy_sha" "$frozen_main" ||
		fail 'legacy serving SHA is not proven to be in official origin/main history'
	candidate_release="$releases_root/$legacy_sha"
	candidate_info="$(publish_release "$legacy_sha" "$legacy_release")"
	previous_release="$candidate_release"
	previous_info="$candidate_info"
	if [[ -e "$current_link" || -L "$current_link" ]]; then
		[[ "$(read_pointer "$current_link")" == "$candidate_release" ]] ||
			fail 'preinstalled migration pointer does not select the exact serving baseline'
	fi
	activate_release migration-user
	exit 0
fi

assert_exclusive_owner system
previous_release="$(read_pointer "$current_link")" || fail 'current release pointer is unsafe'
previous_sha="$(basename "$previous_release")"
previous_info="$(proof validate-release "$previous_release" "$previous_sha" "$root_uid" sealed)"
assert_scheduler_owner "$previous_release"
freeze_origin_main
if [[ -n "$requested_sha" && "$requested_sha" != "$frozen_main" ]]; then
	fail 'supplied SHA is not the exact frozen official origin/main commit'
fi
target_sha="$frozen_main"
if [[ "$target_sha" == "$previous_sha" ]]; then
	((offline_doctor_repair == 0)) || fail 'offline Doctor requires a distinct approved candidate; current-SHA repair is not supported'
	((capture_startup_profile + arm_steady_profile == 0)) || fail 'startup profiling requires a new release; current-SHA restart is not supported'
	if wait_for_live "$previous_release" "$previous_info" system; then
		cleanup_releases
		printf 'SUCCESS sha=%s action=current restart=0\n' "$target_sha"
		exit 0
	fi
	fail 'current release is unhealthy; refusing an unattended restart'
fi
candidate_release="$releases_root/$target_sha"
# Reclaim headroom even when publication or activation will fail or defer.
# Even an old published candidate stays protected until its exact attempt settles.
cleanup_releases "$target_sha"
candidate_info="$(publish_release "$target_sha" "$previous_release")"
activate_prepared_release
