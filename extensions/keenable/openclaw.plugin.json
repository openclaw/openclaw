{
  "id": "keenable",
  "categories": ["web"],
  "activation": {
    "onStartup": false
  },
  "setup": {
    "providers": [
      {
        "id": "keenable",
        "envVars": ["KEENABLE_API_KEY"]
      }
    ]
  },
  "uiHints": {
    "webSearch.apiKey": {
      "label": "Keenable API Key",
      "help": "Keenable Search API key (fallback: KEENABLE_API_KEY env var).",
      "sensitive": true,
      "placeholder": "keen_..."
    },
    "webSearch.baseUrl": {
      "label": "Keenable Search Base URL",
      "help": "Optional Keenable Search API base URL override. OpenClaw appends /v1/search when the URL does not already end there."
    },
    "webSearch.appTitle": {
      "label": "Keenable App Title",
      "help": "Value for the required X-Keenable-Title header (default: OpenClaw)."
    }
  },
  "configContracts": {
    "secretInputs": {
      "paths": [
        {
          "path": "webSearch.apiKey",
          "expected": "string",
          "ownerKind": "capability"
        }
      ]
    }
  },
  "contracts": {
    "webSearchProviders": ["keenable"]
  },
  "configGroups": [
    {
      "id": "web-search",
      "title": "Web search",
      "order": 10,
      "properties": ["webSearch"]
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "webSearch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "apiKey": {
            "type": ["string", "object"]
          },
          "baseUrl": {
            "type": "string"
          },
          "appTitle": {
            "type": "string"
          }
        }
      }
    }
  }
}
