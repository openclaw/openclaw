{
  "name": "@openclaw/muse",
  "version": "2026.10.4",
  "description": "OpenClaw Muse Code agent runtime plugin (registers a `muse` AgentHarness backed by @muse-code/sdk over the Muse Session Protocol to the Muse Code CLI)",
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/openclaw"
  },
  "type": "module",
  "dependencies": {
    "@muse-code/sdk": "1.4.4"
  },
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@openclaw/muse",
      "npmSpec": "@openclaw/muse",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.10.2"
    },
    "compat": {
      "pluginApi": ">=2026.10.4"
    },
    "build": {
      "openclawVersion": "2026.10.4",
      "bundledDist": false
    },
    "release": {
      "bundleRuntimeDependencies": false,
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
