{
  "name": "@openclaw/logbook",
  "version": "2026.10.5",
  "description": "OpenClaw automatic work journal plugin",
  "type": "module",
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*",
    "openclaw": "workspace:*"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.5"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "build": {
      "bundledDist": true,
      "staticAssets": [
        {
          "source": "./src/logbook-schema.postgres.sql",
          "output": "./src/logbook-schema.postgres.sql"
        }
      ],
      "workerEntries": [
        "./src/store.worker.ts"
      ],
      "openclawVersion": "2026.10.5"
    },
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@openclaw/logbook",
      "npmSpec": "@openclaw/logbook",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.9.5"
    },
    "compat": {
      "pluginApi": ">=2026.10.5"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/openclaw"
  }
}
