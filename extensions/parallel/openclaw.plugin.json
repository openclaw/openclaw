{
  "id": "parallel",
  "categories": [
    "web",
    "models"
  ],
  "activation": {
    "onStartup": false
  },
  "setup": {
    "providers": [
      {
        "id": "parallel",
        "envVars": [
          "PARALLEL_API_KEY"
        ]
      }
    ]
  },
  "uiHints": {
    "webSearch.apiKey": {
      "label": "Parallel API Key",
      "help": "Parallel Search API key (fallback: PARALLEL_API_KEY env var).",
      "sensitive": true,
      "placeholder": "par-..."
    },
    "webSearch.baseUrl": {
      "label": "Parallel Search Base URL",
      "help": "Optional Parallel API base URL override. OpenClaw appends /v1/search when the URL does not already end there."
    }
  },
  "contracts": {
    "webSearchProviders": [
      "parallel",
      "parallel-free"
    ],
    "decisionProviders": [
      "parallel"
    ]
  },
  "configGroups": [
    {
      "id": "web-search",
      "title": "Web search",
      "order": 10,
      "properties": [
        "webSearch"
      ]
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "webSearch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "apiKey": {
            "type": [
              "string",
              "object"
            ]
          },
          "baseUrl": {
            "type": "string"
          }
        }
      }
    }
  },
  "providers": [
    "parallel"
  ],
  "providerEndpoints": [
    {
      "endpointClass": "parallel-native",
      "hosts": [
        "api.parallel.ai"
      ]
    }
  ],
  "modelCatalog": {
    "providers": {
      "parallel": {
        "baseUrl": "https://api.parallel.ai/v1",
        "models": [
          {
            "id": "decisions-fast",
            "name": "Parallel: Decisions Fast",
            "input": [
              "text"
            ],
            "inference": {
              "chat": false,
              "decision": {
                "protocol": "parallel-decisions",
                "input": [
                  "text"
                ],
                "questions": {
                  "boolean": {
                    "probabilities": "boolean",
                    "abstention": false
                  },
                  "choice": {
                    "probabilities": "categorical",
                    "abstention": false,
                    "minOptions": 2,
                    "maxOptions": 255
                  },
                  "score": {
                    "probabilities": "categorical",
                    "abstention": false,
                    "minOptions": 2,
                    "maxOptions": 10
                  }
                },
                "grounding": {
                  "webSearch": true
                },
                "limits": {
                  "maxQuestions": 100,
                  "maxStateAndQuestionTokens": 32000
                },
                "billing": {
                  "unit": "requests",
                  "source": "provider-docs"
                }
              }
            }
          }
        ]
      }
    }
  },
  "providerAuthChoices": [
    {
      "provider": "parallel",
      "method": "api-key",
      "choiceId": "parallel-api-key",
      "appGuidedSecret": true,
      "credentialOnly": true,
      "choiceLabel": "Parallel API key",
      "groupId": "parallel",
      "groupLabel": "Parallel",
      "groupHint": "Web-grounded Decisions",
      "optionKey": "parallelApiKey",
      "cliFlag": "--parallel-api-key",
      "cliOption": "--parallel-api-key <key>",
      "cliDescription": "Parallel API key"
    }
  ]
}
