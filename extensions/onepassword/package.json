{
  "name": "@openclaw/onepassword",
  "version": "2026.11.1",
  "description": "1Password SecretRef resolver and audited agent secrets broker for OpenClaw",
  "type": "module",
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*",
    "@solidjs/compiler": "2.0.0-rc.18",
    "esbuild": "0.28.2"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "build": {
      "bundledDist": true,
      "staticAssets": [
        {
          "source": "./onepassword-op-path.js",
          "output": "onepassword-op-path.js"
        },
        {
          "source": "./onepassword-secret-ref-resolver.js",
          "output": "onepassword-secret-ref-resolver.js"
        },
        {
          "source": "./onepassword-secret-id.js",
          "output": "onepassword-secret-id.js"
        }
      ],
      "openclawVersion": "2026.11.1"
    },
    "install": {
      "clawhubSpec": "clawhub:@openclaw/onepassword",
      "npmSpec": "@openclaw/onepassword",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.9.4"
    },
    "compat": {
      "pluginApi": ">=2026.11.1"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    },
    "controlUi": "./browser/index.tsx",
    "assetScripts": {
      "build": "cd ../.. && node --import ./scripts/tsx.mjs scripts/build-plugin-control-ui.mts extensions/onepassword",
      "copy": "cd ../.. && node --import ./scripts/tsx.mjs scripts/build-plugin-control-ui.mts extensions/onepassword --copy",
      "buildOutputs": [
        "dist/openclaw.plugin.json"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/openclaw"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.18",
    "solid-js": "2.0.0-rc.18",
    "zod": "4.6.7"
  }
}
