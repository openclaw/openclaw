{
  "id": "liquid",
  "categories": ["models"],
  "activation": { "onStartup": false },
  "enabledByDefault": true,
  "providers": ["liquid"],
  "providerEndpoints": [
    { "endpointClass": "liquid-native", "hosts": ["api.liquid.ai"] }
  ],
  "providerRequest": { "providers": { "liquid": { "family": "liquid" } } },
  "modelCatalog": {
    "providers": {
      "liquid": {
        "baseUrl": "https://api.liquid.ai/decisions/v1",
        "models": [
          {
            "id": "d1",
            "name": "Liquid AI d1",
            "input": ["text", "image"],
            "inference": {
              "chat": false,
              "decision": {
                "protocol": "liquid-systemone",
                "input": ["text", "image"],
                "questions": {
                  "boolean": { "probabilities": "boolean", "abstention": false },
                  "choice": { "probabilities": "categorical", "abstention": false, "minOptions": 2 },
                  "score": { "probabilities": "categorical", "abstention": false, "minOptions": 2 }
                },
                "confidence": "provider-specific",
                "reasoning": { "modes": ["auto"] },
                "limits": {
                  "image": {
                    "maxBytes": 4194304,
                    "mimeTypes": ["image/png", "image/jpeg", "image/webp"],
                    "remoteUrls": false
                  }
                },
                "billing": { "unit": "tokens", "source": "provider-docs", "usdPerMillion": { "output": 0 } }
              }
            }
          },
          {
            "id": "d1-ultra",
            "name": "Liquid AI d1 Ultra",
            "input": ["text", "image"],
            "inference": {
              "chat": false,
              "decision": {
                "protocol": "liquid-systemone",
                "input": ["text", "image"],
                "questions": {
                  "boolean": { "probabilities": "boolean", "abstention": false },
                  "choice": { "probabilities": "categorical", "abstention": false, "minOptions": 2 },
                  "score": { "probabilities": "categorical", "abstention": false, "minOptions": 2 }
                },
                "confidence": "provider-specific",
                "reasoning": { "modes": ["auto"] },
                "limits": {
                  "image": {
                    "maxBytes": 4194304,
                    "mimeTypes": ["image/png", "image/jpeg", "image/webp"],
                    "remoteUrls": false
                  }
                },
                "billing": { "unit": "tokens", "source": "provider-docs", "usdPerMillion": { "input": 0.042, "output": 0 } }
              }
            }
          }
        ]
      }
    }
  },
  "setup": { "providers": [{ "id": "liquid", "envVars": ["LIQUID_API_KEY"] }] },
  "providerAuthChoices": [
    {
      "provider": "liquid",
      "method": "api-key",
      "choiceId": "liquid-api-key",
      "appGuidedSecret": true,
      "credentialOnly": true,
      "choiceLabel": "Liquid AI API key",
      "groupId": "liquid",
      "groupLabel": "Liquid AI",
      "groupHint": "Native Decision models",
      "optionKey": "liquidApiKey",
      "cliFlag": "--liquid-api-key",
      "cliOption": "--liquid-api-key <key>",
      "cliDescription": "Liquid AI API key"
    }
  ],
  "contracts": { "decisionProviders": ["liquid"] },
  "configSchema": { "type": "object", "additionalProperties": false, "properties": {} }
}
