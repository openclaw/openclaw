{
  "name": "@openclaw/memory-core",
  "version": "2026.9.5",
  "private": true,
  "description": "OpenClaw core memory search plugin",
  "type": "module",
  "exports": {
    "./api.js": "./api.ts"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "json5": "2.2.3",
    "p-limit": "7.3.2",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*",
    "openclaw": "workspace:*"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.5"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "build": {
      "workerEntries": [
        "./src/memory/manager-search.worker.ts",
        "./src/memory/manager-index.worker.ts"
      ]
    },
    "extensions": [
      "./index.ts"
    ]
  }
}
