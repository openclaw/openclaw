{
  "name": "@openclaw/memory-core",
  "version": "2026.10.5",
  "private": true,
  "description": "OpenClaw core memory search plugin",
  "type": "module",
  "exports": {
    "./api.js": "./api.ts",
    "./session-search-visibility-api.js": "./session-search-visibility-api.ts",
    "./worker-api.js": "./worker-api.ts"
  },
  "dependencies": {
    "@openclaw/fs-safe": "0.26.8",
    "@solidjs/web": "2.0.0-rc.16",
    "solid-js": "2.0.0-rc.16",
    "json5": "2.2.3",
    "kysely": "0.29.6",
    "p-limit": "7.3.3",
    "typebox": "1.3.37"
  },
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*",
    "@solidjs/compiler": "2.0.0-rc.16",
    "esbuild": "0.28.2",
    "openclaw": "workspace:*"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.5"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "controlUi": "./browser/index.tsx",
    "assetScripts": {
      "build": "cd ../.. && node --import ./scripts/tsx.mjs scripts/build-plugin-control-ui.mts extensions/memory-core",
      "copy": "cd ../.. && node --import ./scripts/tsx.mjs scripts/build-plugin-control-ui.mts extensions/memory-core --copy",
      "buildOutputs": [
        "dist/openclaw.plugin.json"
      ]
    },
    "build": {
      "workerEntries": [
        "./src/memory/manager-search.worker.ts",
        "./src/memory/manager-index.worker.ts",
        "./src/memory/manager-publication.worker.ts",
        "./src/standing-intents.worker.ts",
        "./src/memory-entry-origins.worker.ts"
      ]
    },
    "extensions": [
      "./index.ts"
    ]
  }
}
