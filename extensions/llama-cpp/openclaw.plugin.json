{
  "id": "llama-cpp",
  "categories": [
    "models"
  ],
  "name": "llama.cpp Provider",
  "description": "Managed and external llama.cpp servers for GGUF chat, embeddings and local images.",
  "activation": {
    "onStartup": false
  },
  "providerCatalogEntry": "./provider-discovery.ts",
  "enabledByDefault": true,
  "autoEnableWhenConfiguredProviders": [
    "llama-cpp",
    "llama-app"
  ],
  "providers": [
    "llama-cpp",
    "llama-app"
  ],
  "modelCatalog": {
    "discovery": {
      "llama-cpp": "refreshable",
      "llama-app": "refreshable"
    }
  },
  "providerRequest": {
    "providers": {
      "llama-cpp": {
        "family": "llama-cpp",
        "openAICompletions": {
          "supportsStreamingUsage": true
        }
      },
      "llama-app": {
        "family": "llama-cpp",
        "openAICompletions": {
          "supportsStreamingUsage": true
        }
      }
    }
  },
  "modelPricing": {
    "providers": {
      "llama-cpp": {
        "external": false
      },
      "llama-app": {
        "external": false
      }
    }
  },
  "syntheticAuthRefs": [
    "llama-cpp",
    "llama-app"
  ],
  "nonSecretAuthMarkers": [
    "llama-cpp-local",
    "llama-app-local"
  ],
  "setup": {
    "providers": [
      {
        "id": "llama-cpp",
        "envVars": [
          "LLAMA_SERVER_API_KEY"
        ]
      },
      {
        "id": "llama-app",
        "envVars": [
          "LLAMA_APP_API_KEY"
        ]
      }
    ]
  },
  "providerAuthChoices": [
    {
      "provider": "llama-cpp",
      "method": "local",
      "choiceId": "llama-cpp",
      "optionKey": "llamaCppEmbeddingOnly",
      "cliFlag": "--llama-cpp-embedding-only",
      "cliOption": "--llama-cpp-embedding-only",
      "cliDescription": "Consent to managed llama.cpp embedding-only model and runtime downloads (non-interactive)",
      "appGuidedDiscovery": true,
      "appGuidedActionLabel": "Set up",
      "choiceLabel": "Built-in local AI",
      "choiceHint": "Let OpenClaw download and run a model for you (powered by llama.cpp).",
      "groupId": "llama-cpp",
      "groupLabel": "llama.cpp",
      "groupHint": "Built-in local AI or a server you already run"
    },
    {
      "provider": "llama-cpp",
      "method": "existing-server",
      "choiceId": "llama-cpp-existing-server",
      "appGuidedDiscovery": true,
      "appGuidedSecret": true,
      "choiceLabel": "Existing llama.cpp server",
      "choiceHint": "Connect to a llama.cpp server you already run.",
      "groupId": "llama-cpp",
      "groupLabel": "llama.cpp",
      "groupHint": "Built-in local AI or a server you already run",
      "optionKey": "llamaServerApiKey",
      "cliFlag": "--llama-server-api-key",
      "cliOption": "--llama-server-api-key <key>",
      "cliDescription": "llama-server API key",
      "appGuidedActionLabel": "Set up"
    },
    {
      "provider": "llama-app",
      "method": "existing-server",
      "choiceId": "llama-app",
      "appGuidedDiscovery": true,
      "appGuidedActionLabel": "Set up",
      "website": "https://llama.app/",
      "appGuidedSecret": true,
      "choiceLabel": "Llama app",
      "choiceHint": "Use models from the separate Llama app (llama.app).",
      "groupId": "llama-app",
      "groupLabel": "Llama app",
      "groupHint": "Models managed by the Llama app"
    }
  ],
  "contracts": {
    "embeddingProviders": [
      "local"
    ],
    "mediaUnderstandingProviders": [
      "llama-cpp"
    ],
    "tools": [
      "local_image"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  }
}
