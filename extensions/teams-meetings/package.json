{
  "name": "@openclaw/teams-meetings",
  "version": "2026.10.5-beta.2",
  "description": "OpenClaw Microsoft Teams browser meeting participant plugin.",
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/openclaw"
  },
  "type": "module",
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*",
    "openclaw": "workspace:*"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.5-beta.2"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@openclaw/teams-meetings",
      "npmSpec": "@openclaw/teams-meetings",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.9.8"
    },
    "compat": {
      "pluginApi": ">=2026.10.5-beta.2"
    },
    "build": {
      "openclawVersion": "2026.10.5-beta.2",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
