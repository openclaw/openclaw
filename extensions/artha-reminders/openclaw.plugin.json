{
  "id": "artha-reminders",
  "name": "Artha Reminders",
  "description": "Lets each chat user schedule reminders and tasks for themselves only.",
  "enabledByDefault": false,
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "defaultTimezone": {
        "type": "string"
      },
      "taskToolsAllow": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "maxSchedulesPerUser": {
        "type": "integer",
        "minimum": 1
      },
      "minRepeatMinutes": {
        "type": "integer",
        "minimum": 1
      }
    },
    "additionalProperties": false
  },
  "contracts": {
    "tools": [
      "my_reminders"
    ]
  }
}
