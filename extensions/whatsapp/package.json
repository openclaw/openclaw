{
  "name": "@openclaw/whatsapp",
  "version": "2026.10.9",
  "description": "OpenClaw WhatsApp channel plugin for WhatsApp Web chats.",
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/openclaw"
  },
  "type": "module",
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.18",
    "audio-decode": "3.12.0",
    "baileys": "7.0.0-rc14",
    "solid-js": "2.0.0-rc.18",
    "typebox": "1.4.3"
  },
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*",
    "@solidjs/compiler": "2.0.0-rc.18",
    "esbuild": "0.28.2",
    "openclaw": "workspace:*"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.9"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "setupFeatures": {
      "configPromotion": "preserve-root",
      "legacySessionSurfaces": true
    },
    "channel": {
      "id": "whatsapp",
      "approvalFlags": [
        "native"
      ],
      "label": "WhatsApp",
      "selectionLabel": "WhatsApp (QR link)",
      "detailLabel": "WhatsApp Web",
      "docsPath": "/channels/whatsapp",
      "docsLabel": "whatsapp",
      "blurb": "works with your own number; recommend a separate phone + eSIM.",
      "systemImage": "message",
      "doctorCapabilities": {
        "dmAllowFromMode": "topOnly",
        "groupModel": "sender",
        "groupAllowFromFallbackToAllowFrom": true,
        "warnOnEmptyGroupSenderAllowlist": true
      },
      "persistedAuthState": {
        "specifier": "./auth-presence",
        "exportName": "hasAnyWhatsAppAuth"
      },
      "setup": {
        "fields": [
          {
            "key": "authDir",
            "kind": "string",
            "cli": {
              "flags": "--auth-dir <path>",
              "description": "WhatsApp auth directory override"
            }
          }
        ]
      }
    },
    "install": {
      "clawhubSpec": "clawhub:@openclaw/whatsapp",
      "npmSpec": "@openclaw/whatsapp",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.25"
    },
    "compat": {
      "pluginApi": ">=2026.10.9"
    },
    "build": {
      "bundledDist": false,
      "openclawVersion": "2026.10.9"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    },
    "controlUi": "./browser/index.tsx",
    "assetScripts": {
      "build": "cd ../.. && node --import ./scripts/tsx.mjs scripts/build-plugin-control-ui.mts extensions/whatsapp",
      "copy": "cd ../.. && node --import ./scripts/tsx.mjs scripts/build-plugin-control-ui.mts extensions/whatsapp --copy",
      "buildOutputs": [
        "dist/openclaw.plugin.json"
      ]
    }
  }
}
