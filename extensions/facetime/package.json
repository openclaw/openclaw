{
  "name": "@openclaw/facetime",
  "version": "2026.9.7",
  "description": "Experimental FaceTime realtime voice carrier for OpenClaw agents",
  "license": "MIT",
  "author": "OpenClaw contributors",
  "homepage": "https://docs.openclaw.ai/plugins/facetime",
  "bugs": {
    "url": "https://github.com/openclaw/openclaw/issues"
  },
  "keywords": [
    "facetime",
    "openclaw",
    "openclaw-plugin",
    "realtime-voice"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/openclaw",
    "directory": "extensions/facetime"
  },
  "files": [
    "assets/icon.png",
    "assets/activity.svg",
    "doctor-contract-api.ts",
    "index.ts",
    "runtime-api.ts",
    "src",
    "docs/phase1-verification.md",
    "helper-endpoint.json",
    "scripts/commit-driver-transaction.sh",
    "scripts/ensure-helper-ipc-key.sh",
    "scripts/inject-helper-terminal.sh",
    "scripts/inject-helper.sh",
    "scripts/install-driver-root.sh",
    "scripts/install-driver.applescript",
    "scripts/install-driver.sh",
    "scripts/remove-user-artifacts.sh",
    "scripts/stage-helper.sh",
    "scripts/verify-native-helper.sh",
    "scripts/verify-xcode-trust.sh",
    "skills/facetime/SKILL.md",
    "skills/facetime/agents/openai.yaml",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "openclaw.plugin.json"
  ],
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "type": "module",
  "scripts": {
    "install:driver": "bash scripts/install-driver.sh",
    "uninstall:driver": "bash scripts/install-driver.sh --uninstall",
    "inject:helper": "bash scripts/inject-helper.sh",
    "inject:helper:phone": "bash scripts/inject-helper.sh --app Phone",
    "inject:helper:terminal": "bash scripts/inject-helper-terminal.sh"
  },
  "dependencies": {
    "typebox": "1.3.30"
  },
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*",
    "openclaw": "workspace:*"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.7"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@openclaw/facetime",
      "npmSpec": "@openclaw/facetime",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.9.4",
      "allowInvalidConfigRecovery": true
    },
    "compat": {
      "pluginApi": ">=2026.9.7"
    },
    "build": {
      "bundledDist": false,
      "openclawVersion": "2026.9.7"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
