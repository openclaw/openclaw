{
  "id": "facetime",
  "name": "FaceTime",
  "description": "Experimental FaceTime realtime voice carrier for OpenClaw agents",
  "categories": ["voice"],
  "enabledByDefault": false,
  "activation": {
    "onStartup": true
  },
  "skills": ["./skills"],
  "contracts": {
    "tools": ["facetime_call"]
  },
  "doctorContract": {
    "configRepair": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean", "default": true },
      "allowedCallers": {
        "type": "array",
        "items": { "type": "string" },
        "default": []
      },
      "realtime": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": { "type": "string" },
          "model": { "type": "string" },
          "voice": { "type": "string" },
          "sessionKey": { "type": "string", "default": "main" },
          "toolPolicy": {
            "type": "string",
            "enum": ["safe-read-only", "owner", "none"],
            "default": "owner"
          },
          "instructions": { "type": "string", "maxLength": 4000 },
          "providers": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "vision": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": false }
        }
      },
      "avatar": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": false }
        }
      }
    }
  },
  "uiHints": {
    "enabled": { "label": "Enable FaceTime Voice" },
    "allowedCallers": {
      "label": "Allowed FaceTime Handles",
      "help": "Only these handles may place or receive bridged calls. Owner tools follow commands.ownerAllowFrom (for example facetime:+12065550123)."
    },
    "realtime.provider": { "label": "Realtime Provider", "advanced": true },
    "realtime.model": { "label": "Realtime Model", "advanced": true },
    "realtime.voice": { "label": "Realtime Voice", "advanced": true },
    "realtime.sessionKey": { "label": "Agent Session Key", "advanced": true },
    "realtime.toolPolicy": { "label": "Tool Policy", "advanced": true },
    "vision.enabled": {
      "label": "See the Caller's Video",
      "help": "Captures the FaceTime call window about every two seconds and shows the agent one frame when it looks. Frames stay in memory and go only to the realtime voice provider. Needs the facetime-video-capture native helper.",
      "advanced": true
    },
    "avatar.enabled": {
      "label": "Lip-synced Avatar",
      "help": "Serves an animated avatar at /facetime/avatar on this Gateway for a local OBS browser source. Loopback only.",
      "advanced": true
    }
  },
  "configContracts": {
    "secretInputs": {
      "paths": [{ "path": "realtime.providers.*.apiKey", "expected": "string" }]
    }
  }
}
