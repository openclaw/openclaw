{
  "id": "beam",
  "categories": ["developer-tools"],
  "activation": {
    "onStartup": false,
    "onCommands": ["beam"],
    "onConfigPaths": ["plugins.entries.beam"]
  },
  "contracts": { "gatewayMethodDispatch": ["authenticated-request"] },
  "cliCommands": [
    {
      "name": "beam",
      "description": "Inspect the installed Beam connector",
      "hasSubcommands": true
    }
  ],
  "commandAliases": [{ "name": "beam", "kind": "cli" }],
  "configContracts": {
    "secretInputs": {
      "bundledDefaultEnabled": false,
      "paths": [{ "path": "mirror.token", "expected": "string", "ownerKind": "capability" }]
    }
  },
  "uiHints": {
    "mirror.endpoint": {
      "label": "Mirror Endpoint",
      "help": "Final receiver URL. Use /api/v1/beam/sessions for existing mirrors or /api/v2/beam for explicitly enrolled independent publications. Connect as an administrator and call beam.mirror.enroll with the full source locator."
    },
    "mirror.token": {
      "label": "Mirror Token",
      "help": "Gateway credential for the remote receiver, sent as a Bearer token.",
      "sensitive": true
    }
  },
  "configGroups": [
    {
      "id": "session-mirroring",
      "title": "Session mirroring",
      "order": 10,
      "properties": ["mirror"]
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "mirror": {
        "type": "object",
        "additionalProperties": false,
        "required": ["endpoint", "catalogs"],
        "properties": {
          "endpoint": {
            "type": "string"
          },
          "token": {
            "type": ["string", "object"]
          },
          "catalogs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pollSeconds": {
            "type": "number"
          },
          "activeWindowMinutes": {
            "type": "number"
          }
        }
      }
    }
  },
  "recommendedPrompts": [
    "Explain how to share a sanitized coding-session snapshot with Beam.",
    "Compare Beam snapshots with Session Share for read-only team visibility."
  ]
}
