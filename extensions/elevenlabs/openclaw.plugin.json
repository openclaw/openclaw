{
  "id": "elevenlabs",
  "categories": ["voice"],
  "capabilityCatalogEntry": "./capability-catalog.ts",
  "doctorContract": {
    "configRepair": true
  },
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": true,
  "setup": {
    "providers": [
      {
        "id": "elevenlabs",
        "envVars": ["ELEVENLABS_API_KEY", "XI_API_KEY"]
      }
    ]
  },
  "contracts": {
    "speechProviders": ["elevenlabs"],
    "mediaUnderstandingProviders": ["elevenlabs"],
    "realtimeTranscriptionProviders": ["elevenlabs"]
  },
  "mediaUnderstandingProviderMetadata": {
    "elevenlabs": {
      "capabilities": ["audio"],
      "defaultModels": {
        "audio": "scribe_v2"
      },
      "autoPriority": {
        "audio": 45
      }
    }
  },
  "configContracts": {
    "compatibilityMigrationPaths": [
      "talk.voiceId",
      "talk.voiceAliases",
      "talk.modelId",
      "talk.outputFormat",
      "talk.apiKey",
      "tts.providers.elevenlabs.model",
      "tts.personas.*.providers.elevenlabs.model",
      "agents.entries.*.tts.providers.elevenlabs.model",
      "agents.entries.*.tts.personas.*.providers.elevenlabs.model",
      "channels.*.tts.providers.elevenlabs.model",
      "channels.*.voice.tts.providers.elevenlabs.model",
      "channels.*.accounts.*.tts.providers.elevenlabs.model",
      "channels.*.accounts.*.voice.tts.providers.elevenlabs.model",
      "talk.providers.elevenlabs.model"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  }
}
