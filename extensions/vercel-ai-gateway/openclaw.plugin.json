{
  "id": "vercel-ai-gateway",
  "categories": ["models"],
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": true,
  "providers": ["vercel-ai-gateway"],
  "contracts": {
    "decisionProviders": [
      "vercel-ai-gateway"
    ]
  },
  "decisionModels": [
    {
      "provider": "vercel-ai-gateway",
      "id": "typesafe-ai/jev",
      "name": "Jev (Vercel AI Gateway)"
    },
    {
      "provider": "vercel-ai-gateway",
      "id": "typesafe-ai/jev-1.13.0",
      "name": "Jev 1.13.0 (Vercel AI Gateway)"
    }
  ],
  "modelCatalog": {
    "discovery": {
      "vercel-ai-gateway": "refreshable"
    }
  },
  "modelIdNormalization": {
    "providers": {
      "vercel-ai-gateway": {
        "aliases": {
          "opus-4.6": "claude-opus-4-6",
          "sonnet-4.6": "claude-sonnet-4-6"
        },
        "prefixWhenBareAfterAliasStartsWith": [
          {
            "modelPrefix": "claude-",
            "prefix": "anthropic"
          }
        ]
      }
    }
  },
  "modelPricing": {
    "providers": {
      "vercel-ai-gateway": {
        "modelsDev": {
          "provider": "vercel",
          "passthroughProviderModel": true
        },
        "openRouter": {
          "passthroughProviderModel": true
        },
        "liteLLM": {
          "passthroughProviderModel": true
        }
      }
    }
  },
  "setup": {
    "providers": [
      {
        "id": "vercel-ai-gateway",
        "envVars": ["AI_GATEWAY_API_KEY"]
      }
    ]
  },
  "providerAuthChoices": [
    {
      "provider": "vercel-ai-gateway",
      "method": "api-key",
      "choiceId": "ai-gateway-api-key",
      "appGuidedSecret": true,
      "choiceLabel": "Vercel AI Gateway API key",
      "groupId": "ai-gateway",
      "groupLabel": "Vercel AI Gateway",
      "groupHint": "API key",
      "optionKey": "aiGatewayApiKey",
      "cliFlag": "--ai-gateway-api-key",
      "cliOption": "--ai-gateway-api-key <key>",
      "cliDescription": "Vercel AI Gateway API key"
    }
  ],
  "configContracts": {
    "secretInputs": {
      "bundledDefaultEnabled": false,
      "paths": [
        {
          "path": "apiKey",
          "expected": "string",
          "ownerKind": "capability"
        }
      ]
    }
  },
  "uiHints": {
    "apiKey": {
      "label": "Vercel AI Gateway credential",
      "help": "Select a SecretRef. Create protected credentials in Settings \u2192 Secrets. Never paste credentials in chat.",
      "sensitive": true
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "apiKey": {
        "type": "object",
        "required": [
          "source",
          "provider",
          "id"
        ],
        "properties": {
          "source": {
            "anyOf": [
              {
                "type": "string",
                "const": "env"
              },
              {
                "type": "string",
                "const": "store"
              },
              {
                "type": "string",
                "const": "file"
              },
              {
                "type": "string",
                "const": "exec"
              }
            ]
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "additionalProperties": false
      }
    }
  }
}
