{
  "id": "onnx",
  "nonSecretAuthMarkers": [
    "onnx-local"
  ],
  "name": "ONNX",
  "description": "Local typed decisions using pinned ONNX classifiers.",
  "categories": [
    "developer-tools"
  ],
  "enabledByDefault": false,
  "cliCommands": [
    {
      "name": "onnx",
      "description": "Manage local ONNX decision models",
      "hasSubcommands": true
    }
  ],
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "decisionProviders": [
      "onnx"
    ]
  },
  "uiHints": {
    "modelDir": {
      "label": "Model directory",
      "help": "Local model artifacts. Download models explicitly with openclaw onnx download."
    },
    "threads": {
      "label": "CPU inference threads",
      "advanced": true
    },
    "maxLoadedModels": {
      "label": "Resident model limit",
      "advanced": true
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "modelDir": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "threads": {
        "type": "integer",
        "minimum": 1,
        "maximum": 8,
        "default": 2
      },
      "maxLoadedModels": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5,
        "default": 2
      }
    }
  },
  "providers": [
    "onnx"
  ],
  "modelCatalog": {
    "providers": {
      "onnx": {
        "authScope": "plugin",
        "models": [
          {
            "id": "gliclass-edge-v3.0",
            "name": "GLiClass Edge v3",
            "inference": {
              "chat": false,
              "decision": {
                "protocol": "onnx-classifier",
                "confidence": "none",
                "input": [
                  "text"
                ],
                "questions": {
                  "boolean": {
                    "probabilities": "boolean",
                    "requiresCriteria": true,
                    "abstention": false
                  },
                  "choice": {
                    "probabilities": "categorical",
                    "abstention": false,
                    "minOptions": 2,
                    "maxOptions": 64
                  },
                  "score": {
                    "probabilities": "categorical",
                    "abstention": false,
                    "minOptions": 2,
                    "maxOptions": 64
                  }
                },
                "limits": {
                  "maxQuestions": 32,
                  "maxInputTokens": 512,
                  "inputTokenScope": "encoded-question"
                },
                "reasoning": {
                  "modes": [
                    "auto"
                  ]
                }
              }
            }
