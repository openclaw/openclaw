{
  "name": "@openclaw/memory-wiki",
  "version": "2026.10.5",
  "description": "OpenClaw persistent wiki plugin",
  "type": "module",
  "dependencies": {
    "mdast-util-from-markdown": "2.1.0",
    "typebox": "1.3.36",
    "yaml": "2.9.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@openclaw/memory-core": "workspace:*",
    "@openclaw/plugin-sdk": "workspace:*",
    "openclaw": "workspace:*"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.5"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@openclaw/memory-wiki",
      "npmSpec": "@openclaw/memory-wiki",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.9.4"
    },
    "compat": {
      "pluginApi": ">=2026.10.5"
    },
    "build": {
      "bundledDist": true,
      "openclawVersion": "2026.10.5",
      "workerEntries": [
        "./src/query-reader.worker.ts"
      ]
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/openclaw"
  }
}
