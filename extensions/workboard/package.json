{
  "name": "@openclaw/workboard",
  "version": "2026.10.6",
  "private": true,
  "description": "OpenClaw dashboard workboard plugin",
  "type": "module",
  "dependencies": {
    "@openclaw/gateway-protocol": "workspace:*",
    "@openclaw/workboard-contract": "workspace:*",
    "@solidjs/web": "2.0.0-rc.18",
    "solid-js": "2.0.0-rc.18",
    "typebox": "1.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@openclaw/gateway-client": "workspace:*",
    "@openclaw/normalization-core": "workspace:*",
    "@openclaw/plugin-sdk": "workspace:*",
    "@solidjs/compiler": "2.0.0-rc.18",
    "esbuild": "0.28.2",
    "openclaw": "workspace:*"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.6"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "controlUi": "./browser/index.ts",
    "assetScripts": {
      "build": "cd ../.. && node --import ./scripts/tsx.mjs scripts/build-plugin-control-ui.mts extensions/workboard",
      "copy": "cd ../.. && node --import ./scripts/tsx.mjs scripts/build-plugin-control-ui.mts extensions/workboard --copy",
      "buildOutputs": [
        "dist/openclaw.plugin.json"
      ]
    },
    "build": {
      "staticAssets": [
        {
          "source": "./src/workboard-schema.postgres.sql",
          "output": "./src/workboard-schema.postgres.sql"
        }
      ],
      "workerEntries": [
        "./src/sqlite-store.worker.ts"
      ]
    }
  }
}
