{
  "extends": "../tsconfig.package-boundary.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web"
  },
  "include": ["*.ts", "src/**/*.ts", "browser/**/*.ts", "browser/**/*.tsx"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "dist/**", "node_modules/**", "browser/test/**"]
}
