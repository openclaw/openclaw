            "contextWindow": 1000000,
            "maxTokens": 128000,
            "compat": { "supportsReasoningEffort": true, "codeMode": "preferred" }
          },
          {
            "id": "gpt-6-luna",
            "name": "gpt-6-luna",
            "reasoning": true,
            "input": ["text", "image"],
            "cost": {
              "input": 0.1,
              "output": 0.5,
              "cacheRead": 0.01,
              "cacheWrite": 0.125
            },
            "contextWindow": 1050000,
            "maxTokens": 128000,
            "compat": { "supportsReasoningEffort": true, "codeMode": "preferred" }
          },
          {
            "id": "gemini-3.8-flash",
            "name": "gemini-3.8-flash",
            "reasoning": true,
            "input": ["text", "image"],
            "cost": {
              "input": 0.75,
              "output": 3.75,
              "cacheRead": 0.075,
              "cacheWrite": 0
