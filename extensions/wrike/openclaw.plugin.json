{
  "id": "wrike",
  "name": "Wrike",
  "description": "Project and task workflows through Wrike's official MCP service.",
  "categories": [
    "productivity"
  ],
  "enabledByDefault": false,
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "mcpServers": {
    "wrike": {
      "url": "https://mcp.wrike.com/v2",
      "transport": "streamable-http",
      "headers": {
        "Authorization": "Bearer ${WRIKE_ACCESS_TOKEN}"
      }
    }
  }
}
