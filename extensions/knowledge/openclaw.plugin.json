{
  "id": "knowledge",
  "kind": "memory",
  "categories": ["memory"],
  "name": "Knowledge",
  "description": "Evidence-backed knowledge, inspectable in OpenClaw.",
  "version": "0.1.0",
  "reload": { "turnHandover": true },
  "configSchema": {
    "type": "object",
    "properties": {
      "operatorRead": {
        "type": "boolean"
      },
      "writesEnabled": {
        "type": "boolean"
      },
      "stores": {
        "type": "object",
        "patternProperties": {
          "^[a-z][a-z0-9-]{0,47}$": {
            "type": "object",
            "required": [
              "agents"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "agents": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                },
                "maxItems": 100
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "pageBudgets": {
        "type": "object",
        "properties": {
          "hubPercentile": {
            "type": "number",
            "minimum": 50,
            "maximum": 99.9,
            "description": "Authored-link degree percentile, within each store partition, at which a page counts as a hub and gets the smaller body budget. Default 90."
          }
        },
        "additionalProperties": false
      },
      "maintenance": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Run the scheduled maintenance pass over every configured store. Default true."
          },
          "schedule": {
            "type": "string",
            "minLength": 9,
            "maxLength": 100,
            "description": "Five-field cron expression. Default 30 3 * * * (03:30 daily)."
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "IANA time zone for the schedule. Default: the Gateway host's time zone."
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "doctorContract": {
    "configRepair": true
  },
  "activation": {
    "onStartup": true
  },
  "controlUi": {
    "entry": "dist/control-ui/60c08d9d3b59278097647bd1b8aa5c2ad6b102c4c93d91b4047f9033eba49aa0/index.js",
    "styles": [
      "dist/control-ui/60c08d9d3b59278097647bd1b8aa5c2ad6b102c4c93d91b4047f9033eba49aa0/index.css"
    ]
  },
  "skills": [
    "./skills"
  ],
  "contracts": {
