{
  "name": "@openclaw/knowledge",
  "version": "2026.10.7",
  "private": true,
  "description": "OpenClaw evidence-backed knowledge vault and memory provider",
  "type": "module",
  "dependencies": {
    "@openclaw/fs-safe": "0.26.13",
    "dompurify": "3.4.17",
    "marked": "18.1.1",
    "typebox": "1.4.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*",
    "esbuild": "0.28.2",
    "openclaw": "workspace:*"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.7"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "controlUi": "./src/control-ui.ts",
    "compat": {
      "pluginApi": ">=2026.10.7"
    },
    "build": {
      "bundledDist": true,
      "workerEntries": [
        "./src/registry-worker.ts",
        "./src/storage-worker.ts"
      ],
      "staticAssets": [
        {
          "source": "./ontologies/knowledge-default.yaml",
          "output": "ontologies/knowledge-default.yaml"
        },
        {
          "source": "./fixtures/sample-vault/README.md",
          "output": "fixtures/sample-vault/README.md"
        },
        {
          "source": "./fixtures/sample-vault/RESOLVER.md",
          "output": "fixtures/sample-vault/RESOLVER.md"
        },
        {
          "source": "./fixtures/sample-vault/artifacts/planning-meeting.txt",
          "output": "fixtures/sample-vault/artifacts/planning-meeting.txt"
        },
        {
          "source": "./fixtures/sample-vault/claims/pilot-decision.md",
          "output": "fixtures/sample-vault/claims/pilot-decision.md"
        },
        {
          "source": "./fixtures/sample-vault/companies/harbor-collective.md",
          "output": "fixtures/sample-vault/companies/harbor-collective.md"
        },
        {
          "source": "./fixtures/sample-vault/meetings/planning.md",
          "output": "fixtures/sample-vault/meetings/planning.md"
        },
        {
          "source": "./fixtures/sample-vault/people/alex-rivera.md",
          "output": "fixtures/sample-vault/people/alex-rivera.md"
        },
        {
          "source": "./fixtures/sample-vault/projects/community-garden.md",
          "output": "fixtures/sample-vault/projects/community-garden.md"
        },
        {
          "source": "./fixtures/sample-vault/relationships/alex-leads-garden.md",
          "output": "fixtures/sample-vault/relationships/alex-leads-garden.md"
        },
        {
          "source": "./fixtures/sample-vault/relationships/harbor-supports-garden.md",
          "output": "fixtures/sample-vault/relationships/harbor-supports-garden.md"
        }
      ]
    },
    "assetScripts": {
      "build": "cd ../.. && node --import ./scripts/tsx.mjs scripts/build-plugin-control-ui.mts extensions/knowledge",
      "copy": "cd ../.. && node --import ./scripts/tsx.mjs scripts/build-plugin-control-ui.mts extensions/knowledge --copy",
      "buildOutputs": [
        "dist/openclaw.plugin.json"
      ]
    }
  }
}
