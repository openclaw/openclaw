{
  "id": "nace",
  "name": "Nace",
  "categories": [
    "models"
  ],
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": true,
  "providers": [
    "nace"
  ],
  "providerEndpoints": [
    {
      "endpointClass": "nace-native",
      "hosts": [
        "console.nace.ai"
      ]
    }
  ],
  "setup": {
    "providers": [
      {
        "id": "nace",
        "envVars": [
          "NACE_API_KEY"
        ]
      }
    ]
  },
  "providerAuthChoices": [
    {
      "provider": "nace",
      "method": "api-key",
      "choiceId": "nace-api-key",
      "appGuidedSecret": true,
      "credentialOnly": true,
      "choiceLabel": "Nace API key",
      "groupId": "nace",
      "groupLabel": "Nace",
      "groupHint": "Native Decision models",
      "optionKey": "naceApiKey",
      "cliFlag": "--nace-api-key",
      "cliOption": "--nace-api-key <key>",
      "cliDescription": "Nace API key"
    }
  ],
  "contracts": {
    "decisionProviders": [
      "nace"
    ]
  },
  "modelCatalog": {
    "providers": {
      "nace": {
        "baseUrl": "https://console.nace.ai/v1",
        "models": [
          {
            "id": "drex-max-v1.1",
            "name": "Drex Max v1.1",
            "input": [
              "text"
            ],
            "inference": {
              "chat": false,
              "decision": {
                "protocol": "openai-decisions",
                "input": [
                  "text"
                ],
                "questions": {
                  "boolean": {
                    "probabilities": "boolean",
                    "abstention": false
                  },
                  "choice": {
                    "probabilities": "categorical",
                    "abstention": false,
                    "minOptions": 2,
                    "maxOptions": 255
                  },
                  "score": {
                    "probabilities": "categorical",
                    "abstention": false,
                    "minOptions": 2,
                    "maxOptions": 255
                  }
                },
                "confidence": "provider-specific",
                "reasoning": {
                  "modes": [
                    "auto"
                  ]
                },
                "limits": {
                  "maxQuestions": 400,
                  "maxRequestTokens": 262144
                }
              }
            }
          }
        ]
      }
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  }
}
