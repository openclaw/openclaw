      "choiceLabel": "Particle API key",
      "groupId": "particle",
      "groupLabel": "Particle",
      "groupHint": "API key",
      "optionKey": "particleApiKey",
      "cliFlag": "--particle-api-key",
      "cliOption": "--particle-api-key <key>",
      "cliDescription": "Particle API key"
    }
  ],
  "modelCatalog": {
