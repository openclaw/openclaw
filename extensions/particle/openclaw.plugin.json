                "low": "low",
                "medium": "high",
                "high": "high",
                "xhigh": "high",
                "max": "max"
              },
              "supportedReasoningEfforts": [
                "none",
                "low",
                "high",
                "max"
              ],
              "thinkingFormat": "openai",
              "defaultThinkingLevel": "high"
            }
          }
        ]
      }
    }
  },
  "modelIdNormalization": {
