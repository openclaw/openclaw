  "description": "OpenClaw on-device Apple Foundation Models provider",
  "type": "module",
  "dependencies": { "zod": "4.5.4" },
  "devDependencies": { "@openclaw/plugin-sdk": "workspace:*" },
  "openclaw": {
    "extensions": ["./index.ts"],
