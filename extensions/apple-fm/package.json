{
  "name": "@openclaw/apple-fm-provider",
  "version": "2026.10.5-beta.2",
  "private": true,
  "description": "OpenClaw on-device Apple Foundation Models provider",
  "type": "module",
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "build": {
      "openclawVersion": "2026.10.5-beta.2",
      "staticAssets": [
        {
          "source": "./assets/AppleFoundationModels.swift",
          "output": "assets/AppleFoundationModels.swift"
        }
      ]
    }
  }
}
