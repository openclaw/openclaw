{
  "id": "typesafe",
  "name": "TypeSafe AI",
  "description": "Typed decision provider for hosted Jev and local System One models.",
  "categories": [
    "developer-tools"
  ],
  "enabledByDefault": false,
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "decisionProviders": [
      "typesafe"
    ]
  },
  "configContracts": {
    "secretInputs": {
      "bundledDefaultEnabled": false,
      "paths": [
        {
          "path": "apiKey",
          "expected": "string",
          "ownerKind": "capability"
        }
      ]
    }
  },
  "uiHints": {
    "apiKey": {
      "label": "TypeSafe API credential",
      "help": "Hosted Jev only. Select a SecretRef in Settings \u2192 Secrets. Ignored for a local baseUrl or an explicit models.providers.typesafe entry. Configure custom server credentials on that provider entry. Never paste credentials in chat.",
      "sensitive": true
    },
    "timeoutMs": {
      "label": "Request timeout (ms)",
      "advanced": true
    },
    "baseUrl": {
      "label": "Local System One origin",
      "help": "Existing loopback-only origin, such as http://127.0.0.1:8009, for a running Kev server. For custom endpoints, authentication, proxy, and TLS settings, use models.providers.typesafe. A model-provider entry takes precedence over this setting. Without either, requests use hosted Jev."
    }
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "apiKey": {
        "type": "object",
        "required": [
          "source",
          "provider",
          "id"
        ],
        "properties": {
          "source": {
            "anyOf": [
              {
                "type": "string",
                "const": "env"
              },
              {
                "type": "string",
                "const": "store"
              },
              {
                "type": "string",
                "const": "file"
              },
              {
                "type": "string",
                "const": "exec"
              }
            ]
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "additionalProperties": false
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 60000,
        "default": 30000
      },
      "baseUrl": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^https?://(?:localhost|127\\.0\\.0\\.1|\\[::1\\])(?::[0-9]{1,5})?/?$"
      }
    },
    "additionalProperties": false
  },
  "providers": [
    "typesafe"
  ],
  "modelCatalog": {
    "providers": {
      "typesafe": {
        "models": [
          {
            "id": "jev-latest",
            "name": "Jev",
            "baseUrl": "https://api.typesafe.ai/v1",
            "inference": {
              "chat": false,
              "decision": {
                "protocol": "typesafe-systemone",
                "input": [
                  "text",
                  "image"
                ],
                "questions": {
                  "boolean": {
                    "probabilities": "boolean",
                    "abstention": false
                  },
                  "choice": {
                    "probabilities": "provider-defined",
                    "abstention": false,
                    "minOptions": 2,
                    "maxOptions": 255
                  },
                  "score": {
                    "probabilities": "provider-defined",
                    "abstention": false,
                    "minOptions": 2,
                    "maxOptions": 10
                  }
                },
                "reasoning": {
                  "modes": ["auto"]
                },
                "confidence": "provider-specific",
                "limits": {
                  "image": {
                    "maxBytes": 4194304,
                    "mimeTypes": ["image/png", "image/jpeg"],
                    "remoteUrls": false
                  }
                }
              }
            }
          },
          {
            "id": "jev-preview",
            "name": "Jev Preview",
            "baseUrl": "https://api.typesafe.ai/v1",
            "status": "preview",
            "inference": {
              "chat": false,
              "decision": {
                "protocol": "typesafe-systemone",
                "input": [
                  "text",
                  "image"
                ],
                "questions": {
                  "boolean": {
                    "probabilities": "boolean",
                    "abstention": false
                  },
                  "choice": {
                    "probabilities": "provider-defined",
                    "abstention": false,
                    "minOptions": 2,
                    "maxOptions": 255
                  },
                  "score": {
                    "probabilities": "provider-defined",
                    "abstention": false,
                    "minOptions": 2,
                    "maxOptions": 10
                  }
                },
                "reasoning": {
                  "modes": ["auto"]
                },
                "confidence": "provider-specific",
                "limits": {
                  "image": {
                    "maxBytes": 4194304,
                    "mimeTypes": ["image/png", "image/jpeg"],
                    "remoteUrls": false
                  }
                }
              }
            }
          },
          {
            "id": "jev-1.13.0",
            "name": "Jev 1.13.0",
            "baseUrl": "https://api.typesafe.ai/v1",
            "inference": {
              "chat": false,
              "decision": {
                "protocol": "typesafe-systemone",
                "input": [
                  "text",
                  "image"
                ],
                "questions": {
                  "boolean": {
                    "probabilities": "boolean",
                    "abstention": false
                  },
                  "choice": {
                    "probabilities": "provider-defined",
                    "abstention": false,
                    "minOptions": 2,
                    "maxOptions": 255
                  },
                  "score": {
                    "probabilities": "provider-defined",
                    "abstention": false,
                    "minOptions": 2,
                    "maxOptions": 10
                  }
                },
                "reasoning": {
                  "modes": ["auto"]
                },
                "confidence": "provider-specific",
                "limits": {
                  "image": {
                    "maxBytes": 4194304,
                    "mimeTypes": ["image/png", "image/jpeg"],
                    "remoteUrls": false
                  },
                  "maxRequestTokens": 64000,
                  "maxStateAndQuestionTokens": 32000
                },
                "billing": {
                  "unit": "tokens",
                  "source": "provider-docs",
                  "usdPerMillion": {
                    "input": 0.042,
                    "output": 0
                  }
                }
              }
            }
          },
          {
            "id": "kev-latest",
            "name": "Kev (local server)",
            "inference": {
              "chat": false,
              "decision": {
                "protocol": "typesafe-systemone",
                "input": [
                  "text"
                ],
                "questions": {
                  "boolean": {
                    "probabilities": "boolean",
                    "abstention": false
                  },
                  "choice": {
                    "probabilities": "provider-defined",
                    "abstention": false,
                    "minOptions": 2,
                    "maxOptions": 255
                  },
                  "score": {
                    "probabilities": "provider-defined",
                    "abstention": false,
                    "minOptions": 2,
                    "maxOptions": 10
                  }
                },
                "reasoning": {
                  "modes": ["auto"]
                },
                "confidence": "provider-specific"
              }
            }
          }
        ],
        "authScope": "plugin"
      }
    }
  },
  "modelPricing": {
    "providers": {
      "typesafe": {
        "external": false
      }
    }
  },
  "nonSecretAuthMarkers": [
    "typesafe-local"
  ]
}
