{
  "id": "typesafe",
  "name": "TypeSafe AI",
  "description": "Typed decision provider for hosted Jev and local System One models.",
  "categories": [
    "developer-tools"
  ],
  "enabledByDefault": false,
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "decisionProviders": [
      "typesafe"
    ]
  },
  "configContracts": {
    "secretInputs": {
      "bundledDefaultEnabled": false,
      "paths": [
        {
          "path": "apiKey",
          "expected": "string",
          "ownerKind": "capability"
        }
      ]
    }
  },
  "uiHints": {
    "apiKey": {
      "label": "TypeSafe API credential",
      "help": "Hosted Jev only. Add a key through Settings → Models → Connect provider, or use an existing SecretRef. Ignored for a local baseUrl. Never paste credentials in chat.",
      "sensitive": true
    },
    "timeoutMs": {
      "label": "Request timeout (ms)",
      "advanced": true
    },
    "baseUrl": {
      "label": "Local System One origin",
      "help": "Optional loopback origin, such as http://127.0.0.1:8009, for a running Kev server. Omit for hosted Jev. Local requests do not use the TypeSafe credential; the server chooses the loaded checkpoint."
    }
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "apiKey": {
        "type": "object",
        "required": [
          "source",
          "provider",
          "id"
        ],
        "properties": {
          "source": {
            "anyOf": [
              {
                "type": "string",
                "const": "env"
              },
              {
                "type": "string",
                "const": "store"
              },
              {
                "type": "string",
                "const": "file"
              },
              {
                "type": "string",
                "const": "exec"
              }
            ]
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "additionalProperties": false
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 60000,
        "default": 30000
      },
      "baseUrl": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^https?://(?:localhost|127\\.0\\.0\\.1|\\[::1\\])(?::[0-9]{1,5})?/?$"
      }
    },
    "additionalProperties": false
  },
  "decisionModels": [
    {
      "provider": "typesafe",
      "id": "jev-latest",
      "name": "Jev",
      "setup": [
        {
          "kind": "local-server",
          "label": "TypeSafe",
          "help": "Start your System One server separately and set its loopback origin in the plugin settings. No API key is needed. The server chooses the checkpoint; this connection applies to every model from this plugin. OpenClaw does not verify the server or download weights here.",
          "configuredPath": "baseUrl",
          "documentationUrl": "https://docs.openclaw.ai/plugins/typesafe#local-system-one-server",
          "whenConfigured": "baseUrl"
        },
        {
          "kind": "api-key",
          "label": "TypeSafe",
          "help": "Add your TypeSafe API key. It is stored securely. Saving a key does not verify it or run a paid evaluation.",
          "credentialPath": "apiKey",
          "documentationUrl": "https://docs.openclaw.ai/plugins/typesafe"
        }
      ],
      "capabilities": {
        "questionTypes": [
          "boolean",
          "choice",
          "score"
        ],
        "maxQuestions": 256,
        "maxChoiceAlternatives": 255,
        "maxScoreLevels": 10,
        "confidence": "provider-specific"
      }
    },
    {
      "provider": "typesafe",
      "id": "jev-1.13.0",
      "name": "Jev 1.13.0",
      "setup": [
        {
          "kind": "local-server",
          "label": "TypeSafe",
          "help": "Start your System One server separately and set its loopback origin in the plugin settings. No API key is needed. The server chooses the checkpoint; this connection applies to every model from this plugin. OpenClaw does not verify the server or download weights here.",
          "configuredPath": "baseUrl",
          "documentationUrl": "https://docs.openclaw.ai/plugins/typesafe#local-system-one-server",
          "whenConfigured": "baseUrl"
        },
        {
          "kind": "api-key",
          "label": "TypeSafe",
          "help": "Add your TypeSafe API key. It is stored securely. Saving a key does not verify it or run a paid evaluation.",
          "credentialPath": "apiKey",
          "documentationUrl": "https://docs.openclaw.ai/plugins/typesafe"
        }
      ],
      "capabilities": {
        "questionTypes": [
          "boolean",
          "choice",
          "score"
        ],
        "maxQuestions": 256,
        "maxChoiceAlternatives": 255,
        "maxScoreLevels": 10,
        "confidence": "provider-specific"
      }
    },
    {
      "provider": "typesafe",
      "id": "kev-latest",
      "name": "Kev (local server)",
      "setup": [
        {
          "kind": "local-server",
          "label": "TypeSafe",
          "help": "Start your System One server separately and set its loopback origin in the plugin settings. No API key is needed. The server chooses the checkpoint; this connection applies to every model from this plugin. OpenClaw does not verify the server or download weights here.",
          "configuredPath": "baseUrl",
          "documentationUrl": "https://docs.openclaw.ai/plugins/typesafe#local-system-one-server"
        }
      ],
      "capabilities": {
        "questionTypes": [
          "boolean",
          "choice",
          "score"
        ],
        "maxQuestions": 256,
        "maxChoiceAlternatives": 255,
        "maxScoreLevels": 10,
        "confidence": "provider-specific"
      }
    }
  ]
}
