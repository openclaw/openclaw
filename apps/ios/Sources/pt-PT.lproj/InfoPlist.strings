/* OpenClaw source: "OpenClaw uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsFullAccessUsageDescription" = "O OpenClaw utiliza os seus calendários para mostrar eventos e contexto de agendamento quando ativa o acesso ao calendário.";
/* OpenClaw source: "OpenClaw uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsUsageDescription" = "O OpenClaw utiliza os seus calendários para mostrar eventos e contexto de agendamento quando ativa o acesso ao calendário.";
/* OpenClaw source: "OpenClaw uses your calendars to add events when you enable calendar access." */
"NSCalendarsWriteOnlyAccessUsageDescription" = "O OpenClaw utiliza os seus calendários para adicionar eventos quando ativa o acesso ao calendário.";
/* OpenClaw source: "OpenClaw uses the camera when you scan a Gateway setup QR code or ask your paired Gateway or assistant to capture a photo or short video from this iPhone, for example to connect to your Gateway or show your assistant a document, device screen, or workspace." */
"NSCameraUsageDescription" = "O OpenClaw utiliza a câmara quando lê um código QR de configuração do Gateway ou pede ao Gateway emparelhado ou ao assistente para captar uma fotografia ou um vídeo curto com este iPhone, por exemplo, para se ligar ao Gateway ou mostrar ao assistente um documento, o ecrã de um dispositivo ou um espaço de trabalho.";
/* OpenClaw source: "OpenClaw uses your contacts so you can search and reference people while using the assistant." */
"NSContactsUsageDescription" = "O OpenClaw utiliza os seus contactos para que possa procurar e referenciar pessoas enquanto utiliza o assistente.";
/* OpenClaw source: "OpenClaw reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "O OpenClaw lê os seus passos, sono, frequência cardíaca em repouso e treinos da aplicação Apple Health para criar os resumos que solicita e enviá-los através do seu Gateway para o fornecedor de IA configurado.";
/* OpenClaw source: "OpenClaw does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "O OpenClaw não grava dados na aplicação Apple Health. Utiliza dados apenas de leitura para criar os resumos que solicita e enviá-los através do seu Gateway para o fornecedor de IA que configurou.";
/* OpenClaw source: "OpenClaw discovers and connects to your OpenClaw gateway on the local network." */
"NSLocalNetworkUsageDescription" = "O OpenClaw deteta e liga-se ao seu Gateway OpenClaw na rede local.";
/* OpenClaw source: "OpenClaw can share your location in the background when you enable Always." */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "O OpenClaw pode partilhar a sua localização em segundo plano quando ativa a opção Always.";
/* OpenClaw source: "OpenClaw uses your location when you allow location sharing." */
"NSLocationWhenInUseUsageDescription" = "O OpenClaw utiliza a sua localização quando permite a partilha de localização.";
/* OpenClaw source: "OpenClaw uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "O OpenClaw utiliza o microfone para conversas em tempo real, ativação por voz, premir para falar e notas de voz.";
/* OpenClaw source: "OpenClaw may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "O OpenClaw pode utilizar dados de movimento para permitir interações e automatizações adaptadas ao dispositivo.";
/* OpenClaw source: "OpenClaw lets your assistant read photos you allow and lets you choose photos to share." */
"NSPhotoLibraryUsageDescription" = "O OpenClaw permite que o seu assistente leia as fotografias cujo acesso autorizar e permite-lhe escolher fotografias para partilhar.";
/* OpenClaw source: "OpenClaw uses your reminders to list, add, and complete tasks when you enable reminders access." */
"NSRemindersFullAccessUsageDescription" = "O OpenClaw utiliza os seus lembretes para listar, adicionar e concluir tarefas quando ativa o acesso aos lembretes.";
/* OpenClaw source: "OpenClaw uses on-device speech recognition for talk mode and voice wake." */
"NSSpeechRecognitionUsageDescription" = "O OpenClaw utiliza o reconhecimento de voz no dispositivo para o modo de conversação e a ativação por voz.";
