<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OpenClawWear" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
    <style name="Theme.OpenClawWear.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <!-- An explicit icon background prevents the system from enlarging the launcher artwork. -->
        <item name="windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
        <item name="postSplashScreenTheme">@style/Theme.OpenClawWear</item>
    </style>
</resources>
