# Copy this file to .env and fill in your OpenClaw Gateway credentials.
# Keep the Gateway on localhost/private network. Never commit your real .env.
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789/v1/chat/completions
OPENCLAW_MODEL=openclaw/default
OPENCLAW_GATEWAY_TOKEN=replace_with_your_gateway_token
SHOPMINI_PORT=4173
