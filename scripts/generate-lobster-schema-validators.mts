import { createHash } from "node:crypto";
import { createRequire } from "node:module";
import path from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";
import { isRecord } from "@openclaw/normalization-core/record-coerce";
import { Ajv } from "ajv";
import standalone from "ajv/dist/standalone/index.js";
import { format } from "oxfmt";
import { writeGeneratedOutput } from "./lib/generated-output-utils.mts";

const repoRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const schemaPath = "dist/src/commands/stdlib/llm_invoke_schemas.js";
const outputPath = "dist/src/commands/stdlib/llm_invoke_validators.generated.js";

export async function generateLobsterValidators(options: {
  check?: boolean;
  packageDirectory?: string;
}): Promise<void> {
  if (!options.check && !options.packageDirectory) {
    throw new Error("Regenerate inside a pnpm patch directory with --package-dir <directory>");
  }
  const packageDirectory = options.packageDirectory
    ? path.resolve(options.packageDirectory)
    : path.resolve(
        path.dirname(
          createRequire(path.join(repoRoot, "extensions/lobster/package.json")).resolve(
            "@clawdbot/lobster/core",
          ),
        ),
        "../../..",
      );
  const schemas: unknown = await import(
    pathToFileURL(path.join(packageDirectory, schemaPath)).href
  );
  if (!isRecord(schemas)) {
    throw new Error("Lobster schema module must export its fixed schemas");
  }
  const { payloadSchema, responseSchema } = schemas;
  if (!isRecord(payloadSchema) || !isRecord(responseSchema)) {
    throw new Error("Lobster payload and response schemas must be objects");
  }
  const ajv = new Ajv({
    allErrors: true,
    strict: false,
    code: { source: true, esm: true, lines: true },
  });
  ajv.addSchema(payloadSchema, "lobster-payload");
  ajv.addSchema(responseSchema, "lobster-response");
  let source = standalone.default(ajv, {
    validatePayload: "lobster-payload",
    validateResponseEnvelope: "lobster-response",
  });
  // Inline Ajv's helper so native ESM and bundled ESM share its Unicode semantics.
  const helper = 'require("ajv/dist/runtime/ucs2length").default';
  const require = createRequire(import.meta.url);
  const ajvPackage: unknown = require("ajv/package.json");
  if (!isRecord(ajvPackage) || typeof ajvPackage.version !== "string") {
    throw new Error("Ajv package version is unavailable");
  }
  let provenance = `// Ajv ${ajvPackage.version} standalone validators.\n`;
  if (source.includes(helper)) {
    const runtime: unknown = require("ajv/dist/runtime/ucs2length.js");
    if (!isRecord(runtime) || typeof runtime.default !== "function") {
      throw new Error("Ajv Unicode-length helper is unavailable");
    }
    const helperSource = runtime.default.toString();
    const helperHash = createHash("sha256").update(helperSource).digest("hex");
    provenance += `// Unicode-length helper SHA-256: ${helperHash}\n`;
    source = source.replaceAll(helper, `(${helperSource})`);
  }
  if (source.includes("require(")) {
    throw new Error("Unhandled Ajv standalone runtime import");
  }
  source = "// Generated by pnpm lobster:validators:gen. Do not edit.\n" + provenance + source;
  const formatted = await format(outputPath, source);
  if (formatted.errors.length) {
    throw new Error(`Cannot format Lobster validators: ${JSON.stringify(formatted.errors)}`);
  }
  const output = writeGeneratedOutput({
    check: options.check === true,
    next: formatted.code,
    outputPath,
    repoRoot: packageDirectory,
  });
  if (options.check && output.changed) {
    throw new Error("Lobster fixed validators are stale; regenerate the pnpm patch");
  }
  console.log(`[lobster:validators] ${output.changed ? "updated" : "unchanged"} ${outputPath}`);
}

if (import.meta.url === pathToFileURL(process.argv[1] ?? "").href) {
  const args = process.argv.slice(2);
  let check = false;
  let packageDirectory: string | undefined;
  for (let index = 0; index < args.length; index += 1) {
    if (args[index] === "--check") {
      check = true;
    } else if (args[index] === "--package-dir" && args[index + 1]) {
      packageDirectory = args[index + 1];
      index += 1;
    } else {
      throw new Error("Usage: pnpm lobster:validators:gen [--check] [--package-dir <directory>]");
    }
  }
  await generateLobsterValidators({ check, packageDirectory });
}
