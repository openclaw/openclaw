/** SQLite readers import the engine without needing its PostgreSQL constants. */
export function generateStatePostgresRuntimeSource(values: Record<string, unknown>): string {
  const fields = Object.entries(values).map(
    ([key, value]) => `
  get ${key}() {
    const value = ${JSON.stringify(value, null, 2)};
    Object.defineProperty(this, ${JSON.stringify(key)}, {
      value,
      enumerable: true,
      configurable: true,
      writable: true,
    });
    return value;
  },`,
  );
  return `// Generated by pnpm db:postgres:gen. Do not edit.\nexport const statePostgresRuntime = {${fields.join("\n")}\n};\n`;
}
