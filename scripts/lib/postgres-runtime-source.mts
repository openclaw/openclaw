/** Keep PostgreSQL payloads out of SQLite readers without changing synchronous getters. */
export function generatePostgresRuntimeFiles(
  outputName: string,
  exportName: string,
  values: Record<string, unknown>,
): Record<string, string> {
  const files: Record<string, string> = {};
  const header = "// Generated by pnpm db:postgres:gen. Do not edit.\n";
  const fields = Object.entries(values).map(([key, value]) => {
    const factoryName = `postgres-${outputName.replace(/\.ts$/u, "")}-${key}`;
    // A factory preserves a fresh mutable value for each getter receiver. Caching
    // a parsed object would share nested mutations across independent owners.
    files[`${factoryName}.ts`] =
      `${header}export default function createPostgresRuntimeValue() {\n  return ${JSON.stringify(value, null, 2)};\n}\n`;
    return `
  get ${key}() {
    const factory = createRequire(import.meta.url)("./${factoryName}.ts");
    const value = (
      // SAFETY: The generator emits this sibling factory with exactly this default export.
      factory as typeof import("./${factoryName}.js")
    ).default();
    Object.defineProperty(this, ${JSON.stringify(key)}, {
      value,
      enumerable: true,
      configurable: true,
      writable: true,
    });
    return value;
  },`;
  });
  files[outputName] =
    `${header}import { createRequire } from "node:module";\nexport const ${exportName} = {${fields.join("\n")}\n};\n`;
  return files;
}
