import { createHash } from "node:crypto";
import type { SqliteSchemaCatalog } from "../../src/infra/sqlite-schema-catalog-types.ts";
import { fingerprintSqliteSchemaCatalog } from "../../src/infra/sqlite-schema-fingerprint.ts";
import { formatGeneratedModule } from "./format-generated-module.mts";
import { readSqliteSchemaCatalog } from "./sqlite-schema-catalog.mts";
import type { SqliteSchemaInput } from "./sqlite-schema-inputs.mts";

type GeneratedCatalog = {
  id: string;
  aliases: string[];
  hash: string;
  fingerprint: string;
  catalog: SqliteSchemaCatalog;
};

const GENERATED_HEADER = "// Generated by pnpm db:postgres:gen. Do not edit.";
const CATALOG_TYPE_IMPORT =
  'import type { SqliteSchemaCatalog } from "../../infra/sqlite-schema-catalog-types.js";';

function storeReaderName(store: string, kind: "Catalog" | "Fingerprint"): string {
  return `readSqlite${store.replace(/(^|-)([a-z])/gu, (_, _prefix, letter: string) => letter.toUpperCase())}${kind}`;
}

function emitStoreCatalogs(store: string, catalogs: GeneratedCatalog[]) {
  const tables: SqliteSchemaCatalog["tables"][number][] = [];
  const tableIndexes = new Map<string, number>();
  const fullCatalogs: Record<string, { tables: number[]; views: SqliteSchemaCatalog["views"] }> =
    {};
  const entries = catalogs.map(({ id, aliases, hash, fingerprint, catalog }) => {
    const references = catalog.tables.map((table) => {
      const key = JSON.stringify(table);
      let index = tableIndexes.get(key);
      if (index === undefined) {
        index = tables.length;
        tableIndexes.set(key, index);
        tables.push(table);
      }
      return index;
    });
    fullCatalogs[hash] = { tables: references, views: catalog.views };
    return `// ${aliases.join(", ")}\n${JSON.stringify(hash)}: ${JSON.stringify([id, fingerprint, references, catalog.views.map(({ name }) => name)])}`;
  });
  // Share table/index names across fragments without loading any full catalog facts.
  const tableNames = tables.map((table) => [
    table.name,
    table.indexes.filter(({ origin }) => origin === "c").map(({ name }) => name),
  ]);
  return {
    json: `${JSON.stringify({ tables, catalogs: fullCatalogs })}\n`,
    module: `${GENERATED_HEADER}
import { readFileSync } from "node:fs";
${CATALOG_TYPE_IMPORT}
import type { GeneratedSqliteFingerprint } from "../../infra/sqlite-schema-fingerprint.js";

type CatalogReference = readonly [id: string, fingerprint: string, tables: readonly number[], views: readonly string[]];
const tableNames: readonly (readonly [string, readonly string[]])[] = ${JSON.stringify(tableNames)};
const fingerprints: Readonly<Record<string, CatalogReference>> = {
${entries.join(",\n")}
};

type CatalogData = {
  tables: SqliteSchemaCatalog["tables"];
  catalogs: Record<string, { tables: number[]; views: SqliteSchemaCatalog["views"] }>;
};
let data: CatalogData | undefined;

export function ${storeReaderName(store, "Fingerprint")}(hash: string): GeneratedSqliteFingerprint | undefined {
  const reference = fingerprints[hash];
  if (!reference) {
    return undefined;
  }
  const [id, fingerprint, tables, viewNames] = reference;
  return {
    id, fingerprint, viewNames,
    tableNames: tables.map((index) => tableNames[index]![0]),
    indexNames: tables.flatMap((index) => tableNames[index]![1]),
  };
}

export function ${storeReaderName(store, "Catalog")}(hash: string): SqliteSchemaCatalog | undefined {
  if (!fingerprints[hash]) {
    return undefined;
  }
  data ??= JSON.parse(readFileSync(new URL("./sqlite-${store}-catalogs.json", import.meta.url), "utf8")) as CatalogData; // SAFETY: Emitted with this loader from typed native catalog facts.
  const catalog = data.catalogs[hash]!;
  return { tables: catalog.tables.map((index) => data!.tables[index]!), views: catalog.views };
}
`,
  };
}

/** Evaluate declared or computed DDL only at build time; owners can initialize extensions first. */
export async function generateSqliteSchemaCatalogs(
  inputs: readonly SqliteSchemaInput[],
  repoRoot: string,
): Promise<Record<string, string>> {
  const { DatabaseSync } = await import("node:sqlite");
  const grouped = new Map<string, GeneratedCatalog[]>();
  const seen = new Map<string, GeneratedCatalog>();
  for (const { id, store, sql, prepare } of inputs) {
    const existing = seen.get(sql);
    if (existing) {
      existing.aliases.push(id);
      continue;
    }
    if (!/^[a-z]+(?:-[a-z]+)*$/u.test(store)) {
      throw new Error(`Invalid SQLite schema store name: ${store}`);
    }
    const hash = createHash("sha256").update(sql).digest("hex");
    const db = new DatabaseSync(":memory:", { allowExtension: true });
    try {
      await prepare?.(db);
      db.exec(sql);
      const catalog = readSqliteSchemaCatalog(db);
      const catalogs = grouped.get(store) ?? [];
      const generated = {
        id,
        aliases: [id],
        hash,
        fingerprint: fingerprintSqliteSchemaCatalog(catalog),
        catalog,
      };
      catalogs.push(generated);
      grouped.set(store, catalogs);
      seen.set(sql, generated);
    } catch (error) {
      throw new Error(`Could not generate SQLite schema catalog for ${id}`, { cause: error });
    } finally {
      db.close();
    }
  }

  const files: Record<string, string> = {};
  const stores = [...grouped.keys()];
  for (const store of stores) {
    const file = `sqlite-${store}-catalogs.ts`;
    const emitted = emitStoreCatalogs(store, grouped.get(store)!);
    files[file] = formatGeneratedModule(emitted.module, {
      repoRoot,
      outputPath: file,
      errorLabel: `SQLite ${store} fingerprints`,
    });
    files[`sqlite-${store}-catalogs.json`] = emitted.json;
  }
  files["sqlite-catalogs.ts"] = formatGeneratedModule(
    `${GENERATED_HEADER}
import { createHash } from "node:crypto";
${CATALOG_TYPE_IMPORT}
import type { GeneratedSqliteFingerprint } from "../../infra/sqlite-schema-fingerprint.js";
${stores.map((store) => `import { ${storeReaderName(store, "Catalog")}, ${storeReaderName(store, "Fingerprint")} } from "./sqlite-${store}-catalogs.js";`).join("\n")}

export function readGeneratedSqliteFingerprint(schemaSql: string): GeneratedSqliteFingerprint | undefined {
  const hash = createHash("sha256").update(schemaSql).digest("hex");
  return ${stores.map((store) => `${storeReaderName(store, "Fingerprint")}(hash)`).join(" ?? ") || "undefined"};
}

export function readGeneratedSqliteCatalog(schemaSql: string): SqliteSchemaCatalog | undefined {
  const hash = createHash("sha256").update(schemaSql).digest("hex");
  return ${stores.map((store) => `${storeReaderName(store, "Catalog")}(hash)`).join(" ?? ") || "undefined"};
}
`,
    { repoRoot, outputPath: "sqlite-catalogs.ts", errorLabel: "SQLite catalog dispatcher" },
  );
  return files;
}
