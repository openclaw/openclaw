/** Synthetic requester custody writer; setup outside wall/CPU/allocation measurements.
 * node --expose-gc --import ./scripts/tsx.mjs scripts/perf/subagent-requester-delivery-measure.mts
 *   <fixture> <output.json> <baseline|candidate> [baseline-source-directory] [allocation]
 * Run five interleaved A/B pairs and five A/A controls, serially. The fixture is
 * generated by team-shape-fixture.ts, never copied from an operator installation.
 * Acceptance: truthful custody, unchanged terminal receipt and no database scans.
 * Candidate may add one registry consumption commit; the existing transcript commit is unchanged.
 */
import assert from "node:assert/strict";
import { randomUUID } from "node:crypto";
import { existsSync, readFileSync, writeFileSync } from "node:fs";
import { Session } from "node:inspector/promises";
import { registerHooks } from "node:module";
import { loadavg } from "node:os";
import path from "node:path";
import { fileURLToPath } from "node:url";
const [fixture, output, arm, overlay, allocation] = process.argv.slice(2);
assert(fixture && output && (arm === "baseline" || arm === "candidate") && global.gc);
const root = process.cwd();
process.env.OPENCLAW_STATE_DIR = fixture;
process.env.OPENCLAW_HOME = fixture;
process.env.OPENCLAW_CONFIG_PATH = path.join(fixture, "openclaw.json");
if (overlay && overlay !== "-") {
  registerHooks({
    load(url, context, next) {
      if (url.startsWith("file:")) {
        const relative = path.relative(root, fileURLToPath(url));
        const replacement = path.join(overlay, relative);
        if (!relative.startsWith("..") && existsSync(replacement)) {
          return {
            format: "module-typescript",
            source: readFileSync(replacement, "utf8"),
            shortCircuit: true,
          };
        }
      }
      return next(url, context);
    },
  });
}
const {
  openOpenClawStateDatabase,
  runOpenClawStateWriteTransaction,
  closeOpenClawStateDatabaseAsync,
} = await import("../../src/state/openclaw-state-db.ts");
const { bindSubagentRunRecord } =
  await import("../../src/agents/subagents/registry/subagent-registry.store.codec.ts");
const { writeSubagentRunValuesInDatabase } =
  await import("../../src/agents/subagents/registry/subagent-registry.store.kernel.ts");
const { mutateSubagentCompletionInDatabase } =
  await import("../../src/agents/subagents/completion/subagent-completion-mutation.kernel.ts");
const { runOpenClawAgentWriteTransaction, closeOpenClawAgentDatabasesAsync } =
  await import("../../src/state/openclaw-agent-db.ts");
const { writeSessionEntry } =
  await import("../../src/config/sessions/session-accessor.sqlite-entry-store.ts");
const { appendTranscriptEventsInTransaction } =
  await import("../../src/config/sessions/session-accessor.sqlite-transcript-store.ts");
const { resolveSqliteTranscriptScope } =
  await import("../../src/config/sessions/session-accessor.sqlite-scope.ts");
const { subagentRuns, compactSubagentRunForMemory } =
  await import("../../src/agents/subagents/registry/subagent-registry-memory.ts");
const iteration = randomUUID();
const database = openOpenClawStateDatabase();
const summary = JSON.parse(readFileSync(path.join(fixture, "team-shape-summary.json"), "utf8"));
assert(summary.format === "openclaw-team-shape-v1");
const batches: import("../../src/agents/subagents/registry/subagent-registry.types.js").SubagentRunRecord[][] =
  Array.from({ length: 30 }, (_, i) => {
    const ids = [0, 1].map((j) => `custody-measure-${i}-${j}`);
    return ids.map((runId) => ({
      runId,
      childSessionKey: `agent:main:subagent:${runId}`,
      requesterSessionKey: `agent:main:requester-${i}`,
      requesterAgentId: "main",
      completionRequesterSessionId: `custody-requester-${iteration}-${i}`,
      requesterDisplayKey: "synthetic",
      task: "synthetic result",
      cleanup: "keep",
      createdAt: 1,
      expectsCompletionMessage: true,
      completionTarget: "parent",
      execution: { status: "terminal", endedAt: 2, outcome: { status: "ok" } },
      completion: { required: true, capturedAt: 2, resultText: "Synthetic child result" },
      delivery: { status: "pending" },
      requesterSettleWake: {
        status: "pending",
        attemptCount: 0,
        batchRunIds: ids,
        rearmGeneration: 1,
      },
    }));
  });
const transaction = <T,>(operation: () => T) =>
  runOpenClawStateWriteTransaction(operation, { database });
transaction(() =>
  writeSubagentRunValuesInDatabase(database, batches.flat().map(bindSubagentRunRecord), []),
);
runOpenClawAgentWriteTransaction(
  (agent) => {
    for (const batch of batches) {
      writeSessionEntry(agent, batch[0]!.requesterSessionKey, {
        sessionId: batch[0]!.completionRequesterSessionId!,
        updatedAt: Date.now(),
      });
    }
  },
  { agentId: "main" },
);
const scopes = batches.map((batch) =>
  resolveSqliteTranscriptScope({
    agentId: "main",
    sessionKey: batch[0]!.requesterSessionKey,
    sessionId: batch[0]!.completionRequesterSessionId!,
  }),
);
global.gc();
const inspector = new Session();
if (allocation === "allocation") {
  inspector.connect();
  await inspector.post("HeapProfiler.startSampling", {
    samplingInterval: 1024,
    includeObjectsCollectedByMajorGC: true,
    includeObjectsCollectedByMinorGC: true,
  });
}
const trials = [];
for (const [index, batch] of batches.entries()) {
  let entries = batch.map((subagent) => ({ subagent }));
  let commits = 0;
  type Mutation =
    import("../../src/agents/subagents/completion/subagent-completion-mutation.types.js").SubagentCompletionMutation;
  const mutate = (
    mutation:
      | Omit<Extract<Mutation, { kind: "requesterWake" }>, "entries">
      | Omit<Extract<Mutation, { kind: "requesterBatch" }>, "entries">,
  ) => {
    const result = transaction(() =>
      mutateSubagentCompletionInDatabase(database, { ...mutation, entries }),
    );
    commits++;
    assert(result.applied === true);
    entries = result.records.map((record) => ({ subagent: record.subagent }));
    for (const { subagent } of entries) {
      subagentRuns.set(subagent.runId, compactSubagentRunForMemory(subagent));
    }
  };
  const cpu = process.cpuUsage();
  const start = performance.now();
  const continuation = `continuation-${iteration}-${index}`;
  const inputIdempotencyKey = `${continuation}:user`;
  mutate({
    kind: "requesterWake",
    operation: {
      kind: "transition",
      state: { ...batch[0]!.requesterSettleWake, status: "dispatching", attemptCount: 1 },
      ...(arm === "candidate"
        ? {
            requesterDelivery: {
              state: "waiting" as const,
              runId: continuation,
              blockingRunId: `requester-${index}`,
            },
          }
        : {}),
    },
  });
  runOpenClawAgentWriteTransaction(
    (agent) => {
      appendTranscriptEventsInTransaction(agent, scopes[index]!, [
        {
          type: "message",
          id: `receipt-${iteration}-${index}`,
          parentId: null,
          timestamp: new Date().toISOString(),
          message: {
            role: "user",
            content: "Synthetic child result",
            timestamp: Date.now(),
            idempotencyKey: inputIdempotencyKey,
          },
        },
      ]);
    },
    { agentId: "main" },
  );
  if (arm === "candidate") {
    mutate({
      kind: "requesterWake",
      operation: {
        kind: "requesterDelivery",
        fact: { state: "consumed", runId: continuation, at: Date.now() },
      },
    });
  }
  mutate({
    kind: "requesterBatch",
    outcome: { delivered: true, path: "direct", deliveredAt: 4 },
    now: 5,
  });
  const wallMs = performance.now() - start;
  const used = process.cpuUsage(cpu);
  trials.push({ wallMs, cpuMs: (used.user + used.system) / 1000, commits, transcriptCommits: 1 });
  assert.equal(commits, arm === "candidate" ? 3 : 2);
  for (const { subagent } of entries) {
    assert.equal(subagent.delivery?.status, "delivered");
    assert.equal(subagent.requesterSettleWake, undefined);
    if (arm === "candidate") {
      assert.equal(subagent.delivery?.requesterDelivery?.state, "consumed");
    }
  }
}
let sampledBytes;
if (allocation === "allocation") {
  const { profile } = await inspector.post("HeapProfiler.stopSampling");
  sampledBytes = profile.samples.reduce((sum, sample) => sum + sample.size, 0);
  inspector.disconnect();
}
writeFileSync(
  output,
  JSON.stringify({
    arm,
    load: loadavg(),
    fixture,
    summary,
    cold: trials[0],
    warm: trials.slice(1),
    sampledBytes,
  }) + "\n",
  { flag: "wx" },
);
transaction(() =>
  writeSubagentRunValuesInDatabase(
    database,
    [],
    batches.flat().map((entry) => entry.runId),
  ),
);
subagentRuns.clear();
await closeOpenClawStateDatabaseAsync();

await closeOpenClawAgentDatabasesAsync();
