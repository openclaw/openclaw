import { existsSync, readFileSync, readdirSync, unlinkSync } from "node:fs";
import path from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";
import { parse } from "acorn";
import { transform } from "esbuild";
import { format } from "oxfmt";
import { IsRefinement, IsSchema, type TSchema } from "typebox";
import { AuditActivityListParamsSchema } from "../packages/gateway-protocol/src/schema/audit-activity.js";
import { AuditRunInspectParamsSchema } from "../packages/gateway-protocol/src/schema/audit-run.js";
import { WebPushVapidPublicKeyParamsSchema } from "../packages/gateway-protocol/src/schema/push.js";
import {
  hasValidNodeHostResources,
  hasValidSessionExecAction,
} from "../packages/gateway-protocol/src/schema/validation-invariants.js";
import { writeGeneratedOutput } from "./lib/generated-output-utils.mts";
import {
  compileStandaloneValidators,
  standaloneValidatorHeader,
} from "./lib/typebox-standalone.mts";

const repoRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const sourceRoot = path.join(repoRoot, "packages/gateway-protocol/src");
const outputRoot = path.join(sourceRoot, "compiled/protocol.generated");
const header = "// Generated by pnpm gateway:validators:gen; do not edit.\n";
// These schemas encode contracts beyond Static. Keep their owner types attached
// to the actual schema object, rather than trusting a caller-selected generic.
const authoredContracts = new Map<TSchema, { module: string; type: string }>([
  [
    AuditActivityListParamsSchema,
    { module: path.join(sourceRoot, "schema/audit-activity.ts"), type: "AuditActivityListParams" },
  ],
  [
    AuditRunInspectParamsSchema,
    { module: path.join(sourceRoot, "schema/audit-run.ts"), type: "AuditRunInspectParams" },
  ],
  [
    WebPushVapidPublicKeyParamsSchema,
    { module: path.join(sourceRoot, "schema/push.ts"), type: "WebPushVapidPublicKeyParams" },
  ],
]);

type Node = { type: string; [key: string]: unknown };
type ImportedName = { source: string; name?: string };
type SchemaBinding = { name: string; module: string; schema: TSchema };

function isNode(value: unknown): value is Node {
  return (
    typeof value === "object" && value !== null && "type" in value && typeof value.type === "string"
  );
}

function identifier(value: unknown): string | undefined {
  return isNode(value) && value.type === "Identifier" && typeof value.name === "string"
    ? value.name
    : undefined;
}

function* sourceFiles(directory: string): Generator<string> {
  for (const entry of readdirSync(directory, { withFileTypes: true }).toSorted((a, b) =>
    a.name.localeCompare(b.name),
  )) {
    if (entry.isDirectory() && entry.name !== "compiled") {
      yield* sourceFiles(path.join(directory, entry.name));
    } else if (
      entry.isFile() &&
      entry.name.endsWith(".ts") &&
      !/\.(?:test|test-support)\.ts$/.test(entry.name)
    ) {
      yield path.join(directory, entry.name);
    }
  }
}

function sourceModule(owner: string, specifier: string): string {
  const resolved = path.resolve(path.dirname(owner), specifier);
  const source = resolved.replace(/\.js$/, ".ts");
  if (!existsSync(source)) {
    throw new Error(`${owner}: schema source not found: ${specifier}`);
  }
  return source;
}

const modules = new Map<string, Promise<unknown>>();
async function schemaExport(module: string, name: string): Promise<TSchema> {
  let loaded = modules.get(module);
  if (!loaded) {
    loaded = import(pathToFileURL(module).href);
    modules.set(module, loaded);
  }
  const namespace = await loaded;
  const schema: unknown =
    typeof namespace === "object" && namespace !== null ? Reflect.get(namespace, name) : undefined;
  if (!IsSchema(schema)) {
    throw new Error(`${module}: ${name} must export its canonical TypeBox schema`);
  }
  return schema;
}

async function bindingsFor(owner: string): Promise<SchemaBinding[]> {
  // The authored schema argument remains the inventory. Erasing types before
  // parsing also handles compact explicit return types without duplicating it.
  const transformed = await transform(readFileSync(owner, "utf8"), { loader: "ts", format: "esm" });
  const program = parse(transformed.code, { ecmaVersion: "latest", sourceType: "module" });
  const imported = new Map<string, ImportedName>();
  const factories = new Set<string>();
  for (const statement of program.body) {
    if (!isNode(statement) || statement.type !== "ImportDeclaration" || !isNode(statement.source)) {
      continue;
    }
    const specifier = statement.source.value;
    if (typeof specifier !== "string" || !Array.isArray(statement.specifiers)) {
      continue;
    }
    for (const entry of statement.specifiers) {
      if (!isNode(entry)) {
        continue;
      }
      const local = identifier(entry.local);
      if (!local) {
        continue;
      }
      if (specifier.endsWith("/protocol-validator.js")) {
        factories.add(local);
      } else if (entry.type === "ImportNamespaceSpecifier") {
        imported.set(local, { source: specifier });
      } else if (entry.type === "ImportSpecifier") {
        imported.set(local, { source: specifier, name: identifier(entry.imported) });
      }
    }
  }
  if (factories.size === 0) {
    return [];
  }
  const bindings = new Map<string, SchemaBinding>();
  for (const exported of program.body) {
    const declaration =
      isNode(exported) && exported.type === "ExportNamedDeclaration"
        ? exported.declaration
        : exported;
    if (
      !isNode(declaration) ||
      declaration.type !== "VariableDeclaration" ||
      !Array.isArray(declaration.declarations)
    ) {
      continue;
    }
    for (const variable of declaration.declarations) {
      const call = isNode(variable) ? variable.init : undefined;
      if (
        !isNode(call) ||
        call.type !== "CallExpression" ||
        !factories.has(identifier(call.callee) ?? "") ||
        !Array.isArray(call.arguments)
      ) {
        continue;
      }
      const argument = call.arguments[0];
      let name = identifier(argument);
      let origin = name ? imported.get(name) : undefined;
      if (isNode(argument) && argument.type === "MemberExpression" && !argument.computed) {
        origin = imported.get(identifier(argument.object) ?? "");
        name = identifier(argument.property);
      }
      if (!name) {
        throw new Error(`${owner}: validator schema must be a named canonical export`);
      }
      name = origin?.name ?? name;
      const module = origin ? sourceModule(owner, origin.source) : owner;
      bindings.set(name, { name, module, schema: await schemaExport(module, name) });
    }
  }
  return [...bindings.values()];
}

function refinementBindings(schemas: readonly TSchema[]): Map<unknown, string> {
  const checks = new Map<unknown, string>([
    [hasValidNodeHostResources, "hasValidNodeHostResources"],
    [hasValidSessionExecAction, "hasValidSessionExecAction"],
  ]);
  const external = new Map<unknown, string>();
  const visited = new WeakSet<object>();
  const visit = (value: unknown): void => {
    if (typeof value !== "object" || value === null || visited.has(value)) {
      return;
    }
    visited.add(value);
    if (IsRefinement(value)) {
      const name = checks.get(value.check);
      if (name) {
        external.set(value, `{ check: ${name} }`);
      }
    }
    for (const descriptor of Object.values(Object.getOwnPropertyDescriptors(value))) {
      if ("value" in descriptor) {
        visit(descriptor.value);
      }
    }
  };
  for (const schema of schemas) {
    visit(schema);
  }
  return external;
}

const args = process.argv.slice(2);
if (args.some((arg) => arg !== "--check")) {
  throw new Error("Usage: pnpm gateway:validators:gen [--check]");
}
const check = args.includes("--check");
const expected = new Set<string>();
const groups: Array<{ name: string; bindings: SchemaBinding[] }> = [];
const schemas = new Map<string, SchemaBinding>();
for (const owner of sourceFiles(sourceRoot)) {
  const bindings = await bindingsFor(owner);
  if (bindings.length === 0) {
    continue;
  }
  groups.push({
    name: path.relative(sourceRoot, owner).replace(/\.ts$/, "").replaceAll(path.sep, "-"),
    bindings,
  });
  for (const binding of bindings) {
    const previous = schemas.get(binding.name);
    if (previous && previous.schema !== binding.schema) {
      throw new Error(`${owner}: conflicting canonical schema export ${binding.name}`);
    }
    schemas.set(binding.name, binding);
  }
}

async function writeOutput(group: string, extension: string, contents: string): Promise<void> {
  const outputPath = path.relative(repoRoot, path.join(outputRoot, `${group}.${extension}`));
  expected.add(path.basename(outputPath));
  const formatted = await format(outputPath, contents);
  if (formatted.errors.length > 0) {
    throw new Error(`Cannot format ${outputPath}: ${JSON.stringify(formatted.errors)}`);
  }
  const result = writeGeneratedOutput({ check, next: formatted.code, outputPath, repoRoot });
  if (check && result.changed) {
    throw new Error(`${outputPath} is stale; run pnpm gateway:validators:gen`);
  }
  console.log(`[gateway:validators] ${result.changed ? "updated" : "unchanged"} ${outputPath}`);
}

const bindings = [...schemas.values()];
// One pool interns shared schema shapes and runtime helpers across every owner.
// Module-scope exports let bundlers retain only the predicates a client imports.
const runtime = await compileStandaloneValidators(
  bindings.map(({ name, schema }) => ({ name: `is${name.replace(/Schema$/, "")}`, schema })),
  {
    resolveDir: repoRoot,
    shareSchemaFunctions: true,
    hoistSchemaFunctions: true,
    externals: refinementBindings(bindings.map(({ schema }) => schema)),
    imports: [
      `import { hasValidNodeHostResources, hasValidSessionExecAction } from ${JSON.stringify(path.join(sourceRoot, "schema/validation-invariants.ts"))};`,
    ],
  },
);
const declarations = bindings
  .map(({ name, module, schema }) => {
    const contract = authoredContracts.get(schema);
    let source = path.relative(outputRoot, contract?.module ?? module).replace(/\.ts$/, ".js");
    if (!source.startsWith(".")) {
      source = `./${source}`;
    }
    const type = contract
      ? `import(${JSON.stringify(source)}).${contract.type}`
      : `import("typebox").Static<typeof import(${JSON.stringify(source)}).${name}>`;
    return `export function is${name.replace(/Schema$/, "")}(value: unknown): value is ${type};`;
  })
  .join("\n");
const marker = standaloneValidatorHeader("pnpm gateway:validators:gen", { declaration: true });
await writeOutput(
  "predicates",
  "js",
  standaloneValidatorHeader("pnpm gateway:validators:gen", {
    additionalLintRules: [
      "eslint/no-underscore-dangle",
      "eslint/curly",
      "eslint/no-param-reassign",
      "eslint/prefer-object-has-own",
      "unicorn/no-instanceof-builtins",
      "unicorn/no-array-sort",
      "typescript/prefer-for-of",
      "eslint/no-useless-escape",
      "eslint/no-control-regex",
      "unicorn/no-useless-length-check",
      "oxc/double-comparisons",
      "typescript/no-unnecessary-type-conversion",
      "typescript/prefer-includes",
      "typescript/require-array-sort-compare",
    ],
  }) + runtime,
);
await writeOutput("predicates", "d.ts", marker + declarations);
for (const group of groups) {
  const reexports = `export { ${group.bindings.map(({ name }) => `is${name.replace(/Schema$/, "")}`).join(", ")} } from "./predicates.js";`;
  for (const extension of ["js", "d.ts"]) {
    await writeOutput(group.name, extension, marker + reexports);
  }
}
if (existsSync(outputRoot)) {
  for (const file of readdirSync(outputRoot)) {
    if (expected.has(file)) {
      continue;
    }
    const outputPath = path.join(outputRoot, file);
    if (!readFileSync(outputPath, "utf8").startsWith(header)) {
      throw new Error(`Unexpected file in generated validator directory: ${outputPath}`);
    }
    if (check) {
      throw new Error(`${outputPath} is obsolete; run pnpm gateway:validators:gen`);
    }
    unlinkSync(outputPath);
  }
}
