(version 1)
(deny default)
(import "dyld-support.sb")
(allow syscall*)
(allow mach-bootstrap)
(allow sysctl-read)
(allow sysctl-write (sysctl-name "kern.wq_limit_cooperative_threads"))
(allow file-read* file-map-executable (subpath "/System") (subpath "/usr/lib") (subpath "/usr/share") (subpath "/Library/Apple"))
(allow file-read-metadata (literal "/tmp") (literal "/var") (literal "/etc") (literal "/private") (literal "/private/tmp"))
(allow file-read* file-write* file-map-executable (subpath (param "BENCH_ROOT")))
(allow file-read* (literal "/dev/random") (literal "/dev/urandom") (literal "/private/etc/services") (literal "/private/etc/protocols"))
(allow file-read* file-write-data (literal "/dev/null") (literal "/dev/zero") (subpath "/dev/fd"))
(allow process-exec (subpath (param "BENCH_ROOT")))
(allow process-fork)
(allow signal (target children))
(allow network-outbound (remote ip (param "BENCH_ENDPOINT")))
(allow mach-lookup (global-name "com.apple.logd") (global-name "com.apple.system.logger") (global-name "com.apple.networkd") (global-name "com.apple.SystemConfiguration.configd") (global-name "com.apple.symptomsd"))
