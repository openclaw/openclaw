#!/usr/bin/env node

import assert from "node:assert/strict";
import { execSync } from "node:child_process";
import fs from "node:fs";
import path from "node:path";
import process from "node:process";
import { fileURLToPath } from "node:url";
import { parseArgs } from "node:util";
import { WORKBOARD_SCHEMA_SQL } from "../extensions/workboard/src/workboard-schema.ts";
import { listOpenClawStateFeatureSchemas } from "../src/state/openclaw-state-feature-schema.ts";
import { isDirectRunUrl } from "./lib/direct-run.mjs";
import { formatGeneratedModule } from "./lib/format-generated-module.mts";
import {
  catalog,
  literal,
  quote,
  sqliteOnlyNulGuards,
  type Catalog,
} from "./lib/postgres-schema-catalog.mts";

const ROOT = fileURLToPath(new URL("../", import.meta.url));
const WORKBOARD_OUTPUT = "extensions/workboard/src/workboard-schema.postgres.sql";
const OUTPUT = "src/state/postgres-schema.generated";
export const pendingPromotion = Object.freeze([
  {
    name: "idx_acp_sessions_resume_agent",
    reason:
      "v22 promotion follow-up PR4b (#169254): derive the ACP resume value once and index its promoted column",
  },
  {
    name: "idx_acp_sessions_resume_acpx",
    reason:
      "v22 promotion follow-up PR4b (#169254): derive the ACP resume value once and index its promoted column",
  },
]);
export const sqliteOnlyAllowList = sqliteOnlyNulGuards.map((column) => ({
  column,
  reason: "PostgreSQL text cannot hold NUL; the guard is enforced by the type.",
}));

function tableStatements(data: Catalog): string[] {
  return ["table", "index", "foreignKey"].flatMap((kind) =>
    data.objects
      .filter(
        (item) =>
          item.kind === kind && item.sql && (kind !== "index" || item.sql.startsWith("CREATE")),
      )
      .map((item) => item.sql!),
  );
}

export async function generateWorkboardPostgresSchema() {
  const { DatabaseSync } = await import("node:sqlite");
  const db = new DatabaseSync(":memory:");
  try {
    db.exec(WORKBOARD_SCHEMA_SQL);
    // Empty schema leaves qualification to the connection owner's search_path.
    const data = catalog(db, "");
    const omissions = data.objects.filter((item) => item.sql === null);
    if (omissions.length) {
      throw new Error(
        `Workboard PostgreSQL schema has unsupported objects: ${omissions.map((item) => `${item.kind} ${item.table}.${item.name}: ${item.reason}`).join("; ")}`,
      );
    }
    return {
      catalog: data,
      sql: `${[
        "-- Generated by pnpm db:postgres:gen --target workboard. Do not edit.",
        "-- The connection owner supplies search_path and the admission transaction.",
        ...tableStatements(data),
      ].join("\n\n")}\n`,
    };
  } finally {
    db.close();
  }
}

export async function generatePostgresSchemas(
  root = ROOT,
  prefix = "openclaw",
  options: { reportOnly?: boolean; includeJsonReport?: boolean } = {},
) {
  if (!prefix || Buffer.byteLength(`${prefix}_state`) > 63 || prefix.includes("\0")) {
    throw new Error("Schema prefix must fit PostgreSQL's 63-byte identifier limit");
  }
  const { DatabaseSync } = await import("node:sqlite");
  const catalogs: Record<string, Catalog> = {};
  const files: Record<string, string> = {};
  const fragments = root === ROOT ? listOpenClawStateFeatureSchemas() : [];
  const manifest = fragments.map(({ id, tables, indexes, dependencies, activation }) => ({
    id,
    tables,
    indexes,
    dependencies,
    activation,
    file: `fragment-${id}.postgres.sql`,
  }));
  for (const name of ["state", "agent"]) {
    const db = new DatabaseSync(":memory:");
    try {
      db.exec(fs.readFileSync(path.join(root, `src/state/openclaw-${name}-schema.sql`), "utf8"));
      if (name === "state") {
        for (const fragment of fragments) {
          db.exec(fragment.sql());
        }
      }
      catalogs[name] = catalog(db, `${prefix}_${name}`);
    } finally {
      db.close();
    }
    const data = catalogs[name]!;
    if (name === "state" && !options.reportOnly) {
      for (const item of data.objects.filter((entry) => entry.sql === null)) {
        const pending =
          item.kind === "index" && pendingPromotion.find((entry) => entry.name === item.name);
        if (pending) {
          item.reason = pending.reason;
          item.category = "pendingPromotion";
        } else if (
          item.table !== "sqlite_sequence" &&
          ["table", "column", "default", "check", "index", "foreignKey"].includes(item.kind)
        ) {
          throw new Error(
            `Unsupported shared-state ${item.kind} ${item.table}.${item.name}: ${item.source}: ${item.reason}`,
          );
        }
      }
    }
    if (name === "state" && root === ROOT) {
      for (const pending of pendingPromotion) {
        assert.ok(
          data.objects.some(
            (item) =>
              item.kind === "index" &&
              item.name === pending.name &&
              item.category === "pendingPromotion",
          ),
          `Stale pendingPromotion entry: ${pending.name}`,
        );
      }
      const ownership = new Map(
        fragments.flatMap((fragment) =>
          fragment.tables.map((table) => [table, fragment.id] as const),
        ),
      );
      const eager = { ...data, objects: data.objects.filter((item) => !ownership.has(item.table)) };
      for (const fragment of manifest) {
        const objects = data.objects.filter((item) => ownership.get(item.table) === fragment.id);
        files[fragment.file] =
          `${["-- Generated lazy feature; create dependencies first.", "BEGIN;", "SET LOCAL standard_conforming_strings = on;", ...tableStatements({ ...data, objects }), "COMMIT;"].join("\n\n")}\n`;
      }
      files["manifest.json"] =
        `${JSON.stringify({ minimumPostgresVersion: 16, fragments: manifest, pendingPromotion, sqliteOnlyAllowList }, null, 2)}\n`;
      files[`${name}.postgres.sql`] =
        `${["-- Generated eager shared state; lazy features are listed in manifest.json.", "BEGIN;", "SET LOCAL standard_conforming_strings = on;", `CREATE SCHEMA ${quote(data.schema)};`, ...tableStatements(eager), "COMMIT;"].join("\n\n")}\n`;
      continue;
    }
    const statements = [
      "-- Generated from canonical SQLite; consult portability-report.md before use.",
      "BEGIN;",
      "SET LOCAL standard_conforming_strings = on;",
      `CREATE SCHEMA ${quote(data.schema)};`,
    ];
    statements.push(...tableStatements(data));
    files[`${name}.postgres.sql`] = `${statements.join("\n\n")}\n\nCOMMIT;\n`;
  }
  const summary: Record<
    string,
    Record<string, { total: number; translated: number; reported: number }>
  > = {};
  const kinds = [
    "table",
    "column",
    "index",
    "foreignKey",
    "check",
    "trigger",
    "virtualTable",
    "internalTable",
  ];
  for (const [name, data] of Object.entries(catalogs)) {
    const counts: (typeof summary)[string] = {};
    for (const kind of kinds) {
      const items = data.objects.filter((item) => item.kind === kind);
      const translated = items.filter((item) => item.sql !== null).length;
      counts[kind] = { total: items.length, translated, reported: items.length - translated };
    }
    summary[name] = counts;
  }
  const limitations = [
    "Readiness tooling only: SQLite remains the runtime store and canonical .sql files remain authoritative. No data migration or runtime SQL/concurrency conformance is proved.",
    "Agent topology remains undecided: schema per agent versus shared tables. The agent output represents one canonical database only.",
    "Text uses C collation. PostgreSQL text rejects NUL; SQLite length(text) stops at NUL. Data validation and numeric/JSON representation differences need a separate migration contract.",
    "STRICT and WITHOUT ROWID options are removed. Identity sequences do not reproduce SQLite rowid/AUTOINCREMENT/sqlite_sequence allocation or rollback semantics; each rowid alias adds a PostgreSQL PK index absent from SQLite's index_list.",
    "Not covered: runtime-created memory FTS5 in packages/memory-host-sdk/src/host/memory-schema-fts.ts; vec0 in extensions/memory-core/src/memory/manager-sync-base.ts and src/migration/doctor-memory-sidecar-import.ts.",
    "Not covered: plugin-owned databases, including extensions/workboard/src/sqlite-store-schema.ts, extensions/logbook/src/store-schema.ts and extensions/team-reports/src/store-schema.ts.",
    "Not covered: additive/startup repair DDL in src/state/*-schema.ts and *migration*.ts, including openclaw-agent-transcript-fts-schema.ts, openclaw-agent-board-schema.ts and openclaw-agent-canonical-validation-migration.ts.",
  ];
  const report = {
    summary,
    limitations,
    pendingPromotion,
    sqliteOnlyAllowList,
    fragments: manifest,
    catalogs,
  };
  if (options.includeJsonReport) {
    files["portability-report.json"] = `${JSON.stringify(report, null, 2)}\n`;
  }
  const markdown = [
    "# PostgreSQL portability report",
    "",
    ...limitations.map((line) => `- ${line}`),
    "",
    "## Counts",
    "",
    "Database | Object | Total | Translated | Reported",
    "--- | --- | ---: | ---: | ---:",
  ];
  for (const [name, counts] of Object.entries(summary)) {
    for (const [kind, count] of Object.entries(counts)) {
      markdown.push(`${name} | ${kind} | ${count.total} | ${count.translated} | ${count.reported}`);
    }
  }
  for (const [name, data] of Object.entries(catalogs)) {
    markdown.push(
      "",
      `## ${name}: omissions and semantic notes`,
      "",
      ...data.notes.map((note) => `- ${note}`),
    );
    for (const item of data.objects.filter((entry) => entry.sql === null)) {
      markdown.push(
        `- ${item.kind} \`${item.table}.${item.name}\`: ${item.reason}${item.category ? `; ${item.category}${item.design ? `; ${item.design}` : ""}` : ""}. Source: \`${item.source.replaceAll("`", "\\`").replaceAll("\n", " ")}\``,
      );
    }
  }
  files["portability-report.md"] = formatGeneratedModule(`${markdown.join("\n")}\n`, {
    repoRoot: ROOT,
    outputPath: "portability-report.md",
    errorLabel: "PostgreSQL portability report",
  });
  return { files, report };
}

async function verifyPostgres(
  catalogs: Record<string, Catalog>,
  querySql: (sql: string) => Promise<unknown>,
): Promise<void> {
  const canonical = (value: unknown): string =>
    JSON.stringify(value, (_key, item: unknown) => {
      if (item !== null && typeof item === "object" && !Array.isArray(item)) {
        return Object.fromEntries(
          Object.entries(item).toSorted(([a], [b]) => a.localeCompare(b, "en")),
        );
      }
      return item;
    });
  for (const data of Object.values(catalogs)) {
    const expected: unknown[] = [];
    const add = (table: string, kind: string, value: unknown) =>
      expected.push({ table, kind, value });
    for (const table of data.tables) {
      add(table.name, "table", null);
      for (const [position, column] of table.columns.entries()) {
        add(table.name, "column", { ...column, position: position + 1 });
      }
      if (table.pk.length) {
        add(table.name, "primaryKey", table.pk);
      }
      for (const unique of table.unique) {
        add(table.name, "unique", unique);
      }
      for (const fk of table.foreignKeys) {
        add(table.name, "foreignKey", fk);
      }
      add(
        table.name,
        "indexes",
        data.schema.endsWith("_state")
          ? data.objects.filter(
              (item) =>
                item.table === table.name &&
                item.kind === "index" &&
                item.category !== "pendingPromotion",
            ).length + (table.columns.some((column) => column.identity) ? 1 : 0)
          : table.indexes,
      );
      add(
        table.name,
        "checks",
        data.objects.filter(
          (item) =>
            item.table === table.name &&
            item.kind === "check" &&
            (data.schema.endsWith("_state") || item.sql),
        ).length,
      );
    }
    const columns = (relation: string, keys: string) =>
      `(SELECT jsonb_agg(a.attname ORDER BY k.ordinality) FROM unnest(${keys}) WITH ORDINALITY k(num, ordinality) JOIN pg_attribute a ON a.attrelid = ${relation} AND a.attnum = k.num)`;
    const action = (field: string) =>
      `CASE ${field} WHEN 'a' THEN 'NO ACTION' WHEN 'r' THEN 'RESTRICT' WHEN 'c' THEN 'CASCADE' WHEN 'n' THEN 'SET NULL' WHEN 'd' THEN 'SET DEFAULT' END`;
    const query = `WITH relations AS (
      SELECT c.oid, c.relname FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
      WHERE n.nspname = ${literal(data.schema)} AND c.relkind IN ('r', 'p')
    ), facts AS (
      SELECT r.relname AS "table", 'table' AS kind, 'null'::jsonb AS value FROM relations r
      UNION ALL SELECT r.relname, 'column', jsonb_build_object(
        'name', a.attname, 'type', format_type(a.atttypid, a.atttypmod),
        'nullable', NOT a.attnotnull, 'identity', a.attidentity = 'd', 'position', a.attnum,
        'default', regexp_replace(pg_get_expr(d.adbin, d.adrelid), '::(text|bigint|double precision)$', ''))
        FROM relations r JOIN pg_attribute a ON a.attrelid = r.oid LEFT JOIN pg_attrdef d ON d.adrelid = r.oid AND d.adnum = a.attnum WHERE a.attnum > 0 AND NOT a.attisdropped
      UNION ALL SELECT r.relname, CASE c.contype WHEN 'p' THEN 'primaryKey' ELSE 'unique' END,
        ${columns("r.oid", "c.conkey")} FROM relations r JOIN pg_constraint c ON c.conrelid = r.oid WHERE c.contype IN ('p', 'u')
      UNION ALL SELECT r.relname, 'foreignKey', jsonb_build_object(
        'columns', ${columns("r.oid", "c.conkey")}, 'target', target.relname,
        'targetColumns', ${columns("c.confrelid", "c.confkey")},
        'onUpdate', ${action("c.confupdtype")}, 'onDelete', ${action("c.confdeltype")},
        'deferrable', c.condeferrable, 'deferred', c.condeferred)
        FROM relations r JOIN pg_constraint c ON c.conrelid = r.oid
        JOIN pg_class target ON target.oid = c.confrelid WHERE c.contype = 'f'
      UNION ALL SELECT r.relname, 'indexes', to_jsonb((SELECT count(*) FROM pg_index i WHERE i.indrelid = r.oid)) FROM relations r
      UNION ALL SELECT r.relname, 'checks', to_jsonb((SELECT count(*) FROM pg_constraint c WHERE c.conrelid = r.oid AND c.contype = 'c')) FROM relations r
    ) SELECT coalesce(jsonb_agg(facts), '[]'::jsonb) FROM facts;`;
    const actual = await querySql(query);
    assert.ok(Array.isArray(actual), "psql must return a JSON catalog array");
    assert.deepStrictEqual(
      actual.map(canonical).toSorted(),
      expected.map(canonical).toSorted(),
      `${data.schema}: unexplained PostgreSQL catalog differences`,
    );
    console.log(
      `${data.schema}: verified ${data.tables.length} tables, ${data.tables.reduce((sum, table) => sum + table.columns.length, 0)} columns, ${data.objects.filter((item) => item.kind === "check").length} CHECKs, ${data.tables.reduce((sum, table) => sum + table.indexes, 0)} indexes, ${data.tables.reduce((sum, table) => sum + table.foreignKeys.length, 0)} FKs; zero unexplained differences (types/nullability/defaults/identity, PK, UNIQUE, FK actions/deferrability)`,
    );
  }
}

export async function checkPostgresCatalog(connection: string): Promise<void> {
  const { Client } = await import("pg");
  const client = new Client({ connectionString: connection });
  const prefix = `conformance_${process.pid}`;
  await client.connect();
  try {
    if (
      Number((await client.query("SHOW server_version_num")).rows[0].server_version_num) < 160000
    ) {
      throw new Error("Shared-state schema requires PostgreSQL 16 or newer (IS JSON)");
    }
    const generated = await generatePostgresSchemas(ROOT, prefix);
    await client.query(generated.files["state.postgres.sql"]!);
    const remaining = [...generated.report.fragments];
    const applied = new Set<string>();
    while (remaining.length) {
      const next = remaining.findIndex((fragment) =>
        fragment.dependencies.every((id) => applied.has(id)),
      );
      if (next < 0) {
        throw new Error("Unresolved or cyclic lazy feature dependencies");
      }
      const [fragment] = remaining.splice(next, 1);
      await client.query(generated.files[fragment!.file]!);
      applied.add(fragment!.id);
    }
    await verifyPostgres(
      { state: generated.report.catalogs.state! },
      async (sql) => (await client.query(sql)).rows[0].coalesce,
    );
    console.log(
      `Pending v22 promotions: ${pendingPromotion.map((entry) => entry.name).join(", ")}`,
    );
  } finally {
    await client.query("ROLLBACK");
    await client.query(`DROP SCHEMA IF EXISTS ${quote(`${prefix}_state`)} CASCADE`);
    await client.end();
  }
}

if (isDirectRunUrl(process.argv[1], import.meta.url)) {
  const { values } = parseArgs({
    options: {
      target: { type: "string", default: "canonical" },
      out: { type: "string" },
      "schema-prefix": { type: "string", default: "openclaw" },
      "verify-psql": { type: "string" },
      "check-connection": { type: "string" },
      verify: { type: "boolean" },
      help: { type: "boolean" },
    },
  });
  if (values["check-connection"]) {
    await checkPostgresCatalog(values["check-connection"]);
  } else if (values.help) {
    console.log(
      "Usage: pnpm db:postgres:gen [--out <dir>] [--schema-prefix openclaw] [--verify]\n       pnpm db:postgres:gen --target workboard [--verify]\n       pnpm db:postgres:gen --check-connection <dsn>\n--out also exports the diagnostic portability-report.json; default tracked outputs omit it.\n--verify-psql accepts a trusted psql shell command and expects eager DDL plus all fragments already applied.",
    );
  } else if (values.target === "workboard") {
    if (values.out || values["verify-psql"]) {
      throw new Error(
        "The workboard target writes its committed artifact; --out and --verify-psql are canonical-only",
      );
    }
    const { sql } = await generateWorkboardPostgresSchema();
    const output = path.join(ROOT, WORKBOARD_OUTPUT);
    if (values.verify) {
      if (fs.readFileSync(output, "utf8") !== sql) {
        throw new Error(
          `${WORKBOARD_OUTPUT} is stale; run pnpm db:postgres:gen --target workboard`,
        );
      }
      console.log(`${WORKBOARD_OUTPUT}: up to date`);
    } else {
      fs.writeFileSync(output, sql);
      console.log(`Generated ${WORKBOARD_OUTPUT}`);
    }
  } else {
    if (values.target !== "canonical") {
      throw new Error("Use --target canonical or --target workboard");
    }
    const out = values.out ?? path.join(ROOT, OUTPUT);
    const result = await generatePostgresSchemas(ROOT, values["schema-prefix"], {
      includeJsonReport: values.out !== undefined,
    });
    if (!values.verify) {
      fs.mkdirSync(out, { recursive: true });
    }
    if (values.verify) {
      assert.deepEqual(
        fs.readdirSync(out).toSorted(),
        Object.keys(result.files).toSorted(),
        "Generated PostgreSQL artifact inventory is stale",
      );
    }
    for (const [name, content] of Object.entries(result.files)) {
      if (values.verify) {
        assert.equal(
          fs.readFileSync(path.join(out, name), "utf8"),
          content,
          `${name} is stale; run pnpm db:postgres:gen`,
        );
      } else {
        fs.writeFileSync(path.join(out, name), content);
      }
    }
    console.log(JSON.stringify(result.report.summary, null, 2));
    if (values["verify-psql"]) {
      await verifyPostgres(result.report.catalogs, async (sql) =>
        JSON.parse(
          execSync(`${values["verify-psql"]} -X -qAt -v ON_ERROR_STOP=1`, {
            input: sql,
            encoding: "utf8",
            maxBuffer: 16 * 1024 * 1024,
          }),
        ),
      );
    }
  }
}
